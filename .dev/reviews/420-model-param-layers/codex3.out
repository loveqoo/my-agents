    86	def _version_ops(versions: dict[str, VersionOps], key: str) -> VersionOps:
    87	    """versions 맵에서 key의 VersionOps를 얻는다(없으면 생성)."""
    88	    if key not in versions:
    89	        versions[key] = VersionOps()
    90	    return versions[key]
