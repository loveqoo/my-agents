    30	@router.post("/register", response_model=AgentOut, status_code=201)
    31	async def register_code_agent(
    32	    body: RegisterCodeAgentIn,
    33	    session: AsyncSession = Depends(get_session),
    34	    principal: User | str = Depends(current_principal),
    35	) -> AgentOut:
    36	    # endpoint를 절대 http(s)로 정규화(스펙 060, 일관성). SDK 직접 등록이라 base는 없다 — 스킴 없는
    37	    # host:port는 http:// 전치, 절대화 불가(빈 값·비-http 스킴)면 등록 시점에 400(채팅서 늦게 안 깸).
    38	    try:
    39	        endpoint = net_guard.normalize_http_url(body.endpoint)
    40	    except ValueError as exc:
    41	        raise HTTPException(status_code=400, detail=str(exc)) from exc
    42	    cfg = {
    43	        "model": body.model,
    44	        "prompt": body.prompt,
    45	        "memories": body.memories,
    46	        "vectorTables": [],
    47	        "mcps": body.mcps,
    48	        "historyDepth": body.historyDepth,
    49	    }
    50	    raw_name = (body.name or body.repo or "코드 에이전트")[:200]
    51	    agent = Agent(
    52	        agent_id=_new_agent_id(),
    53	        # 원격 유래(SDK 등록명) — 거부 대신 자동 변환, 원문은 설명으로(스펙 148, 210). base 180자 캡=접미 여유.
    54	        name=await _dedupe_agent_name(session, slugify_name(raw_name)[:180]),
    55	        description=raw_name,
    56	        source="code",
    57	        model=body.model,
    58	        prompt=body.prompt,
    59	        history_depth=body.historyDepth,
    60	        config=cfg,
    61	        exposed={"a2a": False},
    62	        status="online",
    63	        endpoint=endpoint,
    64	        token=crypto.encrypt(body.token),
    65	        runtime=body.runtime,
    66	        repo=body.repo,
    67	        commit=body.commit,
    68	        registered_at=_today(),
    69	        last_sync="방금",
    70	        active_version=body.commit or None,
    71	        owner_id=owner_of(principal),  # 생성 시 1회 스탬프(스펙 112)
    72	    )
    73	    if body.commit:
    74	        agent.versions.append(
    75	            AgentVersion(
    76	                version=body.commit,
    77	                ever_opened=True,
    78	                note="Deploy · 등록 시 동기화",
    79	                config=cfg,
    80	            )
    81	        )
    82	    session.add(agent)
    83	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
    84	    return await _reload_out(session, agent.id)
    85	
    86	
    87	# ----------------------------- 통합 연결 (스펙 057 — A2A 단일화) -----------------------------
    88	@router.post("/connect", response_model=AgentOut, status_code=201)
    89	async def connect_agent(
    90	    body: ConnectAgentIn,
    91	    session: AsyncSession = Depends(get_session),
    92	    principal: User | str = Depends(current_principal),
    93	) -> AgentOut:
    94	    """원격 에이전트 연결 — URL 하나로 A2A 카드를 fetch해 provenance 자동분류(스펙 057).
    95	
    96	    카드에 my-agents 확장(x-my-agents.manifest)이 있으면 우리가 SDK로 배포한 제1자(source=code,
    97	    매니페스트·배포 메타 보유), 없으면 제3자 A2A(source=external, 불투명). 둘 다 런타임은 A2A 하나.
    98	    SSRF 가드는 fetch_card·probe_endpoint가 각각 guard_url 선행(044/055).
    99	    """
   100	    try:
   101	        card = await agent_card.fetch_card(body.url)
   102	    except ValueError as exc:
   103	        raise HTTPException(status_code=400, detail=str(exc)) from exc
   104	
   105	    # 카드 published ≠ 실행 엔드포인트 live(045 #2). 도달 실패해도 등록 허용, status만 정직하게.
   106	    live = await agent_card.probe_endpoint(card.get("url"))
   107	    ext = agent_card.extract_my_agents(card)
   108	    if ext is not None:
   109	        agent = _build_code_agent_from_card(card, ext, body.token, live, body.url)
   110	    else:
   111	        agent = _build_external_agent(card, body.token, live, body.url)
   112	    agent.owner_id = owner_of(principal)  # 생성 시 1회 스탬프(스펙 112)
   113	    await _slugify_remote_agent(session, agent)  # 카드명은 원격 유래 — 자동 변환(스펙 148)
   114	    session.add(agent)
   115	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   116	    return await _reload_out(session, agent.id)
   117	
   118	
   119	# ----------------------------- 외부 에이전트 등록 (A2A 카드) — deprecated, connect로 대체 -----------------------------
   120	@router.post("/external", response_model=AgentOut, status_code=201)
   121	async def register_external_agent(
   122	    body: RegisterExternalAgentIn,
   123	    session: AsyncSession = Depends(get_session),
   124	    principal: User | str = Depends(current_principal),
   125	) -> AgentOut:
   126	    """A2A Agent Card URL을 fetch·검증해 외부 에이전트로 등록(026, 1차).
   127	
   128	    057 이후 deprecated — 프론트는 connect를 호출한다. 라우트·로직은 무회귀 위해 잔존(connect의
   129	    external 분기와 동일 빌더 공유). 실제 A2A 호출은 _a2a_stream.
   130	    """
   131	    try:
   132	        card = await agent_card.fetch_card(body.cardUrl)
   133	    except ValueError as exc:
   134	        raise HTTPException(status_code=400, detail=str(exc)) from exc
   135	
   136	    live = await agent_card.probe_endpoint(card.get("url"))
   137	    agent = _build_external_agent(card, body.token, live, body.cardUrl)
   138	    agent.owner_id = owner_of(principal)  # 생성 시 1회 스탬프(스펙 112)
   139	    await _slugify_remote_agent(session, agent)  # 카드명은 원격 유래 — 자동 변환(스펙 148)
   140	    session.add(agent)
   141	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   142	    return await _reload_out(session, agent.id)
   143	
