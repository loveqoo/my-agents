   140	async def _collect_feedback_aggregates(
   141	    session: AsyncSession, agent: Agent, versions: dict[str, VersionOps]
   142	) -> tuple[int, int]:
   143	    """피드백 집계(스펙 209, 242 trace 귀속)를 versions에 채우고 버전 미기록 (up, down)을 반환."""
   144	    from ..models import Message, MessageFeedback
   145	    from ..models import Session as SessionRow
   146	
   147	    # 피드백 집계 — feedback→message(trace.agentVersion)→session(agent_pk=이 에이전트).
   148	    _ver_expr = Message.trace[
   149	        "agentVersion"
   150	    ].astext  # 식 재사용(두 번 쓰면 bind 파라미터가 갈라져 GROUP BY 불일치)
   151	    fb = (
   152	        await session.execute(
   153	            select(_ver_expr, MessageFeedback.rating, func.count(MessageFeedback.id))
   154	            .join(
   155	                Message,
   156	                (Message.id == MessageFeedback.message_pk)
   157	                # codex 244 #1 — 중복 session_pk 불일치 행(보정/버그 유래) 방어: 메시지와 피드백의
   158	                # 세션 일치를 조인에 강제(정상 경로는 항상 참, 불일치 행은 집계 제외).
   159	                & (Message.session_pk == MessageFeedback.session_pk),
   160	            )
   161	            .join(SessionRow, SessionRow.id == MessageFeedback.session_pk)
   162	            .where(SessionRow.agent_pk == agent.id)
   163	            .group_by(_ver_expr, MessageFeedback.rating)
   164	        )
   165	    ).all()
   166	    un_up = un_down = 0
   167	    for ver, rating, cnt in fb:
   168	        if ver:
   169	            vo = _version_ops(versions, ver)
   170	            if rating == "up":
   171	                vo.up += int(cnt)
   172	            else:
   173	                vo.down += int(cnt)
   174	        elif rating == "up":
   175	            un_up += int(cnt)
   176	        else:
   177	            un_down += int(cnt)
   178	    return un_up, un_down
   179	
