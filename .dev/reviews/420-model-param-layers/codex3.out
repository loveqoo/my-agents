   181	@router.get("/{agent_id}/ops", response_model=AgentOpsOut)
   182	async def agent_ops(
   183	    agent_id: uuid.UUID,
   184	    session: AsyncSession = Depends(get_session),
   185	    principal: User | str = Depends(current_principal),
   186	) -> AgentOpsOut:
   187	    """버전별 운영 지표(스펙 244) — 평가(240 귀속)·자동 회귀(241)·피드백(209, 242 trace 귀속) 집계.
   188	
   189	    게이트=상세와 동일(may_use_agent, 비가시 404-fold). 피드백의 버전 귀속은 대상 assistant 메시지의
   190	    trace.agentVersion(242 이후 기록) — 미기록분은 unversioned로 정직하게 분리(과거를 아는 척 안 함)."""
   191	    agent = await _load_agent(session, agent_id)
   192	    if agent is None or not may_use_agent(agent, principal):
   193	        raise HTTPException(status_code=404, detail="agent not found")
   194	    if not may_manage(agent, principal):
   195	        # 운영 지표=전 유저 피드백·평가 합산(codex 244 #2) — 관리자·소유자 전용(사용자는 대화만).
   196	        raise HTTPException(
   197	            status_code=403, detail="운영 지표는 이 에이전트를 관리할 수 있어야 합니다"
   198	        )
   199	
   200	    versions: dict[str, VersionOps] = {}
   201	    await _collect_eval_aggregates(session, agent, versions)
   202	    un_up, un_down = await _collect_feedback_aggregates(session, agent, versions)
   203	    return AgentOpsOut(versions=versions, unversionedUp=un_up, unversionedDown=un_down)
