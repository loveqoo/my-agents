   340	
   341	def _preserve_impl(body: AgentUpdate, agent: Agent, draft: AgentVersion | None, cfg: dict) -> None:
   342	    """요청에 impl 미명시면 편집 베이스(초안→활성 config)의 impl을 cfg에 이어받는다.
   343	
   344	    impl(스펙 085 SDK 런타임 키)은 편집 폼이 아직 안 보내므로(SPA 미배선), 요청에 명시되지
   345	    않으면 기존 값을 보존한다 — 안 그러면 Pydantic 기본 None이 덮어써 편집→활성화가 커스텀
   346	    에이전트를 DefaultUiAgent로 silent 되돌린다(codex 적대 리뷰 F1). 명시적으로 보내면(클리어 포함)
   347	    그 값 존중."""
   348	    if "impl" not in body.config.model_fields_set:
   349	        base = (draft.config if draft is not None else None) or dict(agent.config or {})
   350	        cfg["impl"] = base.get("impl")  # draft=미오픈 스크래치(스펙 370 — 이름만 승계)
   351	
   352	
   353	# ----------------------------- 편집 = 초안 저장 -----------------------------
   354	@router.put("/{agent_id}", response_model=AgentOut)
   355	async def update_agent(
   356	    agent_id: uuid.UUID,
   357	    body: AgentUpdate,
   358	    session: AsyncSession = Depends(get_session),
   359	    principal: User | str = Depends(current_principal),
   360	) -> AgentOut:
   361	    agent = await _load_agent(session, agent_id)
   362	    if agent is None:
   363	        raise HTTPException(status_code=404, detail="agent not found")
   364	    assert_may_manage(
   365	        agent, principal, not_found_detail="agent not found"
   366	    )  # 소유자/특권만(스펙 112)
   367	
   368	    cfg = body.config.model_dump()
   369	    _enforce_tool_policy_gate(cfg, principal)
   370	    _enforce_ephemeral_boundary(
   371	        cfg
   372	    )  # DB 쓰기 능력 금지(스펙 237)  # 완화는 admin만(스펙 177 P2 D4)
   373	    draft = next((v for v in agent.versions if not v.ever_opened), None)  # 스크래치(스펙 370)
   374	    _preserve_impl(body, agent, draft, cfg)
   375	    _strip_pipeline_model_params(cfg)  # 최종 impl 확정 후 노드형 modelParams 강제 비움(스펙 420 P1①)
   376	    # 노드 참조 존재 검증(스펙 316, codex P1) — impl 무관 + 이름 잠금(삭제 가드와 직렬화).
   377	    await assert_node_refs_exist(session, cfg.get("nodes"))
   378	    # 기억 이름 존재 검증(스펙 387) — 노드 참조와 같은 규칙(dangling name의 조용한 무동작 차단).
   379	    await assert_memory_names_exist(session, cfg)
   380	    # 노드형 풀=노드 합집합 서버 파생(스펙 289 P2) — impl 보존 **뒤**에 호출(미명시 impl이 pipeline로
   381	    # 확정된 뒤라야 파생 게이트가 맞는다).
   382	    await derive_pipeline_pool(cfg)
   383	    # 충돌 규칙(스펙 370): 스크래치 유일 — 있으면 그 행을 새 번호·새 pins로 대체, 없으면 신설.
   384	    # 번호 = 오픈+1(오픈이력 슬롯이면 최대 오픈+1 — 오픈됐던 버전은 불변 보호).
   385	    scratch, target_ver = scratch_target(agent)
   386	    pins = await freeze_pins(session, cfg)  # 편집 시점 재freeze(스펙 370)
   387	    if scratch is not None:
   388	        scratch.version = target_ver
   389	        scratch.config = cfg
   390	        scratch.pins = pins
   391	        scratch.note = f"Edited {_today()}"
   392	    else:
   393	        agent.versions.append(
   394	            AgentVersion(
   395	                version=target_ver,
   396	                ever_opened=False,
   397	                pins=pins,
   398	                note=f"{agent.active_version or 'v0'}에서 편집",
   399	                config=cfg,
   400	            )
   401	        )
   402	    if body.name is not None and body.name != agent.name:
   403	        assert_valid_name(body.name)  # 식별 이름 변경도 규칙(스펙 148)
   404	        agent.name = body.name
   405	    if body.description is not None:
   406	        agent.description = body.description.strip() or None  # ""=설명 비우기
   407	    # 서빙 config/active_version 은 건드리지 않음.
   408	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   409	    return await _reload_out(session, agent.id)
   410	
   411	
   412	@router.delete("/{agent_id}", status_code=204)
   413	async def delete_agent(
   414	    agent_id: uuid.UUID,
   415	    session: AsyncSession = Depends(get_session),
   416	    principal: User | str = Depends(current_principal),
   417	) -> None:
   418	    agent = await get_or_404(session, Agent, agent_id, detail="agent not found")
   419	    assert_may_manage(
   420	        agent, principal, not_found_detail="agent not found"
   421	    )  # 소유자/특권만(스펙 112)
   422	    await session.delete(agent)
   423	    await session.commit()
     1	"""버전 라우트(스펙 370) — 오픈(포인터 이동)·채택(pins 재freeze).
     2	
     3	구 상태기계(draft/active/archived + 포크·되돌리기·프롬프트 스냅샷 갱신)는 폐기:
     4	- 포크 → 없음(편집이 곧 다음 버전 작업 — 충돌 규칙은 crud_routes PUT).
     5	- 되돌리기 → 예전 버전 오픈(activate)이 곧 롤백.
     6	- prompt/refresh(스펙 161 promptStale) → 채택(adopt)이 전 블록으로 일반화.
     7	오픈은 미래 평가 게이트(367-E: 점수·회수 임계)의 관문이다.
     8	"""
     9	
    10	import uuid
    11	
    12	from fastapi import Depends, HTTPException
    13	from sqlalchemy.ext.asyncio import AsyncSession
    14	
    15	from ..auth import current_principal
    16	from ..background import spawn
    17	from ..block_versions import freeze_pins, resolve_pinned
    18	from ..db import get_session
    19	from ..models import AgentVersion, User
    20	from ..ownership import assert_may_manage
    21	from ..schemas import ActivateIn, AgentOut
    22	from .guards import _enforce_ephemeral_boundary, _strip_pipeline_model_params
    23	from .helpers import _find_version, _load_agent, _reload_out, _today, scratch_target
    24	from .routers import router
    25	
    26	
    27	# ----------------------------- 오픈 (포인터 이동 + ever_opened) -----------------------------
    28	@router.post("/{agent_id}/activate", response_model=AgentOut)
    29	async def activate_version(
    30	    agent_id: uuid.UUID,
    31	    body: ActivateIn,
    32	    session: AsyncSession = Depends(get_session),
    33	    principal: User | str = Depends(current_principal),
    34	) -> AgentOut:
    35	    """버전 오픈(스펙 370) — 라이브 포인터를 그 버전으로 옮기고 ever_opened를 영구 스탬프.
    36	
    37	    롤백 = 예전 오픈 버전을 다시 오픈(같은 동사). head 컬럼(config/model/prompt/depth)은 오픈
    38	    버전의 구체화 캐시 — prompt는 pin payload에서(불변), pin 부재 시 head 폴백(레거시)."""
    39	    agent = await _load_agent(session, agent_id)
    40	    if agent is None:
    41	        raise HTTPException(status_code=404, detail="agent not found")
    42	    assert_may_manage(
    43	        agent, principal, not_found_detail="agent not found"
    44	    )  # 소유자/특권만(스펙 112)
    45	
    46	    target = _find_version(agent, body.version)
    47	    if target is None:
    48	        raise HTTPException(status_code=404, detail="version not found")
    49	    if agent.active_version == body.version:
    50	        raise HTTPException(status_code=400, detail="이미 오픈된 버전입니다")
    51	    # 평가 게이트(스펙 372=367-E) — 스크래치(미오픈) 첫 오픈만. 롤백(ever_opened)은 면제(개발자 확정:
    52	    # 긴급 롤백을 게이트가 막으면 사고 대응이 잠긴다). 우회 플래그 없음 — 급하면 설정에서 임계를
    53	    # 낮추는 명시 행위로만(감사 가능).
    54	    if not target.ever_opened and agent.source == "ui":
    55	        blocked = await _eval_gate_reason(session, agent.id, body.version)
    56	        if blocked:
    57	            raise HTTPException(status_code=400, detail=blocked)
    58	
    59	    cfg = dict(target.config or {})
    60	    _enforce_ephemeral_boundary(
    61	        cfg
    62	    )  # 스펙 237(codex #1) — 과거 버전 오픈도 "존재 불가" 불변식 유지
    63	    _strip_pipeline_model_params(cfg)  # 노드형 modelParams 비움(스펙 420 — 과거 버전 raw 재저장 차단)
    64	    target.ever_opened = True  # 오픈 이력 = 영구 불변 보호(스펙 370 충돌 규칙)
    65	    agent.config = cfg
    66	    agent.model = cfg["model"]
    67	    agent.prompt = await _pinned_prompt_body(session, target, cfg)
    68	    agent.history_depth = cfg["historyDepth"]
    69	    agent.active_version = body.version
    70	    agent.status = "online"
    71	
    72	    await session.commit()
    73	    # 자동 회귀(스펙 241, AgentOps B) — 새 버전이 서빙되는 순간 회귀 자산 자동 재실행(fire-and-forget:
    74	    # 실패해도 오픈은 정상). 평가 게이트(367-E)가 추후 이 관문에 선다.
    75	    from ..eval_routes import trigger_auto_regression
    76	
    77	    # 오픈 이벤트의 버전을 명시 관통(스펙 399 버전 핀 완성형 — codex 적대: 태스크 실행 전 재오픈이
    78	    # 끼면 태스크가 나중 active를 캡처하는 race, 이벤트 버전을 인자로 고정).
    79	    spawn(trigger_auto_regression(agent.id, principal, opened_version=body.version))
    80	    return await _reload_out(session, agent.id)
    81	
    82	
    83	async def _eval_gate_reason(session: AsyncSession, agent_pk: uuid.UUID, version: str) -> str | None:
    84	    """평가 게이트 판정(스펙 372) — 통과면 None, 미달이면 사유(긍정형: 무엇이 되면 열리는가).
    85	
    86	    회수 = 그 버전의 성공(status=ok·score 보유) 평가 런 수, 점수 = 그 런들의 **평균**(개발자 확정 —
    87	    우연한 1회 고/저점에 안 덩샘). 임계는 전역 설정(app_settings) — 둘 다 0이면 게이트 꺼짐."""
    88	    from sqlalchemy import func, select
    89	
    90	    from ..app_settings import get_setting
    91	    from ..models import EvalRun
    92	
    93	    min_runs = await get_setting("eval_gate_min_runs")
    94	    min_score = await get_setting("eval_gate_min_score")
    95	    if not min_runs and not min_score:
    96	        return None  # 게이트 꺼짐(기본) — 무회귀
    97	    runs, avg_score = (
    98	        await session.execute(
    99	            select(func.count(EvalRun.id), func.avg(EvalRun.score)).where(
   100	                EvalRun.agent_pk == agent_pk,
   101	                EvalRun.agent_version == version,
   102	                EvalRun.status == "ok",
   103	                EvalRun.score.is_not(None),
   104	            )
   105	        )
   106	    ).one()
   107	    runs = int(runs or 0)
   108	    avg_score = float(avg_score) if avg_score is not None else None
   109	    # 경계값 부동소수 가드 — 평균이 이진 표현상 0.7999…로 떨어져도 80% 임계를 통과해야 한다
   110	    # (verify_372가 정확 경계(0.9+0.5+1.0)/3=0.8을 회귀 핀으로 고정).
   111	    ok = runs >= int(min_runs) and (
   112	        float(min_score) <= 0 or (avg_score or 0) + 1e-9 >= float(min_score)
   113	    )
   114	    if ok:
   115	        return None
   116	    now_score = f"평균 {avg_score * 100:.0f}%" if avg_score is not None else "점수 없음"
   117	    return (
   118	        f"평가 게이트: 현재 성공 평가 {runs}회·{now_score} — "
   119	        f"{int(min_runs)}회 이상·평균 {float(min_score) * 100:.0f}% 이상이면 오픈할 수 있습니다. "
   120	        f"(에이전트 상세·평가 화면에서 이 버전(v{version.lstrip('v')})을 지정해 평가를 돌리세요)"
   121	    )
   122	
   123	
   124	async def _pinned_prompt_body(session: AsyncSession, vrow: AgentVersion, cfg: dict) -> str:
   125	    """오픈 버전의 프롬프트 본문 — pin payload 우선(불변), 부재 시 head 해석 폴백(레거시·literal)."""
   126	    from .helpers import resolve_prompt
   127	
   128	    name = cfg.get("prompt") or ""
   129	    payload = await resolve_pinned(session, vrow.pins, "prompt", name)
   130	    if payload is not None:
     1	"""verify_420 — 모델 파라미터 캐스케이드 층 정책(스펙 420) 계약 핀.
     2	
     3	FE(modelParamLayerApplies)가 숨긴 층 == BE(layer_applies)가 안 적용을 못박는다 — FE/BE 드리프트 봉인.
     4	
     5	  P  정책 단위: layer_applies 매트릭스(model-default 항상·node=pipeline만·agent/session=non-pipeline만).
     6	  W  쓰기 경계: AgentConfig가 노드형 modelParams를 비운다(illegal state 표현 불가), 비노드형은 보존.
     7	  R  해석 관문(실 DB): 노드형에 agent·session 층 modelParams가 노드 model_cfg에 **안 실림**(명시 모델
     8	     노드·모델없는 폴백 노드 둘 다). 비노드형은 agent 층이 실림(무회귀).
     9	
    10	실행: uv run python tests/_throwaway_db.py tests/verify_420_model_param_layers.py
    11	"""
    12	
    13	import asyncio
    14	import pathlib
    15	import sys
    16	
    17	ROOT = pathlib.Path(__file__).resolve().parent.parent
    18	sys.path.insert(0, str(ROOT / "packages" / "api" / "src"))
    19	sys.path.insert(0, str(ROOT / "packages" / "agent" / "src"))
    20	
    21	import uuid  # noqa: E402
    22	
    23	from sqlalchemy import delete, select  # noqa: E402
    24	
    25	from api.agents.guards import _strip_pipeline_model_params  # noqa: E402
    26	from api.chat_context import _load_context, _resolve_model, _resolve_node_models  # noqa: E402
    27	from api.db import SessionLocal  # noqa: E402
    28	from api.model_param_layers import layer_applies  # noqa: E402
    29	from api.models import Agent, ModelConfig  # noqa: E402
    30	from api.schemas.agents import AgentConfig  # noqa: E402
    31	
    32	_TAG = f"v420-{uuid.uuid4().hex[:8]}"
    33	
    34	_fails: list[str] = []
    35	passed = 0
    36	
    37	
    38	def check(cond: object, msg: str) -> None:
    39	    global passed
    40	    print(("  ok  " if cond else " FAIL ") + msg)
    41	    if cond:
    42	        passed += 1
    43	    else:
    44	        _fails.append(msg)
    45	
    46	
    47	def _p_policy() -> None:
    48	    print("== P 정책 단위(layer_applies) ==")
    49	    check(layer_applies("model-default", "pipeline") and layer_applies("model-default", None),
    50	          "model-default: 항상")
    51	    check(layer_applies("node", "pipeline") and not layer_applies("node", None),
    52	          "node: pipeline만")
    53	    check(not layer_applies("agent", "pipeline") and layer_applies("agent", None),
    54	          "agent: non-pipeline만")
    55	    check(not layer_applies("session", "pipeline") and layer_applies("session", None),
    56	          "session: non-pipeline만")
    57	    try:
    58	        layer_applies("bogus", None)
    59	        check(False, "알 수 없는 층 → ValueError")
    60	    except ValueError:
    61	        check(True, "알 수 없는 층 → ValueError(오타 조기 발견)")
    62	
    63	
    64	def _w_write_boundary() -> None:
    65	    print("== W 쓰기 경계(AgentConfig + strip 헬퍼) ==")
    66	    node = AgentConfig(impl="pipeline", modelParams={"temperature": 0.3}, nodes=[{"prompt": "x"}])
    67	    check(node.modelParams == {}, f"노드형 modelParams 저장 차단(비움) (got {node.modelParams})")
    68	    direct = AgentConfig(impl=None, modelParams={"temperature": 0.3})
    69	    check(direct.modelParams.get("temperature") == 0.3, "비노드형 modelParams 보존(무회귀)")
    70	    # P1① codex — update 순서 역전(impl 나중 복원) 방어: 최종 impl 확정 후 strip 헬퍼.
    71	    cfg = {"impl": "pipeline", "modelParams": {"temperature": 0.9}}  # 파싱 땐 impl 없다가 복원된 형태
    72	    _strip_pipeline_model_params(cfg)
    73	    check(cfg["modelParams"] == {}, f"strip 헬퍼: 노드형 modelParams 비움(update 순서 방어) (got {cfg['modelParams']})")
    74	    cfg2 = {"impl": None, "modelParams": {"temperature": 0.9}}
    75	    _strip_pipeline_model_params(cfg2)
    76	    check(cfg2["modelParams"].get("temperature") == 0.9, "strip 헬퍼: 비노드형 보존(오탐 없음)")
    77	
    78	
    79	async def _t_temperature_channel(model_name: str) -> None:
    80	    """P1② codex — temperature 병렬 통로 봉인: 노드형 에이전트(레거시 불법 저장 config, raw 시드로
    81	    validator 우회)의 ctx.temperature가 None이어야(agent·session 둘 다). 이게 run_params로 4입구+노드에
    82	    새던 실우회. 비노드형은 ctx.temperature 유지(무회귀)."""
    83	    print("== T temperature 병렬 통로(ctx.temperature, 실 로더) ==")
    84	    async with SessionLocal() as s:
    85	        # raw 시드 = AgentConfig validator 우회(레거시·API 직접 저장 재현) — 불법 modelParams가 DB에.
    86	        s.add(Agent(
    87	            agent_id=f"agt_{_TAG}_pipe", name=f"{_TAG}_pipe", source="ui", active_version="v1",
    88	            config={"impl": "pipeline", "model": model_name, "modelParams": {"temperature": 0.9},
    89	                    "nodes": [{"prompt": "n", "model": model_name}]},
    90	        ))
    91	        s.add(Agent(
    92	            agent_id=f"agt_{_TAG}_direct", name=f"{_TAG}_direct", source="ui", active_version="v1",
    93	            config={"impl": None, "model": model_name, "modelParams": {"temperature": 0.5}},
    94	        ))
    95	        await s.commit()
    96	        pipe = (await s.execute(select(Agent).where(Agent.agent_id == f"agt_{_TAG}_pipe"))).scalar_one()
    97	        direct = (await s.execute(select(Agent).where(Agent.agent_id == f"agt_{_TAG}_direct"))).scalar_one()
    98	        pipe_id, direct_id = pipe.id, direct.id
    99	    try:
   100	        ctx = await _load_context(pipe_id, None, {}, own=None)
   101	        check(ctx.temperature is None, f"노드형 ctx.temperature=None(agent 층 병렬통로 봉인) (got {ctx.temperature})")
   102	        ctx_s = await _load_context(pipe_id, None, {"modelParams": {"temperature": 0.01}}, own=None)
   103	        check(ctx_s.temperature is None, f"노드형 ctx.temperature=None(session 오버라이드도 봉인) (got {ctx_s.temperature})")
   104	        ctx_d = await _load_context(direct_id, None, {}, own=None)
   105	        check(ctx_d.temperature == 0.5, f"비노드형 ctx.temperature 유지(무회귀) (got {ctx_d.temperature})")
   106	    finally:
   107	        async with SessionLocal() as s:
   108	            await s.execute(delete(Agent).where(Agent.agent_id.like(f"agt_{_TAG}_%")))
   109	            await s.commit()
   110	
   111	
   112	async def _r_resolution() -> None:
   113	    print("== R 해석 관문(실 DB) ==")
   114	    async with SessionLocal() as s:
   115	        m = (
   116	            await s.execute(
   117	                select(ModelConfig).where(ModelConfig.kind == "chat").limit(1)
   118	            )
   119	        ).scalar_one_or_none()
   120	    if m is None:
   121	        check(False, "등록 chat 모델 없음 — 시드 확인")
   122	        return None
   123	    model_name = m.name
   124	
   125	    # 노드형: agent 층(temperature) + session 층(top_p)이 노드에 안 실려야. + node 층은 실려야(양성).
   126	    node_cfg = {"impl": "pipeline", "model": model_name, "modelParams": {"temperature": 0.9}}
   127	    async with SessionLocal() as s:
   128	        default_cfg = await _resolve_model(s, node_cfg, None)
   129	        nodes = [
   130	            {"prompt": "with-model", "model": model_name},  # 자기 모델 노드(경로 A)
   131	            {"prompt": "no-model"},  # 모델 없는 노드 → default_cfg 폴백(경로 B)
   132	            {"prompt": "own-mp", "model": model_name, "modelParams": {"temperature": 0.42}},  # node 층(양성)
   133	        ]
   134	        resolved = await _resolve_node_models(
   135	            s, nodes, default_cfg, agent_cfg=node_cfg, session_mp={"top_p": 0.5}
   136	        )
   137	    by_tag = {r.get("prompt"): (r.get("model_cfg") or {}).get("params") or {} for r in resolved}
   138	    for tag in ("with-model", "no-model", "own-mp"):
   139	        params = by_tag[tag]
   140	        check(params.get("temperature") != 0.9, f"[{tag}] 노드형: agent 층(temperature) 미적용 (got {params.get('temperature')})")
   141	        check(params.get("top_p") != 0.5, f"[{tag}] 노드형: session 층(top_p) 미적용 (got {params.get('top_p')})")
   142	    # node 층 양성 무회귀(codex 재검 P2) — 노드 자기 modelParams는 실제로 model_cfg.params에 실린다.
   143	    check(by_tag["own-mp"].get("temperature") == 0.42,
   144	          f"node 층 양성: 노드 자기 modelParams(temperature) 적용됨 (got {by_tag['own-mp'].get('temperature')})")
   145	
   146	    # 노드형 default_cfg(폴백 원천)도 agent 층 없어야(경로 B 봉인 확인).
   147	    check((default_cfg.get("params") or {}).get("temperature") != 0.9,
   148	          "노드형 default_cfg: agent 층 미적용(폴백 경로 봉인)")
   149	
   150	    # 비노드형: agent 층이 실려야(무회귀).
   151	    direct_cfg = {"impl": None, "model": model_name, "modelParams": {"temperature": 0.9}}
   152	    async with SessionLocal() as s:
   153	        mc = await _resolve_model(s, direct_cfg, None)
   154	    check((mc.get("params") or {}).get("temperature") == 0.9,
   155	          f"비노드형: agent 층(temperature) 적용됨(무회귀) (got {(mc.get('params') or {}).get('temperature')})")
   156	    return model_name
   157	
   158	
   159	async def main() -> None:
   160	    _p_policy()
   161	    _w_write_boundary()
   162	    model_name = await _r_resolution()
   163	    if model_name:
   164	        await _t_temperature_channel(model_name)
   165	    print()
   166	    if _fails:
   167	        print(f"FAILED: {len(_fails)}건")
   168	        for f in _fails:
   169	            print("  -", f)
   170	        sys.exit(1)
   171	    print(f"VERIFY420_OK — {passed}건 전부 통과")
   172	
   173	
   174	if __name__ == "__main__":
   175	    asyncio.run(main())

