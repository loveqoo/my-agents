    93	async def _collect_eval_aggregates(
    94	    session: AsyncSession, agent: Agent, versions: dict[str, VersionOps]
    95	) -> None:
    96	    """평가 런 집계(스펙 240 귀속·241 자동 회귀)와 버전별 최근 성공 점수를 versions에 채운다."""
    97	    from sqlalchemy import case
    98	
    99	    from ..models import EvalRun
   100	
   101	    # 평가 집계 — SQL 전수(codex 244 #3: 최신 N개 순회는 조용한 과소집계 = no-silent-caps 위반).
   102	    agg = (
   103	        await session.execute(
   104	            select(
   105	                EvalRun.agent_version,
   106	                func.count(EvalRun.id),
   107	                func.sum(case((EvalRun.env["trigger"].astext == "activate", 1), else_=0)),
   108	                func.sum(case((EvalRun.status == "error", 1), else_=0)),
   109	            )
   110	            .where(EvalRun.agent_pk == agent.id, EvalRun.agent_version.is_not(None))
   111	            .group_by(EvalRun.agent_version)
   112	        )
   113	    ).all()
   114	    for ver, total, auto, errs in agg:
   115	        vo = _version_ops(versions, ver)
   116	        vo.evalRuns = int(total)
   117	        vo.autoRuns = int(auto or 0)
   118	        vo.errorRuns = int(errs or 0)
   119	    # 버전별 **최근 성공** 점수(DISTINCT ON) — 최신 런이 error여도 마지막 성공을 정직하게 표기
   120	    # (UI는 errorRuns>0이면 실패 칩을 함께 노출 — codex 244 #4).
   121	    last_ok = (
   122	        await session.execute(
   123	            select(EvalRun.agent_version, EvalRun.score, EvalRun.started_at)
   124	            .where(
   125	                EvalRun.agent_pk == agent.id,
   126	                EvalRun.agent_version.is_not(None),
   127	                EvalRun.status == "ok",
   128	                EvalRun.score.is_not(None),
   129	            )
   130	            .distinct(EvalRun.agent_version)
   131	            .order_by(EvalRun.agent_version, EvalRun.started_at.desc())
   132	        )
   133	    ).all()
   134	    for ver, score, started_at in last_ok:
   135	        vo = _version_ops(versions, ver)
   136	        vo.lastScore = score
   137	        vo.lastRunAt = started_at.isoformat() if started_at else None
   138	
