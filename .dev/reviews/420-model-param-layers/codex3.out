   225	            out.stalePins = await stale_pins(session, open_row.pins)
   226	    # 노드 참조 해석 결과(스펙 316, 파생·읽기 전용) — 오버라이드 패널이 참조 노드의 유효 설정을
   227	    # 보게. 해석 실패(미해결 참조)는 조회를 막지 않고 None(고치러 온 화면을 잠그지 않는다 —
   228	    # 실행 시점의 422가 정직 통보를 맡는다).
   229	    if isinstance(out.nodes, list):
   230	        try:
   231	            out.resolvedNodes = await resolve_node_refs(session, out.nodes)
   232	        except HTTPException:
   233	            out.resolvedNodes = None
   234	    return out
   235	
   236	
   237	# ----------------------------- 생성 (UI) -----------------------------
   238	@router.post("", response_model=AgentOut, status_code=201)
   239	async def create_agent(
   240	    body: AgentCreate,
   241	    session: AsyncSession = Depends(get_session),
   242	    principal: User | str = Depends(current_principal),
   243	) -> AgentOut:
   244	    assert_valid_name(body.name)  # 식별 이름 규칙(스펙 148) — 서버가 진실원
   245	    cfg = body.config.model_dump()
   246	    _enforce_tool_policy_gate(cfg, principal)
   247	    _enforce_ephemeral_boundary(
   248	        cfg
   249	    )  # DB 쓰기 능력 금지(스펙 237)  # 완화는 admin만(스펙 177 P2 D4)
   250	    _strip_pipeline_model_params(cfg)  # 노드형 modelParams 강제 비움(스펙 420 — validator와 이중 방어)
   251	    # 노드 참조 존재 검증(스펙 316, codex P1) — impl 무관(비노드형 저장도 실행 시 422 시한폭탄 금지).
   252	    # 참조 이름 advisory lock으로 삭제 가드와 직렬화(TOCTOU — 검증 후 커밋 전 삭제 봉인).
   253	    await assert_node_refs_exist(session, cfg.get("nodes"))
   254	    # 기억 이름 존재 검증(스펙 387) — 노드 참조와 같은 규칙(dangling name의 조용한 무동작 차단).
   255	    await assert_memory_names_exist(session, cfg)
   256	    await derive_pipeline_pool(
   257	        cfg
   258	    )  # 노드형 풀=노드 합집합 서버 파생(스펙 289 P2 — 폼 밖 입구도 안전)
   259	    agent = Agent(
   260	        agent_id=_new_agent_id(),
   261	        name=body.name,
   262	        description=(body.description or "").strip() or None,  # 설명(자유 표기, 스펙 210)
   263	        source="ui",
   264	        model=body.config.model,
   265	        prompt=await resolve_prompt(session, body.config.prompt),
   266	        history_depth=body.config.historyDepth,
   267	        config=cfg,
   268	        exposed={"a2a": False},
   269	        status="idle",
   270	        active_version=None,
   271	        owner_id=owner_of(principal),  # 생성 시 1회 스탬프(스펙 112, 069)
   272	    )
   273	    agent.versions.append(
   274	        AgentVersion(
   275	            version="v1",
   276	            ever_opened=False,
   277	            pins=await freeze_pins(session, cfg),  # 블록 버전 못박기(스펙 370)
   278	            note="초기 버전",
   279	            config=cfg,
   280	        )
   281	    )
   282	    session.add(agent)
   283	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   284	    return await _reload_out(session, agent.id)
   285	
   286	
   287	# ----------------------------- 복제 (저마찰 재사용, 스펙 120) -----------------------------
   288	@router.post("/{agent_id}/clone", response_model=AgentOut, status_code=201)
   289	async def clone_agent(
   290	    agent_id: uuid.UUID,
   291	    session: AsyncSession = Depends(get_session),
   292	    principal: User | str = Depends(current_principal),
   293	) -> AgentOut:
   294	    """기존 에이전트 설정을 새 **ui 초안**으로 복사(행위 재사용 — '이거랑 비슷한 거 하나 더'). 복제는
   295	    **읽기+새 생성**이라 원본 *관리 권한 불요*(가시하면 복제 가능 — 사용≠관리, 스펙 112). 소유권은
   296	    **복제자**에게 스탬프(원본 소유자 승계 금지 — 069 no-takeover). 미존재/미가시 원본은 404-fold."""
   297	    src = await _load_agent(session, agent_id)
   298	    if src is None or not may_use_agent(src, principal):
   299	        # codex High#2 — 타인 private를 복제하면 설정(프롬프트·능력)이 내 소유로 유출되고
   300	        # 복제본 채팅으로 사용 게이트가 무력화된다. "가시하면 복제"의 가시=may_use(147 이후).
   301	        raise HTTPException(status_code=404, detail="agent not found")
   302	    cfg = dict(src.config or {})
   303	    cfg.pop(
   304	        "card", None
   305	    )  # 외부 등록 스냅샷은 복사 안 함(ui 복제=행위 설정만; endpoint/token은 Agent 컬럼이라 애초 미복사)
   306	    _enforce_tool_policy_gate(cfg, principal)
   307	    _enforce_ephemeral_boundary(
   308	        cfg
   309	    )  # DB 쓰기 능력 금지(스펙 237)  # 완화 정책 복제도 admin만(스펙 177 P2 D4)
   310	    _strip_pipeline_model_params(cfg)  # 노드형 modelParams 비움(스펙 420 — raw 복제로 불법 상태 재생산 차단)
   311	    clone = Agent(
   312	        agent_id=_new_agent_id(),
   313	        # 식별 이름은 규칙 준수+유니크로 자동 생성(스펙 217: 영소문자·숫자·대시만 — 접미는 영문 '-copy'),
   314	        # 사람용 표기는 설명에(스펙 148, 210). base 캡=접미 여유.
   315	        name=await _dedupe_agent_name(session, f"{src.name[:180]}-copy"),
   316	        description=f"{src.description or src.name} (복사본)"[:200],
   317	        source="ui",
   318	        model=cfg.get("model") or src.model,
   319	        prompt=await resolve_prompt(session, cfg.get("prompt") or ""),
   320	        history_depth=cfg.get("historyDepth") or src.history_depth,
   321	        config=cfg,
   322	        exposed={"a2a": False},
   323	        status="idle",
   324	        active_version=None,
   325	        owner_id=owner_of(principal),  # 복제자가 소유(스펙 112·069 — 원본 소유자 승계 안 함)
   326	    )
   327	    clone.versions.append(
   328	        AgentVersion(
   329	            version="v1",
   330	            ever_opened=False,
   331	            pins=await freeze_pins(session, cfg),
   332	            note=f"복제: {src.name}",
   333	            config=cfg,
   334	        )
   335	    )
   336	    session.add(clone)
   337	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   338	    return await _reload_out(session, clone.id)
