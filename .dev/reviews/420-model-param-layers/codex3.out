    78	class AgentOpsOut(BaseModel):
    79	    """버전 운영 집계(스펙 244, AgentOps D) — "Version 하나가 운영 단위"의 데이터 면."""
    80	
    81	    versions: dict[str, VersionOps]
    82	    unversionedUp: int = 0  # 버전 미기록(242 이전) 피드백 — 정직한 분리
    83	    unversionedDown: int = 0
    84	
