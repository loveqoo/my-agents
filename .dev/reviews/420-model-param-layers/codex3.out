    47	    rows = result.scalars().all()
    48	    # 가시성(스펙 147): private(owner 있음)는 소유자·특권만 목록에서 본다(external은 항상).
    49	    # 플레이그라운드도 이 목록을 쓰므로 자동 적용. admin/machine은 전부(관리 시야).
    50	    from ..ownership import may_use_agent
    51	
    52	    rows = [a for a in rows if may_use_agent(a, principal)]
    53	    outs = [agent_to_out(a) for a in rows]
    54	    for out in outs:  # 스펙 114 — 관리 가능 여부를 각 객체에 실어 UI가 버튼 표시를 파생
    55	        out.can_manage = may_manage(out.owner_id, principal)
    56	        # 노드 참조 해석 결과(스펙 316, 파생) — UI가 listAgents 단일 소스라 목록에도 채운다
    57	        # (오버라이드 패널·폼 미리보기가 유효 설정을 봄). 실패는 None(화면 비잠금 — 실행 시 422).
    58	        if isinstance(out.nodes, list):
