   145	async def _resync_display_only(
   146	    session: AsyncSession, agent: Agent, *, offline: bool = False
   147	) -> AgentOut:
   148	    """카드 재해석 없이 표시(last_sync·선택적 offline)만 갱신하고 직렬화 응답을 반환."""
   149	    if offline:
   150	        agent.status = "offline"
   151	    agent.last_sync = "방금"
   152	    await session.commit()
   153	    return await _reload_out(session, agent.id)
   154	
   155	
   156	def _transition_active_commit(agent: Agent, new_commit: str, cfg: dict) -> None:
   157	    """commit 변경 시 버전 행 전이(057 F4) — 스펙 370: active는 포인터(active_version)가 진실원.
   158	    code 버전 행은 배포 이력이므로 전부 ever_opened=True(오픈 이력 보호와 동형)."""
   159	    agent.commit = new_commit
   160	    existing = _find_version(agent, new_commit)
   161	    if existing is None:  # A→B→A 재왕복: 기존 행 재사용(중복 행 금지)
   162	        agent.versions.append(
   163	            AgentVersion(
   164	                version=new_commit,
   165	                ever_opened=True,
   166	                note="resync 재보고(스펙 285)",
   167	                config=dict(cfg),
   168	            )
   169	        )
   170	    agent.active_version = new_commit
   171	
   172	
   173	def _resync_deploy_meta(agent: Agent, card: dict, cfg: dict) -> None:
   174	    """배포 메타 재보고(스펙 285) — 상태는 실측인데 버전(commit)은 등록 시점 신고라 낡던 비대칭 해소.
   175	
   176	    code(확장 보유)만: repo·runtime은 값 있을 때만 갱신(카드에서 사라지면 기존 보존 — merge-preserve),
   177	    commit 변경 시 버전 행을 057 F4 불변식대로 전이."""
   178	    ext = agent_card.extract_my_agents(card)
   179	    if agent.source != "code" or ext is None:
   180	        return
   181	    deploy = ext.get("deploy") or {}
   182	    new_repo = _clip(deploy.get("repo"), 200)
   183	    new_runtime = _clip(deploy.get("runtime"), 200)
   184	    if new_repo:
   185	        agent.repo = new_repo
   186	    if new_runtime:
   187	        agent.runtime = new_runtime
   188	    new_commit = _clip(deploy.get("commit"), 80)  # 길이 하드닝(057 F3 동일)
   189	    if new_commit and new_commit != agent.commit:
   190	        _transition_active_commit(agent, new_commit, cfg)
   191	
   192	
   193	# ----------------------------- 코드 에이전트 재동기화 -----------------------------
   194	@router.post("/{agent_id}/resync", response_model=AgentOut)
   195	async def resync_agent(
   196	    agent_id: uuid.UUID,
   197	    session: AsyncSession = Depends(get_session),
   198	    principal: User | str = Depends(current_principal),
   199	) -> AgentOut:
   200	    """stale endpoint 자가치유(스펙 081 P1).
   201	
   202	    저장해둔 카드 출처(config["cardUrl"])에서 카드를 재fetch → `fetch_card`가 071의 prefix-상대
   203	    endpoint resolution을 재실행 → endpoint·카드 스냅샷·status(probe liveness)를 in-place 갱신한다.
   204	    071 보정은 fetch_card 시점에만 걸리므로, 071 이전 등록분·원격 변경분의 stale endpoint는 이 경로로만
   205	    재연결 없이 고쳐진다. 기존 행 갱신이라 id/소유/버전은 보존(connect의 새 Agent 생성과 다름).
   206	
   207	    cardUrl이 없는 레거시 행은 재해석 출처가 없어 last_sync만 갱신(재연결 1회 필요).
   208	    SSRF 경계: fetch_card·probe_endpoint가 각각 저장된 cardUrl(connect 때 guard 통과한 사용자 입력)에서만
   209	    guard_url 선행 — request Host 등 외부 파생 입력을 쓰지 않으므로 host-poisoning 무관(learning 064).
   210	    """
   211	    agent = await _load_agent(session, agent_id)
   212	    if agent is None:
   213	        raise HTTPException(status_code=404, detail="agent not found")
   214	    assert_may_manage(
   215	        agent, principal, not_found_detail="agent not found"
   216	    )  # 소유자/특권만(스펙 112)
   217	
   218	    cfg = dict(agent.config or {})
   219	    card_url = cfg.get("cardUrl")
   220	    if not isinstance(card_url, str) or not card_url:
   221	        # 레거시(cardUrl 미저장): 재해석 출처 없음 → 기존 동작 유지(표시만 갱신). 한 번 재연결하면
   222	        # 이후 connect가 cardUrl을 채워 자가치유 경로로 들어온다.
   223	        return await _resync_display_only(session, agent)
   224	
   225	    try:
   226	        card = await agent_card.fetch_card(card_url)
   227	    except ValueError:
   228	        # 카드 출처 도달 실패 — 등록은 유지하되 status는 정직하게 offline(045 #2). endpoint는 보존
   229	        # (다음 resync에서 재시도). 표시 갱신만.
   230	        return await _resync_display_only(session, agent, offline=True)
   231	
   232	    live = await agent_card.probe_endpoint(card.get("url"))
   233	    cfg["card"] = card  # 카드 스냅샷 갱신(표시·검증 단일 소스)
   234	    agent.config = cfg  # JSONB는 in-place 변이 미추적 — 재할당으로 더티 표기
   235	    agent.endpoint = _norm_endpoint(card.get("url"))
   236	    agent.status = "online" if live else "offline"
   237	    agent.last_sync = "방금"
   238	    _resync_deploy_meta(agent, card, cfg)
   239	    await session.commit()
   240	    return await _reload_out(session, agent.id)
     1	"""A2A 카드 → Agent 빌더 (connect/external 공유).
     2	
     3	코드 에이전트 토큰은 암호화 저장(출력은 serializer가 마스킹). 원격 인증 시 복호화 사용.
     4	"""
     5	
     6	from .. import crypto, net_guard
     7	from ..models import Agent, AgentVersion
     8	from .helpers import _new_agent_id, _today
     9	
    10	
    11	def _clip(value: object, maxlen: int) -> str | None:
    12	    """카드/매니페스트 문자열을 DB 컬럼 상한에 맞춰 안전화(적대리뷰 057 Finding 3).
    13	
    14	    제3자가 거대/잡 문자열을 흘려도 Postgres bounded 컬럼(String(N))에서 commit이 500나지 않게,
    15	    문자열이 아니면 None, 너무 길면 잘라 반환한다(표시·provenance 메타라 절단 허용)."""
    16	    if not isinstance(value, str):
    17	        return None
    18	    value = value.strip()
    19	    if not value:
    20	        return None
    21	    return value[:maxlen]
    22	
    23	
    24	def _norm_endpoint(raw: object) -> str | None:
    25	    """카드 서비스 url을 절대 http(s)로 정규화해 저장(스펙 063, 빌더 하드닝).
    26	
    27	    `fetch_card`가 이미 정규화하므로 정상 경로는 idempotent. fetch_card를 우회하는 미래 경로가
    28	    스킴 없는 url을 흘려도 저장 데이터가 청결하게 유지된다(표시·probe도 같은 endpoint를 읽는다).
    29	    정규화 불가(빈 값·비-http 스킴)면 clip한 raw를 그대로 보존 — 등록을 500내지 않고, 호출 경계
    30	    (a2a_client, 스펙 063 D1)가 2차로 다시 시도한다."""
    31	    clipped = _clip(raw, 400)
    32	    if not clipped:
    33	        return None
    34	    try:
    35	        return net_guard.normalize_http_url(clipped)
    36	    except ValueError:
    37	        return clipped
    38	
    39	
    40	def _build_external_agent(
    41	    card: dict, token: str | None, live: bool, card_url: str | None = None
    42	) -> Agent:
    43	    """제3자 A2A 카드 → external Agent. 불투명 카드 스냅샷, 로컬 모델/메모리/MCP 미해석(비로컬).
    44	
    45	    카드 스냅샷은 config["card"], 서비스 URL은 endpoint, 호출 크레덴셜은 crypto.encrypt로 token에
    46	    저장(2차 런타임 호출에서 복호 사용).
    47	
    48	    card_url = 카드를 가져온 출처(.well-known 위치). resync 자가치유(스펙 081)가 이 URL로 카드를
    49	    재fetch해 endpoint·status를 갱신한다 — 저장 안 하면 stale endpoint를 재연결 없이 못 고친다."""
    50	    cfg = {
    51	        "model": "",  # 외부는 로컬 모델 미해석
    52	        "prompt": "",
    53	        "memories": [],
    54	        "vectorTables": [],
    55	        "mcps": [],
    56	        "historyDepth": 10,
    57	        "card": card,  # 등록 시점 카드 스냅샷(표시·검증 단일 소스)
    58	        "cardUrl": card_url,  # 카드 출처 — resync 재해석용(스펙 081)
    59	    }
    60	    return Agent(
    61	        agent_id=_new_agent_id(),
    62	        name=_clip(card.get("name"), 200) or "외부 에이전트",
    63	        source="external",
    64	        model="",
    65	        prompt="",
    66	        history_depth=10,
    67	        config=cfg,
    68	        exposed={"a2a": False},  # 우리가 소비측(클라이언트) — 서버측 노출과 무관
    69	        status="online" if live else "offline",
    70	        endpoint=_norm_endpoint(card.get("url")),
    71	        token=crypto.encrypt(token) if token else None,
    72	        registered_at=_today(),
    73	        last_sync="방금",
    74	    )
    75	
    76	
    77	def _cfg_from_manifest(card: dict, ext: dict, card_url: str | None) -> dict:
    78	    """ext["manifest"] → 저장 config dict(카드 스냅샷·cardUrl 포함, 잡 타입은 기본값으로 안전화)."""
    79	    manifest = ext["manifest"]
    80	    history_depth = manifest.get("historyDepth")
    81	    if not isinstance(history_depth, int):
    82	        history_depth = 10
    83	    return {
    84	        "model": manifest.get("model") or "",
    85	        "prompt": manifest.get("prompt") or "",
    86	        "memories": manifest.get("memories") if isinstance(manifest.get("memories"), list) else [],
    87	        "vectorTables": [],
    88	        "mcps": manifest.get("mcps") if isinstance(manifest.get("mcps"), list) else [],
    89	        "historyDepth": history_depth,
    90	        "card": card,  # 카드 스냅샷 — external과 동일하게 표시·검증 단일 소스
    91	        "cardUrl": card_url,  # 카드 출처 — resync 재해석용(스펙 081)
    92	    }
    93	
    94	
    95	def _rows_from_card_versions(
    96	    raw_versions: object, cfg: dict
    97	) -> tuple[list[AgentVersion], str | None]:
    98	    """카드 신고 versions → (AgentVersion 행 목록, 첫 active 버전 id). 잡값(비-dict·버전 없음)은 건너뜀."""
    99	    versions: list[AgentVersion] = []
   100	    active_version_id: str | None = None
   101	    if isinstance(raw_versions, list):
   102	        for raw_version in raw_versions:
   103	            if not isinstance(raw_version, dict):
   104	                continue
   105	            vid = _clip(raw_version.get("version"), 40)
   106	            if vid is None:
   107	                continue
   108	            vstatus = _clip(raw_version.get("status"), 20) or "archived"
   109	            if vstatus == "active" and active_version_id is None:
   110	                active_version_id = vid  # 카드 status는 포인터 해석에만 소비(스펙 370)
   111	            versions.append(
   112	                AgentVersion(
   113	                    version=vid,
   114	                    ever_opened=True,  # 원격 배포 이력 — 전부 불변 보호(스펙 370)
   115	                    note=raw_version.get("note")
   116	                    if isinstance(raw_version.get("note"), str)
   117	                    else "",
   118	                    config=cfg,
   119	                )
   120	            )
   121	    return versions, active_version_id
   122	
   123	
   124	def _versions_from_deploy(deploy: dict, cfg: dict) -> tuple[list[AgentVersion], str | None]:
   125	    """deploy.versions → (AgentVersion 목록, active 버전 id).
   126	
   127	    active_version 불변식(적대리뷰 057 Finding 4): active_version은 항상 실재하는 active
   128	    AgentVersion을 가리키거나 None. deploy.versions 잡값(빈 리스트·archived만·잡 버전)이 와도 active
   129	    row 없이 active_version만 세팅되는 불일치를 만들지 않는다."""
   130	    versions, active_version_id = _rows_from_card_versions(deploy.get("versions"), cfg)
   131	    commit = _clip(deploy.get("commit"), 80)
   132	    if active_version_id is None and commit:
   133	        # 카드에 active 버전이 없으면 commit으로 active 1개 합성(external register와 일관). 합성한 뒤에만
   134	        # active_version을 세팅 — 실재하는 row를 보장한다.
   135	        synth = _clip(commit, 40)
   136	        versions.append(
   137	            AgentVersion(version=synth, ever_opened=True, note="Deploy · 카드 동기화", config=cfg)
   138	        )
   139	        active_version_id = synth
   140	    return versions, active_version_id
   141	
   142	
   143	def _build_code_agent_from_card(
   144	    card: dict, ext: dict, token: str | None, live: bool, card_url: str | None = None
   145	) -> Agent:
   146	    """제1자(SDK 배포) A2A 카드 + my-agents 확장 → code Agent (스펙 057).
   147	
   148	    config는 ext["manifest"](model/prompt/mcps/…)에서 채우고 카드 스냅샷을 함께 보존한다.
   149	    repo/commit/runtime·AgentVersion은 ext["deploy"]에서 만든다. **전부 카드에서 fetch — 프론트
   150	    날조 없음**. A2A 호출엔 카드 url+token만 쓰지만(현 external과 동일), 저장 config는 1급 표시·resync용.
   151	    """
   152	    deploy = ext["deploy"]
   153	    cfg = _cfg_from_manifest(card, ext, card_url)
   154	    # 길이 하드닝(적대리뷰 057 Finding 3) — bounded 컬럼에 잡/거대 문자열이 들어가 commit이 500나지 않게.
   155	    commit = _clip(deploy.get("commit"), 80)
   156	    agent = Agent(
   157	        agent_id=_new_agent_id(),
   158	        name=_clip(card.get("name"), 200) or _clip(deploy.get("repo"), 200) or "SDK 에이전트",
   159	        source="code",
   160	        model=_clip(cfg["model"], 120) or "",
   161	        prompt=cfg["prompt"],  # Text 컬럼 — 무제한
   162	        history_depth=cfg["historyDepth"],
   163	        config=cfg,
   164	        exposed={"a2a": False},
   165	        status="online" if live else "offline",
   166	        endpoint=_norm_endpoint(card.get("url")),
   167	        token=crypto.encrypt(token) if token else None,
   168	        runtime=_clip(deploy.get("runtime"), 200),
   169	        repo=_clip(deploy.get("repo"), 200),
   170	        commit=commit,
   171	        registered_at=_today(),
   172	        last_sync="방금",
   173	    )
   174	    versions, active_version_id = _versions_from_deploy(deploy, cfg)
   175	    agent.versions.extend(versions)
   176	    agent.active_version = active_version_id
   177	    return agent
   315	    for (
   316	        aid,
   317	        name,
   318	        description,
   319	        source,
   320	        model,
   321	        prompt,
   322	        mems,
   323	        hist,
   324	        vts,
   325	        mcps,
   326	        a2a,
   327	        status,
   328	        active,
   329	        versions,
   330	    ) in AGENTS:
   331	        cfg = {
   332	            "model": model,
   333	            "prompt": prompt,
   334	            "memories": list(mems),
   335	            "vectorTables": list(vts),
   336	            "mcps": list(mcps),
   337	            "historyDepth": hist,
   338	        }
   339	        agent = Agent(
   340	            agent_id=aid,
   341	            name=name,
   342	            description=description,
   343	            source=source,
   344	            model=model,
   345	            prompt=prompt_body.get(prompt, prompt),
   346	            history_depth=hist,
   347	            config=cfg,
   348	            exposed={"a2a": a2a},
   349	            status=status,
   350	            active_version=active,
   351	        )
   352	        for ver, _vstatus, _created, note in versions:
   353	            # 시드 이력은 전부 오픈됐던 버전(스펙 370 — active/archived 구분은 포인터가 대체).
   354	            agent.versions.append(
   355	                AgentVersion(version=ver, ever_opened=True, note=note, config=dict(cfg))
   356	            )
   357	        session.add(agent)
