    14	def _collect_relaxing_caps(tool_policy: dict) -> list[str]:
    15	    """완화 의도(required=False 또는 approver=self) 오버라이드가 걸린 cap 목록을 반환."""
    16	    relaxing: list[str] = []
    17	    for cap, entry in tool_policy.items():
    18	        appr = entry.get("approval") if isinstance(entry, dict) else None
    19	        if not isinstance(appr, dict):
    20	            continue
    21	        # 검증기가 required→bool, approver→{admin,self} 정규화. required=false 또는 approver=self = 완화 의도.
    22	        if appr.get("required") is False or appr.get("approver") == "self":
    23	            relaxing.append(cap)
    24	    return relaxing
