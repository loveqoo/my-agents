    74	async def _build_eval_graph(
    75	    ctx: ChatContext,
    76	    impl: CustomAgent,
    77	    prompt_prompt: str,
    78	    mem_hits: list,
    79	    calls_sink: list[dict],
    80	    principal: User | str,
    81	    delegation_chain: tuple,
    82	    delegation_budget: dict | None,
    83	) -> tuple[Any, PolicyScopedBroker]:
    84	    """평가용 그래프를 도구·브로커 주입으로 빌드 → (graph, broker)."""
    85	    tools = await runtime.build_mcp_tools(
    86	        ctx.mcp_servers, calls_sink, ctx.tool_policy, ctx.tool_names
    87	    )
    88	    if ctx.rag_collections:
    89	        tools.append(runtime.build_rag_tool(ctx.rag_collections, calls_sink))
    90	    # 브로커 주입(조율형 위임 채점) — 실행 주체(principal)의 RBAC로 스코프(chat 경로와 동일 술어).
    91	    # 스펙 256 v2(깊이 N): 호출 체인에 자기 자신을 덧붙여 하위 브로커에 관통 — 체인 내 재방문만
    92	    # 차단(순환 0), 새 에이전트로는 계속 하강 가능.
    93	    chain = tuple(delegation_chain) + ((ctx.ext_agent_id,) if ctx.ext_agent_id else ())
    94	    broker = build_broker(
    95	        principal,
    96	        ctx.capabilities,
    97	        ctx.tool_policy,
    98	        delegation_chain=chain,
    99	        delegation_budget=delegation_budget,
   100	    )
   101	    # 노드 에이전트-호출 도구(스펙 318) — 평가도 실제 파이프라인(위임 포함)을 태운다(317 입구 정합).
   102	    # pipeline만·broker가 이미 스코프(권한 상승 0).
   103	    if ctx.impl == "pipeline":
   104	        tools.extend(runtime.build_agent_tools(broker, await broker.agent_capabilities()))
   105	    run_params = {} if ctx.temperature is None else {"temperature": ctx.temperature}
   106	    build_ctx = AgentBuildContext(
   107	        prompt=prompt_prompt,
   108	        model_cfg=ctx.model_cfg,
   109	        tools=tools,
   110	        checkpointer=None,  # HIL cap은 fail-closed(interrupt→예외→error 관측)
   111	        params=run_params,
   112	        memories=mem_hits,
   113	        broker=broker,
   114	        # impl_config — 노코드 impl 설정 통로(codex 317 P1: eval 입구 누락 봉합). 이게 없으면 노드형/
   115	        # 산출물형 평가가 **기본 단일 노드로 조용히 퇴화**해 실제 서빙과 다른 것을 채점했고, 미등록
   116	        # 코드 노드도 설정 오류 대신 폴백 실행됐다. 채팅·A2A 서빙·승인 재개와 동일 주입(네 번째 입구).
   117	        impl_config=(
   118	            {"nodes": ctx.nodes_resolved} if ctx.nodes_resolved is not None else ctx.artifact_spec
   119	        ),
   120	    )
   121	    return impl.build_graph(build_ctx), broker
   122	
   123	
   124	async def _stream_observed(
   125	    graph: Any, messages: list[dict], cfg: dict
   126	) -> tuple[str, list[str], bool, str | None]:
   127	    """그래프 스트림 실행 + 관측 수집 → (output, observed_nodes, error, detail)."""
   128	    acc: list[str] = []
   129	    observed_nodes: list[str] = []
   130	    error = False
   131	    detail = None
   132	    try:
   133	        async for stream_mode, chunk in graph.astream(
   134	            {"messages": messages}, config=cfg, stream_mode=["messages", "updates"]
   135	        ):
   136	            if stream_mode == "messages":
   137	                msg_chunk, _meta = chunk
   138	                if runtime.is_tool_message(msg_chunk):
   139	                    continue
   140	                text = runtime._content_text(getattr(msg_chunk, "content", ""))
   141	                if text:
   142	                    acc.append(text)
   143	            elif stream_mode == "updates" and isinstance(chunk, dict):
   144	                if "__interrupt__" in chunk:
   145	                    # 승인 게이트 cap — 평가에선 진행 불가(fail-closed 관측).
   146	                    error = True
   147	                    detail = "승인 게이트 도구가 호출됨 — 평가 실행은 승인 없이 중단(fail-closed)"
   148	                observed_nodes.extend(n for n in chunk if not n.startswith("__"))
   149	    except Exception as exc:
   150	        error = True
   151	        detail = str(exc)[:500]
   152	    return "".join(acc), observed_nodes, error, detail
   153	
   154	
   155	async def eval_run_agent(
   156	    agent_pk: uuid.UUID,
   157	    user_text: str,
   158	    principal: User | str,
   159	    overrides: dict | None = None,
   160	    version: str | None = None,
   161	    delegation_chain: tuple = (),
   162	    delegation_budget: dict | None = None,
   163	) -> dict:
   164	    """케이스 1건 실행 → obs {"output", "trace_nodes", "error", "detail"?}.
   165	
   166	    overrides(스펙 141): 모델 비교 실행용 — 기존 화이트리스트 경로(_load_context)를 그대로 태워
   167	    {"model": 레지스트리 이름}만 주입한다(admin 내부 호출이라 own=None 특권 경로).
   168	    실패(설정 오류·모델 예외·HIL interrupt)는 예외를 던지지 않고 error=True obs로 접는다 —
   169	    run_eval이 no_error assert로 채점하고 전체 평가는 계속(하네스 계약)."""
   170	    try:
   171	        ctx = await _load_context(
   172	            agent_pk, None, overrides, version=version
   173	        )  # 버전 지정 평가(스펙 242)
   174	    except Exception as exc:
   175	        return {
   176	            "output": "",
   177	            "trace_nodes": [],
   178	            "error": True,
   179	            "detail": f"컨텍스트 로드 실패: {exc}",
   180	        }
   181	    try:
   182	        impl = resolve_agent_runtime(ctx)
   183	    except AgentConfigError as exc:
   184	        return {"output": "", "trace_nodes": [], "error": True, "detail": f"런타임 미해결: {exc}"}
   185	    if impl is None or ctx.model_cfg is None:
   186	        return {
   187	            "output": "",
   188	            "trace_nodes": [],
   189	            "error": True,
   190	            "detail": "로컬(ui) 에이전트가 아니거나 채팅 모델이 없습니다(평가는 로컬 에이전트만)",
   191	        }
   192	
   193	    used_memory, mem_hits, prompt_prompt = await _recall_memory(ctx, user_text)
   194	
   195	    calls_sink: list[dict] = []
   196	    try:
   197	        graph, broker = await _build_eval_graph(
   198	            ctx,
   199	            impl,
   200	            prompt_prompt,
   201	            mem_hits,
   202	            calls_sink,
   203	            principal,
   204	            delegation_chain,
   205	            delegation_budget,
   206	        )
   207	    except AgentConfigError as exc:
   208	        # 그래프 조립 시점 설정 실패(스펙 317 — 코드 노드 impl 미등록 등)도 error obs로 접는다
   209	        # (하네스 계약 — 케이스 error 채점, 전체 평가는 계속. 조용한 폴백 채점 금지).
   210	        return {
   211	            "output": "",
   212	            "trace_nodes": [],
   213	            "error": True,
   214	            "detail": f"그래프 조립 실패: {exc}",
   215	        }
   216	    messages = _window([{"role": "user", "content": user_text}], ctx.history_depth)
   217	    cfg = observability.with_trace(None, name=f"eval:{ctx.ext_agent_id}")
   218	
   219	    output, observed_nodes, error, detail = await _stream_observed(graph, messages, cfg)
   220	

