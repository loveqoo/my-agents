   180	    async def _memory_add(self, reply: str) -> None:
     1	"""평가 실행 러너 — 오염 제로 에이전트 턴 + 관측 union (스펙 137 단계 ②).
     2	
     3	`chat()` 재사용은 불가(persistHistory=False여도 세션 lazy-create·turns 갱신·자동 memory.add가
     4	발생 — 137 조사 확정). 이 러너는 `prepare_serve_turn`(A2A 서빙용 순수 컴퓨트) 골격에
     5	`event_stream`의 **관측 수집부**(updates 노드·calls_sink·broker invocations)를 이식하고
     6	**build_broker를 주입**(조율형 위임 채점 지원 — 서빙 경로엔 없어 위임이 안 돌았음)한다.
     7	`_persist`·`memory.add`는 절대 호출하지 않는다(오염 제로). 메모리 **회상(search)은 수행** —
     8	읽기 전용이라 무오염이며, 직접형의 memory 사용 채점(`memory:used` 토큰)의 근거가 된다.
     9	checkpointer=None — HIL 게이트 cap은 interrupt가 예외로 떨어져 error 관측(평가 중 승인 대기 없음).
    10	
    11	관측 union(조사 확정 — 없으면 직접형 도구 사용을 놓쳐 "조용한 초록", 회고 100 대죄):
    12	  trace_nodes = 그래프 노드(원형) ∪ 브로커 canonical(broker_invoke: 접두 제거형 병기)
    13	              ∪ 직접형 calls_sink(`mcp:{server}/{tool}`, rag는 `rag:{tool}`) ∪ `memory:used`.
    14	→ `trace_has("rag:")` 같은 assert가 직접형/조율형 무관하게 채점된다.
    15	"""
    16	
    17	import asyncio
    18	import logging
    19	import uuid
    20	from typing import Any
    21	
    22	from agent.runtime import AgentBuildContext, AgentConfigError, CustomAgent
    23	
    24	from . import memory, observability, runtime
    25	from .broker import build_broker
    26	from .broker.core import PolicyScopedBroker
    27	from .chat import ChatContext, _load_context, _window, resolve_agent_runtime
    28	from .models import User
    29	
    30	log = logging.getLogger("api.eval")
    31	
    32	_OUTPUT_CAP = 4000  # obs 영속 시 출력 캡(성적표 표시용 — 전문 아님)
    33	
    34	
    35	def _canonical_tokens(
    36	    observed_nodes: list[str],
    37	    calls_sink: list[dict],
    38	    broker_invocations: list[dict],
    39	    used_memory: bool,
    40	) -> list[str]:
    41	    """관측 3형태를 canonical 토큰으로 union — 채점 어휘를 에이전트 형태와 무관하게 통일."""
    42	    tokens: list[str] = list(observed_nodes)
    43	    for inv in broker_invocations:
    44	        node = str(inv.get("node", ""))
    45	        tokens.append(node)
    46	        if node.startswith("broker_invoke:"):
    47	            tokens.append(node[len("broker_invoke:") :])  # canonical: rag:X / mcp:s/t / memory:user
    48	    for call in calls_sink:
    49	        server = str(call.get("server", ""))
    50	        tool = str(call.get("tool", ""))
    51	        tokens.append(f"rag:{tool}" if server == "rag" else f"mcp:{server}/{tool}")
    52	    if used_memory:
    53	        tokens.append("memory:used")
    54	    return tokens
    55	
    56	
    57	async def _recall_memory(ctx: ChatContext, user_text: str) -> tuple[bool, list, str]:
    58	    """메모리 회상(읽기 전용 — 무오염) → (used_memory, mem_hits, prompt_prompt). add는 절대 안 함."""
    59	    used_memory = memory.memory_enabled(ctx.memories) and ctx.mem_cfg is not None
    60	    recall_scope = {"user_id": None, "run_id": None, "agent_id": ctx.ext_agent_id}
    61	    mem_hits = (
    62	        await asyncio.to_thread(memory.search, recall_scope, user_text, ctx.mem_cfg)
    63	        if used_memory
    64	        else []
    65	    )
    66	    prompt_prompt = ctx.prompt
    67	    if mem_hits:
    68	        prompt_prompt = (
    69	            f"{prompt_prompt}\n\n# 관련 기억(회상됨)\n{memory.format_memory_hits(mem_hits)}"
    70	        )
    71	    return used_memory, mem_hits, prompt_prompt
