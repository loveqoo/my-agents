   124	def _filter_capabilities(cfg: dict) -> list:
   125	    """능력 브로커 allowlist(스펙 100) — 오케스트레이션 허용 cap id 목록(없으면 [] = deny-by-default).
     1	"""등록된 에이전트와의 대화 (SSE 스트리밍).
     2	
     3	prompt + (선택)mem0 장기 메모리 + (선택)MCP 합성 툴을 LangGraph로 합성해 실행하고,
     4	세션/메시지/트레이스를 영속화한다. 트레이스는 Playground 인스펙터가 소비.
     5	
     6	지배 스펙: docs/spec/007-real-agent-service.md (Phase 2)
     7	
     8	스펙 291(Phase 3b) → 396: 관심사별 형제 모듈(chat_context/history/persist/trace/approval +
     9	392: sse_errors/a2a_proxy/a2a_serve/graph_build + 396: turn_runtime/sse_frames/final)로 분할 —
    10	이 모듈은 **파사드**(전 심볼 재수출) + 라우터 + `chat()` 진입 오케스트레이터만 갖는다.
    11	외부의 `from api.chat import X` / `from api import chat` 접근은 전부 무변경(재배선 없는 분할 계약).
    12	"""
    13	
    14	import asyncio  # noqa: F401  (파사드 재수출 — 분할 전 공개 표면 보존)
    15	import json
    16	import logging
    17	import secrets  # noqa: F401  (파사드 재수출)
    18	import time
    19	import uuid
    20	from collections.abc import AsyncIterator
