    24	from api.db import SessionLocal  # noqa: E402
    25	from api.model_param_layers import layer_applies  # noqa: E402
    26	from api.models import ModelConfig  # noqa: E402
    27	from api.schemas.agents import AgentConfig  # noqa: E402
    28	
    29	_fails: list[str] = []
    30	passed = 0
    31	
    32	
    33	def check(cond: object, msg: str) -> None:
    34	    global passed
    35	    print(("  ok  " if cond else " FAIL ") + msg)
    36	    if cond:
    37	        passed += 1
    38	    else:
    39	        _fails.append(msg)
    40	
    41	
    42	def _p_policy() -> None:
    43	    print("== P 정책 단위(layer_applies) ==")
    44	    check(layer_applies("model-default", "pipeline") and layer_applies("model-default", None),
    45	          "model-default: 항상")
    46	    check(layer_applies("node", "pipeline") and not layer_applies("node", None),
    47	          "node: pipeline만")
    48	    check(not layer_applies("agent", "pipeline") and layer_applies("agent", None),
    49	          "agent: non-pipeline만")
    50	    check(not layer_applies("session", "pipeline") and layer_applies("session", None),
    51	          "session: non-pipeline만")
    52	    try:
    53	        layer_applies("bogus", None)
    54	        check(False, "알 수 없는 층 → ValueError")
    55	    except ValueError:
    56	        check(True, "알 수 없는 층 → ValueError(오타 조기 발견)")
    57	
    58	
    59	def _w_write_boundary() -> None:
    60	    print("== W 쓰기 경계(AgentConfig) ==")
    61	    node = AgentConfig(impl="pipeline", modelParams={"temperature": 0.3}, nodes=[{"prompt": "x"}])
    62	    check(node.modelParams == {}, f"노드형 modelParams 저장 차단(비움) (got {node.modelParams})")
    63	    direct = AgentConfig(impl=None, modelParams={"temperature": 0.3})
    64	    check(direct.modelParams.get("temperature") == 0.3, "비노드형 modelParams 보존(무회귀)")
    65	
    66	
    67	async def _r_resolution() -> None:
    68	    print("== R 해석 관문(실 DB) ==")
    69	    async with SessionLocal() as s:
    70	        m = (
    71	            await s.execute(
    72	                select(ModelConfig).where(ModelConfig.kind == "chat").limit(1)
    73	            )
    74	        ).scalar_one_or_none()
    75	    if m is None:
    76	        check(False, "등록 chat 모델 없음 — 시드 확인")
    77	        return
    78	    model_name = m.name
    79	
    80	    # 노드형: agent 층(temperature) + session 층(top_p)이 노드에 안 실려야.
    81	    node_cfg = {"impl": "pipeline", "model": model_name, "modelParams": {"temperature": 0.9}}
    82	    async with SessionLocal() as s:
    83	        default_cfg = await _resolve_model(s, node_cfg, None)
