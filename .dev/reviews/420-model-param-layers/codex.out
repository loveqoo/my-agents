   184	    # agent 층 적용은 정책이 허용할 때만(스펙 420) — 노드형은 layer_applies("agent")=False라 agent
   185	    # modelParams를 안 굽는다. 그래야 노드 폴백용 default_cfg가 깨끗해 agent 층이 노드로 안 샌다.
   186	    _agent_layer = layer_applies("agent", cfg.get("impl"))
   187	
   188	    def _fold(model_cfg: dict) -> dict:
   189	        return _apply_agent_model_params(model_cfg, cfg) if _agent_layer else model_cfg
   190	
   191	    model_name = cfg.get("model")
   192	    if model_name:
   193	        pinned = await _pinned_model_cfg(db, pins, model_name)  # pin 우선(스펙 370)
   194	        if pinned is not None:
   195	            return _fold(pinned)
   196	    m = await _registry_chat_model(db, model_name) if model_name else None
   197	    if m is None:
   198	        # 거절은 **실명을 댄** 오버라이드에만(스펙 401) — 모델 미지정 에이전트(model_name=None)에
   199	        # model 키 없는(또는 null) 오버라이드가 오면 None==None으로 오폭하던 것을 실명 요구로 봉합.
