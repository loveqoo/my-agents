    42	def _rag_tools_for(ctx: ChatContext, calls_sink: list[dict]) -> list:
    43	    """RAG 검색 도구 목록. 기본=전체 컬렉션 단일 도구(search_documents, 무회귀). 노드형(스펙 268 P1)은
    44	    **컬렉션별 도구**(`search_documents__<컬렉션>`, _safe_name — 265 이름 체계)를 추가로 빌드해 노드가
    45	    컬렉션을 골라 참조한다("검색 노드는 A만, 검증 노드는 B만"). 참조 안 된 도구는 노드 필터에서 그냥
    46	    안 쓰임(무해). 구저장 민이름(search_documents)은 전체-컬렉션 도구로 계속 해석."""
    47	    tools: list = []
    48	    if not ctx.rag_collections:
    49	        return tools
    50	    ms = ctx.rag_min_scores
    51	    tools.append(runtime.build_rag_tool(ctx.rag_collections, calls_sink, ms))
    52	    if ctx.nodes_resolved is not None:
    53	        for col in ctx.rag_collections:
    54	            tools.append(
    55	                runtime.build_rag_tool(
    56	                    [col],
    57	                    calls_sink,
    58	                    ms,
    59	                    name=runtime._safe_name("search_documents", col["name"]),
    60	                )
    61	            )
    62	    return tools
