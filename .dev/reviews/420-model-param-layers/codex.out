    85	            {"prompt": "with-model", "model": model_name},  # 자기 모델 노드(경로 A)
    86	            {"prompt": "no-model"},  # 모델 없는 노드 → default_cfg 폴백(경로 B)
    87	        ]
    88	        resolved = await _resolve_node_models(
