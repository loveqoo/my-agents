    92	        params = (r.get("model_cfg") or {}).get("params") or {}
    93	        tag = r.get("prompt")
    94	        check(params.get("temperature") != 0.9, f"[{tag}] 노드형: agent 층(temperature) 미적용 (got {params.get('temperature')})")
    95	        check(params.get("top_p") != 0.5, f"[{tag}] 노드형: session 층(top_p) 미적용 (got {params.get('top_p')})")
    96	
    97	    # 노드형 default_cfg(폴백 원천)도 agent 층 없어야(경로 B 봉인 확인).
    98	    check((default_cfg.get("params") or {}).get("temperature") != 0.9,
    99	          "노드형 default_cfg: agent 층 미적용(폴백 경로 봉인)")
   100	
   101	    # 비노드형: agent 층이 실려야(무회귀).
   102	    direct_cfg = {"impl": None, "model": model_name, "modelParams": {"temperature": 0.9}}
   103	    async with SessionLocal() as s:
