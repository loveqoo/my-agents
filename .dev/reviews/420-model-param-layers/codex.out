   110	async def _resolve_node_models(
   111	    db: AsyncSession,
   112	    nodes: list,
   113	    default_cfg: dict | None,
   114	    pins: dict | None = None,
   115	    agent_cfg: dict | None = None,
   116	    session_mp: dict | None = None,
   117	) -> list[dict]:
   118	    """노드형(스펙 259) 노드별 모델을 레지스트리에서 미리 해석해 `model_cfg`를 심는다(085 U2 — impl은
   119	    DB 미접촉). 에이전트 모델 해석과 **동일 조회**(`ModelConfig.name==name, kind=="chat"`, provider
   120	    상속) — 드리프트 0. 미지정/미존재 이름은 `default_cfg`(에이전트 기본 chat 모델)로 폴백. 같은 모델
   121	    이름은 1회만 조회해 재사용(N 노드 M 중복 모델 → distinct 쿼리). 순수 데이터 반환(잡 노드는 통과 —
   122	    정규화는 impl의 normalize_nodes가)."""
   123	    resolved: list[dict] = []
   124	    cache: dict[str, dict | None] = {}
   125	    for node in nodes:
   126	        if not isinstance(node, dict):
   127	            continue
   128	        name = node.get("model")
   129	        cfg = None
   130	        if isinstance(name, str) and name.strip():
   131	            if name not in cache:
   132	                cache[name] = await _chat_model_cfg(db, name, pins)
   133	            cfg = cache[name]
   134	        # 심은 model_cfg는 해석된 노드 모델(없으면 에이전트 기본으로 폴백 — impl의 _model_from_node).
   135	        # 캐스케이드 층(스펙 420 정책): 노드형은 **노드 층만** 유효 — agent·session 층은 layer_applies가
   136	        # False라 적용 안 함(노드가 모델 파라미터 소유, 스펙 417·419). _resolve_model도 같은 정책이라
   137	        # default_cfg(폴백)에도 agent 층이 안 실린다 → agent 층이 노드로 새는 두 경로 다 봉인.
   138	        _impl = (agent_cfg or {}).get("impl")
   139	        node_cfg = cfg if cfg is not None else default_cfg
   140	        if cfg is not None and agent_cfg and layer_applies("agent", _impl):
   141	            node_cfg = _apply_agent_model_params(cfg, agent_cfg)
   142	        node_mp = node.get("modelParams")  # node 층 — 노드형에서 항상 유효
   143	        if node_cfg is not None and isinstance(node_mp, dict) and node_mp:
   144	            node_cfg = _apply_agent_model_params(node_cfg, {"modelParams": node_mp})
   145	        if (
   146	            node_cfg is not None
   147	            and isinstance(session_mp, dict)
   148	            and session_mp
   149	            and layer_applies("session", _impl)
   150	        ):
   151	            node_cfg = _apply_agent_model_params(node_cfg, {"modelParams": session_mp})
   152	        resolved.append({**node, "model_cfg": node_cfg})
   153	    return resolved
   154	
   155	
   156	# 설정 오버라이드 화이트리스트는 서술자 목록(agent.capabilities)에서 **파생**한다(스펙 409 —
   157	# 하드코딩 두 곳 소멸, 설정 추가=서술자 한 줄). 캐스케이드: 모델 params 기본 → 에이전트
   158	# config.modelParams → 노드 modelParams(노드형) → 세션 오버라이드. 능력(capabilities)은 층에 없다
   159	# (사실은 불가침). temperature는 제외 — AgentConfig.temperature(스펙 077)가 이미 에이전트 층 정본.
   160	MODEL_PARAM_OVERRIDE_KEYS = SETTING_KEYS
   161	
   162	
   163	def _apply_agent_model_params(model_cfg: dict, cfg: dict) -> dict:
   164	    """모델 params 위에 에이전트/노드 modelParams(화이트리스트만)를 덮는다 — 미명시 키는 상속."""
   165	    agent_mp = cfg.get("modelParams") or {}
   166	    if not isinstance(agent_mp, dict) or not agent_mp:
   167	        return model_cfg
   168	    merged = dict(model_cfg.get("params") or {})
   169	    for key in MODEL_PARAM_OVERRIDE_KEYS:
   170	        if key in agent_mp and agent_mp[key] is not None:
   171	            merged[key] = agent_mp[key]
   172	    return {**model_cfg, "params": merged}
