   147	    async def _interrupt_outcome(self, interrupts: list[dict]) -> ServeOutcome:
   148	        """서빙 interrupt → 승인 대기 변환(스펙 388 P2).
   149	
   150	        도구는 interrupt 이전이라 미실행(부수효과 0, 041 §3.3). 비영속은 승인 불가 안내(235)."""
