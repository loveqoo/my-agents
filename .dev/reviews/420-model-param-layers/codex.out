     1	"""세션 오버라이드·노드 병합 — chat_context.py에서 분할(스펙 394 P1).
     2	
     3	_merge_node_overrides(구 CC 12)는 노드별 병합(_merge_one_node) 추출로 분해.
     4	파사드는 chat_context.py(재수출 계약 — verify_317이 직접 임포트).
     5	"""
     6	
     7	from agent.capabilities import clean_setting_params
     8	
     9	from .chat_context_types import _is_remote
    10	from .models import Agent
    11	
    12	# 노드 오버라이드 필드 화이트리스트(스펙 287) — 구조 식별자(name)는 제외해 저장본 유지.
    13	# 노드 추가/삭제는 테스트 범위 밖(사용자 결정): 오버라이드는 "이 에이전트 그대로, 설정만 바꿔
    14	# 테스트"가 목적이라 구조 변경 요청은 받지 않는다(서버 강제 — 클라이언트 신뢰 금지).
    15	_NODE_OVERRIDE_FIELDS = {
    16	    "prompt",
    17	    "model",
    18	    "tools",
    19	    "historyDepth",
    20	    "memories",
    21	    "memoryQuery",
    22	    "context",
    23	    "format",
    24	    "fields",
    25	}
    26	
    27	
    28	def _node_patch_fields(base_n: dict) -> set[str]:
    29	    """이 노드에 병합 가능한 오버라이드 필드(스펙 317) — 설정 노드=화이트리스트 전체, 코드 노드=
    30	    manifest.overridable ∩ 화이트리스트(나머지는 코드가 소유 — 세션 패치로 못 바꾼다). 미등록
    31	    impl은 빈 집합(fail-closed — 어차피 실행이 설정 오류로 거부됨)."""
    32	    impl = base_n.get("impl")
    33	    if not isinstance(impl, str) or not impl.strip():
    34	        return _NODE_OVERRIDE_FIELDS
    35	    from agent.nodes import get_node_impl
    36	
    37	    node_impl = get_node_impl(impl)
    38	    if node_impl is None:
    39	        return set()
    40	    return _NODE_OVERRIDE_FIELDS & set(node_impl.describe().overridable)
    41	
    42	
    43	def _merge_one_node(base_n: object, ov_n: object) -> tuple[dict, bool] | None:
    44	    """노드 하나 병합 — (병합본, 코드소유 필드 드롭 여부). 형식 오류는 None(mismatch 신호)."""
    45	    if not isinstance(base_n, dict) or not isinstance(ov_n, dict):
    46	        return None
    47	    allowed = _node_patch_fields(base_n)
    48	    patch = {k: v for k, v in ov_n.items() if k in allowed}
    49	    dropped = any(k in _NODE_OVERRIDE_FIELDS and k not in allowed for k in ov_n)
    50	    return {**base_n, **patch}, dropped
    51	
    52	
    53	def _merge_node_overrides(saved: list, ov: object) -> tuple[list, str]:
    54	    """노드형 세션 오버라이드 merge(스펙 287). 길이(=구조)가 같을 때만 인덱스별로 필드
    55	    화이트리스트를 저장 노드 위에 덮는다. 불일치·형식 오류는 저장본 그대로 + "mismatch"
    56	    (조용한 드롭 금지 — 트레이스가 표면화, 스펙 125 계열). 코드 노드(스펙 317)는 manifest가
    57	    선언한 표면만 병합하고, 화이트리스트 필드가 표면 밖이라 떨어지면 "partial"로 표면화
    58	    (조용한 무시 금지 — 무엇이 안 먹었는지 트레이스가 말한다). 순수 함수(테스트 단위)."""
    59	    if not isinstance(ov, list) or len(ov) != len(saved):
    60	        return saved, "mismatch"
    61	    merged: list = []
    62	    dropped = False
    63	    for base_n, ov_n in zip(saved, ov, strict=True):
    64	        one = _merge_one_node(base_n, ov_n)
    65	        if one is None:
    66	            return saved, "mismatch"
    67	        node, one_dropped = one
    68	        dropped = dropped or one_dropped  # 코드 소유 필드를 덮으려 함 — 병합은 계속, 정직 표기
    69	        merged.append(node)
    70	    return merged, ("partial" if dropped else "applied")
    71	
    72	
    73	def _coerce_history_depth(cfg: dict, agent: Agent) -> None:
    74	    """historyDepth 형 가드(codex 287 Low) — 비정수(예: 문자열)는 _window의 `depth < 0` 비교에서
    75	    TypeError 500. 정수화 실패 시 저장값 폴백(요청 하나로 500 못 만들게)."""
    76	    if isinstance(cfg.get("historyDepth"), int):
    77	        return
    78	    try:
    79	        cfg["historyDepth"] = int(cfg["historyDepth"])
    80	    except (TypeError, ValueError):
    81	        cfg["historyDepth"] = (agent.config or {}).get("historyDepth", 20)
    82	
    83	
    84	def _apply_overrides(
    85	    cfg: dict, prompt: str, overrides: dict | None, agent: Agent, allowed: set
    86	) -> tuple[dict, str, str | None, dict | None]:
    87	    """web 한정 세션 오버라이드 병합(스펙 025) — 화이트리스트 키만, 저장 에이전트는 불변.
    88	
    89	    코드·외부(원격) 에이전트는 미적용(bypass 보존 — 026 read-only 취급). 모델은 여전히
    90	    cfg["model"] 이름으로 레지스트리에서만 해석 → [012] 단일 소스 불변식 유지.
    91	    - capabilities(스펙 122): 브로커가 build_broker(principal=호출자)로 호출자 RBAC 게이트
    92	      (_permitted = allowlist ∩ RBAC)하므로 주입분도 안전(confused-deputy 무관).
    93	    - tools(스펙 276): 직접형 도구 단위 배선 — 노출 축소/서버별 필터라 완화 아님.
    94	    - vectorTables(스펙 287): 노드형 문서 풀 파생의 실효 축 — RAG 읽기(사용=공용 정책 211).
    95	    - nodes(스펙 287): 구조 불변 강제 merge(allowed와 분리 — 통짜 교체가 아니라 저장 노드 위
    96	      필드 merge, 추가/삭제=범위 밖). 미적용 사유(mismatch)는 트레이스가 표면화.
    97	    반환 (cfg, prompt, nodes_status, passthrough) — passthrough=적용된 원본 오버라이드(미적용=None):
    98	    in-process 커스텀 에이전트가 화이트리스트 밖 키도 읽게 ctx["overrides"]로 전달(스펙 085)."""
    99	    if not overrides or _is_remote(agent.source):
   100	        return cfg, prompt, None, None
   101	    # modelParams(스펙 408)는 통짜 교체가 아니라 per-key 병합 — 세션이 stream만 보내도 에이전트의
   102	    # enable_thinking 오버라이드가 살아남아야 3층 캐스케이드가 키 단위로 성립한다. 세션 값도
   103	    # 정리기로 걸러 화이트리스트 bool만 병합(스펙 409 codex — 문자열 "false" 게이트 우회 차단).
   104	    saved_mp = dict(cfg.get("modelParams") or {})
   105	    cfg.update({k: v for k, v in overrides.items() if k in allowed and k != "modelParams"})
   106	    if "modelParams" in overrides:
   107	        cfg["modelParams"] = {**saved_mp, **clean_setting_params(overrides["modelParams"])}
   108	    if "historyDepth" in overrides:
   109	        _coerce_history_depth(cfg, agent)
   110	    # systemPrompt는 비어있지 않을 때만 prompt를 덮어쓴다 — 빈/공백 문자열로
   111	    # 저장된 프롬프트를 지우지 않도록(백엔드 자체 가드, 클라이언트 신뢰 안 함. codex P1).
   112	    sp = overrides.get("systemPrompt")
   113	    if isinstance(sp, str) and sp.strip():
   114	        prompt = sp
   115	    nodes_status: str | None = None
   116	    if overrides.get("nodes") is not None:
   117	        if isinstance(cfg.get("nodes"), list):
   118	            cfg["nodes"], nodes_status = _merge_node_overrides(cfg["nodes"], overrides["nodes"])
   119	        else:
   120	            nodes_status = "mismatch"  # 노드형이 아닌 에이전트에 nodes를 보냄
   121	    return cfg, prompt, nodes_status, overrides
   122	
