   164	    async def _persist_turn(self, reply: str) -> None:
   165	        """정상 완주 턴의 영속(스펙 388 P1) — 세션·메시지 저장(0턴 lazy-create·소유자 스탬프는
   166	        _persist가 처리). 트레이스는 최소 정직 표기(서빙은 캡처 없음)·토큰은 추정 폴백(estimated 명시)."""
