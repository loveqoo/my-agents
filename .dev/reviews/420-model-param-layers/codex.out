   142	    @staticmethod
   143	    def _apply_node_scalar_fields(n: dict[str, Any], node: dict[str, Any]) -> None:
   144	        """선택 스칼라 필드(name/model 길이 캡, 화이트리스트 enum, historyDepth 캡)를 node에 채운다."""
   145	        for key in ("name", "model"):  # 문자열 필드(선택) — 길이 캡
   146	            val = n.get(key)
   147	            if isinstance(val, str) and val.strip():
   148	                if len(val) > 200:
   149	                    raise ValueError(f"nodes 항목 {key}은 200자 이하여야 합니다.")
   150	                node[key] = val
   151	        ctx_mode = n.get("context")  # 맥락 모드(스펙 260) — 화이트리스트 값만
   152	        if ctx_mode in ("carry", "clean"):
   153	            node["context"] = ctx_mode
   154	        fmt = n.get("format")  # 출력 형식(스펙 261) — 화이트리스트 값만
   155	        if fmt in ("text", "json"):
   156	            node["format"] = fmt
