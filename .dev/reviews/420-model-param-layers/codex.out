    84	def _apply_overrides(
    85	    cfg: dict, prompt: str, overrides: dict | None, agent: Agent, allowed: set
    86	) -> tuple[dict, str, str | None, dict | None]:
    87	    """web 한정 세션 오버라이드 병합(스펙 025) — 화이트리스트 키만, 저장 에이전트는 불변.
    88	
    89	    코드·외부(원격) 에이전트는 미적용(bypass 보존 — 026 read-only 취급). 모델은 여전히
    90	    cfg["model"] 이름으로 레지스트리에서만 해석 → [012] 단일 소스 불변식 유지.
    91	    - capabilities(스펙 122): 브로커가 build_broker(principal=호출자)로 호출자 RBAC 게이트
    92	      (_permitted = allowlist ∩ RBAC)하므로 주입분도 안전(confused-deputy 무관).
    93	    - tools(스펙 276): 직접형 도구 단위 배선 — 노출 축소/서버별 필터라 완화 아님.
    94	    - vectorTables(스펙 287): 노드형 문서 풀 파생의 실효 축 — RAG 읽기(사용=공용 정책 211).
    95	    - nodes(스펙 287): 구조 불변 강제 merge(allowed와 분리 — 통짜 교체가 아니라 저장 노드 위
    96	      필드 merge, 추가/삭제=범위 밖). 미적용 사유(mismatch)는 트레이스가 표면화.
    97	    반환 (cfg, prompt, nodes_status, passthrough) — passthrough=적용된 원본 오버라이드(미적용=None):
    98	    in-process 커스텀 에이전트가 화이트리스트 밖 키도 읽게 ctx["overrides"]로 전달(스펙 085)."""
    99	    if not overrides or _is_remote(agent.source):
   100	        return cfg, prompt, None, None
   101	    # modelParams(스펙 408)는 통짜 교체가 아니라 per-key 병합 — 세션이 stream만 보내도 에이전트의
   102	    # enable_thinking 오버라이드가 살아남아야 3층 캐스케이드가 키 단위로 성립한다. 세션 값도
   103	    # 정리기로 걸러 화이트리스트 bool만 병합(스펙 409 codex — 문자열 "false" 게이트 우회 차단).
   104	    saved_mp = dict(cfg.get("modelParams") or {})
   105	    cfg.update({k: v for k, v in overrides.items() if k in allowed and k != "modelParams"})
   106	    if "modelParams" in overrides:
   107	        cfg["modelParams"] = {**saved_mp, **clean_setting_params(overrides["modelParams"])}
   108	    if "historyDepth" in overrides:
   109	        _coerce_history_depth(cfg, agent)
   110	    # systemPrompt는 비어있지 않을 때만 prompt를 덮어쓴다 — 빈/공백 문자열로
   111	    # 저장된 프롬프트를 지우지 않도록(백엔드 자체 가드, 클라이언트 신뢰 안 함. codex P1).
   112	    sp = overrides.get("systemPrompt")
   113	    if isinstance(sp, str) and sp.strip():
   114	        prompt = sp
   115	    nodes_status: str | None = None
   116	    if overrides.get("nodes") is not None:
   117	        if isinstance(cfg.get("nodes"), list):
   118	            cfg["nodes"], nodes_status = _merge_node_overrides(cfg["nodes"], overrides["nodes"])
   119	        else:
   120	            nodes_status = "mismatch"  # 노드형이 아닌 에이전트에 nodes를 보냄
   121	    return cfg, prompt, nodes_status, overrides
