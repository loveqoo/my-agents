   123	    # WHERE에 닿으면 asyncpg가 DBAPIError(500)로 샌다. NUL 포함 id는 애초에 저장 행과 매칭 불가라
   124	    # 새 세션으로 fold하는 것이 계약("200+새 세션 발급")과 일치한다 — resume 자체를 건너뛴다.
   125	    # (다른 특수문자·긴 길이는 파라미터 바인딩이 안전 처리하므로 그대로 통과시켜 매칭 실패에 맡긴다.)
   126	    if session_str_id and "\x00" in session_str_id:
   127	        session_str_id = None
   128	    async with SessionLocal() as db:
   129	        agent = await get_or_404(db, Agent, agent_id, detail="agent not found")
   130	        cfg, prompt, pinned_version, nodes_status, applied_overrides = await _prepare_cfg(
   131	            db, agent, version, overrides
   132	        )
   133	        remote = _is_remote(agent.source)
   134	        # 실행 버전(스펙 242) — pinned=지정 버전(미리보기), exec=실제 실행 버전(지정 없으면 활성).
   135	        # trace.agentVersion 기록·HIL 게이트(pinned는 승인 재개가 서빙 config로 돌아 drift) 근거.
   136	        exec_version = pinned_version or agent.active_version
   137	        prompt_name, prompt_id = await _resolve_prompt_provenance(
   138	            db, cfg, applied_overrides, remote
   139	        )
   140	        pins = await _resolve_exec_pins(db, agent.id, exec_version, remote)
   141	        # 코드·외부 에이전트는 비로컬(원격/A2A) 실행이라 로컬 모델이 필요 없다(건너뜀 = None).
   142	        nodes = cfg.get("nodes")  # 노드형 파이프라인 노드 명세(스펙 259) — 아래서 노드별 모델 해석
   143	        # 세션 modelParams(스펙 409) — 노드형에서 노드 층 뒤에 재적용해 세션이 최상위가 되게(codex P1①).
