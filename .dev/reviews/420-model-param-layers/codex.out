   116	    @field_validator("artifactSpec")
   117	    @classmethod
   118	    def _check_artifact_spec(cls, v: dict[str, Any] | None) -> dict[str, Any] | None:
   119	        """산출물 필드 명세 얕은 검증(스펙 190) — fields=배열·각 항목 문자열 key 필수(≤100개).
   120	        의미 검증(후보 유효성 등)은 런타임 normalize_artifact_fields가 방어(빈/문자열후보 무시)."""
   121	        if v is None:
   122	            return v
   123	        if not isinstance(v, dict):
   124	            raise ValueError("artifactSpec은 객체여야 합니다.")
   125	        fields = v.get("fields")
   126	        if fields is not None:
   127	            if not isinstance(fields, list):
   128	                raise ValueError("artifactSpec.fields는 배열이어야 합니다.")
   129	            if len(fields) > 100:
   130	                raise ValueError("artifactSpec.fields는 100개 이하여야 합니다.")
   131	            for field in fields:
   132	                if (
   133	                    not isinstance(field, dict)
   134	                    or not isinstance(field.get("key"), str)
   135	                    or not field["key"].strip()
   136	                ):
   137	                    raise ValueError(
   138	                        "artifactSpec.fields 항목은 비어있지 않은 문자열 key가 필요합니다."
   139	                    )
   140	        return v
