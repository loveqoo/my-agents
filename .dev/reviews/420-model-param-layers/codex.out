    65	def _fold_temperature(cfg: dict) -> None:
    66	    """레거시 temperature 흡수(스펙 411) — 옛 저장 config의 `temperature`(스펙 077 특례)를 통합
    67	    파라미터 축 `modelParams.temperature`로 이관한다. modelParams에 이미 있으면(신규 저장분) 무변화.
    68	    None(자동=모델 기본)은 이관 안 함(미설정 의미 보존). 세션 오버라이드 temperature도 _apply_overrides가
    69	    modelParams로 넣으므로 여기서 legacy 키만 흡수. temperature가 다른 파라미터와 한 메커니즘이 된다."""
    70	    temp = cfg.get("temperature")
    71	    if isinstance(temp, (int, float)) and not isinstance(temp, bool):
    72	        mp = cfg.get("modelParams")
    73	        if not isinstance(mp, dict):
    74	            mp = {}
    75	            cfg["modelParams"] = mp
    76	        mp.setdefault("temperature", float(temp))
    77	    cfg.pop("temperature", None)  # 특례 키 은퇴(이관 후 제거 — 이중 거처 방지)
