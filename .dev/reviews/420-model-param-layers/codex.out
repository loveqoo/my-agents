    10	실행: uv run python tests/_throwaway_db.py tests/verify_420_model_param_layers.py
    11	"""
    12	
    13	import asyncio
    14	import pathlib
    15	import sys
    16	
    17	ROOT = pathlib.Path(__file__).resolve().parent.parent
