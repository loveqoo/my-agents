   105	async def _build_resume_broker(
   106	    user_id: str | None,
   107	    capabilities: list[str] | None,
   108	    tool_policy: dict | None = None,
   109	    *,
   110	    delegation_chain: tuple = (),
   111	    delegation_budget: dict | None = None,
   112	    force_approval: bool = False,  # 첨부 유래 턴 복원(스펙 415 P4)
   113	) -> PolicyScopedBroker:
   114	    """재개용 스코프 브로커 — 원 요청자(user_id)의 RBAC를 재구성해 request-time 게이트를 그대로 복원.
   115	
   116	    build_broker(principal, ...)와 **동일 술어**를 principal 객체 없이 재현한다: superuser면 우회(원
   117	    요청과 동일 안전판), 아니면 casbin `enforce(user_id, capability:{kind}, invoke)`. user_id가 없으면
   118	    deny(머신 발 — 이 경로는 애초에 브로커 interrupt를 못 만들므로 실질 미도달, 안전측 기본).
   119	
   120	    로컬 위임(스펙 256) 봉합(codex 256 [P2]): 재개도 원 턴과 동일하게 (1) **원 요청자 principal 객체**를
   121	    AgentProvider에 관통해야 하위 eval_run_agent→build_broker가 principal.id로 스코프를 재구성한다
   122	    (없으면 크래시 → 승인된 로컬 위임이 조용히 미실행). (2) **delegation_chain**(루트 agent_id)을
   123	    관통해야 재개 후 재위임에서도 순환·깊이 게이트가 원 턴과 동일하게 성립한다."""
   124	    is_super = False
   125	    requester = None  # 원 요청자 User 객체(AgentProvider가 로컬 위임 하위 실행의 RBAC 주체로 사용)
   126	    if user_id:
   127	        try:
   128	            async with SessionLocal() as s:
   129	                u = await s.get(User, uuid.UUID(user_id))
   130	                requester = u  # 로드된 속성(id·is_superuser)은 세션 종료 후 접근 가능
   131	                is_super = bool(u and u.is_superuser)
   132	        except (ValueError, TypeError):
   133	            is_super = False  # user_id가 UUID 형식이 아니면 casbin 경로로만(우회 없음)
   134	
   135	    def rbac_allows(kind: str, name: str | None = None) -> bool:
   136	        # per-cap 부여 지원(스펙 112) — build_broker와 **동일 술어**(`_rbac_allows`, drift 0).
   137	        if not user_id:
   138	            return False
   139	        if is_super:
   140	            return True
   141	        from .broker import _rbac_allows
   142	
   143	        return _rbac_allows(authz.get_enforcer(), user_id, kind, name)
   144	
   145	    # user_id 주입(스펙 104) — MemoryProvider가 재개 경로에서도 원 요청자 스코프를 복원한다. 없으면
   146	    # 재개 시 `memory:user`가 사라져 자기 기억 접근이 깨진다(fail-closed지만 기능 회귀, 적대 리뷰 104 P2).
   147	    # principal(원 요청자)·delegation_chain(루트) 관통 — 로컬 위임 재개 봉합(codex 256 [P2]).
   148	    # 스펙 294: 조립은 build_providers(BrokerContext) 단일 출처 — 브로커는 소비만.
   149	    providers = build_providers(
   150	        BrokerContext(
   151	            principal=requester,
   152	            user_id=user_id,
   153	            delegation_chain=delegation_chain,
   154	            delegation_budget=delegation_budget,
   155	        )
   156	    )
   157	    return PolicyScopedBroker(
   158	        capabilities, rbac_allows, providers, tool_policy=tool_policy, force_approval=force_approval
   159	    )
   160	
   161	
   162	def _impl_drifted(snap_impl: str | None, cur_impl: str | None) -> bool:
   163	    """스펙 171 — 재개 시 impl(그래프 위상)이 생성 시점과 달라졌나. 순수 함수(단위 검증 가능).
   164	
   165	    - snap None = 스펙 171 마이그레이션 이전에 만든 행 = 스냅샷 부재 = 대조 불가 → False(스킵, 하위호환).
   166	    - "" = 기본(DefaultUiAgent). cur도 None/""면 기본이므로 `cur or ""`로 정규화해 대조.
   167	    - snap이 있고 현재와 다르면 True → 재개는 미정의 동작(다른 그래프를 stale checkpoint에 resume)이라 거부.
   168	    """
   169	    if snap_impl is None:
   170	        return False
   171	    return snap_impl != (cur_impl or "")
   172	
