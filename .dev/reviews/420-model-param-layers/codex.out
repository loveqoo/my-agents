   145	        session_mp = clean_setting_params(overrides.get("modelParams")) if isinstance(overrides, dict) else None
   146	        model_cfg = await _resolve_model(db, cfg, overrides, pins) if not remote else None
   147	        nodes_resolved = await _resolve_nodes_for_ctx(
   148	            db, nodes, model_cfg, remote, pins, cfg=cfg, session_mp=session_mp
   149	        )
   150	        mem_cfg = await _resolve_mem_cfg(db, model_cfg)
   151	        mcp_servers, tool_names = await _resolve_mcp_servers(db, cfg, pins)
   152	        rag_collections, rag_unresolved = await _resolve_rag(db, cfg, remote)
   153	        session = await _resolve_session(db, agent, session_str_id, own)
