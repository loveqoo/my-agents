    80	async def _prepare_cfg(
    81	    db: AsyncSession, agent: Agent, version: str | None, overrides: dict | None
    82	) -> tuple[dict, str, str | None, str | None, dict | None]:
    83	    """cfg 준비 단계(스펙 394 분해) — 버전 스냅샷·노드 ref 해석·오버라이드 병합·풀 재파생.
    84	    반환 (cfg, prompt, pinned_version, nodes_status, applied_overrides). 순서는 모듈 docstring ①~④."""
    85	    cfg = dict(agent.config or {})
    86	    # (스펙 211) 구 113 P0의 저장본/override 권한 분리(stored_mcps 포착)는 사용=공용 전환으로 소멸.
    87	    cfg, prompt, pinned_version = await _resolve_version_and_prompt(db, agent, cfg, version)
    88	    # 노드 참조 해석(스펙 316) — ref 항목을 등록 노드 config 사본으로 치환. **오버라이드 병합
    89	    # 전에**(해석→병합): 세션 패치는 해석된 유효 노드 위에 얹는다. 미해결 참조는 422로 명확히
    90	    # 실패(반쪽 파이프라인 조용히 실행 금지 — 089 패턴). 핀 버전 미리보기(version=) 스냅샷의
    91	    # 참조도 여기서 함께 해석된다(_resolve_version_and_prompt 뒤 단일 지점).
    92	    if not _is_remote(agent.source) and isinstance(cfg.get("nodes"), list):
    93	        cfg["nodes"] = await resolve_node_refs(db, cfg["nodes"])
    94	    cfg, prompt, nodes_status, applied_overrides = _apply_overrides(
    95	        cfg, prompt, overrides, agent, _OVERRIDE_ALLOWED
    96	    )
    97	    _fold_temperature(cfg)  # 레거시 temperature → modelParams 이관(스펙 411 흡수)
    98	    # 노드형 풀 서버 파생(스펙 289 P2) — 로드 시 무조건 재파생: 폼 밖 입구(API 직생성·구저장·
    99	    # 오버라이드)로 풀이 비었거나 낡았어도 노드 참조대로 도구·문서·기억이 빌드된다(learning 151).
   100	    # 저장 시 파생(agents.py)과 같은 규칙이라 폼 저장분엔 무변화(멱등).
   101	    if not _is_remote(agent.source):
   102	        await derive_pipeline_pool(cfg)
