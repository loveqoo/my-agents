   202	@router.get("/{agent_id}", response_model=AgentOut)
   203	async def get_agent(
   204	    agent_id: uuid.UUID,
   205	    session: AsyncSession = Depends(get_session),
   206	    principal: User | str = Depends(current_principal),
   207	) -> AgentOut:
   208	    agent = await _load_agent(session, agent_id)
   209	    if agent is None or not may_use_agent(agent, principal):
   210	        # 사용 게이트(스펙 147, codex High#1) — 타인 private는 UUID를 알아도 미존재와 동일(404-fold,
   211	        # 068: systemPrompt·config가 단건 응답에 실리므로 목록만 막으면 열람 우회).
   212	        raise HTTPException(status_code=404, detail="agent not found")
   213	    out = agent_to_out(agent)
   214	    out.can_manage = may_manage(out.owner_id, principal)  # 스펙 114
   215	    # 채택 배지 데이터(스펙 370 §4) — 오픈 버전 pins vs 블록 head. 단건 GET만 계산(목록은 무비용 유지).
   216	    if agent.active_version:
   217	        open_row = next((v for v in agent.versions if v.version == agent.active_version), None)
   218	        if open_row is not None:
   219	            from ..block_versions import stale_pins
   220	
