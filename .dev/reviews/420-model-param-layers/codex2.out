packages/api/src/api/mock_mcp.py:45:    # failing_op의 meta는 시드하지 않는다(seed 카탈로그 미포함, 위 MOCK_MCP_TOOLS 주석 참고) — 전용
packages/api/src/api/block_versions.py:12:import uuid
     1	"""모델 파라미터 캐스케이드 층 정책(스펙 420) — FE `CapabilitySettings.tsx`의 `modelParamLayerApplies`
     2	BE 형제(대칭). modelParams가 적용되는 4층(model-default → agent → node → session) 중 **어느 층이 어느
     3	에이전트 유형에서 유효한가**를 한 곳에서 판정한다.
     4	
     5	여기가 BE의 유일한 판정처다 — 캐스케이드를 적용하는 관문(`_resolve_model`·`_resolve_node_models`,
     6	chat_context_models)이 이 함수를 참조한다. 그래서 노드형에 agent·session 층이 새지 않는 게 특정
     7	호출자(chat/resume/serve/eval)가 아니라 **관문 자체**에서 강제된다([[policy-at-the-chokepoint]]).
     8	
     9	규칙(FE와 동일): model-default=항상 · node=노드형(pipeline)만 · agent·session=노드형이 **아닐** 때만
    10	(노드형은 노드가 모델 파라미터를 소유 — 에이전트·세션 층이 노드로 새면 중복/혼란, 스펙 417·419·420).
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	_PIPELINE = "pipeline"
    16	
    17	
    18	def layer_applies(layer: str, impl: str | None) -> bool:
    19	    """이 캐스케이드 층이 주어진 에이전트 impl에서 유효(적용/편집 가능)한가.
    20	
    21	    layer: 'model-default' | 'agent' | 'node' | 'session'. 알 수 없는 층은 ValueError(오타 조기 발견).
    22	    """
    23	    is_pipeline = impl == _PIPELINE
    24	    if layer == "model-default":
    25	        return True
    26	    if layer == "node":
    27	        return is_pipeline
    28	    if layer in ("agent", "session"):
    29	        return not is_pipeline
    30	    raise ValueError(f"알 수 없는 모델 파라미터 층: {layer!r}")
   110	    overrides: dict | None = None,
   111	    own: str | None = None,
   112	    version: str | None = None,
   113	) -> ChatContext:
   114	    """에이전트 구성 + MCP 활성 툴 + 세션(생성/지속)을 한 번에 준비.
   115	
   116	    overrides(스펙 025): Playground Proxy의 세션 한정 설정 덮어쓰기. **web 에이전트에만** 적용하고
   117	    화이트리스트 키만 받는다(저장된 에이전트는 불변). 코드 에이전트는 원격 실행이라 미적용(bypass).
   118	
   119	    own(스펙 068): resume 소유자 스코프. 비-admin이면 `str(principal.id)`, admin/머신·내부 호출은
   120	    None. `own is not None`이면 resume 바인딩이 `Session.user_id == own`을 요구해, *타인/NULL/추측*
   121	    session_id는 매칭 실패 → 새 세션 발급(067 읽기 게이트와 동일 판정 — 열거 오라클·소유권 탈취 봉인).
   122	    """
   123	    # 세션 id 위생(스펙 290 적대): Postgres text는 NUL(0x00)을 저장·조회할 수 없어, 오염된 id가
   124	    # WHERE에 닿으면 asyncpg가 DBAPIError(500)로 샌다. NUL 포함 id는 애초에 저장 행과 매칭 불가라
   125	    # 새 세션으로 fold하는 것이 계약("200+새 세션 발급")과 일치한다 — resume 자체를 건너뛴다.
   126	    # (다른 특수문자·긴 길이는 파라미터 바인딩이 안전 처리하므로 그대로 통과시켜 매칭 실패에 맡긴다.)
   127	    if session_str_id and "\x00" in session_str_id:
   128	        session_str_id = None
   129	    async with SessionLocal() as db:
   130	        agent = await get_or_404(db, Agent, agent_id, detail="agent not found")
   131	        cfg, prompt, pinned_version, nodes_status, applied_overrides = await _prepare_cfg(
   132	            db, agent, version, overrides
   133	        )
   134	        remote = _is_remote(agent.source)
   135	        # 실행 버전(스펙 242) — pinned=지정 버전(미리보기), exec=실제 실행 버전(지정 없으면 활성).
   136	        # trace.agentVersion 기록·HIL 게이트(pinned는 승인 재개가 서빙 config로 돌아 drift) 근거.
   137	        exec_version = pinned_version or agent.active_version
   138	        prompt_name, prompt_id = await _resolve_prompt_provenance(
   139	            db, cfg, applied_overrides, remote
   140	        )
   141	        pins = await _resolve_exec_pins(db, agent.id, exec_version, remote)
   142	        # 코드·외부 에이전트는 비로컬(원격/A2A) 실행이라 로컬 모델이 필요 없다(건너뜀 = None).
   143	        nodes = cfg.get("nodes")  # 노드형 파이프라인 노드 명세(스펙 259) — 아래서 노드별 모델 해석
   144	        # 세션 modelParams(스펙 409) — 노드형에서 노드 층 뒤에 재적용해 세션이 최상위가 되게(codex P1①).
   145	        # 화이트리스트 bool만(문자열 "false" 게이트 우회 차단 — 실행부 _as_bool와 이중 방어).
   146	        session_mp = clean_setting_params(overrides.get("modelParams")) if isinstance(overrides, dict) else None
   147	        model_cfg = await _resolve_model(db, cfg, overrides, pins) if not remote else None
   148	        nodes_resolved = await _resolve_nodes_for_ctx(
   149	            db, nodes, model_cfg, remote, pins, cfg=cfg, session_mp=session_mp
   150	        )
