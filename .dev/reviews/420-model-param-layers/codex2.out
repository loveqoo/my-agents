   295	    pins: dict[str, int] = Field(default_factory=dict)  # 블록 버전 못박기 {kind:name → ver}
   296	    note: str = ""
   297	    config: dict[str, Any] = Field(default_factory=dict)
   298	    createdAt: str | None = None
   299	
   300	
   301	class AgentOut(AuditOut):
   302	    id: uuid.UUID
   303	    agentId: str
   304	    name: str  # 식별 이름(규칙, 스펙 148)
   305	    description: str | None = None  # 설명(자유 표기, 스펙 210) — 표시는 name 단독
   306	    source: str
   307	    model: str
   308	    prompt: str  # 프롬프트 이름(블록 참조, UI 표시용)
   309	    temperature: float | None = None  # 에이전트 영속 온도(스펙 077). None=자동(모델 등록값)
   310	    modelParams: dict[str, Any] = Field(
   311	        default_factory=dict
   312	    )  # 모델 설정 오버라이드(스펙 408 — 폼 재로드용)
   313	    systemPrompt: str = ""  # 해석된 시스템 프롬프트 본문(런타임이 쓰는 것 = 저장 시점 스냅샷)
   314	    # 오픈 버전 pins 중 블록 head가 더 새 버전인 항목(스펙 370 §4 채택 배지) — 단건 GET만 계산.
   315	    stalePins: list[dict[str, Any]] = Field(default_factory=list)
   316	    historyDepth: int
   317	    persistHistory: bool = True
   318	    ephemeral: bool = False
   319	    suggestedPrompts: list[str] = Field(default_factory=list)  # 플그 추천 명령어(스펙 238)
   320	    impl: str | None = None  # in-process 커스텀 런타임 키(스펙 085) — 폼 재로드/라운드트립 보존용
   321	    # 공통 인터페이스 준수 분류(스펙 089) — 파생값(저장 안 함). conforming=준수(default/적합 impl),
   322	    # non_conforming=A2A 원격(정당한 다른 종류), config_error=impl 선언했으나 미해결(설정 실패).
   323	    conformance: str = "conforming"
   324	    memories: list[str] = Field(default_factory=list)
   325	    vectorTables: list[str] = Field(default_factory=list)
   233	# ----------------------------- 생성 (UI) -----------------------------
   234	@router.post("", response_model=AgentOut, status_code=201)
   235	async def create_agent(
   236	    body: AgentCreate,
   237	    session: AsyncSession = Depends(get_session),
   238	    principal: User | str = Depends(current_principal),
   239	) -> AgentOut:
   240	    assert_valid_name(body.name)  # 식별 이름 규칙(스펙 148) — 서버가 진실원
   241	    cfg = body.config.model_dump()
   242	    _enforce_tool_policy_gate(cfg, principal)
   243	    _enforce_ephemeral_boundary(
   244	        cfg
   245	    )  # DB 쓰기 능력 금지(스펙 237)  # 완화는 admin만(스펙 177 P2 D4)
   246	    _strip_pipeline_model_params(cfg)  # 노드형 modelParams 강제 비움(스펙 420 — validator와 이중 방어)
   247	    # 노드 참조 존재 검증(스펙 316, codex P1) — impl 무관(비노드형 저장도 실행 시 422 시한폭탄 금지).
   248	    # 참조 이름 advisory lock으로 삭제 가드와 직렬화(TOCTOU — 검증 후 커밋 전 삭제 봉인).
   249	    await assert_node_refs_exist(session, cfg.get("nodes"))
   250	    # 기억 이름 존재 검증(스펙 387) — 노드 참조와 같은 규칙(dangling name의 조용한 무동작 차단).
   251	    await assert_memory_names_exist(session, cfg)
   252	    await derive_pipeline_pool(
   253	        cfg
   254	    )  # 노드형 풀=노드 합집합 서버 파생(스펙 289 P2 — 폼 밖 입구도 안전)
   255	    agent = Agent(
   256	        agent_id=_new_agent_id(),
   257	        name=body.name,
   258	        description=(body.description or "").strip() or None,  # 설명(자유 표기, 스펙 210)
   259	        source="ui",
   260	        model=body.config.model,
   261	        prompt=await resolve_prompt(session, body.config.prompt),
   262	        history_depth=body.config.historyDepth,
   263	        config=cfg,
   264	        exposed={"a2a": False},
   265	        status="idle",
   266	        active_version=None,
   267	        owner_id=owner_of(principal),  # 생성 시 1회 스탬프(스펙 112, 069)
   268	    )
   269	    agent.versions.append(
   270	        AgentVersion(
   271	            version="v1",
   272	            ever_opened=False,
   273	            pins=await freeze_pins(session, cfg),  # 블록 버전 못박기(스펙 370)
   274	            note="초기 버전",
   275	            config=cfg,
   276	        )
   277	    )
   278	    session.add(agent)
   279	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   280	    return await _reload_out(session, agent.id)
   283	# ----------------------------- 복제 (저마찰 재사용, 스펙 120) -----------------------------
   284	@router.post("/{agent_id}/clone", response_model=AgentOut, status_code=201)
   285	async def clone_agent(
   286	    agent_id: uuid.UUID,
   287	    session: AsyncSession = Depends(get_session),
   288	    principal: User | str = Depends(current_principal),
   289	) -> AgentOut:
   290	    """기존 에이전트 설정을 새 **ui 초안**으로 복사(행위 재사용 — '이거랑 비슷한 거 하나 더'). 복제는
   291	    **읽기+새 생성**이라 원본 *관리 권한 불요*(가시하면 복제 가능 — 사용≠관리, 스펙 112). 소유권은
   292	    **복제자**에게 스탬프(원본 소유자 승계 금지 — 069 no-takeover). 미존재/미가시 원본은 404-fold."""
   293	    src = await _load_agent(session, agent_id)
   294	    if src is None or not may_use_agent(src, principal):
   295	        # codex High#2 — 타인 private를 복제하면 설정(프롬프트·능력)이 내 소유로 유출되고
