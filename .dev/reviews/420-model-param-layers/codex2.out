   358	# ----------------------------- 편집 = 초안 저장 -----------------------------
   359	@router.put("/{agent_id}", response_model=AgentOut)
   360	async def update_agent(
   361	    agent_id: uuid.UUID,
   362	    body: AgentUpdate,
   363	    session: AsyncSession = Depends(get_session),
   364	    principal: User | str = Depends(current_principal),
   365	) -> AgentOut:
   366	    agent = await _load_agent(session, agent_id)
   367	    if agent is None:
   368	        raise HTTPException(status_code=404, detail="agent not found")
   369	    assert_may_manage(
   370	        agent, principal, not_found_detail="agent not found"
   371	    )  # 소유자/특권만(스펙 112)
   372	
   373	    cfg = body.config.model_dump()
   374	    _enforce_tool_policy_gate(cfg, principal)
   375	    _enforce_ephemeral_boundary(
   376	        cfg
   377	    )  # DB 쓰기 능력 금지(스펙 237)  # 완화는 admin만(스펙 177 P2 D4)
   378	    draft = next((v for v in agent.versions if not v.ever_opened), None)  # 스크래치(스펙 370)
   379	    _preserve_impl(body, agent, draft, cfg)
   380	    _strip_pipeline_model_params(cfg)  # 최종 impl 확정 후 노드형 modelParams 강제 비움(스펙 420 P1①)
   381	    # 노드 참조 존재 검증(스펙 316, codex P1) — impl 무관 + 이름 잠금(삭제 가드와 직렬화).
   382	    await assert_node_refs_exist(session, cfg.get("nodes"))
   383	    # 기억 이름 존재 검증(스펙 387) — 노드 참조와 같은 규칙(dangling name의 조용한 무동작 차단).
   384	    await assert_memory_names_exist(session, cfg)
   385	    # 노드형 풀=노드 합집합 서버 파생(스펙 289 P2) — impl 보존 **뒤**에 호출(미명시 impl이 pipeline로
   386	    # 확정된 뒤라야 파생 게이트가 맞는다).
   387	    await derive_pipeline_pool(cfg)
   388	    # 충돌 규칙(스펙 370): 스크래치 유일 — 있으면 그 행을 새 번호·새 pins로 대체, 없으면 신설.
   389	    # 번호 = 오픈+1(오픈이력 슬롯이면 최대 오픈+1 — 오픈됐던 버전은 불변 보호).
   390	    scratch, target_ver = scratch_target(agent)
   391	    pins = await freeze_pins(session, cfg)  # 편집 시점 재freeze(스펙 370)
   392	    if scratch is not None:
   393	        scratch.version = target_ver
   394	        scratch.config = cfg
   395	        scratch.pins = pins
   396	        scratch.note = f"Edited {_today()}"
   397	    else:
   398	        agent.versions.append(
   399	            AgentVersion(
   400	                version=target_ver,
   401	                ever_opened=False,
   402	                pins=pins,
   403	                note=f"{agent.active_version or 'v0'}에서 편집",
   404	                config=cfg,
   405	            )
    45	
    46	    target = _find_version(agent, body.version)
    47	    if target is None:
    48	        raise HTTPException(status_code=404, detail="version not found")
    49	    if agent.active_version == body.version:
    50	        raise HTTPException(status_code=400, detail="이미 오픈된 버전입니다")
    51	    # 평가 게이트(스펙 372=367-E) — 스크래치(미오픈) 첫 오픈만. 롤백(ever_opened)은 면제(구남님 확정:
    52	    # 긴급 롤백을 게이트가 막으면 사고 대응이 잠긴다). 우회 플래그 없음 — 급하면 설정에서 임계를
    53	    # 낮추는 명시 행위로만(감사 가능).
    54	    if not target.ever_opened and agent.source == "ui":
    55	        blocked = await _eval_gate_reason(session, agent.id, body.version)
    56	        if blocked:
    57	            raise HTTPException(status_code=400, detail=blocked)
    58	
    59	    cfg = dict(target.config or {})
    60	    _enforce_ephemeral_boundary(
    61	        cfg
    62	    )  # 스펙 237(codex #1) — 과거 버전 오픈도 "존재 불가" 불변식 유지
    63	    target.ever_opened = True  # 오픈 이력 = 영구 불변 보호(스펙 370 충돌 규칙)
    64	    agent.config = cfg
    65	    agent.model = cfg["model"]
