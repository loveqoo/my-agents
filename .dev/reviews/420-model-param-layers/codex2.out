    52	def is_third_party(source: str) -> bool:
    53	    """제3자(밖에서 가져온) 에이전트 소스 — 오늘은 external(A2A 카드)만. `is_first_party`의 여집합.
    54	    재공개 금지(스펙 152)·사용 항상 허용(147) 등 '가져다 쓰는 것' 취급의 단일 기준(스펙 183)."""
    55	    return not is_first_party(source)
