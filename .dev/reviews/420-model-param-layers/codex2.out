   244	async def resolve_agent_mem_cfg(db: AsyncSession, agent: Agent) -> dict | None:
   245	    """에이전트의 mem0 설정(레지스트리 chat llm + 기본 embedding)을 해석. 없으면 None.
   190	    if not may_manage(agent, principal):
   191	        # 운영 지표=전 유저 피드백·평가 합산(codex 244 #2) — 관리자·소유자 전용(사용자는 대화만).
   192	        raise HTTPException(
   193	            status_code=403, detail="운영 지표는 이 에이전트를 관리할 수 있어야 합니다"
   194	        )
   195	
   196	    versions: dict[str, VersionOps] = {}
   197	    await _collect_eval_aggregates(session, agent, versions)
   198	    un_up, un_down = await _collect_feedback_aggregates(session, agent, versions)
   199	    return AgentOpsOut(versions=versions, unversionedUp=un_up, unversionedDown=un_down)
   200	
