    61	async def _registry_chat_model(db: AsyncSession, name: str) -> ModelConfig | None:
    62	    """레지스트리 chat 모델 단건 조회(name, kind=chat, provider 상속) — 해석 3경로 공유 조회."""
    63	    return (
    64	        await db.execute(
    65	            select(ModelConfig)
    66	            .where(ModelConfig.name == name, ModelConfig.kind == "chat")
    67	            .options(selectinload(ModelConfig.provider))
    68	        )
    69	    ).scalar_one_or_none()
    70	
    71	
    72	async def _default_chat_registry(db: AsyncSession) -> ModelConfig | None:
    73	    """기본(is_default) chat 모델 조회 — 저장 설정 미지정/미등록의 graceful 폴백 대상."""
    74	    return (
    75	        (
    76	            await db.execute(
    77	                select(ModelConfig)
    78	                .where(ModelConfig.kind == "chat", ModelConfig.is_default.is_(True))
    79	                .options(selectinload(ModelConfig.provider))
    80	            )
    81	        )
    82	        .scalars()
    83	        .first()
    84	    )
