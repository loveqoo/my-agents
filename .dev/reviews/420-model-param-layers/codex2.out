    31	async def _pinned_model_cfg(db: AsyncSession, pins: dict | None, name: str) -> dict | None:
    32	    """pin이 head와 다를 때만 이력 payload로 model_cfg 구성(스펙 370) — 369 경계 그대로
    33	    저작 내용(model_id·params·provider_id)은 pin, 연결처 비밀(base_url·api_key)은 라이브 provider."""
    34	    from .block_versions import resolve_pinned
    35	    from .models import Provider as _Provider
    36	
    37	    payload = await resolve_pinned(db, pins, "model", name)
    38	    if payload is None:
    39	        return None
    40	    prov = None
    41	    if payload.get("provider_id"):
    42	        try:
    43	            prov = await db.get(_Provider, uuid.UUID(str(payload["provider_id"])))
    44	        except ValueError:
    45	            prov = None
    46	    if prov is None or not prov.base_url or not payload.get("model_id"):
    47	        return None  # 불완전 pin — head 폴백(정직 degrade)
    48	    # 능력은 스냅샷하지 않는다(스펙 408) — 서버 능력은 **라이브 사실**이라 pin과 무관하게 현재
    49	    # 등록 행에서 읽는다(구버전 pin이라도 지금 서버가 스트리밍을 껐으면 지금 사실을 따라야 함).
    50	    live = await _registry_chat_model(db, name)
    51	    caps = dict(live.capabilities or {}) if live is not None else {}
    52	    return {
    53	        "base_url": prov.base_url,
    54	        "api_key": crypto.decrypt(prov.api_key),
    55	        "model_id": payload["model_id"],
    56	        "params": dict(payload.get("params") or {}),
    57	        "capabilities": caps,
    58	    }
    59	
