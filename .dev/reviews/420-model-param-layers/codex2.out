     1	"""verify_420 — 모델 파라미터 캐스케이드 층 정책(스펙 420) 계약 핀.
     2	
     3	FE(modelParamLayerApplies)가 숨긴 층 == BE(layer_applies)가 안 적용을 못박는다 — FE/BE 드리프트 봉인.
     4	
     5	  P  정책 단위: layer_applies 매트릭스(model-default 항상·node=pipeline만·agent/session=non-pipeline만).
     6	  W  쓰기 경계: AgentConfig가 노드형 modelParams를 비운다(illegal state 표현 불가), 비노드형은 보존.
     7	  R  해석 관문(실 DB): 노드형에 agent·session 층 modelParams가 노드 model_cfg에 **안 실림**(명시 모델
     8	     노드·모델없는 폴백 노드 둘 다). 비노드형은 agent 층이 실림(무회귀).
     9	
    10	실행: uv run python tests/_throwaway_db.py tests/verify_420_model_param_layers.py
    11	"""
    12	
    13	import asyncio
    14	import pathlib
    15	import sys
    16	
    17	ROOT = pathlib.Path(__file__).resolve().parent.parent
    18	sys.path.insert(0, str(ROOT / "packages" / "api" / "src"))
    19	sys.path.insert(0, str(ROOT / "packages" / "agent" / "src"))
    20	
    21	import uuid  # noqa: E402
    22	
    23	from sqlalchemy import delete, select  # noqa: E402
    24	
    25	from api.agents.crud_routes import _strip_pipeline_model_params  # noqa: E402
    26	from api.chat_context import _load_context, _resolve_model, _resolve_node_models  # noqa: E402
    27	from api.db import SessionLocal  # noqa: E402
    28	from api.model_param_layers import layer_applies  # noqa: E402
    29	from api.models import Agent, ModelConfig  # noqa: E402
    30	from api.schemas.agents import AgentConfig  # noqa: E402
    31	
    32	_TAG = f"v420-{uuid.uuid4().hex[:8]}"
    33	
    34	_fails: list[str] = []
    35	passed = 0
    36	
    37	
    38	def check(cond: object, msg: str) -> None:
    39	    global passed
    40	    print(("  ok  " if cond else " FAIL ") + msg)
    41	    if cond:
    42	        passed += 1
    43	    else:
    44	        _fails.append(msg)
    45	
    46	
    47	def _p_policy() -> None:
    48	    print("== P 정책 단위(layer_applies) ==")
    49	    check(layer_applies("model-default", "pipeline") and layer_applies("model-default", None),
    50	          "model-default: 항상")
    51	    check(layer_applies("node", "pipeline") and not layer_applies("node", None),
    52	          "node: pipeline만")
    53	    check(not layer_applies("agent", "pipeline") and layer_applies("agent", None),
    54	          "agent: non-pipeline만")
    55	    check(not layer_applies("session", "pipeline") and layer_applies("session", None),
    56	          "session: non-pipeline만")
    57	    try:
    58	        layer_applies("bogus", None)
    59	        check(False, "알 수 없는 층 → ValueError")
    60	    except ValueError:
    61	        check(True, "알 수 없는 층 → ValueError(오타 조기 발견)")
    62	
    63	
    64	def _w_write_boundary() -> None:
    65	    print("== W 쓰기 경계(AgentConfig + strip 헬퍼) ==")
    66	    node = AgentConfig(impl="pipeline", modelParams={"temperature": 0.3}, nodes=[{"prompt": "x"}])
    67	    check(node.modelParams == {}, f"노드형 modelParams 저장 차단(비움) (got {node.modelParams})")
    68	    direct = AgentConfig(impl=None, modelParams={"temperature": 0.3})
    69	    check(direct.modelParams.get("temperature") == 0.3, "비노드형 modelParams 보존(무회귀)")
    70	    # P1① codex — update 순서 역전(impl 나중 복원) 방어: 최종 impl 확정 후 strip 헬퍼.
    71	    cfg = {"impl": "pipeline", "modelParams": {"temperature": 0.9}}  # 파싱 땐 impl 없다가 복원된 형태
    72	    _strip_pipeline_model_params(cfg)
    73	    check(cfg["modelParams"] == {}, f"strip 헬퍼: 노드형 modelParams 비움(update 순서 방어) (got {cfg['modelParams']})")
    74	    cfg2 = {"impl": None, "modelParams": {"temperature": 0.9}}
    75	    _strip_pipeline_model_params(cfg2)
    76	    check(cfg2["modelParams"].get("temperature") == 0.9, "strip 헬퍼: 비노드형 보존(오탐 없음)")
    77	
    78	
    79	async def _t_temperature_channel(model_name: str) -> None:
    80	    """P1② codex — temperature 병렬 통로 봉인: 노드형 에이전트(레거시 불법 저장 config, raw 시드로
    81	    validator 우회)의 ctx.temperature가 None이어야(agent·session 둘 다). 이게 run_params로 4입구+노드에
    82	    새던 실우회. 비노드형은 ctx.temperature 유지(무회귀)."""
    83	    print("== T temperature 병렬 통로(ctx.temperature, 실 로더) ==")
    84	    async with SessionLocal() as s:
    85	        # raw 시드 = AgentConfig validator 우회(레거시·API 직접 저장 재현) — 불법 modelParams가 DB에.
    86	        s.add(Agent(
    87	            agent_id=f"agt_{_TAG}_pipe", name=f"{_TAG}_pipe", source="ui", active_version="v1",
    88	            config={"impl": "pipeline", "model": model_name, "modelParams": {"temperature": 0.9},
    89	                    "nodes": [{"prompt": "n", "model": model_name}]},
    90	        ))
    91	        s.add(Agent(
    92	            agent_id=f"agt_{_TAG}_direct", name=f"{_TAG}_direct", source="ui", active_version="v1",
    93	            config={"impl": None, "model": model_name, "modelParams": {"temperature": 0.5}},
    94	        ))
    95	        await s.commit()
    96	        pipe = (await s.execute(select(Agent).where(Agent.agent_id == f"agt_{_TAG}_pipe"))).scalar_one()
    97	        direct = (await s.execute(select(Agent).where(Agent.agent_id == f"agt_{_TAG}_direct"))).scalar_one()
    98	        pipe_id, direct_id = pipe.id, direct.id
    99	    try:
   100	        ctx = await _load_context(pipe_id, None, {}, own=None)
   101	        check(ctx.temperature is None, f"노드형 ctx.temperature=None(agent 층 병렬통로 봉인) (got {ctx.temperature})")
   102	        ctx_s = await _load_context(pipe_id, None, {"modelParams": {"temperature": 0.01}}, own=None)
   103	        check(ctx_s.temperature is None, f"노드형 ctx.temperature=None(session 오버라이드도 봉인) (got {ctx_s.temperature})")
   104	        ctx_d = await _load_context(direct_id, None, {}, own=None)
   105	        check(ctx_d.temperature == 0.5, f"비노드형 ctx.temperature 유지(무회귀) (got {ctx_d.temperature})")
   106	    finally:
   107	        async with SessionLocal() as s:
   108	            await s.execute(delete(Agent).where(Agent.agent_id.like(f"agt_{_TAG}_%")))
   109	            await s.commit()
   110	
   111	
   112	async def _r_resolution() -> None:
   113	    print("== R 해석 관문(실 DB) ==")
   114	    async with SessionLocal() as s:
   115	        m = (
   116	            await s.execute(
   117	                select(ModelConfig).where(ModelConfig.kind == "chat").limit(1)
   118	            )
   119	        ).scalar_one_or_none()
   120	    if m is None:
   121	        check(False, "등록 chat 모델 없음 — 시드 확인")
   122	        return None
   123	    model_name = m.name
   124	
   125	    # 노드형: agent 층(temperature) + session 층(top_p)이 노드에 안 실려야.
   126	    node_cfg = {"impl": "pipeline", "model": model_name, "modelParams": {"temperature": 0.9}}
   127	    async with SessionLocal() as s:
   128	        default_cfg = await _resolve_model(s, node_cfg, None)
   129	        nodes = [
   130	            {"prompt": "with-model", "model": model_name},  # 자기 모델 노드(경로 A)
   131	            {"prompt": "no-model"},  # 모델 없는 노드 → default_cfg 폴백(경로 B)
   132	        ]
   133	        resolved = await _resolve_node_models(
   134	            s, nodes, default_cfg, agent_cfg=node_cfg, session_mp={"top_p": 0.5}
   135	        )
   136	    for r in resolved:
   137	        params = (r.get("model_cfg") or {}).get("params") or {}
   138	        tag = r.get("prompt")
   139	        check(params.get("temperature") != 0.9, f"[{tag}] 노드형: agent 층(temperature) 미적용 (got {params.get('temperature')})")
   140	        check(params.get("top_p") != 0.5, f"[{tag}] 노드형: session 층(top_p) 미적용 (got {params.get('top_p')})")
   141	
   142	    # 노드형 default_cfg(폴백 원천)도 agent 층 없어야(경로 B 봉인 확인).
   143	    check((default_cfg.get("params") or {}).get("temperature") != 0.9,
   144	          "노드형 default_cfg: agent 층 미적용(폴백 경로 봉인)")
   145	
   146	    # 비노드형: agent 층이 실려야(무회귀).
   147	    direct_cfg = {"impl": None, "model": model_name, "modelParams": {"temperature": 0.9}}
   148	    async with SessionLocal() as s:
   149	        mc = await _resolve_model(s, direct_cfg, None)
   150	    check((mc.get("params") or {}).get("temperature") == 0.9,
   151	          f"비노드형: agent 층(temperature) 적용됨(무회귀) (got {(mc.get('params') or {}).get('temperature')})")
   152	    return model_name
   153	
   154	
   155	async def main() -> None:
   156	    _p_policy()
   157	    _w_write_boundary()
   158	    model_name = await _r_resolution()
   159	    if model_name:
   160	        await _t_temperature_channel(model_name)
   161	    print()
   162	    if _fails:
   163	        print(f"FAILED: {len(_fails)}건")
   164	        for f in _fails:
   165	            print("  -", f)
   166	        sys.exit(1)
   167	    print(f"VERIFY420_OK — {passed}건 전부 통과")
   168	
   169	
   170	if __name__ == "__main__":
   171	    asyncio.run(main())

