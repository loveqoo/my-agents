+from pydantic import BaseModel, Field, field_validator, model_validator
 
 from agent.capabilities import clean_setting_params
 
@@ -29,6 +29,16 @@ class AgentConfig(BaseModel):
         """저장 경계에서 화이트리스트 설정 키의 bool만 보존(스펙 409 codex P2③) — 실행부만 거르던
         것을 저장까지 정직화(에코·버전 오염 차단). 노드·세션과 같은 공유 정리기."""
         return clean_setting_params(v)
+
+    @model_validator(mode="after")
+    def _strip_agent_params_for_pipeline(self) -> "AgentConfig":
+        """노드형(pipeline)은 agent 층 modelParams를 **가질 수 없다**(스펙 420) — 저장 경계에서 비워
+        illegal state를 표현 불가능하게(FE finalizeForm의 BE 짝, 417). 런타임 관문(_resolve_model·
+        _resolve_node_models)이 layer_applies로 이미 무시하지만, 데이터도 안 갖게 해 완결(런타임 정책과
+        저장 데이터가 갈리지 않게). 노드형은 모델 파라미터를 노드가 소유(nodes[].modelParams)."""
+        if self.impl == "pipeline" and self.modelParams:
