    68	    params: dict = field(default_factory=dict)  # temperature 등 런타임 파라미터
    69	    memories: list = field(default_factory=list)  # 회상된 기억(플랫폼이 이미 prompt에 합칠 수도)
    70	    overrides: dict | None = None  # 원본 오버라이드(에이전트가 추가 키를 읽고 싶을 때)
    71	    broker: Any = None  # 능력 브로커(스펙 100). 플랫폼이 **정책으로 미리 스코프**해 주입. None이면
    72	    # 발견 공집합(deny-by-default). 에이전트는 이 핸들만 보고 능력을 오케스트레이션한다(정책·DB 미접촉).
    73	    impl_config: dict | None = None  # 스펙 190 — 에이전트별 impl 설정(예: 노코드 산출물형의 필드
    74	    # 명세 config.artifactSpec). 코드 저작 에이전트는 대개 안 본다. 플랫폼이 config에서 뽑아 주입.
    75	    memory_recall: Any = (
    76	        None  # 캐싱 회상 프록시(스펙 268 P2) — async callable(query|None, node)→포맷
    77	    )
    78	    # 텍스트. 스코프는 플랫폼이 고정(브로커 주입 선례). None=회상 없음(비노드형·비영속 — 무회귀).
    79	    history_window: Any = (
    80	        None  # 단기 기억 창 프록시(스펙 270) — async callable(depth|None, node)→이전
    81	    )
    82	    # 대화 BaseMessage 리스트(depth별 슬라이스+캐시). memory_recall과 대칭 신규 축. None=창 없음
    83	    # (비노드형은 에이전트 _window가 이미 처리 — 무회귀). 노드형만 주입(대화를 누적서 분리해 노드별 슬라이스).
