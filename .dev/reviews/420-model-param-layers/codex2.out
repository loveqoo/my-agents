    79	async def _t_temperature_channel(model_name: str) -> None:
    80	    """P1② codex — temperature 병렬 통로 봉인: 노드형 에이전트(레거시 불법 저장 config, raw 시드로
    81	    validator 우회)의 ctx.temperature가 None이어야(agent·session 둘 다). 이게 run_params로 4입구+노드에
    82	    새던 실우회. 비노드형은 ctx.temperature 유지(무회귀)."""
    83	    print("== T temperature 병렬 통로(ctx.temperature, 실 로더) ==")
    84	    async with SessionLocal() as s:
    85	        # raw 시드 = AgentConfig validator 우회(레거시·API 직접 저장 재현) — 불법 modelParams가 DB에.
    86	        s.add(Agent(
    87	            agent_id=f"agt_{_TAG}_pipe", name=f"{_TAG}_pipe", source="ui", active_version="v1",
    88	            config={"impl": "pipeline", "model": model_name, "modelParams": {"temperature": 0.9},
    89	                    "nodes": [{"prompt": "n", "model": model_name}]},
    90	        ))
    91	        s.add(Agent(
    92	            agent_id=f"agt_{_TAG}_direct", name=f"{_TAG}_direct", source="ui", active_version="v1",
    93	            config={"impl": None, "model": model_name, "modelParams": {"temperature": 0.5}},
    94	        ))
    95	        await s.commit()
    96	        pipe = (await s.execute(select(Agent).where(Agent.agent_id == f"agt_{_TAG}_pipe"))).scalar_one()
    97	        direct = (await s.execute(select(Agent).where(Agent.agent_id == f"agt_{_TAG}_direct"))).scalar_one()
    98	        pipe_id, direct_id = pipe.id, direct.id
    99	    try:
   100	        ctx = await _load_context(pipe_id, None, {}, own=None)
   101	        check(ctx.temperature is None, f"노드형 ctx.temperature=None(agent 층 병렬통로 봉인) (got {ctx.temperature})")
   102	        ctx_s = await _load_context(pipe_id, None, {"modelParams": {"temperature": 0.01}}, own=None)
   103	        check(ctx_s.temperature is None, f"노드형 ctx.temperature=None(session 오버라이드도 봉인) (got {ctx_s.temperature})")
   104	        ctx_d = await _load_context(direct_id, None, {}, own=None)
   105	        check(ctx_d.temperature == 0.5, f"비노드형 ctx.temperature 유지(무회귀) (got {ctx_d.temperature})")
   106	    finally:
   107	        async with SessionLocal() as s:
   108	            await s.execute(delete(Agent).where(Agent.agent_id.like(f"agt_{_TAG}_%")))
   109	            await s.commit()
   112	async def _r_resolution() -> None:
   113	    print("== R 해석 관문(실 DB) ==")
   114	    async with SessionLocal() as s:
   115	        m = (
   116	            await s.execute(
   117	                select(ModelConfig).where(ModelConfig.kind == "chat").limit(1)
   118	            )
   119	        ).scalar_one_or_none()
   120	    if m is None:
   121	        check(False, "등록 chat 모델 없음 — 시드 확인")
   122	        return None
   123	    model_name = m.name
   124	
   125	    # 노드형: agent 층(temperature) + session 층(top_p)이 노드에 안 실려야.
   126	    node_cfg = {"impl": "pipeline", "model": model_name, "modelParams": {"temperature": 0.9}}
   127	    async with SessionLocal() as s:
   128	        default_cfg = await _resolve_model(s, node_cfg, None)
   129	        nodes = [
   130	            {"prompt": "with-model", "model": model_name},  # 자기 모델 노드(경로 A)
   131	            {"prompt": "no-model"},  # 모델 없는 노드 → default_cfg 폴백(경로 B)
   132	        ]
   133	        resolved = await _resolve_node_models(
   134	            s, nodes, default_cfg, agent_cfg=node_cfg, session_mp={"top_p": 0.5}
   135	        )
   136	    for r in resolved:
   137	        params = (r.get("model_cfg") or {}).get("params") or {}
   138	        tag = r.get("prompt")
   139	        check(params.get("temperature") != 0.9, f"[{tag}] 노드형: agent 층(temperature) 미적용 (got {params.get('temperature')})")
   140	        check(params.get("top_p") != 0.5, f"[{tag}] 노드형: session 층(top_p) 미적용 (got {params.get('top_p')})")
   141	
   142	    # 노드형 default_cfg(폴백 원천)도 agent 층 없어야(경로 B 봉인 확인).
   143	    check((default_cfg.get("params") or {}).get("temperature") != 0.9,
   144	          "노드형 default_cfg: agent 층 미적용(폴백 경로 봉인)")
   145	
   146	    # 비노드형: agent 층이 실려야(무회귀).
   147	    direct_cfg = {"impl": None, "model": model_name, "modelParams": {"temperature": 0.9}}
   148	    async with SessionLocal() as s:
   149	        mc = await _resolve_model(s, direct_cfg, None)
   150	    check((mc.get("params") or {}).get("temperature") == 0.9,
   151	          f"비노드형: agent 층(temperature) 적용됨(무회귀) (got {(mc.get('params') or {}).get('temperature')})")
   152	    return model_name
    18	def layer_applies(layer: str, impl: str | None) -> bool:
    19	    """이 캐스케이드 층이 주어진 에이전트 impl에서 유효(적용/편집 가능)한가.
    20	
    21	    layer: 'model-default' | 'agent' | 'node' | 'session'. 알 수 없는 층은 ValueError(오타 조기 발견).
    22	    """
    23	    is_pipeline = impl == _PIPELINE
    24	    if layer == "model-default":
    25	        return True
    26	    if layer == "node":
    27	        return is_pipeline
    28	    if layer in ("agent", "session"):
    29	        return not is_pipeline
    30	    raise ValueError(f"알 수 없는 모델 파라미터 층: {layer!r}")
   130	- docs/spec, .dev/retrospect, .dev/learning, plan, retrospective, repo operating rules
   131	
   132	## User preferences
   133	
   134	- when working in this repo, the user corrected: "User 스코프는 내가 허락할 때만 접근해. 이 프로젝트 내용으로 User 스코프를 더럽히지 말라구." -> do not write repo-specific content into User-scope memory without explicit permission; keep it in repo files or project notes instead [Task 1]
   135	- when tracking work, the user said: "항상 6가지 작업 중에 어떤 작업중인지 파악하고 있어야 해." -> keep the current 6-step loop stage explicit and current rather than guessed from stale context [Task 1]
   136	- when repo rules belong in docs, the user said: "CLAUDE.md에 추가 해줘." -> if they ask for a durable repo-wide rule, prefer the repo manual file over transient memory [Task 1]
   137	- when the user said: "다른 파일을 건드리지 말고 위 가이드 폴더만 건드리십시오." -> treat folder scope as a hard boundary, not a loose suggestion, even when using a separate worktree [Task 2]
   138	- when the user later said: "제가 승인하지 않은 곳을 수정하고 있나요?" -> stop immediately if validation or support work drifts beyond the approved folder [Task 2]
   139	- when the user said: "이미 vite 서버가 떠 있습니다." -> reuse existing infrastructure instead of launching duplicate services by default [Task 2]
   140	- when the user said: "지금까지 수정한 내용을 원복하십시오." -> on rollback requests, revert every artifact of the attempt, including temporary worktrees, branches, and environment state [Task 2]
   141	
   142	## Reusable knowledge
   143	
   144	- The repo uses a layered context model: User -> Project -> Folder, with lower scopes overriding higher ones; folder scope means a small subfolder `CLAUDE.md` or similar that only applies in that folder [Task 1]
   145	- Path-based project memory is keyed by absolute path, so repo renames can strand external memory; durable repo-specific guidance belongs inside the repo when it must survive path changes [Task 1]
   146	- Root `CLAUDE.md` is the project-wide place for workflow rules like mandatory stage labels, while `.dev/learning/` captures learned repo lessons and `.dev/retrospect/` is the AI-retrospective area; `docs/spec` is for product/spec work rather than retrospectives [Task 1][Task 3]
   147	- `admin/public/guide/` is the guide surface; it consists of `index.html`, `developer.html`, and nine referenced screenshots under `admin/public/guide/images/` [Task 2]
   148	- The current console UI now exposes `개요`, `에이전트`, `빌딩 블록`, `노드`, `RAG 컬렉션`, `세션`, `메모리`, `승인`, admin submenus, `Playground`, and `평가` [Task 2]
   149	- Current agent types surfaced in the console include direct response, orchestrate, artifact form, and pipeline/node-based flows [Task 2]
   150	- `AGENTS.md` is the actual root operations file in this repo; `AGENT.md` does not exist, so filename ambiguity should be resolved by listing files before editing [Task 2]
   151	- `git worktree remove --force <path>` and `git branch -D <branch>` were the clean rollback path for an isolated out-of-band worktree attempt [Task 2]
   152	
   153	## Failures and how to do differently
   154	
   155	- Symptom: project facts got written into User-scope memory. Cause: scope choice was treated as blanket authorization. Fix: treat User-scope access as a separate permission boundary and ask before writing any cross-project user memory [Task 1]
   156	- Symptom: the current 6-step label drifted and the user had to correct it twice. Cause: stale inference instead of explicit tracking. Fix: keep the stage label current in responses and update it when the work crosses a step boundary [Task 1]
   157	- Symptom: a folder-only doc refresh drifts into runtime/API/DB work. Cause: validation expanded beyond the approved surface while chasing screenshot/UI checks. Fix: keep validation read-only and inside the approved folder unless the user explicitly authorizes runtime side effects [Task 2]
