   303	    _enforce_ephemeral_boundary(
   304	        cfg
   305	    )  # DB 쓰기 능력 금지(스펙 237)  # 완화 정책 복제도 admin만(스펙 177 P2 D4)
   306	    clone = Agent(
   307	        agent_id=_new_agent_id(),
   308	        # 식별 이름은 규칙 준수+유니크로 자동 생성(스펙 217: 영소문자·숫자·대시만 — 접미는 영문 '-copy'),
   309	        # 사람용 표기는 설명에(스펙 148, 210). base 캡=접미 여유.
   310	        name=await _dedupe_agent_name(session, f"{src.name[:180]}-copy"),
   311	        description=f"{src.description or src.name} (복사본)"[:200],
   312	        source="ui",
   313	        model=cfg.get("model") or src.model,
   314	        prompt=await resolve_prompt(session, cfg.get("prompt") or ""),
   315	        history_depth=cfg.get("historyDepth") or src.history_depth,
   316	        config=cfg,
   317	        exposed={"a2a": False},
   318	        status="idle",
   319	        active_version=None,
   320	        owner_id=owner_of(principal),  # 복제자가 소유(스펙 112·069 — 원본 소유자 승계 안 함)
   321	    )
   322	    clone.versions.append(
   323	        AgentVersion(
   324	            version="v1",
   325	            ever_opened=False,
   326	            pins=await freeze_pins(session, cfg),
   327	            note=f"복제: {src.name}",
   328	            config=cfg,
   329	        )
   330	    )
   331	    session.add(clone)
   332	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   333	    return await _reload_out(session, clone.id)
   336	def _preserve_impl(body: AgentUpdate, agent: Agent, draft: AgentVersion | None, cfg: dict) -> None:
   337	    """요청에 impl 미명시면 편집 베이스(초안→활성 config)의 impl을 cfg에 이어받는다.
   338	
   339	    impl(스펙 085 SDK 런타임 키)은 편집 폼이 아직 안 보내므로(SPA 미배선), 요청에 명시되지
   340	    않으면 기존 값을 보존한다 — 안 그러면 Pydantic 기본 None이 덮어써 편집→활성화가 커스텀
   341	    에이전트를 DefaultUiAgent로 silent 되돌린다(codex 적대 리뷰 F1). 명시적으로 보내면(클리어 포함)
   342	    그 값 존중."""
   343	    if "impl" not in body.config.model_fields_set:
   344	        base = (draft.config if draft is not None else None) or dict(agent.config or {})
   345	        cfg["impl"] = base.get("impl")  # draft=미오픈 스크래치(스펙 370 — 이름만 승계)
   346	
   347	
   348	def _strip_pipeline_model_params(cfg: dict) -> None:
   349	    """노드형(pipeline)이면 agent 층 modelParams를 비운다(스펙 420 — illegal state 표현 불가).
   350	
   351	    AgentConfig validator는 **파싱 시점 impl**로 판정하는데, update는 `_preserve_impl`이 impl을
   352	    나중에 복원해 순서가 역전된다(impl 생략 PUT → 파싱 땐 None → strip 안 됨 → 복원 → 불법 저장,
   353	    codex 420 P1①). 그래서 **최종 impl이 확정된 뒤** 라우트에서 한 번 더 강제한다(관문=cfg 확정점)."""
   354	    if cfg.get("impl") == "pipeline" and cfg.get("modelParams"):
   355	        cfg["modelParams"] = {}
   356	
