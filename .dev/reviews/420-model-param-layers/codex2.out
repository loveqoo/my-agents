   283	# ----------------------------- 복제 (저마찰 재사용, 스펙 120) -----------------------------
   284	@router.post("/{agent_id}/clone", response_model=AgentOut, status_code=201)
   285	async def clone_agent(
   286	    agent_id: uuid.UUID,
   287	    session: AsyncSession = Depends(get_session),
   288	    principal: User | str = Depends(current_principal),
   289	) -> AgentOut:
   290	    """기존 에이전트 설정을 새 **ui 초안**으로 복사(행위 재사용 — '이거랑 비슷한 거 하나 더'). 복제는
   291	    **읽기+새 생성**이라 원본 *관리 권한 불요*(가시하면 복제 가능 — 사용≠관리, 스펙 112). 소유권은
   292	    **복제자**에게 스탬프(원본 소유자 승계 금지 — 069 no-takeover). 미존재/미가시 원본은 404-fold."""
   293	    src = await _load_agent(session, agent_id)
   294	    if src is None or not may_use_agent(src, principal):
   295	        # codex High#2 — 타인 private를 복제하면 설정(프롬프트·능력)이 내 소유로 유출되고
   296	        # 복제본 채팅으로 사용 게이트가 무력화된다. "가시하면 복제"의 가시=may_use(147 이후).
   297	        raise HTTPException(status_code=404, detail="agent not found")
   298	    cfg = dict(src.config or {})
   299	    cfg.pop(
   300	        "card", None
   301	    )  # 외부 등록 스냅샷은 복사 안 함(ui 복제=행위 설정만; endpoint/token은 Agent 컬럼이라 애초 미복사)
   302	    _enforce_tool_policy_gate(cfg, principal)
   303	    _enforce_ephemeral_boundary(
   304	        cfg
   305	    )  # DB 쓰기 능력 금지(스펙 237)  # 완화 정책 복제도 admin만(스펙 177 P2 D4)
   306	    clone = Agent(
   307	        agent_id=_new_agent_id(),
   308	        # 식별 이름은 규칙 준수+유니크로 자동 생성(스펙 217: 영소문자·숫자·대시만 — 접미는 영문 '-copy'),
   309	        # 사람용 표기는 설명에(스펙 148, 210). base 캡=접미 여유.
   310	        name=await _dedupe_agent_name(session, f"{src.name[:180]}-copy"),
   311	        description=f"{src.description or src.name} (복사본)"[:200],
   312	        source="ui",
   313	        model=cfg.get("model") or src.model,
   314	        prompt=await resolve_prompt(session, cfg.get("prompt") or ""),
   315	        history_depth=cfg.get("historyDepth") or src.history_depth,
   316	        config=cfg,
   317	        exposed={"a2a": False},
   318	        status="idle",
   319	        active_version=None,
   320	        owner_id=owner_of(principal),  # 복제자가 소유(스펙 112·069 — 원본 소유자 승계 안 함)
   321	    )
   322	    clone.versions.append(
   323	        AgentVersion(
   324	            version="v1",
   325	            ever_opened=False,
   326	            pins=await freeze_pins(session, cfg),
   327	            note=f"복제: {src.name}",
   328	            config=cfg,
   329	        )
   330	    )
   331	    session.add(clone)
   332	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   333	    return await _reload_out(session, clone.id)
