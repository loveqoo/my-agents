    27	def _resolve_wire_params(
    28	    caps: dict, params: dict, cfg_params: dict, default_temperature: float
    29	) -> tuple[dict, dict, bool]:
    30	    """PARAMS 서술자(스펙 411)로 유효값을 해석·wire 배선 → (top_kwargs, extra_body, disable_streaming).
    31	
    32	    build_chat_openai에서 추출(스펙 416 — CC 분해). 층 우선순위=호출자 params(세션) > cfg_params
    33	    (모델·에이전트·노드 병합). bool=능력 AND 설정(게이트), number=범위 클램프. wire별 배선이 유일한
    34	    축별 코드: top=ChatOpenAI 직접 kwargs, extra_body=비표준, disable_streaming.
    35	    """
    36	    top_kwargs: dict = {}
    37	    chat_template_kwargs: dict = {}
    38	    extra_body: dict = {}
    39	    disable_streaming = False
    40	    for p in PARAMS:
    41	        if p.kind == "bool":
    42	            eff = resolve_effective(p.key, caps, params, cfg_params)
    43	            if p.wire == "disable_streaming":
    44	                disable_streaming = not eff
    45	            elif p.wire == "extra_body":
    46	                chat_template_kwargs[p.key] = eff
    47	            continue
    48	        # number
    49	        if p.key == "temperature":
    50	            # temperature는 미명시 시 caller default_temperature 존중(기존 계약 — 스펙 077 흡수).
    51	            num = resolve_number("temperature", params, cfg_params)
    52	            explicit = any(
    53	                isinstance(lay.get("temperature"), (int, float))
    54	                and not isinstance(lay.get("temperature"), bool)
    55	                for lay in (params, cfg_params)
    56	            )
    57	            num = num if explicit else default_temperature
    58	        else:
    59	            num = resolve_number(p.key, params, cfg_params)
    60	        if p.key == "max_tokens" and (num is None or num <= 0):
    61	            continue  # 0/미설정=서버 기본(안 보냄)
    62	        if num is None:
    63	            continue
    64	        if p.wire == "top":
    65	            top_kwargs[p.key] = num
    66	        elif p.wire == "extra_body":
    67	            extra_body[p.key] = num
    68	    if chat_template_kwargs:
    69	        extra_body["chat_template_kwargs"] = chat_template_kwargs
    70	    return top_kwargs, extra_body, disable_streaming
    71	
    72	
    73	def _pool_key(
    74	    loop_id: int | None,
    75	    base_url: str,
    76	    api_key: str,
    77	    model_id: str,
    78	    top_kwargs: dict,
    79	    extra_body: dict,
    80	    disable_streaming: bool,
    81	) -> tuple:
    82	    """클라이언트 풀 키(스펙 371 D2) — 해석된 모든 파라미터 반영(스펙 411, 값 다르면 다른 클라이언트).
    83	    api_key는 지문으로만(평문 저장 금지). loop_id 포함 — httpx async 클라는 자기 이벤트 루프에 묶인다."""
    84	    return (
    85	        loop_id,
    86	        base_url,
    87	        hashlib.sha256(api_key.encode()).hexdigest()[:8],
    88	        model_id,
    89	        json.dumps(top_kwargs, sort_keys=True),
    90	        json.dumps(extra_body, sort_keys=True),
    91	        disable_streaming,
    92	    )
    93	
    94	
    95	def _pool_remember(key: tuple, client: ChatOpenAI) -> None:
    96	    """LRU 저장(삽입순 최고령 축출, 상한 _CLIENT_POOL_MAX). loop_id None(동기)은 호출부가 미저장."""
    97	    if len(_CLIENT_POOL) >= _CLIENT_POOL_MAX:
    98	        _CLIENT_POOL.pop(next(iter(_CLIENT_POOL)))
    99	    _CLIENT_POOL[key] = client
   100	
   101	
   102	# on_missing="raise"(기본)면 None 불가 → 호출부가 model을 바로 쓴다. "none"이면 None 가능(artifact).
   103	@overload
   104	def build_chat_openai(
   105	    cfg: dict | None,
   106	    params: dict | None = ...,
   107	    *,
   108	    default_temperature: float = ...,
   109	    on_missing: Literal["raise"] = ...,
   110	    error_label: str = ...,
   111	) -> ChatOpenAI: ...
   112	@overload
   113	def build_chat_openai(
   114	    cfg: dict | None,
   115	    params: dict | None = ...,
   116	    *,
   117	    default_temperature: float = ...,
   118	    on_missing: Literal["none"],
   119	    error_label: str = ...,
   120	) -> ChatOpenAI | None: ...
   121	def build_chat_openai(
   122	    cfg: dict | None,
   123	    params: dict | None = None,
   124	    *,
   125	    default_temperature: float = 0.7,
   126	    on_missing: str = "raise",
   127	    error_label: str = _MISSING_MSG,
   128	) -> ChatOpenAI | None:
   129	    """model_cfg → ChatOpenAI. base_url/model_id 없으면 `on_missing`: "raise"(기본)면 명확히 실패,
   130	    "none"이면 None 반환(모델 없이도 도는 경로용 — artifact ask-only). temperature 우선순위:
   131	    호출자 params > 모델 등록 params > `default_temperature`."""
   132	    cfg = cfg or {}
   133	    base_url = cfg.get("base_url") or ""
   134	    model_id = cfg.get("model_id") or ""
   135	    if not base_url or not model_id:
   136	        if on_missing == "none":
   137	            return None
   138	        raise RuntimeError(error_label)
   139	    # 파라미터 유효값 해석·wire 배선(스펙 411 — temperature·top_p·max_tokens·repetition_penalty·
   140	    # stream·enable_thinking 단일 메커니즘). 상세 규칙은 _resolve_wire_params(스펙 416 추출).
   141	    top_kwargs, extra_body, disable_streaming = _resolve_wire_params(
   142	        cfg.get("capabilities") or {}, params or {}, cfg.get("params") or {}, default_temperature
   143	    )
   144	    api_key = cfg.get("api_key") or "sk-noauth"
   145	    # 클라이언트 풀(스펙 371 D2) — 같은 연결·모델·파라미터면 인스턴스 재사용(ChatOpenAI는 호출간
   146	    # 무상태·async-safe). 목적은 생성 비용(~0.1ms)이 아니라 **커넥션 재사용**(실 프로바이더 TLS
   147	    # 핸드셰이크 — mock 루프백 사각지대). 루프별 격리 — httpx async 클라는 자기 이벤트 루프에 묶인다.
   148	    # 서버는 루프 하나라 늘 적중, asyncio.run 반복(in-proc 테스트)은 루프마다 새 인스턴스(죽은 루프
   149	    # 엔트리는 LRU 축출). 루프 밖(동기)이면 풀 미사용.
   150	    try:
   151	        loop_id = id(asyncio.get_running_loop())
   152	    except RuntimeError:
   153	        loop_id = None
   154	    key = _pool_key(loop_id, base_url, api_key, model_id, top_kwargs, extra_body, disable_streaming)
   155	    if loop_id is not None and (pooled := _CLIENT_POOL.get(key)) is not None:
   156	        return pooled
   157	    # ReasoningChatOpenAI(스펙 410): base가 버리는 reasoning_content를 additional_kwargs로 되살린다
   158	    # (사고 없는 모델·응답엔 무영향 — 항상 써도 안전). 사고 과정 표시(410 P2/P3)가 이를 소비.
   159	    # top_kwargs=temperature/top_p/max_tokens(표준 인자), extra_body=enable_thinking/repetition_penalty(비표준).
   160	    client = ReasoningChatOpenAI(
   161	        base_url=base_url,
   162	        api_key=api_key,
   163	        model=model_id,
   164	        # 능력 없음/사용 끔 → astream이 ainvoke로 접혀 완성문 1회 yield(비스트리밍 안전 실행).
   165	        disable_streaming=disable_streaming,
   166	        extra_body=extra_body,
   167	        **top_kwargs,
   168	    )
   169	    if loop_id is not None:
   170	        _pool_remember(key, client)
