   215	async def _resolve_mem_cfg(db: AsyncSession, model_cfg: dict | None) -> dict | None:
   216	    """mem0용 모델 설정(레지스트리) — llm=해석된 chat 모델, embedder=기본 embedding 모델.
   217	
   218	    임베딩 모델이 없으면 None → 메모리 비활성(graceful)."""
   219	    if not model_cfg:
   220	        return None
   221	    emb = (
   222	        (
   223	            await db.execute(
   224	                select(ModelConfig)
   225	                .where(ModelConfig.kind == "embedding", ModelConfig.is_default.is_(True))
   226	                .options(selectinload(ModelConfig.provider))
   227	            )
   228	        )
   229	        .scalars()
   230	        .first()
   231	    )
   232	    if emb is None or emb.provider is None:
   233	        return None
   234	    return {
   235	        "llm": {
   236	            "base_url": model_cfg["base_url"],
   237	            "api_key": model_cfg["api_key"],
   238	            "model_id": model_cfg["model_id"],
   239	        },
   240	        "embedder": llm_cfg_of(emb),
   241	    }
   242	
