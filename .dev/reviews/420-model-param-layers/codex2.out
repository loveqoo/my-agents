    65	class _MemoryRecallProxy:
    66	    """노드별 회상 프록시(스펙 268 P2, 사용자 설계) — 노드형 노드가 **각자** 회상을 조회하고, 여기서
    67	    **키워드로 캐싱**한다(같은 키워드=캐시 반환 → 비용 자연 수렴 1회, 다른 키워드=개별 조회). 이로써
    68	    "1회 조회→노드 매핑"과 "노드별 키워드 조회"가 한 메커니즘으로 통일된다.
    69	
    70	    - 수명 = **한 턴**(요청) — 턴을 넘겨 캐시하면 새 기억이 안 보이므로 금지.
    71	    - 스코프는 플랫폼이 생성 시 **고정**(RBAC — 노드가 남의 기억을 못 봄, 브로커 주입 선례).
    72	    - 조회마다 (node, query, hits, cached)를 기록(스펙 082 — 조회 행위 계측) → trace["memoryRecalls"].
    73	    - 반환은 **포맷된 텍스트**(format_memory_hits) — 엔진(agent 패키지)이 api 모듈에 비의존."""
    74	
    75	    def __init__(
    76	        self, scope: dict, mem_cfg: dict | None, default_query: str, records: list[dict]
    77	    ) -> None:
    78	        self._scope = dict(scope)
    79	        self._cfg = mem_cfg
    80	        self._default = default_query or ""
    81	        self._cache: dict[str, tuple[str, list[dict]]] = {}  # query → (포맷 텍스트, 회상 히트)
    82	        self.records = records
    83	
    84	    async def __call__(self, query: str | None = None, node: str = "") -> str:
    85	        q = (query if isinstance(query, str) and query.strip() else self._default).strip()[:300]
    86	        # 메모리 축 정화(스펙 407) — memoryQuery=input 모드는 노드가 받은 메시지(첨부 주입본 포함)를
    87	        # 그대로 넘긴다. 회상 관문에서 펜스를 걷어 원발화만 검색(문서는 지식 축이지 기억 축이 아님).
    88	        from .chat_attachments import strip_attachment_blocks
    89	
    90	        q = strip_attachment_blocks(q)[:300]
    91	        if not q:
    92	            return ""
    93	        cached = q in self._cache
    94	        if not cached:
    95	            hits = await asyncio.to_thread(memory.search, self._scope, q, self._cfg)
    96	            self._cache[q] = (memory.format_memory_hits(hits) if hits else "", hits)
    97	        text, hits = self._cache[q]
    98	        # 기록 쿼리는 비밀 마스킹(codex 268 P3 — 타 트레이스 표면과 정합): input 모드 키워드는 앞 노드
    99	        # 출력이라 비밀이 섞일 수 있음(_sanitize가 sk-… 등 마스킹, 캡 120).
   100	        self.records.append(
   101	            {
   102	                "node": node,
   103	                "query": memory._sanitize(q, cap=120),
   104	                "hits": len(hits),
   105	                "cached": cached,
   106	                # 회상 내용(스펙 359) — 표준 retrieve_memory 경로(t.memories)와 같은
   107	                # {text, score, scope} 리스트로 실어 인스펙터가 MemoryRow로 렌더한다. 내용 마스킹은
   108	                # 표준 경로와 파리티(자기 스코프 저장 기억, 이미 무마스킹 노출 — 새 노출 아님).
   109	                "memories": hits,
   110	            }
   111	        )
   112	        return text
   113	
