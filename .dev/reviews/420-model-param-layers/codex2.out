   335	
   336	def _preserve_impl(body: AgentUpdate, agent: Agent, draft: AgentVersion | None, cfg: dict) -> None:
   337	    """요청에 impl 미명시면 편집 베이스(초안→활성 config)의 impl을 cfg에 이어받는다.
   338	
   339	    impl(스펙 085 SDK 런타임 키)은 편집 폼이 아직 안 보내므로(SPA 미배선), 요청에 명시되지
   340	    않으면 기존 값을 보존한다 — 안 그러면 Pydantic 기본 None이 덮어써 편집→활성화가 커스텀
   341	    에이전트를 DefaultUiAgent로 silent 되돌린다(codex 적대 리뷰 F1). 명시적으로 보내면(클리어 포함)
   342	    그 값 존중."""
   343	    if "impl" not in body.config.model_fields_set:
   344	        base = (draft.config if draft is not None else None) or dict(agent.config or {})
   345	        cfg["impl"] = base.get("impl")  # draft=미오픈 스크래치(스펙 370 — 이름만 승계)
   346	
   347	
   348	def _strip_pipeline_model_params(cfg: dict) -> None:
   349	    """노드형(pipeline)이면 agent 층 modelParams를 비운다(스펙 420 — illegal state 표현 불가).
   350	
   351	    AgentConfig validator는 **파싱 시점 impl**로 판정하는데, update는 `_preserve_impl`이 impl을
   352	    나중에 복원해 순서가 역전된다(impl 생략 PUT → 파싱 땐 None → strip 안 됨 → 복원 → 불법 저장,
   353	    codex 420 P1①). 그래서 **최종 impl이 확정된 뒤** 라우트에서 한 번 더 강제한다(관문=cfg 확정점)."""
   354	    if cfg.get("impl") == "pipeline" and cfg.get("modelParams"):
   355	        cfg["modelParams"] = {}
   356	
   357	
   358	# ----------------------------- 편집 = 초안 저장 -----------------------------
   359	@router.put("/{agent_id}", response_model=AgentOut)
   360	async def update_agent(
   361	    agent_id: uuid.UUID,
   362	    body: AgentUpdate,
   363	    session: AsyncSession = Depends(get_session),
   364	    principal: User | str = Depends(current_principal),
   365	) -> AgentOut:
   366	    agent = await _load_agent(session, agent_id)
   367	    if agent is None:
   368	        raise HTTPException(status_code=404, detail="agent not found")
   369	    assert_may_manage(
   370	        agent, principal, not_found_detail="agent not found"
   371	    )  # 소유자/특권만(스펙 112)
   372	
   373	    cfg = body.config.model_dump()
   374	    _enforce_tool_policy_gate(cfg, principal)
   375	    _enforce_ephemeral_boundary(
   376	        cfg
   377	    )  # DB 쓰기 능력 금지(스펙 237)  # 완화는 admin만(스펙 177 P2 D4)
   378	    draft = next((v for v in agent.versions if not v.ever_opened), None)  # 스크래치(스펙 370)
   379	    _preserve_impl(body, agent, draft, cfg)
   380	    _strip_pipeline_model_params(cfg)  # 최종 impl 확정 후 노드형 modelParams 강제 비움(스펙 420 P1①)
   381	    # 노드 참조 존재 검증(스펙 316, codex P1) — impl 무관 + 이름 잠금(삭제 가드와 직렬화).
   382	    await assert_node_refs_exist(session, cfg.get("nodes"))
   383	    # 기억 이름 존재 검증(스펙 387) — 노드 참조와 같은 규칙(dangling name의 조용한 무동작 차단).
   384	    await assert_memory_names_exist(session, cfg)
   385	    # 노드형 풀=노드 합집합 서버 파생(스펙 289 P2) — impl 보존 **뒤**에 호출(미명시 impl이 pipeline로
   386	    # 확정된 뒤라야 파생 게이트가 맞는다).
   387	    await derive_pipeline_pool(cfg)
   388	    # 충돌 규칙(스펙 370): 스크래치 유일 — 있으면 그 행을 새 번호·새 pins로 대체, 없으면 신설.
   389	    # 번호 = 오픈+1(오픈이력 슬롯이면 최대 오픈+1 — 오픈됐던 버전은 불변 보호).
   390	    scratch, target_ver = scratch_target(agent)
   391	    pins = await freeze_pins(session, cfg)  # 편집 시점 재freeze(스펙 370)
   392	    if scratch is not None:
   393	        scratch.version = target_ver
   394	        scratch.config = cfg
   395	        scratch.pins = pins
   396	        scratch.note = f"Edited {_today()}"
   397	    else:
   398	        agent.versions.append(
   399	            AgentVersion(
   400	                version=target_ver,
   401	                ever_opened=False,
   402	                pins=pins,
   403	                note=f"{agent.active_version or 'v0'}에서 편집",
   404	                config=cfg,
   405	            )
   406	        )
   407	    if body.name is not None and body.name != agent.name:
   408	        assert_valid_name(body.name)  # 식별 이름 변경도 규칙(스펙 148)
   409	        agent.name = body.name
   410	    if body.description is not None:
   411	        agent.description = body.description.strip() or None  # ""=설명 비우기
   412	    # 서빙 config/active_version 은 건드리지 않음.
   413	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   414	    return await _reload_out(session, agent.id)
   415	
   416	
   417	@router.delete("/{agent_id}", status_code=204)
   418	async def delete_agent(
   419	    agent_id: uuid.UUID,
   420	    session: AsyncSession = Depends(get_session),
   421	    principal: User | str = Depends(current_principal),
   422	) -> None:
   423	    agent = await get_or_404(session, Agent, agent_id, detail="agent not found")
   424	    assert_may_manage(
   425	        agent, principal, not_found_detail="agent not found"
   426	    )  # 소유자/특권만(스펙 112)
   427	    await session.delete(agent)
   428	    await session.commit()

