   134	# ----------------------------- 채택 (pins 재freeze — promptStale 후계) -----------------------------
   135	@router.post("/{agent_id}/adopt", response_model=AgentOut)
   136	async def adopt_block_versions(
   137	    agent_id: uuid.UUID,
   138	    session: AsyncSession = Depends(get_session),
   139	    principal: User | str = Depends(current_principal),
   140	) -> AgentOut:
   141	    """블록 새 버전 채택(스펙 370 §4) — 오픈 버전 config 그대로, pins만 현재 head로 재freeze한
   142	    스크래치를 만든다(충돌 규칙 공유). 오픈은 별도 명시 동작 — 채택이 서빙을 바꾸지 않는다."""
   143	    agent = await _load_agent(session, agent_id)
   144	    if agent is None:
   145	        raise HTTPException(status_code=404, detail="agent not found")
   146	    assert_may_manage(agent, principal, not_found_detail="agent not found")
   147	    base = _find_version(agent, agent.active_version) if agent.active_version else None
   148	    cfg = dict((base.config if base is not None else agent.config) or {})
   149	    scratch, target_ver = scratch_target(agent)
   150	    pins = await freeze_pins(session, cfg)
   151	    if scratch is not None:
   152	        scratch.version = target_ver
   153	        scratch.config = cfg
   154	        scratch.pins = pins
   155	        scratch.note = f"블록 새 버전 채택 {_today()}"
   156	    else:
   157	        agent.versions.append(
   158	            AgentVersion(
   159	                version=target_ver,
   160	                ever_opened=False,
   161	                pins=pins,
   162	                note=f"블록 새 버전 채택 {_today()}",
   163	                config=cfg,
   164	            )
   165	        )
   166	    await session.commit()
   167	    return await _reload_out(session, agent.id)
   110	    정직 보고. in-place 스냅샷 갱신(구 161)은 불변 버전 모델과 비정합이라 스크래치 채택(스펙 370) —
   111	    반영은 각 에이전트에서 오픈해야 서빙된다(명시적)."""
   112	
   113	    session: AsyncSession
   114	    principal: User | str
   115	    prompt: Prompt
   116	    want: set[uuid.UUID]
   117	    applied: list[uuid.UUID] = field(default_factory=list)
   118	    skipped: list[uuid.UUID] = field(default_factory=list)
   119	
   120	    def _is_eligible(self, agent: Agent) -> bool:
   121	        return (
   122	            is_first_party(agent.source)
   123	            and _config_has(agent.config, "prompt", self.prompt.name)
   124	            and may_manage(agent.owner_id, self.principal)
   125	        )
   126	
   127	    async def _adopt(self, agent: Agent) -> None:
   128	        """채택 스크래치 생성/갱신 — 활성 버전 config 기반, 참조 핀 동결(freeze_pins)."""
   129	        from .agents.helpers import _today, scratch_target
   130	        from .block_versions import freeze_pins
   131	        from .models import AgentVersion
   132	
   133	        loaded = (
   134	            await self.session.execute(
   135	                select(Agent).where(Agent.id == agent.id).options(selectinload(Agent.versions))
   136	            )
   137	        ).scalar_one()
   138	        scratch, target_ver = scratch_target(loaded)
   139	        base = next((v for v in loaded.versions if v.version == loaded.active_version), None)
   140	        cfg = dict((base.config if base is not None else loaded.config) or {})
   141	        pins = await freeze_pins(self.session, cfg)
   142	        note = f"프롬프트 새 버전 채택 {_today()}"
   143	        if scratch is not None:
   144	            scratch.version = target_ver
   145	            scratch.config = cfg
   146	            scratch.pins = pins
   147	            scratch.note = note
   148	        else:
   149	            loaded.versions.append(
   150	                AgentVersion(
   151	                    version=target_ver, ever_opened=False, pins=pins, note=note, config=cfg
   152	                )
   153	            )
   154	
   155	    async def run(self) -> PromptApplyOut:
   156	        agents = (
   157	            (await self.session.execute(select(Agent).where(Agent.id.in_(self.want))))
   158	            .scalars()
   159	            .all()
   160	        )
   161	        for agent in agents:
   162	            if self._is_eligible(agent):
   163	                await self._adopt(agent)
   164	                self.applied.append(agent.id)
   165	            else:
   166	                self.skipped.append(agent.id)
   167	        found = {a.id for a in agents}
   168	        self.skipped.extend(aid for aid in self.want if aid not in found)  # 미존재도 skip 정직 보고
   169	        if self.applied:
   170	            await self.session.commit()
   171	        return PromptApplyOut(applied=self.applied, skipped=self.skipped)
   172	
