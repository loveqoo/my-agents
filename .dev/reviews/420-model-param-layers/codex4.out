   137	    @staticmethod
   138	    def _apply_node_scalar_fields(n: dict[str, Any], node: dict[str, Any]) -> None:
   139	        """선택 스칼라 필드(name/model 길이 캡, 화이트리스트 enum, historyDepth 캡)를 node에 채운다."""
   140	        for key in ("name", "model"):  # 문자열 필드(선택) — 길이 캡
   141	            val = n.get(key)
   142	            if isinstance(val, str) and val.strip():
   143	                if len(val) > 200:
   144	                    raise ValueError(f"nodes 항목 {key}은 200자 이하여야 합니다.")
   145	                node[key] = val
   146	        ctx_mode = n.get("context")  # 맥락 모드(스펙 260) — 화이트리스트 값만
   147	        if ctx_mode in ("carry", "clean"):
   148	            node["context"] = ctx_mode
   149	        fmt = n.get("format")  # 출력 형식(스펙 261) — 화이트리스트 값만
   150	        if fmt in ("text", "json"):
   151	            node["format"] = fmt
   152	        mem_q = n.get("memoryQuery")  # 회상 키워드 모드(스펙 268 P2) — 화이트리스트 값만
   153	        if mem_q in ("user", "input"):
   154	            node["memoryQuery"] = mem_q
   155	        hd = n.get("historyDepth")  # 노드별 단기 기억 창(스펙 270) — 미지정=에이전트 상속.
   156	        if isinstance(hd, int) and not isinstance(hd, bool):  # bool은 int 하위형 — 배제
   157	            if hd > 1000:
   158	                raise ValueError("nodes 항목 historyDepth는 1000 이하여야 합니다.")
   159	            node["historyDepth"] = hd  # 음수·0 허용(음수/전체·0=대화 없음)
   160	
   161	    @staticmethod
