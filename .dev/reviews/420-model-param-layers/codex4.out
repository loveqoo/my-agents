    77	def _cfg_from_manifest(card: dict, ext: dict, card_url: str | None) -> dict:
    78	    """ext["manifest"] → 저장 config dict(카드 스냅샷·cardUrl 포함, 잡 타입은 기본값으로 안전화)."""
    79	    manifest = ext["manifest"]
    80	    history_depth = manifest.get("historyDepth")
    81	    if not isinstance(history_depth, int):
    82	        history_depth = 10
    83	    return {
    84	        "model": manifest.get("model") or "",
    85	        "prompt": manifest.get("prompt") or "",
    86	        "memories": manifest.get("memories") if isinstance(manifest.get("memories"), list) else [],
    87	        "vectorTables": [],
    88	        "mcps": manifest.get("mcps") if isinstance(manifest.get("mcps"), list) else [],
    89	        "historyDepth": history_depth,
    90	        "card": card,  # 카드 스냅샷 — external과 동일하게 표시·검증 단일 소스
    91	        "cardUrl": card_url,  # 카드 출처 — resync 재해석용(스펙 081)
    92	    }
