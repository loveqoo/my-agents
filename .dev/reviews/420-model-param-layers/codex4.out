    94	
    95	def _rows_from_card_versions(
    96	    raw_versions: object, cfg: dict
    97	) -> tuple[list[AgentVersion], str | None]:
    98	    """카드 신고 versions → (AgentVersion 행 목록, 첫 active 버전 id). 잡값(비-dict·버전 없음)은 건너뜀."""
    99	    versions: list[AgentVersion] = []
   100	    active_version_id: str | None = None
   101	    if isinstance(raw_versions, list):
   102	        for raw_version in raw_versions:
   103	            if not isinstance(raw_version, dict):
   104	                continue
   105	            vid = _clip(raw_version.get("version"), 40)
   106	            if vid is None:
   107	                continue
   108	            vstatus = _clip(raw_version.get("status"), 20) or "archived"
   109	            if vstatus == "active" and active_version_id is None:
   110	                active_version_id = vid  # 카드 status는 포인터 해석에만 소비(스펙 370)
   111	            versions.append(
   112	                AgentVersion(
   113	                    version=vid,
   114	                    ever_opened=True,  # 원격 배포 이력 — 전부 불변 보호(스펙 370)
   115	                    note=raw_version.get("note")
   116	                    if isinstance(raw_version.get("note"), str)
   117	                    else "",
   118	                    config=cfg,
   119	                )
   120	            )
   121	    return versions, active_version_id
   122	
   123	
   124	def _versions_from_deploy(deploy: dict, cfg: dict) -> tuple[list[AgentVersion], str | None]:
   125	    """deploy.versions → (AgentVersion 목록, active 버전 id).
   126	
   127	    active_version 불변식(적대리뷰 057 Finding 4): active_version은 항상 실재하는 active
   128	    AgentVersion을 가리키거나 None. deploy.versions 잡값(빈 리스트·archived만·잡 버전)이 와도 active
   129	    row 없이 active_version만 세팅되는 불일치를 만들지 않는다."""
   130	    versions, active_version_id = _rows_from_card_versions(deploy.get("versions"), cfg)
   131	    commit = _clip(deploy.get("commit"), 80)
   132	    if active_version_id is None and commit:
   133	        # 카드에 active 버전이 없으면 commit으로 active 1개 합성(external register와 일관). 합성한 뒤에만
   134	        # active_version을 세팅 — 실재하는 row를 보장한다.
   135	        synth = _clip(commit, 40)
   136	        versions.append(
   137	            AgentVersion(version=synth, ever_opened=True, note="Deploy · 카드 동기화", config=cfg)
   138	        )
   139	        active_version_id = synth
   140	    return versions, active_version_id
   141	
   142	
   143	def _build_code_agent_from_card(
   144	    card: dict, ext: dict, token: str | None, live: bool, card_url: str | None = None
   145	) -> Agent:
   146	    """제1자(SDK 배포) A2A 카드 + my-agents 확장 → code Agent (스펙 057).
   147	
   148	    config는 ext["manifest"](model/prompt/mcps/…)에서 채우고 카드 스냅샷을 함께 보존한다.
   149	    repo/commit/runtime·AgentVersion은 ext["deploy"]에서 만든다. **전부 카드에서 fetch — 프론트
   150	    날조 없음**. A2A 호출엔 카드 url+token만 쓰지만(현 external과 동일), 저장 config는 1급 표시·resync용.
   151	    """
   152	    deploy = ext["deploy"]
   153	    cfg = _cfg_from_manifest(card, ext, card_url)
   154	    # 길이 하드닝(적대리뷰 057 Finding 3) — bounded 컬럼에 잡/거대 문자열이 들어가 commit이 500나지 않게.
   155	    commit = _clip(deploy.get("commit"), 80)
   156	    agent = Agent(
   157	        agent_id=_new_agent_id(),
   158	        name=_clip(card.get("name"), 200) or _clip(deploy.get("repo"), 200) or "SDK 에이전트",
   159	        source="code",
   160	        model=_clip(cfg["model"], 120) or "",
   161	        prompt=cfg["prompt"],  # Text 컬럼 — 무제한
   162	        history_depth=cfg["historyDepth"],
   163	        config=cfg,
   164	        exposed={"a2a": False},
   165	        status="online" if live else "offline",
   166	        endpoint=_norm_endpoint(card.get("url")),
   167	        token=crypto.encrypt(token) if token else None,
   168	        runtime=_clip(deploy.get("runtime"), 200),
   169	        repo=_clip(deploy.get("repo"), 200),
   170	        commit=commit,
   171	        registered_at=_today(),
   172	        last_sync="방금",
   173	    )
   174	    versions, active_version_id = _versions_from_deploy(deploy, cfg)
   175	    agent.versions.extend(versions)
   176	    agent.active_version = active_version_id
   177	    return agent
    35	) -> AgentOut:
    36	    # endpoint를 절대 http(s)로 정규화(스펙 060, 일관성). SDK 직접 등록이라 base는 없다 — 스킴 없는
    37	    # host:port는 http:// 전치, 절대화 불가(빈 값·비-http 스킴)면 등록 시점에 400(채팅서 늦게 안 깸).
    38	    try:
    39	        endpoint = net_guard.normalize_http_url(body.endpoint)
    40	    except ValueError as exc:
    41	        raise HTTPException(status_code=400, detail=str(exc)) from exc
    42	    cfg = {
