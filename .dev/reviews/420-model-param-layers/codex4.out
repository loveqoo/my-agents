   111	    @field_validator("artifactSpec")
   112	    @classmethod
   113	    def _check_artifact_spec(cls, v: dict[str, Any] | None) -> dict[str, Any] | None:
   114	        """산출물 필드 명세 얕은 검증(스펙 190) — fields=배열·각 항목 문자열 key 필수(≤100개).
   115	        의미 검증(후보 유효성 등)은 런타임 normalize_artifact_fields가 방어(빈/문자열후보 무시)."""
   116	        if v is None:
   117	            return v
   118	        if not isinstance(v, dict):
   119	            raise ValueError("artifactSpec은 객체여야 합니다.")
   120	        fields = v.get("fields")
   121	        if fields is not None:
   122	            if not isinstance(fields, list):
   123	                raise ValueError("artifactSpec.fields는 배열이어야 합니다.")
   124	            if len(fields) > 100:
   125	                raise ValueError("artifactSpec.fields는 100개 이하여야 합니다.")
   126	            for field in fields:
   127	                if (
   128	                    not isinstance(field, dict)
   129	                    or not isinstance(field.get("key"), str)
   130	                    or not field["key"].strip()
   131	                ):
   132	                    raise ValueError(
   133	                        "artifactSpec.fields 항목은 비어있지 않은 문자열 key가 필요합니다."
   134	                    )
   135	        return v
