   335	def _preserve_impl(body: AgentUpdate, agent: Agent, draft: AgentVersion | None, cfg: dict) -> None:
   336	    """요청에 impl 미명시면 편집 베이스(초안→활성 config)의 impl을 cfg에 이어받는다.
   337	
   338	    impl(스펙 085 SDK 런타임 키)은 편집 폼이 아직 안 보내므로(SPA 미배선), 요청에 명시되지
   339	    않으면 기존 값을 보존한다 — 안 그러면 Pydantic 기본 None이 덮어써 편집→활성화가 커스텀
   340	    에이전트를 DefaultUiAgent로 silent 되돌린다(codex 적대 리뷰 F1). 명시적으로 보내면(클리어 포함)
   341	    그 값 존중."""
   342	    if "impl" not in body.config.model_fields_set:
   343	        base = (draft.config if draft is not None else None) or dict(agent.config or {})
   344	        cfg["impl"] = base.get("impl")  # draft=미오픈 스크래치(스펙 370 — 이름만 승계)
   345	
   346	
   347	# ----------------------------- 편집 = 초안 저장 -----------------------------
   348	@router.put("/{agent_id}", response_model=AgentOut)
   349	async def update_agent(
   350	    agent_id: uuid.UUID,
   351	    body: AgentUpdate,
   352	    session: AsyncSession = Depends(get_session),
   353	    principal: User | str = Depends(current_principal),
   354	) -> AgentOut:
   355	    agent = await _load_agent(session, agent_id)
   356	    if agent is None:
   357	        raise HTTPException(status_code=404, detail="agent not found")
   358	    assert_may_manage(
   359	        agent, principal, not_found_detail="agent not found"
   360	    )  # 소유자/특권만(스펙 112)
   361	
   362	    cfg = body.config.model_dump()
   363	    _enforce_tool_policy_gate(cfg, principal)
   364	    _enforce_ephemeral_boundary(
   365	        cfg
   366	    )  # DB 쓰기 능력 금지(스펙 237)  # 완화는 admin만(스펙 177 P2 D4)
   367	    draft = next((v for v in agent.versions if not v.ever_opened), None)  # 스크래치(스펙 370)
   368	    _preserve_impl(body, agent, draft, cfg)
   369	    # 노드 참조 존재 검증(스펙 316, codex P1) — impl 무관 + 이름 잠금(삭제 가드와 직렬화).
   370	    await assert_node_refs_exist(session, cfg.get("nodes"))
   371	    # 기억 이름 존재 검증(스펙 387) — 노드 참조와 같은 규칙(dangling name의 조용한 무동작 차단).
   372	    await assert_memory_names_exist(session, cfg)
   373	    # 노드형 풀=노드 합집합 서버 파생(스펙 289 P2) — impl 보존 **뒤**에 호출(미명시 impl이 pipeline로
   374	    # 확정된 뒤라야 파생 게이트가 맞는다).
   375	    await derive_pipeline_pool(cfg)
   376	    # 충돌 규칙(스펙 370): 스크래치 유일 — 있으면 그 행을 새 번호·새 pins로 대체, 없으면 신설.
   377	    # 번호 = 오픈+1(오픈이력 슬롯이면 최대 오픈+1 — 오픈됐던 버전은 불변 보호).
   378	    scratch, target_ver = scratch_target(agent)
   379	    pins = await freeze_pins(session, cfg)  # 편집 시점 재freeze(스펙 370)
   380	    if scratch is not None:
   381	        scratch.version = target_ver
   382	        scratch.config = cfg
   383	        scratch.pins = pins
   384	        scratch.note = f"Edited {_today()}"
   385	    else:
   386	        agent.versions.append(
   387	            AgentVersion(
   388	                version=target_ver,
   389	                ever_opened=False,
   390	                pins=pins,
   391	                note=f"{agent.active_version or 'v0'}에서 편집",
   392	                config=cfg,
   393	            )
   394	        )
   395	    if body.name is not None and body.name != agent.name:
   396	        assert_valid_name(body.name)  # 식별 이름 변경도 규칙(스펙 148)
   397	        agent.name = body.name
   398	    if body.description is not None:
   399	        agent.description = body.description.strip() or None  # ""=설명 비우기
   400	    # 서빙 config/active_version 은 건드리지 않음.
   401	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   402	    return await _reload_out(session, agent.id)
