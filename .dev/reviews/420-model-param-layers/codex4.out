    27	# ----------------------------- 오픈 (포인터 이동 + ever_opened) -----------------------------
    28	@router.post("/{agent_id}/activate", response_model=AgentOut)
    29	async def activate_version(
    30	    agent_id: uuid.UUID,
    31	    body: ActivateIn,
    32	    session: AsyncSession = Depends(get_session),
    33	    principal: User | str = Depends(current_principal),
    34	) -> AgentOut:
    35	    """버전 오픈(스펙 370) — 라이브 포인터를 그 버전으로 옮기고 ever_opened를 영구 스탬프.
    36	
    37	    롤백 = 예전 오픈 버전을 다시 오픈(같은 동사). head 컬럼(config/model/prompt/depth)은 오픈
    38	    버전의 구체화 캐시 — prompt는 pin payload에서(불변), pin 부재 시 head 폴백(레거시)."""
    39	    agent = await _load_agent(session, agent_id)
    40	    if agent is None:
    41	        raise HTTPException(status_code=404, detail="agent not found")
    42	    assert_may_manage(
    43	        agent, principal, not_found_detail="agent not found"
    44	    )  # 소유자/특권만(스펙 112)
    45	
    46	    target = _find_version(agent, body.version)
    47	    if target is None:
    48	        raise HTTPException(status_code=404, detail="version not found")
    49	    if agent.active_version == body.version:
    50	        raise HTTPException(status_code=400, detail="이미 오픈된 버전입니다")
    51	    # 평가 게이트(스펙 372=367-E) — 스크래치(미오픈) 첫 오픈만. 롤백(ever_opened)은 면제(개발자 확정:
    52	    # 긴급 롤백을 게이트가 막으면 사고 대응이 잠긴다). 우회 플래그 없음 — 급하면 설정에서 임계를
    53	    # 낮추는 명시 행위로만(감사 가능).
    54	    if not target.ever_opened and agent.source == "ui":
    55	        blocked = await _eval_gate_reason(session, agent.id, body.version)
    56	        if blocked:
    57	            raise HTTPException(status_code=400, detail=blocked)
    58	
    59	    cfg = dict(target.config or {})
    60	    _enforce_ephemeral_boundary(
    61	        cfg
    62	    )  # 스펙 237(codex #1) — 과거 버전 오픈도 "존재 불가" 불변식 유지
    63	    target.ever_opened = True  # 오픈 이력 = 영구 불변 보호(스펙 370 충돌 규칙)
    64	    agent.config = cfg
    65	    agent.model = cfg["model"]
    66	    agent.prompt = await _pinned_prompt_body(session, target, cfg)
    67	    agent.history_depth = cfg["historyDepth"]
    68	    agent.active_version = body.version
    69	    agent.status = "online"
    70	
    71	    await session.commit()
    72	    # 자동 회귀(스펙 241, AgentOps B) — 새 버전이 서빙되는 순간 회귀 자산 자동 재실행(fire-and-forget:
    73	    # 실패해도 오픈은 정상). 평가 게이트(367-E)가 추후 이 관문에 선다.
    74	    from ..eval_routes import trigger_auto_regression
    75	
    76	    # 오픈 이벤트의 버전을 명시 관통(스펙 399 버전 핀 완성형 — codex 적대: 태스크 실행 전 재오픈이
    77	    # 끼면 태스크가 나중 active를 캡처하는 race, 이벤트 버전을 인자로 고정).
    78	    spawn(trigger_auto_regression(agent.id, principal, opened_version=body.version))
    79	    return await _reload_out(session, agent.id)
    80	
