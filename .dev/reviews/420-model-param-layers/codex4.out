   405	@router.delete("/{agent_id}", status_code=204)
   406	async def delete_agent(
   407	    agent_id: uuid.UUID,
   408	    session: AsyncSession = Depends(get_session),
   409	    principal: User | str = Depends(current_principal),
   410	) -> None:
   411	    agent = await get_or_404(session, Agent, agent_id, detail="agent not found")
   412	    assert_may_manage(
   413	        agent, principal, not_found_detail="agent not found"
   414	    )  # 소유자/특권만(스펙 112)
   415	    await session.delete(agent)
   416	    await session.commit()
     1	"""버전 라우트(스펙 370) — 오픈(포인터 이동)·채택(pins 재freeze).
     2	
     3	구 상태기계(draft/active/archived + 포크·되돌리기·프롬프트 스냅샷 갱신)는 폐기:
     4	- 포크 → 없음(편집이 곧 다음 버전 작업 — 충돌 규칙은 crud_routes PUT).
     5	- 되돌리기 → 예전 버전 오픈(activate)이 곧 롤백.
     6	- prompt/refresh(스펙 161 promptStale) → 채택(adopt)이 전 블록으로 일반화.
     7	오픈은 미래 평가 게이트(367-E: 점수·회수 임계)의 관문이다.
     8	"""
     9	
    10	import uuid
    11	
