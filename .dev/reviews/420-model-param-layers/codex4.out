    74	    # A2A 위임 승인 opt-in(스펙 117) — 이 에이전트에게 위임(A2A 전송)할 때 승인 게이트를 걸지. 기본 False=
    75	    # 게이트 없음(무회귀). 브로커 AgentProvider.approval_for가 read하는 정책 소스라 **라운드트립 보존 필수**
    76	    # (없으면 model_dump가 조용히 드롭 → 게이트 비활성, learning 101 seed-bypasses-write-schema).
    77	    requires_approval: bool = False
    78	    impl: str | None = None  # in-process 커스텀 런타임 키(스펙 085). None=기본 DefaultUiAgent.
    79	    # 신뢰 레지스트리의 *키*일 뿐 코드 아님 — 미지/미등록 키는 조용히 기본으로 폴백(eval 없음).
    80	    # 노코드 산출물형(스펙 190) — {kind?, fields:[{key,label?,candidates?,required?}]}. impl=artifact_form이
    81	    # 이 명세를 읽어 폼을 돈다(chat.py가 impl_config로 주입). 라운드트립 보존 필수(model_dump가 드롭하면
    82	    # 폼 재로드 시 명세 소실 — learning 101 seed-bypasses-write-schema 동형).
    83	    artifactSpec: dict[str, Any] | None = None
    84	    # 노드형(스펙 259) — 일렬 파이프라인 노드 명세 [{name?, prompt, model?, tools?:[str]}]. impl=pipeline이
    85	    # 이 리스트를 읽어 순서대로 실행(chat.py가 노드별 모델 해석 후 impl_config로 주입). 라운드트립 보존 필수.
    86	    nodes: list[dict[str, Any]] | None = None
    87	    # 컬렉션별 문서 검색 최소 유사도(스펙 191 v2) — {컬렉션명: 0~1}. 미만 문서는 검색 코어가 드롭.
    88	    # 항목 없으면 그 컬렉션은 무필터. 값 0~1(1=완전 일치).
    89	    ragMinScores: dict[str, float] = Field(default_factory=dict)
    90	
    91	    @field_validator("ragMinScores", mode="before")
    92	    @classmethod
    93	    def _check_rag_min_scores(cls, v: Any) -> dict:
    94	        """컬렉션별 임계값 맵 형태 검증(스펙 191 v2) — dict[str, 0~1]. 각 값 범위 밖·비수치면 거부.
    95	        mode=before: bool(True→1.0)·문자열 코어싱 전 원값을 잡아 거부(숫자만 허용). 0 값은 허용(무필터)."""
    96	        if v is None:
    97	            return {}
    98	        if not isinstance(v, dict):
    99	            raise ValueError("ragMinScores는 객체여야 합니다.")
   100	        out: dict[str, float] = {}
   101	        for k, val in v.items():
   102	            if not isinstance(k, str) or not k.strip():
   103	                raise ValueError("ragMinScores 키(컬렉션명)는 비어있지 않은 문자열이어야 합니다.")
   104	            if isinstance(val, bool) or not isinstance(val, (int, float)):
   105	                raise ValueError(f"ragMinScores['{k}']는 숫자여야 합니다.")
   106	            if not (0.0 <= float(val) <= 1.0):
   107	                raise ValueError(f"ragMinScores['{k}']는 0.0~1.0 범위여야 합니다.")
   108	            out[k] = float(val)
   109	        return out
