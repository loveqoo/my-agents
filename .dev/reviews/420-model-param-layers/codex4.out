    87	# ----------------------------- 통합 연결 (스펙 057 — A2A 단일화) -----------------------------
    88	@router.post("/connect", response_model=AgentOut, status_code=201)
    89	async def connect_agent(
    90	    body: ConnectAgentIn,
    91	    session: AsyncSession = Depends(get_session),
    92	    principal: User | str = Depends(current_principal),
    93	) -> AgentOut:
    94	    """원격 에이전트 연결 — URL 하나로 A2A 카드를 fetch해 provenance 자동분류(스펙 057).
    95	
    96	    카드에 my-agents 확장(x-my-agents.manifest)이 있으면 우리가 SDK로 배포한 제1자(source=code,
    97	    매니페스트·배포 메타 보유), 없으면 제3자 A2A(source=external, 불투명). 둘 다 런타임은 A2A 하나.
    98	    SSRF 가드는 fetch_card·probe_endpoint가 각각 guard_url 선행(044/055).
    99	    """
   100	    try:
   101	        card = await agent_card.fetch_card(body.url)
   102	    except ValueError as exc:
   103	        raise HTTPException(status_code=400, detail=str(exc)) from exc
   104	
   105	    # 카드 published ≠ 실행 엔드포인트 live(045 #2). 도달 실패해도 등록 허용, status만 정직하게.
   106	    live = await agent_card.probe_endpoint(card.get("url"))
   107	    ext = agent_card.extract_my_agents(card)
   108	    if ext is not None:
   109	        agent = _build_code_agent_from_card(card, ext, body.token, live, body.url)
   110	    else:
   111	        agent = _build_external_agent(card, body.token, live, body.url)
   112	    agent.owner_id = owner_of(principal)  # 생성 시 1회 스탬프(스펙 112)
   113	    await _slugify_remote_agent(session, agent)  # 카드명은 원격 유래 — 자동 변환(스펙 148)
   114	    session.add(agent)
   115	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   116	    return await _reload_out(session, agent.id)
