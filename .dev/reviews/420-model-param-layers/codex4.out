    16	class AgentConfig(BaseModel):
    17	    model: str = "mock-llm"  # 미지정 시 기본 모델(스펙 059)
    18	    prompt: str = ""  # 프롬프트 이름(블록 참조)
    19	    # temperature는 **은퇴**(스펙 411 흡수) — modelParams.temperature가 정본. 이 필드는 옛 저장분 read
    20	    # 하위호환 자리만(로더 _fold_temperature가 modelParams로 이관, serializer는 modelParams로 접어 노출).
    21	    temperature: float | None = None
    22	    # 모델 파라미터 오버라이드(스펙 408→411 캐스케이드) — 화이트리스트 키(stream·enable_thinking·
    23	    # temperature·top_p·max_tokens·repetition_penalty)만 실효. 미명시 키=모델 기본 상속. temperature 통합 거처.
    24	    modelParams: dict[str, Any] = Field(default_factory=dict)
    25	
    26	    @field_validator("modelParams")
    27	    @classmethod
    28	    def _clean_model_params(cls, v: Any) -> dict:
    29	        """저장 경계에서 화이트리스트 설정 키의 bool만 보존(스펙 409 codex P2③) — 실행부만 거르던
    30	        것을 저장까지 정직화(에코·버전 오염 차단). 노드·세션과 같은 공유 정리기."""
    31	        return clean_setting_params(v)
    32	
    33	    # 노드형 agent 층 modelParams 제거는 여기(파싱 시점)가 아니라 **Agent/AgentVersion.config ORM
    34	    # @validates**가 강제한다(스펙 420) — config가 저장되는 모든 경로가 지나는 단일 관문. 파싱-시점
    35	    # 판정은 update의 impl-복원 순서 역전을 못 잡고, clone/adopt처럼 AgentConfig를 안 거치는 raw 복사
    36	    # 경로를 놓친다. ORM 관문 한 곳이 이 모든 입구를 덮는다.
    37	    memories: list[str] = Field(default_factory=list)
    38	    vectorTables: list[str] = Field(default_factory=list)
    39	    mcps: list[str] = Field(default_factory=list)
    40	    # 직접형 도구 단위 배선(스펙 276) — 런타임명(`server__tool`) 목록. **mcps(서버 목록)가 서버 배선의
    41	    # 진실원**이고 tools는 그 위의 노출 필터: 서버별로 이 목록에 항목이 있으면 그 도구만, 없으면 전체
    42	    # (구저장 빈 목록=지금과 동일=무회귀). model_dump 드롭 방지 위해 스키마 필드 필수(learning 101 동형).
    43	    tools: list[str] = Field(default_factory=list)
    44	    # 능력 브로커 allowlist(스펙 100 §69·101) — 오케스트레이터가 서브스텝 위임할 수 있는 능력 id.
    45	    # 규약: bare=agent cap, `mcp:<server>`=서버 전체, `mcp:<server>/<tool>`=툴 단위. 없으면 []=deny-by-
    46	    # default. 실제 인가는 요청 시 RBAC와 교집합(build_broker). UI 편집은 Phase 2-d로 이연(스펙 101).
    47	    capabilities: list[str] = Field(default_factory=list)
    48	    # 도구 승인 오버라이드(스펙 177 P2) — cap_id(`mcp:{server}/{tool}`)→{approval:{required?, approver?}}.
    49	    # 도구 기본 정책(tools_meta)을 에이전트별로 강화(끔→켬)·완화(켬→끔)·승인자 변경. 리졸버가 덮어씀
    50	    # (runtime.resolve_tool_approval). **완화는 저장 시 admin 게이트**(agents CRUD) — 스키마는 구조만 강제.
    51	    toolPolicy: dict[str, Any] = Field(default_factory=dict)
    52	    historyDepth: int = 20
    53	    persistHistory: bool = (
    54	        True  # 대화를 DB에 저장할지(끄면 윈도우 모드 — 세션은 남고 메시지만 스킵)
    55	    )
    56	    # 비영속(1회성) 모드(스펙 235) — true면 DB 적재 전면 스킵(세션 행·카운터·메시지·commit·메모리 전부
    57	    # 무동작). 고트래픽·기록 무의미한 단순 추론 제공용. persistHistory의 상위집합. model_dump 드롭 방지 위해
    58	    # 반드시 스키마 필드로 둔다(위 requires_approval 주석의 seed-bypasses-write-schema 함정과 동일).
    59	    ephemeral: bool = False
    60	    # 플레이그라운드 추천 명령어(스펙 238, 옵셔널) — 에이전트별 프롬프트 카드. 캡=최대 8개·각 200자
    61	    # (직접 POST 입력 신뢰경계 — learning 075). 빈/공백 항목은 검증기가 걸러낸다.
    62	    suggestedPrompts: list[str] = Field(default_factory=list)
    63	
    64	    @field_validator("suggestedPrompts")
    65	    @classmethod
    66	    def _cap_suggested(cls, v: list[str]) -> list[str]:
    67	        cleaned = [s.strip() for s in v if isinstance(s, str) and s.strip()]
    68	        if len(cleaned) > 8:
    69	            raise ValueError("추천 명령어는 최대 8개까지입니다.")
    70	        if any(len(s) > 200 for s in cleaned):
    71	            raise ValueError("추천 명령어는 각 200자 이내여야 합니다.")
    72	        return cleaned
