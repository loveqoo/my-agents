   193	# ----------------------------- 코드 에이전트 재동기화 -----------------------------
   194	@router.post("/{agent_id}/resync", response_model=AgentOut)
   195	async def resync_agent(
   196	    agent_id: uuid.UUID,
   197	    session: AsyncSession = Depends(get_session),
   198	    principal: User | str = Depends(current_principal),
   199	) -> AgentOut:
   200	    """stale endpoint 자가치유(스펙 081 P1).
   201	
   202	    저장해둔 카드 출처(config["cardUrl"])에서 카드를 재fetch → `fetch_card`가 071의 prefix-상대
   203	    endpoint resolution을 재실행 → endpoint·카드 스냅샷·status(probe liveness)를 in-place 갱신한다.
   204	    071 보정은 fetch_card 시점에만 걸리므로, 071 이전 등록분·원격 변경분의 stale endpoint는 이 경로로만
   205	    재연결 없이 고쳐진다. 기존 행 갱신이라 id/소유/버전은 보존(connect의 새 Agent 생성과 다름).
   206	
   207	    cardUrl이 없는 레거시 행은 재해석 출처가 없어 last_sync만 갱신(재연결 1회 필요).
   208	    SSRF 경계: fetch_card·probe_endpoint가 각각 저장된 cardUrl(connect 때 guard 통과한 사용자 입력)에서만
   209	    guard_url 선행 — request Host 등 외부 파생 입력을 쓰지 않으므로 host-poisoning 무관(learning 064).
   210	    """
   211	    agent = await _load_agent(session, agent_id)
   212	    if agent is None:
   213	        raise HTTPException(status_code=404, detail="agent not found")
   214	    assert_may_manage(
   215	        agent, principal, not_found_detail="agent not found"
   216	    )  # 소유자/특권만(스펙 112)
   217	
   218	    cfg = dict(agent.config or {})
   219	    card_url = cfg.get("cardUrl")
   220	    if not isinstance(card_url, str) or not card_url:
   221	        # 레거시(cardUrl 미저장): 재해석 출처 없음 → 기존 동작 유지(표시만 갱신). 한 번 재연결하면
   222	        # 이후 connect가 cardUrl을 채워 자가치유 경로로 들어온다.
   223	        return await _resync_display_only(session, agent)
   224	
   225	    try:
   226	        card = await agent_card.fetch_card(card_url)
   227	    except ValueError:
   228	        # 카드 출처 도달 실패 — 등록은 유지하되 status는 정직하게 offline(045 #2). endpoint는 보존
   229	        # (다음 resync에서 재시도). 표시 갱신만.
   230	        return await _resync_display_only(session, agent, offline=True)
   231	
   232	    live = await agent_card.probe_endpoint(card.get("url"))
   233	    cfg["card"] = card  # 카드 스냅샷 갱신(표시·검증 단일 소스)
   234	    agent.config = cfg  # JSONB는 in-place 변이 미추적 — 재할당으로 더티 표기
   235	    agent.endpoint = _norm_endpoint(card.get("url"))
   236	    agent.status = "online" if live else "offline"
   237	    agent.last_sync = "방금"
   238	    _resync_deploy_meta(agent, card, cfg)
   239	    await session.commit()
   240	    return await _reload_out(session, agent.id)
