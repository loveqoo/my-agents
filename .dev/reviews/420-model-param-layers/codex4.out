   228	        )
   229	        .scalars()
   230	        .first()
   145	        # 화이트리스트 bool만(문자열 "false" 게이트 우회 차단 — 실행부 _as_bool와 이중 방어).
   146	        session_mp = clean_setting_params(overrides.get("modelParams")) if isinstance(overrides, dict) else None
   147	        model_cfg = await _resolve_model(db, cfg, overrides, pins) if not remote else None
   148	        nodes_resolved = await _resolve_nodes_for_ctx(
   149	            db, nodes, model_cfg, remote, pins, cfg=cfg, session_mp=session_mp
   150	        )
   151	        mem_cfg = await _resolve_mem_cfg(db, model_cfg)
   152	        mcp_servers, tool_names = await _resolve_mcp_servers(db, cfg, pins)
   153	        rag_collections, rag_unresolved = await _resolve_rag(db, cfg, remote)
   154	        session = await _resolve_session(db, agent, session_str_id, own)
   155	        return ChatContext(
   156	            prompt=prompt,
   157	            ext_agent_id=agent.agent_id,
   158	            agent_name=agent.name,
   159	            agent_pk=agent.id,
   160	            source=agent.source,
   161	            impl=cfg.get("impl"),
   162	            artifact_spec=cfg.get("artifactSpec"),
   163	            nodes=nodes,
   164	            overrides_nodes_status=nodes_status,
   165	            # 원본 오버라이드 — in-process 커스텀이 화이트리스트 밖 키도 읽게 전달(스펙 085
   166	            # AgentBuildContext.overrides). 원격은 None(로컬 설정 주입 무의미, bypass 보존).
   167	            overrides=applied_overrides,
   168	            endpoint=agent.endpoint,
   169	            token=agent.token,
   170	            card=cfg.get("card"),
   171	            memories=cfg.get("memories", []),
   172	            capabilities=_filter_capabilities(cfg),
   173	            # 도구 승인 오버라이드(스펙 177 P2) — 요청 오버라이드 허용키엔 불포함(요청으로 승인 완화
   174	            # 우회 금지, config-only). 완화 권한은 저장 시 admin 게이트로 강제.
   175	            tool_policy=cfg.get("toolPolicy") or {},
   176	            # temperature는 통합 파라미터 축(modelParams)에서 파생(스펙 411 흡수) → trace/지문 연속성.
   177	            # 미명시=None(모델 등록 params 적용). 실행 배선은 build_chat_openai가 modelParams로 직접 해석.
   178	            # **노드형은 None**(스펙 420 P1② codex): ctx.temperature는 agent/session 층 값인데, 이게
   179	            # run_params로 4입구(chat/resume/serve/eval)+노드에 흘러 노드 파라미터를 덮는 **병렬 통로**다.
   180	            # modelParams 캐스케이드만 막으면 이 통로로 샌다 — 같은 정책(agent 층=non-pipeline만)으로 봉인.
   181	            temperature=(
   182	                (cfg.get("modelParams") or {}).get("temperature")
   183	                if layer_applies("agent", cfg.get("impl"))
   184	                else None
   185	            ),
   186	            history_depth=cfg.get("historyDepth", 20),
   187	            persist_history=cfg.get("persistHistory", True),
   188	            # 비영속(1회성) 모드(스펙 235) — true면 DB 적재 전면 스킵(persistHistory의 상위집합).
   189	            ephemeral=bool(cfg.get("ephemeral", False)),
   190	            pinned_version=pinned_version,
   191	            exec_version=exec_version,
   192	            prompt_name=prompt_name,
   193	            prompt_id=prompt_id,
   194	            pins=pins,
   195	            model_cfg=model_cfg,
   196	            nodes_resolved=nodes_resolved,
   197	            mem_cfg=mem_cfg,
   198	            mcp_servers=mcp_servers,
   199	            tool_names=tool_names,
   200	            rag_collections=rag_collections,
   134	# ----------------------------- 채택 (pins 재freeze — promptStale 후계) -----------------------------
   135	@router.post("/{agent_id}/adopt", response_model=AgentOut)
   136	async def adopt_block_versions(
   137	    agent_id: uuid.UUID,
   138	    session: AsyncSession = Depends(get_session),
