   119	# ----------------------------- 외부 에이전트 등록 (A2A 카드) — deprecated, connect로 대체 -----------------------------
   120	@router.post("/external", response_model=AgentOut, status_code=201)
   121	async def register_external_agent(
   122	    body: RegisterExternalAgentIn,
   123	    session: AsyncSession = Depends(get_session),
   124	    principal: User | str = Depends(current_principal),
   125	) -> AgentOut:
   126	    """A2A Agent Card URL을 fetch·검증해 외부 에이전트로 등록(026, 1차).
   127	
   128	    057 이후 deprecated — 프론트는 connect를 호출한다. 라우트·로직은 무회귀 위해 잔존(connect의
   129	    external 분기와 동일 빌더 공유). 실제 A2A 호출은 _a2a_stream.
   130	    """
   131	    try:
   132	        card = await agent_card.fetch_card(body.cardUrl)
   133	    except ValueError as exc:
   134	        raise HTTPException(status_code=400, detail=str(exc)) from exc
   135	
   136	    live = await agent_card.probe_endpoint(card.get("url"))
   137	    agent = _build_external_agent(card, body.token, live, body.cardUrl)
   138	    agent.owner_id = owner_of(principal)  # 생성 시 1회 스탬프(스펙 112)
   139	    await _slugify_remote_agent(session, agent)  # 카드명은 원격 유래 — 자동 변환(스펙 148)
   140	    session.add(agent)
   141	    await _commit_or_409(session, "같은 식별 이름의 에이전트가 이미 있습니다.")
   142	    return await _reload_out(session, agent.id)
   143	
   144	
   145	async def _resync_display_only(
   146	    session: AsyncSession, agent: Agent, *, offline: bool = False
   147	) -> AgentOut:
   148	    """카드 재해석 없이 표시(last_sync·선택적 offline)만 갱신하고 직렬화 응답을 반환."""
   149	    if offline:
   150	        agent.status = "offline"
   151	    agent.last_sync = "방금"
   152	    await session.commit()
   153	    return await _reload_out(session, agent.id)
   154	
   155	
   156	def _transition_active_commit(agent: Agent, new_commit: str, cfg: dict) -> None:
   157	    """commit 변경 시 버전 행 전이(057 F4) — 스펙 370: active는 포인터(active_version)가 진실원.
   158	    code 버전 행은 배포 이력이므로 전부 ever_opened=True(오픈 이력 보호와 동형)."""
   159	    agent.commit = new_commit
   160	    existing = _find_version(agent, new_commit)
   161	    if existing is None:  # A→B→A 재왕복: 기존 행 재사용(중복 행 금지)
   162	        agent.versions.append(
   163	            AgentVersion(
   164	                version=new_commit,
   165	                ever_opened=True,
   166	                note="resync 재보고(스펙 285)",
   167	                config=dict(cfg),
   168	            )
   169	        )
   170	    agent.active_version = new_commit
   171	
   172	
   173	def _resync_deploy_meta(agent: Agent, card: dict, cfg: dict) -> None:
   174	    """배포 메타 재보고(스펙 285) — 상태는 실측인데 버전(commit)은 등록 시점 신고라 낡던 비대칭 해소.
   175	
   176	    code(확장 보유)만: repo·runtime은 값 있을 때만 갱신(카드에서 사라지면 기존 보존 — merge-preserve),
   177	    commit 변경 시 버전 행을 057 F4 불변식대로 전이."""
   178	    ext = agent_card.extract_my_agents(card)
   179	    if agent.source != "code" or ext is None:
   180	        return
   181	    deploy = ext.get("deploy") or {}
   182	    new_repo = _clip(deploy.get("repo"), 200)
   183	    new_runtime = _clip(deploy.get("runtime"), 200)
   184	    if new_repo:
   185	        agent.repo = new_repo
   186	    if new_runtime:
   187	        agent.runtime = new_runtime
   188	    new_commit = _clip(deploy.get("commit"), 80)  # 길이 하드닝(057 F3 동일)
   189	    if new_commit and new_commit != agent.commit:
   190	        _transition_active_commit(agent, new_commit, cfg)
