   180	async def main() -> None:
   181	    _p_policy()
   182	    _w_pure()
   183	    await _o_orm_chokepoint()
   184	    model_name = await _r_resolution()
   185	    if model_name:
   186	        await _t_temperature_channel(model_name)
   187	    print()
   188	    if _fails:
   189	        print(f"FAILED: {len(_fails)}건")
   190	        for f in _fails:
   191	            print("  -", f)
   192	        sys.exit(1)
   193	    print(f"VERIFY420_OK — {passed}건 전부 통과")
