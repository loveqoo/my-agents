    95	async def _t_temperature_channel(model_name: str) -> None:
    96	    """P1② codex — temperature 병렬 통로 봉인: 노드형 에이전트(레거시 불법 저장 config, raw 시드로
    97	    validator 우회)의 ctx.temperature가 None이어야(agent·session 둘 다). 이게 run_params로 4입구+노드에
    98	    새던 실우회. 비노드형은 ctx.temperature 유지(무회귀)."""
    99	    print("== T temperature 병렬 통로(ctx.temperature, 실 로더 — 레거시 dirty 행) ==")
   100	    illegal = {"impl": "pipeline", "model": model_name, "modelParams": {"temperature": 0.9},
   101	               "nodes": [{"prompt": "n", "model": model_name}]}
   102	    async with SessionLocal() as s:
   103	        # ORM @validates가 노드형 modelParams를 막으므로, **선재 dirty 행**(마이그레이션 이전 저장분)을
   104	        # 재현하려면 raw SQL로 JSONB를 직접 주입한다. 런타임 관문이 이런 레거시 행도 안전 처리하나 검증.
   105	        s.add(Agent(agent_id=f"agt_{_TAG}_pipe", name=f"{_TAG}_pipe", source="ui", active_version="v1",
   106	                    config={"impl": "pipeline", "model": model_name}))
   107	        s.add(Agent(agent_id=f"agt_{_TAG}_direct", name=f"{_TAG}_direct", source="ui", active_version="v1",
   108	                    config={"impl": None, "model": model_name, "modelParams": {"temperature": 0.5}}))
   109	        await s.commit()
   110	        pipe = (await s.execute(select(Agent).where(Agent.agent_id == f"agt_{_TAG}_pipe"))).scalar_one()
   111	        direct = (await s.execute(select(Agent).where(Agent.agent_id == f"agt_{_TAG}_direct"))).scalar_one()
   112	        pipe_id, direct_id = pipe.id, direct.id
   113	        # raw JSONB 주입(@validates 우회) — 선재 불법 config 시뮬레이션.
   114	        await s.execute(update(Agent).where(Agent.id == pipe_id).values(config=illegal).execution_options(synchronize_session=False))
   115	        await s.commit()
   116	    # 주입 확인(우회 성공해야 이 테스트가 의미 있음).
   117	    async with SessionLocal() as s:
   118	        raw = (await s.execute(text("select config->'modelParams'->>'temperature' as t from agents where id = :i"), {"i": str(pipe_id)})).scalar_one_or_none()
   119	        check(raw == "0.9", f"레거시 dirty 행 주입됨(raw SQL 우회 확인) (got {raw})")
   120	    try:
   121	        ctx = await _load_context(pipe_id, None, {}, own=None)
   122	        check(ctx.temperature is None, f"노드형 ctx.temperature=None(agent 층 병렬통로 봉인) (got {ctx.temperature})")
   123	        ctx_s = await _load_context(pipe_id, None, {"modelParams": {"temperature": 0.01}}, own=None)
   124	        check(ctx_s.temperature is None, f"노드형 ctx.temperature=None(session 오버라이드도 봉인) (got {ctx_s.temperature})")
   125	        ctx_d = await _load_context(direct_id, None, {}, own=None)
   126	        check(ctx_d.temperature == 0.5, f"비노드형 ctx.temperature 유지(무회귀) (got {ctx_d.temperature})")
   127	    finally:
   128	        async with SessionLocal() as s:
   129	            await s.execute(delete(Agent).where(Agent.agent_id.like(f"agt_{_TAG}_%")))
   130	            await s.commit()
   131	
