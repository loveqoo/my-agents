   123	async def _pinned_prompt_body(session: AsyncSession, vrow: AgentVersion, cfg: dict) -> str:
   124	    """오픈 버전의 프롬프트 본문 — pin payload 우선(불변), 부재 시 head 해석 폴백(레거시·literal)."""
   125	    from .helpers import resolve_prompt
   126	
   127	    name = cfg.get("prompt") or ""
   128	    payload = await resolve_pinned(session, vrow.pins, "prompt", name)
   129	    if payload is not None:
   130	        return payload.get("body", "")
   131	    return await resolve_prompt(session, name)
