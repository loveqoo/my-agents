    40	def _build_external_agent(
    41	    card: dict, token: str | None, live: bool, card_url: str | None = None
    42	) -> Agent:
    43	    """제3자 A2A 카드 → external Agent. 불투명 카드 스냅샷, 로컬 모델/메모리/MCP 미해석(비로컬).
    44	
    45	    카드 스냅샷은 config["card"], 서비스 URL은 endpoint, 호출 크레덴셜은 crypto.encrypt로 token에
    46	    저장(2차 런타임 호출에서 복호 사용).
    47	
    48	    card_url = 카드를 가져온 출처(.well-known 위치). resync 자가치유(스펙 081)가 이 URL로 카드를
    49	    재fetch해 endpoint·status를 갱신한다 — 저장 안 하면 stale endpoint를 재연결 없이 못 고친다."""
    50	    cfg = {
    51	        "model": "",  # 외부는 로컬 모델 미해석
    52	        "prompt": "",
    53	        "memories": [],
    54	        "vectorTables": [],
    55	        "mcps": [],
    56	        "historyDepth": 10,
    57	        "card": card,  # 등록 시점 카드 스냅샷(표시·검증 단일 소스)
    58	        "cardUrl": card_url,  # 카드 출처 — resync 재해석용(스펙 081)
    59	    }
    60	    return Agent(
    61	        agent_id=_new_agent_id(),
    62	        name=_clip(card.get("name"), 200) or "외부 에이전트",
    63	        source="external",
    64	        model="",
    65	        prompt="",
    66	        history_depth=10,
    67	        config=cfg,
    68	        exposed={"a2a": False},  # 우리가 소비측(클라이언트) — 서버측 노출과 무관
    69	        status="online" if live else "offline",
    70	        endpoint=_norm_endpoint(card.get("url")),
    71	        token=crypto.encrypt(token) if token else None,
    72	        registered_at=_today(),
    73	        last_sync="방금",
    74	    )
