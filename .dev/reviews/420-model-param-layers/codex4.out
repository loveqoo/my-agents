   133	async def _r_resolution() -> None:
   134	    print("== R 해석 관문(실 DB) ==")
   135	    async with SessionLocal() as s:
   136	        m = (
   137	            await s.execute(
   138	                select(ModelConfig).where(ModelConfig.kind == "chat").limit(1)
   139	            )
   140	        ).scalar_one_or_none()
   141	    if m is None:
   142	        check(False, "등록 chat 모델 없음 — 시드 확인")
   143	        return None
   144	    model_name = m.name
   145	
   146	    # 노드형: agent 층(temperature) + session 층(top_p)이 노드에 안 실려야. + node 층은 실려야(양성).
   147	    node_cfg = {"impl": "pipeline", "model": model_name, "modelParams": {"temperature": 0.9}}
   148	    async with SessionLocal() as s:
   149	        default_cfg = await _resolve_model(s, node_cfg, None)
   150	        nodes = [
   151	            {"prompt": "with-model", "model": model_name},  # 자기 모델 노드(경로 A)
   152	            {"prompt": "no-model"},  # 모델 없는 노드 → default_cfg 폴백(경로 B)
   153	            {"prompt": "own-mp", "model": model_name, "modelParams": {"temperature": 0.42}},  # node 층(양성)
   154	        ]
   155	        resolved = await _resolve_node_models(
   156	            s, nodes, default_cfg, agent_cfg=node_cfg, session_mp={"top_p": 0.5}
   157	        )
   158	    by_tag = {r.get("prompt"): (r.get("model_cfg") or {}).get("params") or {} for r in resolved}
   159	    for tag in ("with-model", "no-model", "own-mp"):
   160	        params = by_tag[tag]
   161	        check(params.get("temperature") != 0.9, f"[{tag}] 노드형: agent 층(temperature) 미적용 (got {params.get('temperature')})")
   162	        check(params.get("top_p") != 0.5, f"[{tag}] 노드형: session 층(top_p) 미적용 (got {params.get('top_p')})")
   163	    # node 층 양성 무회귀(codex 재검 P2) — 노드 자기 modelParams는 실제로 model_cfg.params에 실린다.
   164	    check(by_tag["own-mp"].get("temperature") == 0.42,
   165	          f"node 층 양성: 노드 자기 modelParams(temperature) 적용됨 (got {by_tag['own-mp'].get('temperature')})")
   166	
   167	    # 노드형 default_cfg(폴백 원천)도 agent 층 없어야(경로 B 봉인 확인).
   168	    check((default_cfg.get("params") or {}).get("temperature") != 0.9,
   169	          "노드형 default_cfg: agent 층 미적용(폴백 경로 봉인)")
   170	
   171	    # 비노드형: agent 층이 실려야(무회귀).
   172	    direct_cfg = {"impl": None, "model": model_name, "modelParams": {"temperature": 0.9}}
   173	    async with SessionLocal() as s:
   174	        mc = await _resolve_model(s, direct_cfg, None)
   175	    check((mc.get("params") or {}).get("temperature") == 0.9,
   176	          f"비노드형: agent 층(temperature) 적용됨(무회귀) (got {(mc.get('params') or {}).get('temperature')})")
   177	    return model_name
   178	
