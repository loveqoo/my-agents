    34	async def _resolve_rag(db: AsyncSession, cfg: dict, remote: bool) -> tuple[list[dict], list[str]]:
    35	    """RAG 컬렉션 해석(스펙 037) — vectorTables(이름 목록) → 검색 도구 배선용 dict.
    36	
    37	    질의는 **각 컬렉션이 인제스트에 쓴 임베딩 모델**로 임베딩해야 같은 벡터 공간(035 진실원).
    38	    provider 불완전 컬렉션은 검색 불가라 skip(graceful). 컬렉션은 전부 공용(스펙 172) — 가시성 축
    39	    제거, 관리(수정·삭제)는 소유자만. 원격(code/external)은 비로컬이라 빈 결과.
    40	    반환 (rag_collections, unresolved — 해석 실패 이름은 트레이스로 표면화, 타자검증 F)."""
    41	    vt_names = config_names(cfg, "vectorTables")  # 삭제 가드와 동일 normalizer(drift 0)
    42	    if not vt_names or remote:
    43	        return [], []
    44	    cols = (
    45	        (
    46	            await db.execute(
    47	                select(Collection)
    48	                .where(Collection.name.in_(vt_names))
    49	                .options(
    50	                    selectinload(Collection.embedding_model).selectinload(ModelConfig.provider)
    51	                )
    52	            )
    53	        )
    54	        .scalars()
    55	        .all()
    56	    )
    57	    rag_collections: list[dict] = []
    58	    for col in cols:
    59	        entry = _rag_collection_entry(col)
    60	        if entry is None:
    61	            log.warning("rag collection %s skipped: embedding model/provider 불완전", col.name)
    62	            continue
    63	        rag_collections.append(entry)
    64	    resolved = {rc["name"] for rc in rag_collections}
    65	    unresolved = [n for n in vt_names if n not in resolved]
    66	    if unresolved:
    67	        log.warning(
    68	            "rag vectorTables 미해석: %s (요청 %s → 해석 %s)",
    69	            unresolved,
    70	            vt_names,
    71	            sorted(resolved),
    72	        )
    73	    return rag_collections, unresolved

