   150	            ephemeral=bool(cfg.get("ephemeral", False)),
   151	            pinned_version=pinned_version,
   152	            exec_version=exec_version,
   153	            prompt_name=prompt_name,
   154	            prompt_id=prompt_id,
   155	            pins=pins,
   156	            model_cfg=model_cfg,
   157	            nodes_resolved=nodes_resolved,
   158	            mem_cfg=mem_cfg,
   159	            mcp_servers=mcp_servers,
