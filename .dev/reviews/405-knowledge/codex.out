   410	          message.success(`'${colName}'에 저장돼 이번 세션에 배선됐습니다 — 영구 배선은 에이전트 편집에서.`)
   411	          return
   412	        }
   413	        if (row?.status === 'error') {
   414	          patchKJob(agentId, file.name, { status: 'error', err: row.error ?? '인제스트 실패' })
   415	          message.error(`인제스트 실패: ${row.error ?? '(원인 미상)'}`)
   416	          return
   417	        }
   418	      }
   419	      patchKJob(agentId, file.name, { status: 'error', err: '시간 초과' })
   420	    } catch (e) {
   421	      const msg = e instanceof Error ? e.message : String(e)
   422	      if (file) patchKJob(agentId, file.name, { status: 'error', err: msg })
   423	      message.error(msg)
   424	    }
   425	  }
   426	
   427	  const send = async (text: string, form?: { formId: string; values: Record<string, string> }) => {
   428	    if (streaming) return
   429	    const id = activeId
   430	    if (!id) return
   431	    // 승인 대기 중엔 새 입력 차단(스펙 179 P3) — 그래프가 그 턴에서 멈춰 있어, 새 턴을 끼우면
   432	    // 저장시각(created_at) 순서가 어긋나(대기 턴이 나중 저장) 대화가 뒤바뀐다. 승인/거부 후 이어간다.
   433	    if (pendingApproval && pendingApproval.convoId === id) return
   434	    // 폼 대기는 입력을 잠그지 않는다(이중 입력 일급, 스펙 188) — 전송 시작 시 이 대화의 폼을 내리고,
   435	    // 서버가 재제시(form 프레임)하면 콜백이 다시 세운다.
   555	        controllerRef.current = null
   556	        setStreaming(false)
   557	      }
   558	    }
   559	  }
   560	
   561	  const switchAgent = (id: string) => {
   562	    stop()
   563	    setActiveId(id)
   564	    // 서랍 열린 채 에이전트를 바꾸면 닫는다(후속28, 사용자) — 열린 서랍은 이전 에이전트의
   565	    // 오버라이드 폼이라 새 에이전트와 안 맞는 상태를 노출하게 됨.
   566	    setOverridePanelOpen(false)
   567	  }
   568	
   569	  // "새 대화" — 활성 에이전트의 대화·세션을 비워 처음부터 다시 시작한다(스펙 032: userId 잠금 분리).
   570	  const resetConversation = () => {
   571	    stop()
   572	    // 진행 중인 세션 로드가 리셋된 대화를 되살리지 않도록 시퀀스를 무효화(codex 지적).
   573	    sessionLoadSeqRef.current++
   574	    setConvos((c) => ({ ...c, [activeId]: [] }))
   575	    setSessions((s) => {
   576	      const n = { ...s }
   577	      delete n[activeId]
   578	      return n
   579	    })
   580	    setSelectedTurn(null)
   581	    setInspectorOpen(false)
   582	    // 세션 칩 힌트("클릭하여 다른 세션 선택"/"첫 세션…")가 최신 목록 기준이 되도록(스펙 248 후속9 —
   583	    // 드롭다운 열 때만 리로드하면 방금 만든 세션이 안 잡혀 문구가 틀린다).
   584	    refreshSessions()
   585	  }
   586	
   587	  // 버전 미리보기 선택(스펙 243) — 바꾸면 새 대화로 리셋(한 대화에 버전 혼재 방지·오버라이드 결과 동일).
   588	  const pinVersion = (v?: string) => {
   589	    setPinnedVersions((m) => ({ ...m, [activeId]: v }))
   590	    resetConversation()
   591	  }
   592	
   593	  // 과거 세션 선택 → DB 메시지를 불러와 대화 복원 + session_id를 활성 세션으로 고정(스펙 055).
   594	  // 이어 보내기는 기존 send()가 sessions[id]를 그대로 써 같은 세션에 쌓인다. 컨텍스트도 복원된
   595	  // convos에서 재구성되어 일관. 진행 중 스트림이 있으면 먼저 멈춘다(025 리셋 흐름과 동일 안전).
   596	  const loadSession = (sid: string) => {
   597	    if (!activeId || sid === sessions[activeId]) return
   598	    // 방어 가드(codex): 피커는 활성 에이전트 세션만 보여주지만, 늦게 도착한 다른 에이전트
   599	    // 목록이 섞였을 가능성을 차단 — 선택 세션이 활성 에이전트 소속이 아니면 무시.
   600	    const picked = sessionList.find((s) => s.id === sid)
   601	    if (picked && activeAgent && picked.agentId !== activeAgent.agentId) return
   602	    stop()
   603	    const seq = ++sessionLoadSeqRef.current
   604	    const targetId = activeId // 로드 중 에이전트가 바뀌어도 원 에이전트 대화에만 반영.
   605	    const prevSid = sessions[targetId] // 실패 시 롤백용(undefined면 새 세션 상태로 복귀).
   606	    // session_id를 먼저 고정 — 메시지 로드 완료 전에 전송해도 같은(올바른) 세션에 쌓이게.
   607	    setSessions((s) => ({ ...s, [targetId]: sid }))
   608	    getSessionMessages(sid)
   609	      .then((msgs) => {
   610	        if (seq !== sessionLoadSeqRef.current) return // 더 최신 선택이 있으면 폐기(레이스).
   611	        if (overrideActive) {
   612	          // 스펙 134 — 오버라이드는 세션 속성이 아니라 "지금 적용 중" 상태: 과거 세션에 이어 쓰면 이전
   613	          // 턴들과 설정이 다를 수 있음을 환기(로드 **성공 시에만** — 실패 시 뜨면 오해 소지).
   614	          // 턴별 진실은 인스펙터 "오버라이드" 섹션이 영구 기록.
   615	          message.info('오버라이드 적용 중 — 이 세션의 이전 턴들과 설정이 다를 수 있습니다.')
   616	        }
   617	        const mapped: ChatMsg[] = msgs.map((m) => ({
   618	          role: m.role === 'assistant' ? 'ai' : 'me',
   619	          text: m.content,
   620	          trace: (m.trace as unknown as Trace) ?? undefined,
   621	          id: m.id ?? undefined, // 스펙 209 P1.5 — 피드백 부착용(assistant만 서버가 채움)
   622	          feedback: m.feedback ?? null,
   623	        }))
   624	        setConvos((c) => ({ ...c, [targetId]: mapped }))
   625	        setSelectedTurn(null)
   626	        setInspectorOpen(false)
   627	      })
   628	      .catch(() => {
   629	        // 로드 실패 → 낙관적으로 고정한 session_id를 원복(이전 세션에 묶인 채 남지 않게, codex).
   630	        if (seq === sessionLoadSeqRef.current) {
   631	          setSessions((s) => {
   632	            const n = { ...s }
   633	            if (prevSid === undefined) delete n[targetId]
   634	            else n[targetId] = prevSid
   635	            return n
   636	          })
   637	        }
   638	        message.error('세션을 불러오지 못했습니다.')
   639	      })
   640	  }
   660	  const openInspector = (i: number) => {
   661	    setSelectedTurn(i)
   662	    setInspectorOpen(true)
   663	  }
   664	
   665	  const selectedMsg = selectedTurn != null ? messages[selectedTurn] : null
   666	  // 턴 번호(스펙 205) — 배열 인덱스가 아니라 그 시점까지의 user 메시지 수(질문 순번). 1문답="턴 1".
   667	  const selectedTurnNo = selectedTurn != null
   668	    ? messages.slice(0, selectedTurn + 1).filter((m) => m.role === 'me').length
   669	    : 1
   670	
   671	  // 오버라이드 서랍(스펙 248 후속17) — DebugChat의 헤더 아래 영역에 렌더(U 손잡이 바로 아래서 내려옴).
   672	  // 후속19(사용자): 닫기도 같은 손잡이로 — 서랍이 열리면 손잡이가 서랍 앞면 하단(우측)으로 내려온
   673	  // 것처럼, 하단 U를 당기면(클릭) 서랍이 올라간다. 좌측 X는 제거(여닫이 입구 일원화).
   674	  const overridePanelNode = (
   675	    <>
   676	      <Modal
   677	        open={!!kModal}
   678	        title="지식으로 저장 (RAG)"
   679	        okText="저장"
   680	        cancelText="취소"
   681	        onCancel={() => setKModal(null)}
   682	        onOk={() => void runKnowledgeIngest()}
   683	        okButtonProps={{ disabled: !kTarget && !kNewName.trim() }}
   684	      >
   685	        <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
   686	          <div>
   687	            📎 <b>{kModal?.file.name}</b> — 문서를 컬렉션에 저장하고 이번 세션에 배선합니다.
   688	            <div style={{ fontSize: 12, color: 'var(--color-text-tertiary)', marginTop: 4 }}>
   689	              저장된 문서는 지식 자산으로 남습니다. 배선은 이번 세션 한정 — 영구 배선은 에이전트 편집에서.
   690	            </div>
   691	          </div>
   692	          <Select
   693	            placeholder="기존 컬렉션 선택 (또는 아래에 새 이름 입력)"
   694	            value={kTarget || undefined}
   695	            onChange={(v) => setKTarget(v)}
   696	            allowClear
   697	            onClear={() => setKTarget('')}
   698	            options={collections
   699	              .filter((c) => (c.kind ?? 'document') === 'document')
   700	              .map((c) => ({ value: c.id, label: c.name }))}
   701	          />
   702	          {!kTarget && (
   703	            <Input
   704	              placeholder="새 컬렉션 이름 (영소문자·숫자·대시)"
   705	              value={kNewName}
   706	              onChange={(e) => setKNewName(e.target.value)}
   707	            />
   708	          )}
   709	        </div>
   710	      </Modal>
   760	      />
   761	    </>
   762	  )
   763	
   764	  return (
   765	    <div style={{ flex: 1, minHeight: 0, display: 'flex', background: 'var(--color-bg-container)' }}>
   766	      {inspectorOpen && !overlayInspector ? (
   767	        /* 도킹 인스펙터를 antd Splitter로(스펙 204) — 수제 aside 고정폭 대신 드래그 리사이즈.
   768	           채팅‖인스펙터 분할은 Splitter.Panel이 폭을 소유한다(Inspector aside는 width 100%). */
