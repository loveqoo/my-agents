    97	def assert_may_manage(
    98	    resource: object,
    99	    principal: User | str | None,
   100	    enforcer: casbin.AsyncEnforcer | None = None,
   101	    not_found_detail: str = "not found",
   102	) -> None:
   103	    """카탈로그 항목 수정/삭제 게이트(스펙 112) — 특권 or 소유자 본인만. 아니면 **404-fold**(존재
   104	    비노출, 068 — 남의/NULL-owned 항목을 403으로 구분해주지 않는다). NULL-owned는 특권만(fail-closed).
   105	    호출자는 resource를 이미 로드한 상태(존재 404는 먼저 처리). 단일 게이트 헬퍼(drift 0).
   106	    enforcer 미전달이면 is_privileged가 지연 로드(머신·superuser는 casbin 미접촉).
   107	
   108	    **`not_found_detail`은 그 라우트의 존재-404 detail과 반드시 일치시킨다**(codex 112 P1): 비소유 거부가
   109	    "not found"인데 미존재가 "agent not found"면 body 차이로 존재가 새어(068 위반). 같은 status+같은 body라야
   110	    404-fold가 성립한다."""
   111	    from fastapi import HTTPException
   112	
   113	    if may_manage(getattr(resource, "owner_id", None), principal, enforcer):
   114	        return
   115	    raise HTTPException(status_code=404, detail=not_found_detail)
   116	
   117	
   118	# (스펙 211) agent_may_wire(스펙 113 배선 인가 술어)는 "사용=공용" 정책 전환으로 제거.
   119	# MCP/RAG 등 카탈로그 자원의 **사용(배선)**은 등록만 되면 허용, **관리(수정/삭제)**는
   120	# assert_may_manage(소유자/특권)가 계속 게이트한다. 커스텀 MCP의 외부 노출은 published가
   121	# 서빙 게이트(served_mcp._is_served)로만 소비된다.
   122	def may_use_agent(agent: object, principal: User | str | None) -> bool:
   123	    """에이전트 **사용**(채팅·목록 노출) 게이트 — 스펙 147 트리:
   124	    public(owner 없음)=모두, private(owner 있음)=소유자·특권만, external=항상(가져다 쓰는 것).
   125	    관리(may_manage)와 축이 다르다 — public은 모두 사용하지만 관리는 특권만."""
   126	    if is_third_party(getattr(agent, "source", "ui")):
   127	        return True  # 가져다 쓰는 것(external) — 사용 항상 허용(스펙 147)
   128	    owner = getattr(agent, "owner_id", None)
