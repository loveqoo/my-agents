   126	            ext_agent_id=agent.agent_id,
   127	            agent_name=agent.name,
   128	            agent_pk=agent.id,
   129	            source=agent.source,
   130	            impl=cfg.get("impl"),
   131	            artifact_spec=cfg.get("artifactSpec"),
