    18	def _used_node_tools(nodes: list[dict]) -> set[str]:
    19	    """노드들이 참조하는 도구명(접두명 srv__tool + 구저장 민이름) 합집합."""
    20	    return {t for n in nodes for t in (n.get("tools") or []) if isinstance(t, str)}
    21	
    22	
    23	def _server_tool_used(s: McpServer, used: set[str], bare_owners: dict[str, set[str]]) -> bool:
    24	    """서버 도구 중 노드가 참조한 것이 있는가 — 접두명(srv__tool) 또는 전역 유일 민이름."""
    25	    return any(
    26	        runtime._safe_name(s.name, t) in used or (t in used and len(bare_owners.get(t) or ()) == 1)
    27	        for t in (s.tools or [])
    28	    )
    29	
    30	
    31	def _mcp_pool(servers: Sequence[McpServer], used: set[str]) -> list[str]:
    32	    """노드 참조 도구를 보유한 MCP 서버 이름 목록.
    33	
    34	    민이름(bare, 구저장 'echo'류) 매칭은 **전역 유일할 때만**(codex 289 #4) — 같은 도구명이 여러
    35	    서버에 있으면 모두 풀에 열려 불필요한 MCP 접속이 생긴다. 모호=제외(fail-closed — 런타임
    36	    _resolve_tool의 모호 스킵(265)과 같은 결). 접두명(srv__tool)은 모호성이 없어 그대로."""
    37	    bare_owners: dict[str, set[str]] = {}
    38	    for server in servers:
    39	        for tool in server.tools or []:
    40	            bare_owners.setdefault(tool, set()).add(server.name)
    41	    return [s.name for s in servers if _server_tool_used(s, used, bare_owners)]
    42	
    43	
    44	def _doc_pool(cols: list[str], used: set[str]) -> list[str]:
    45	    """노드 참조 문서 컬렉션 목록 — 민이름 'search_documents'는 전체 컬렉션."""
    46	    if "search_documents" in used:
    47	        return list(cols)
    48	    return [c for c in cols if runtime._safe_name("search_documents", c) in used]
    49	
    50	
    51	def _derive_pool(
    52	    nodes: list[dict], servers: Sequence[McpServer], cols: list[str]
    53	) -> dict[str, list]:
    54	    """풀 합집합 계산(순수 — DB 무접촉, 스펙 394 분해): 해석된 노드들의 참조로 mcps/vectorTables/
    55	    memories/capabilities를 파생. 규칙은 폼 derivePipelinePool과 동일(단일 의미)."""
    56	    used = _used_node_tools(nodes)
    57	    return {
    58	        "mcps": _mcp_pool(servers, used),
    59	        "vectorTables": _doc_pool(cols, used),
    60	        "memories": sorted(
    61	            {m for n in nodes for m in (n.get("memories") or []) if isinstance(m, str)}
    62	        ),
    63	        # 에이전트-호출 축 파생(스펙 318) — 노드 `tools`의 `agent__{agent_id}`에서 대상 id를 뽑아
    64	        # capabilities(브로커 allowlist)로 심는다. 권한 비상승: 노드가 이미 참조하는 것의 합집합.
    65	        # 자기 참조는 런타임 방문 집합(_delegable)이 최종 차단(UI도 선배제).
    66	        "capabilities": sorted(
    67	            {
    68	                t[len("agent__") :]
    69	                for t in used
    70	                if t.startswith("agent__") and len(t) > len("agent__")
    71	            }
    72	        ),
    73	    }
