   843	        selectedTurn={inspectorOpen ? selectedTurn : null}
   844	        onSelectTurn={openInspector}
   845	        attachments={attachments}
   846	        onAttachFiles={attachFiles}
   847	        onRemoveAttachment={(i) => setAttachments((prev) => prev.filter((_, x) => x !== i))}
   848	        knowledgeJobs={kJobsByAgent[activeId] ?? []}
   849	        onAttachKnowledge={knowledgeAttach}
   850	        onDismissKnowledgeJob={(i) =>
   851	          setKJobsByAgent((m) => ({ ...m, [activeId]: (m[activeId] || []).filter((_, x) => x !== i) }))
   852	        }
   853	        onSend={send}
   854	        onStop={stop}
   855	        onResetConversation={resetConversation}
   856	        inspectorOpen={inspectorOpen}
   857	        overrideActive={overrideActive}
   858	        onToggleOverrides={() => setOverridePanelOpen((o) => !o)}
   859	        a2aMode={!!a2aByAgent[activeId]}
   860	        onToggleA2A={(v) => setA2aByAgent((m) => ({ ...m, [activeId]: v }))}
    90	  const chip = header ? (
    91	    <Tag
    92	      color={b.remote ? 'default' : 'blue'}
    93	      style={{ fontFamily: 'var(--font-family-code)', fontWeight: 600, marginInlineEnd: 6 }}
    94	    >
    95	      {b.text}
    96	    </Tag>
    97	  ) : (
    98	    <Tag bordered={false} style={{ fontFamily: 'var(--font-family-code)', fontSize: 11, color: 'var(--color-text-tertiary)', background: 'transparent', paddingInline: 0, marginInlineEnd: 0 }}>
    99	      {b.text}
   100	    </Tag>
   101	  )
   102	  return b.tip ? <Tooltip title={b.tip}>{chip}</Tooltip> : chip
   103	}
   104	
   105	/* 미활성 초안 감지(스펙 078): 편집은 항상 draft 버전에 저장되고 Playground는 활성 서빙
   106	   config를 실행하므로, 초안이 있으면 "편집이 아직 반영 안 됨"이다. 진실원은 agent.versions
   107	   (list_agents가 draft 포함 전 버전 직렬화) — mock 상수 아님(learning 035). code/external은
   108	   draft 상태 버전이 없어 자연히 false. */
   109	function hasDraft(a: Agent): boolean {
   110	  // 스크래치(미오픈 작업본, 스펙 370 — 구 초안).
   111	  return (a.versions ?? []).some((v) => !v.everOpened)
   112	}
   113	
   114	/* 헤더/피커에 다는 미반영 초안 배지. compact면 아이콘만(좁은 폭에서도 안내 보존). */
   115	function DraftBadge({ compact }: { compact?: boolean }) {
   116	  return (
   117	    <Tooltip title="이 에이전트에 오픈되지 않은 작업본이 있습니다. Playground는 오픈된 버전을 실행합니다 — 변경을 반영하려면 에이전트에서 작업본을 오픈하세요.">
   118	      <Tag color="gold" style={{ margin: 0, display: 'inline-flex', alignItems: 'center', gap: 4 }}>
   119	        <Icon name="edit" size={11} />
   120	        {compact ? null : '미반영 작업본'}
   121	      </Tag>
   122	    </Tooltip>
   123	  )
   124	}
   125	
   126	interface DebugChatProps {
   127	  overrideOpen?: boolean // 서랍 열림 — 여는 손잡이 숨김(후속27: 손잡이는 서랍과 함께 내려갔다)
   128	  overridePanel?: React.ReactNode // 오버라이드 top 드로어 — 헤더 아래 영역에서 내려오도록 여기서 렌더
   129	  agent: Agent | null
   130	  agents: Agent[]
   131	  onSwitchAgent: (id: string) => void
   132	  sessions: Session[]
   133	  currentSessionId?: string
   134	  sessionsLoading: boolean
   135	  onPickSession: (sid: string) => void
   136	  onReloadSessions: () => void
   137	  messages: ChatMsg[]
   138	  // 스펙 209 P1.5 — assistant 응답 피드백(👍/👎) 변경을 상위(convos)로 전파(낙관 갱신).
   139	  onFeedbackChange?: (msgIndex: number, fb: MessageFeedback | null) => void
   140	  streaming: boolean
   141	  awaitingApproval: boolean // 승인 대기 중(스펙 179 P3) — 입력 차단(그래프가 그 턴에서 멈춤)
   142	  approvalCanResolve?: boolean // 인라인 승인(스펙 180) — 현재 사용자가 이 승인을 그 자리서 처리 가능
   143	  approvalKind?: 'self' | 'admin' // 승인 종류(라벨용)
   144	  onResolveApproval?: (decision: 'approve' | 'reject') => Promise<void> | void
   145	  // 산출물형 폼(스펙 188) — 폼 프레임이 오면 입력 위에 렌더. 제출은 onSubmitForm, 텍스트 입력도
