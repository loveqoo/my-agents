   793	        onSubmitForm={submitForm}
   794	        selectedTurn={inspectorOpen ? selectedTurn : null}
   795	        onSelectTurn={openInspector}
   796	        attachments={attachments}
   797	        onAttachFiles={attachFiles}
   798	        onRemoveAttachment={(i) => setAttachments((prev) => prev.filter((_, x) => x !== i))}
   799	        knowledgeJobs={kJobsByAgent[activeId] ?? []}
   800	        onAttachKnowledge={knowledgeAttach}
   801	        onDismissKnowledgeJob={(i) =>
