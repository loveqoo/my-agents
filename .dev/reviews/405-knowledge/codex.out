   835	        onFeedbackChange={handleFeedbackChange}
   836	        streaming={streaming}
   837	        awaitingApproval={!!pendingApproval && pendingApproval.convoId === activeId}
   838	        approvalCanResolve={canResolvePending && pendingApproval?.convoId === activeId}
   839	        approvalKind={pendingApproval?.approver === 'self' ? 'self' : 'admin'}
