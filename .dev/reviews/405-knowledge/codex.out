   786	        onFeedbackChange={handleFeedbackChange}
   787	        streaming={streaming}
   788	        awaitingApproval={!!pendingApproval && pendingApproval.convoId === activeId}
   789	        approvalCanResolve={canResolvePending && pendingApproval?.convoId === activeId}
   790	        approvalKind={pendingApproval?.approver === 'self' ? 'self' : 'admin'}
   791	        onResolveApproval={resolvePending}
