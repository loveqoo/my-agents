   810	        a2aMode={!!a2aByAgent[activeId]}
   811	        onToggleA2A={(v) => setA2aByAgent((m) => ({ ...m, [activeId]: v }))}
   812	        pinnedVersion={pinnedVersions[activeId]}
   813	        onPinVersion={pinVersion}
   814	      />
   815	            </div>
   816	          </Splitter.Panel>
   817	          <Splitter.Panel defaultSize={384} min={300} max={720}>
   818	            <Inspector agent={activeAgent} turn={selectedMsg} turnIndex={selectedTurnNo - 1} onClose={() => setInspectorOpen(false)} />
   819	          </Splitter.Panel>
   820	        </Splitter>
   821	      ) : (
   822	        <>
   823	      <DebugChat
   824	        agent={activeAgent}
   825	        agents={agents}
   826	        onSwitchAgent={switchAgent}
   827	        sessions={sessionList}
   828	        currentSessionId={sessions[activeId]}
   829	        sessionsLoading={sessionsLoading}
   830	        onPickSession={loadSession}
   831	        onReloadSessions={refreshSessions}
   832	        overridePanel={overridePanelNode}
   833	        overrideOpen={overridePanelOpen}
