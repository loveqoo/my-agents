    46	    col = await resolve_search_collection(session, cid)
    47	    try:
    48	        hits = await runtime.search_collections([col], body.query, body.top_k)
    49	    except runtime.RagSearchError as exc:
    50	        # 무중단 재인덱싱(스펙 313): 검색은 재인덱싱에 막히지 않으므로 locked(409)는 더 이상 발생하지
    51	        # 않는다. 빈 질의는 스키마(min_length=1)가 먼저 막으므로 여기 도달하는 건 embed/db 실패 — 502.
    52	        raise HTTPException(status_code=502, detail=exc.tool_msg) from exc
