   116	
   117	    # 엔티티 형식 위반은 여기서 400(스펙 149 계약 — 배경으로 밀면 400을 줄 수 없다). CPU 구간이라
   118	    # to_thread — 수만 행 파싱·스키마 검증이 이벤트 루프를 정지시키지 않게(스펙 334).
   119	    entity_rows = await asyncio.to_thread(_parse_entity_rows, c, data)
   120	
   121	    doc = Document(
   122	        collection_id=c.id,
   123	        filename=file.filename or "untitled",
   124	        content_type=file.content_type,
   125	        byte_size=len(data),
    25	    cid: uuid.UUID,
    26	    body: CollectionSearchIn,
