   773	            <div style={{ height: '100%', display: 'flex', minWidth: 0 }}>
   774	      <DebugChat
   775	        agent={activeAgent}
   776	        agents={agents}
   777	        onSwitchAgent={switchAgent}
   778	        sessions={sessionList}
   779	        currentSessionId={sessions[activeId]}
   780	        sessionsLoading={sessionsLoading}
   781	        onPickSession={loadSession}
   782	        onReloadSessions={refreshSessions}
   783	        overridePanel={overridePanelNode}
   784	        overrideOpen={overridePanelOpen}
