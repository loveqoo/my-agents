    44	@router.get("/{cid}/documents", response_model=DocumentPageOut)
    45	async def list_documents(
    46	    cid: uuid.UUID,
    47	    q: str | None = Query(None, max_length=500),
    48	    limit: int = Query(20, ge=1, le=100),
    49	    offset: int = Query(0, ge=0, le=1_000_000),
    50	    session: AsyncSession = Depends(get_session),
    51	    _principal: User | str = Depends(current_principal),
    52	) -> Any:
    53	    """문서 페이지 목록(스펙 128) — 문서는 증가 축이라 서버 페이지네이션 + 파일명 부분일치(q).
    54	
    55	    세션(list_sessions)과 동형: LIMIT/OFFSET + count total + ilike(`like_escape` 재사용 — 정본 sqlutil).
    56	    스코프(collection_id)는 SQL WHERE. 사용은 전부 공용(스펙 172) — 로그인한 누구나 문서 목록 조회
    57	    가능(익명은 current_principal이 401). 존재 404만 유지(관리는 여전히 소유자만)."""
    58	    col = await get_or_404(
    59	        session, Collection, cid
    60	    )  # 존재 404만(관리는 소유자만 — 아래 스코프 무관)
    61	    # blob 보존 여부를 outerjoin으로 동반 조회(스펙 331 editable — 행별 재조회 없이 한 방).
    62	    base = (
    63	        select(Document, DocumentBlob.document_id.isnot(None))
    64	        .outerjoin(DocumentBlob, DocumentBlob.document_id == Document.id)
    65	        .where(Document.collection_id == cid)
    66	    )
    67	    if q and q.strip():
    68	        base = base.where(Document.filename.ilike(f"%{like_escape(q.strip())}%", escape="\\"))
    69	    total = (await session.execute(select(func.count()).select_from(base.subquery()))).scalar_one()
    70	    rows = (
    71	        # id tiebreak — 같은 created_at(한 트랜잭션 일괄 인제스트)에서도 페이지가 결정적·비중복(127 원칙).
    72	        await session.execute(
    73	            base.order_by(Document.created_at, Document.id).offset(offset).limit(limit)
    74	        )
    75	    ).all()
    76	    items = [
    77	        DocumentOut.model_validate(doc).model_copy(
    78	            update={"editable": _doc_editable(col, doc, has_blob)[0]}
    79	        )
    80	        for doc, has_blob in rows
    81	    ]
    82	    # 전역 처리 중 신호(스펙 334, codex P2) — 현재 페이지/검색어와 무관하게 컬렉션 전체 기준.
    83	    processing = (
    84	        await session.execute(
    85	            select(func.count())
    86	            .select_from(Document)
    87	            .where(Document.collection_id == cid, Document.status.in_(("parsing", "embedding")))
    88	        )
    89	    ).scalar_one()
    90	    return DocumentPageOut(items=items, total=total, processing=processing)
    91	
