   105	        cfg, prompt, pinned_version, nodes_status, applied_overrides = await _prepare_cfg(
   106	            db, agent, version, overrides
   107	        )
   108	        remote = _is_remote(agent.source)
   109	        # 실행 버전(스펙 242) — pinned=지정 버전(미리보기), exec=실제 실행 버전(지정 없으면 활성).
   110	        # trace.agentVersion 기록·HIL 게이트(pinned는 승인 재개가 서빙 config로 돌아 drift) 근거.
