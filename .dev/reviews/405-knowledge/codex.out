    84	def may_manage(
    85	    row_owner: str | None,
    86	    principal: User | str | None,
    87	    enforcer: casbin.AsyncEnforcer | None = None,
    88	) -> bool:
    89	    """관리 가능 여부 **불리언 술어**(스펙 114) — assert_may_manage의 형제(단일 술어, drift 0).
    90	    특권(머신·superuser·admin 역할) or 소유자 본인. UI가 can_manage를 이걸로 파생(프론트 재계산 금지)."""
    91	    if is_privileged(principal, enforcer):
    92	        return True
    93	    oid = owner_of(principal)
    94	    return bool(oid) and row_owner == oid
    95	
