     1	"""노드형 파이프라인 풀 파생 — chat_context.py에서 분할(스펙 394 P4).
     2	
     3	derive_pipeline_pool(구 CC 14)은 **순수 파생**(_derive_pool — DB 무접촉)과 **DB 래퍼**
     4	(derive_pipeline_pool — 이름·cfg mutate 계약 유지)로 분리(codex 자문).
     5	파사드는 chat_context.py(재수출 계약).
     6	"""
     7	
     8	from collections.abc import Sequence
     9	
    10	from sqlalchemy import select
