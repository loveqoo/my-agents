    10	# 노드 오버라이드 필드 화이트리스트(스펙 287) — 구조 식별자(name)는 제외해 저장본 유지.
    11	# 노드 추가/삭제는 테스트 범위 밖(사용자 결정): 오버라이드는 "이 에이전트 그대로, 설정만 바꿔
    12	# 테스트"가 목적이라 구조 변경 요청은 받지 않는다(서버 강제 — 클라이언트 신뢰 금지).
    13	_NODE_OVERRIDE_FIELDS = {
    14	    "prompt",
    15	    "model",
    16	    "tools",
    17	    "historyDepth",
    18	    "memories",
    19	    "memoryQuery",
    20	    "context",
