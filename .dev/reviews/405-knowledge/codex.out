    71	def _coerce_history_depth(cfg: dict, agent: Agent) -> None:
    72	    """historyDepth 형 가드(codex 287 Low) — 비정수(예: 문자열)는 _window의 `depth < 0` 비교에서
    73	    TypeError 500. 정수화 실패 시 저장값 폴백(요청 하나로 500 못 만들게)."""
    74	    if isinstance(cfg.get("historyDepth"), int):
    75	        return
    76	    try:
    77	        cfg["historyDepth"] = int(cfg["historyDepth"])
    78	    except (TypeError, ValueError):
    79	        cfg["historyDepth"] = (agent.config or {}).get("historyDepth", 20)
    80	
    81	
    82	def _apply_overrides(
    83	    cfg: dict, prompt: str, overrides: dict | None, agent: Agent, allowed: set
    84	) -> tuple[dict, str, str | None, dict | None]:
    85	    """web 한정 세션 오버라이드 병합(스펙 025) — 화이트리스트 키만, 저장 에이전트는 불변.
    86	
    87	    코드·외부(원격) 에이전트는 미적용(bypass 보존 — 026 read-only 취급). 모델은 여전히
    88	    cfg["model"] 이름으로 레지스트리에서만 해석 → [012] 단일 소스 불변식 유지.
    89	    - capabilities(스펙 122): 브로커가 build_broker(principal=호출자)로 호출자 RBAC 게이트
    90	      (_permitted = allowlist ∩ RBAC)하므로 주입분도 안전(confused-deputy 무관).
    91	    - tools(스펙 276): 직접형 도구 단위 배선 — 노출 축소/서버별 필터라 완화 아님.
    92	    - vectorTables(스펙 287): 노드형 문서 풀 파생의 실효 축 — RAG 읽기(사용=공용 정책 211).
    93	    - nodes(스펙 287): 구조 불변 강제 merge(allowed와 분리 — 통짜 교체가 아니라 저장 노드 위
    94	      필드 merge, 추가/삭제=범위 밖). 미적용 사유(mismatch)는 트레이스가 표면화.
    95	    반환 (cfg, prompt, nodes_status, passthrough) — passthrough=적용된 원본 오버라이드(미적용=None):
    96	    in-process 커스텀 에이전트가 화이트리스트 밖 키도 읽게 ctx["overrides"]로 전달(스펙 085)."""
    97	    if not overrides or _is_remote(agent.source):
    98	        return cfg, prompt, None, None
    99	    cfg.update({k: v for k, v in overrides.items() if k in allowed})
   100	    if "historyDepth" in overrides:
   101	        _coerce_history_depth(cfg, agent)
   102	    # systemPrompt는 비어있지 않을 때만 prompt를 덮어쓴다 — 빈/공백 문자열로
   103	    # 저장된 프롬프트를 지우지 않도록(백엔드 자체 가드, 클라이언트 신뢰 안 함. codex P1).
   104	    sp = overrides.get("systemPrompt")
   105	    if isinstance(sp, str) and sp.strip():
   106	        prompt = sp
   107	    nodes_status: str | None = None
   108	    if overrides.get("nodes") is not None:
   109	        if isinstance(cfg.get("nodes"), list):
   110	            cfg["nodes"], nodes_status = _merge_node_overrides(cfg["nodes"], overrides["nodes"])
   111	        else:
   112	            nodes_status = "mismatch"  # 노드형이 아닌 에이전트에 nodes를 보냄
