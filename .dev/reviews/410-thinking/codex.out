   832	function handleFrame(frame: string, cb: ChatCallbacks): boolean {
   833	  const lines = frame.split('\n')
   834	  const event = lines.find((l) => l.startsWith('event: '))?.slice(7)
   835	  const dataLine = lines.find((l) => l.startsWith('data: '))
   836	  if (!dataLine) return false
   837	  const data = dataLine.slice(6)
   838	  // 스펙 314: [DONE]은 '턴 논리 완료'일 뿐 스트림 종료가 아니다 — 이후 트레일링 event: memory가 올 수
   839	  // 있어 계속 읽는다(리더는 서버가 스트림을 닫을 때/abort 시 끝난다). 완료 처리는 onDone로.
   840	  if (data === '[DONE]') {
   841	    cb.onDone?.()
   842	    return false
   843	  }
   844	  try {
   845	    const parsed = JSON.parse(data)
   846	    if (event === 'trace') cb.onTrace?.(parsed)
   847	    else if (event === 'memory' && typeof parsed.mid === 'string') cb.onMemory?.(parsed.mid, parsed.memorySaved)
   848	    else if (event === 'message_id' && typeof parsed.id === 'string') cb.onMessageId?.(parsed.id)
   849	    else if (typeof parsed.reasoning === 'string') cb.onReasoning?.(parsed.reasoning)
   850	    else if (typeof parsed.text === 'string') cb.onToken(parsed.text)
   851	    else if (typeof parsed.session === 'string') cb.onSession?.(parsed.session)
   852	    else if (typeof parsed.error === 'string') cb.onToken(`\n[오류] ${parsed.error}`)
   853	    // 승인 대기 프레임은 text와 approval을 함께 실어 온다 — text는 위에서 토큰으로 표시하고,
   854	    // approval id는 별도로 표면화(else-if 아님)해 요청자 폴링을 트리거한다(스펙 179).
   855	    if (typeof parsed.approval === 'string')
   856	      cb.onApproval?.(parsed.approval, typeof parsed.approver === 'string' ? parsed.approver : undefined)
