   858	    if (parsed.form && typeof parsed.formId === 'string') cb.onForm?.(parsed.formId, parsed.form)
   859	    if (parsed.artifact && typeof parsed.artifact.kind === 'string') cb.onArtifact?.(parsed.artifact)
   860	  } catch {
   861	    /* 비-JSON 프레임 무시 */
   862	  }
   863	  return false
   864	}
   865	
   866	/** A2A 서빙 프레임(스펙 155) 파서 — direct용 handleFrame과 형태가 달라 별도.
   867	 * JSON-RPC message/stream: result.kind==="status-update" → status.message.parts[].text 델타,
   868	 * final:true 또는 [DONE]에서 종료. error 프레임은 표면화. 세션/trace는 A2A가 안 준다(정직). */
   869	function handleA2AFrame(frame: string, onToken: (t: string) => void): boolean {
   870	  const dataLine = frame.split('\n').find((l) => l.startsWith('data: '))
   871	  // 프레임에 `data:`가 없으면 SSE가 아니다 — 서버가 스트림 대신 평문 JSON-RPC error 바디를 준 경우
   872	  // (루프 가드 -32000, 미지원 메서드 -32601 등은 dispatch 전에 평문으로 반환). 통째로 파싱해 표면화.
   873	  const data = dataLine ? dataLine.slice(6) : frame.trim()
   874	  if (!data) return false
   875	  if (data === '[DONE]') return true
   876	  try {
   877	    const parsed = JSON.parse(data)
   878	    const err = parsed.error
   879	    if (err) {
   880	      onToken(`\n[오류] ${typeof err === 'object' ? err.message ?? JSON.stringify(err) : err}`)
   881	      return false
   882	    }
   883	    const result = parsed.result
   884	    if (result && result.kind === 'status-update') {
   885	      const parts = result.status?.message?.parts
   886	      if (Array.isArray(parts)) {
   887	        for (const p of parts) {
   888	          if (p && p.kind === 'text' && typeof p.text === 'string' && p.text) onToken(p.text)
   889	        }
   890	      }
   891	      if (result.final === true) return true
   892	    }
   893	  } catch {
   894	    /* 비-JSON 프레임 무시 */
   895	  }
   896	  return false
   897	}
   898	
   899	/** A2A 경유 테스트(스펙 155) — 노출 에이전트(source∈{ui,code} + exposed.a2a)를 외부 소비자처럼
   900	 * `/agents/{id}/a2a` JSON-RPC message/stream으로 호출한다. 단발 메시지 텍스트만 전달(세션/히스토리/
   901	 * trace/오버라이드 없음 — 우리 A2A 서빙이 안 넘김). 인증은 direct와 동일(current_principal). */
   902	export async function streamChatA2A(
   903	  agentId: string,
   904	  text: string,
   905	  onToken: (t: string) => void,
   906	  signal?: AbortSignal,
   907	): Promise<void> {
   908	  const res = await fetch(`${BASE}/agents/${agentId}/a2a`, {
   909	    method: 'POST',
   910	    credentials: 'include',
    90	        return self.ctx.session_id
    91	
    92	    @property
    93	    def outcome(self) -> ServeOutcome:
    94	        """스트림 소진 후의 최종 결과. 소진 전 접근은 프로그래밍 오류로 즉시 죽인다(fail-loud)."""
