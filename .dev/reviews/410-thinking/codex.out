    10	실행: uv run --project packages/api python tests/verify_410_thinking_display.py
    11	"""
    12	
    13	import os
    14	import sys
    15	
    16	ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    17	sys.path.insert(0, os.path.join(ROOT, "packages", "api", "src"))
    18	sys.path.insert(0, os.path.join(ROOT, "packages", "agent", "src"))
    19	
    20	_fails: list[str] = []
    21	passed = 0
    22	
    23	
    24	def check(cond: bool, msg: str) -> None:
    25	    global passed
    26	    print(("  ok  " if cond else " FAIL ") + msg)
    27	    if cond:
    28	        passed += 1
    29	    else:
    30	        _fails.append(msg)
    31	
    32	
    33	def main() -> None:
    34	    from agent.model import build_chat_openai
    35	
    36	    client = build_chat_openai({"base_url": "http://x/v1", "api_key": "k", "model_id": "m"})
    37	    check(type(client).__name__ == "ReasoningChatOpenAI", "U0 build_chat_openai가 ReasoningChatOpenAI 사용")
    38	
    39	    # U1 비스트리밍: reasoning_content 있는 응답 → additional_kwargs로 되살림.
    40	    resp = {
    41	        "id": "x",
    42	        "model": "m",
    43	        "choices": [
    44	            {
    45	                "index": 0,
    46	                "message": {"role": "assistant", "content": "13은 소수입니다.", "reasoning_content": "13을 2~3으로 나눠본다..."},
    47	                "finish_reason": "stop",
    48	            }
    49	        ],
    50	        "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
    51	    }
    52	    result = client._create_chat_result(resp)
    53	    msg = result.generations[0].message
    54	    check(
    55	        msg.additional_kwargs.get("reasoning_content") == "13을 2~3으로 나눠본다...",
    56	        f"U1a reasoning_content 추출 (got {msg.additional_kwargs.get('reasoning_content')!r})",
    57	    )
    58	    check(msg.content == "13은 소수입니다.", "U1b 본문(content)은 그대로")
    59	
    60	    # U1c 사고 없는 응답엔 reasoning_content 키 없음(무영향).
    61	    resp2 = {"id": "y", "model": "m", "choices": [{"index": 0, "message": {"role": "assistant", "content": "4"}, "finish_reason": "stop"}], "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}}
    62	    r2 = client._create_chat_result(resp2)
    63	    check("reasoning_content" not in r2.generations[0].message.additional_kwargs, "U1c 사고 없으면 키 부재(무영향)")
    64	
    65	    # U2 스트리밍 훅: delta.reasoning_content → additional_kwargs.
    66	    from langchain_core.messages import AIMessageChunk
    67	
    68	    chunk = {"choices": [{"index": 0, "delta": {"content": "부분", "reasoning_content": "생각조각"}, "finish_reason": None}]}
    69	    gen = client._convert_chunk_to_generation_chunk(chunk, AIMessageChunk, {})
    70	    check(
    71	        gen is not None and gen.message.additional_kwargs.get("reasoning_content") == "생각조각",
    72	        f"U2 스트리밍 델타 reasoning 추출 (got {getattr(gen and gen.message, 'additional_kwargs', {})})",
    73	    )
    74	
    75	    # U3 축 분리: _stream_reasoning=reasoning만, _stream_text=content만(reasoning 불포함).
    76	    from api.chat_sse_frames import _stream_reasoning, _stream_text
    77	
    78	    m = AIMessageChunk(content="답변 본문", additional_kwargs={"reasoning_content": "사고 과정"})
    79	    check(_stream_reasoning(m) == "사고 과정", f"U3a _stream_reasoning=reasoning (got {_stream_reasoning(m)!r})")
    80	    check(_stream_text(m) == "답변 본문", f"U3b _stream_text=content만 (got {_stream_text(m)!r})")
    81	    check("사고" not in _stream_text(m), "U3c 본문 추출에 reasoning 안 섞임(acc 오염 0 — 축 분리)")
    82	    # 사고 없는 메시지: reasoning 프레임 없음.
    83	    m2 = AIMessageChunk(content="그냥 답")
    84	    check(_stream_reasoning(m2) == "", "U3d 사고 없으면 reasoning 빈 문자열(프레임 없음)")
    85	
    86	    print(f"\n{passed} passed, {len(_fails)} failed")
    87	    if _fails:
    88	        sys.exit(1)
    89	    print("VERIFY410_OK")
    90	
    91	
    92	if __name__ == "__main__":
    93	    main()
     1	/* 사고 과정 표시 e2e(스펙 410) — 플레이그라운드가 thinking 응답의 사고 과정을 접이식 패널로
     2	   보여주는지 실증. 셋업(인증 fetch): MLX 기본 chat 모델의 thinking 능력 켜기 + 단건(stream=off)
     3	   thinking 에이전트 생성 → 채팅 → '사고 과정'(@ant-design/x Think) 패널 등장 단언 → 정리(복원).
     4	
     5	   실행: PLAYWRIGHT_DIR=<abs>/tests/e2e/node_modules/playwright node tests/browser/verify-410-thinking.mjs [out.png] */
     6	const pwDir = process.env.PLAYWRIGHT_DIR
     7	const _pw = await import(pwDir ? `${pwDir}/index.js` : 'playwright')
     8	const chromium = _pw.chromium ?? _pw.default?.chromium
     9	const URL = process.env.ADMIN_URL ?? 'http://127.0.0.1:5173'
    10	const _fx = process.env.ADMIN_EMAIL ? null : (await import('./_fixture.mjs')).provisionSuper()
    11	const EMAIL = process.env.ADMIN_EMAIL ?? _fx.email
    12	const PASSWORD = process.env.ADMIN_PASSWORD ?? _fx.password
    13	const OUT = process.argv[2] ?? '/tmp/verify-410-thinking.png'
    14	
    15	const browser = await chromium.launch({ channel: 'chrome', headless: true })
    16	const ctx = await browser.newContext({ viewport: { width: 1280, height: 900 } })
    17	const page = await ctx.newPage()
    18	const fails = []
    19	const ok = (cond, msg) => { console.log((cond ? '  ok  ' : ' FAIL ') + msg); if (!cond) fails.push(msg) }
    20	let created = null // { agentId, modelId, origCaps }
    21	try {
    22	  await page.goto(URL, { waitUntil: 'networkidle', timeout: 30000 })
    23	  await page.getByText('my-agents 로그인', { exact: true }).waitFor({ timeout: 10000 })
    24	  await page.getByPlaceholder('you@example.com').fill(EMAIL)
    25	  await page.getByPlaceholder('비밀번호').fill(PASSWORD)
    26	  await page.getByRole('button', { name: '로그인' }).click()
    27	  await page.waitForTimeout(1500)
    28	
    29	  // 셋업(인증 fetch, 같은 출처 /api 프록시): MLX chat 모델 thinking 능력 ON + 단건 thinking 에이전트.
    30	  created = await page.evaluate(async () => {
    31	    const j = (r) => r.json()
    32	    const models = await fetch('/api/models?kind=chat', { credentials: 'include' }).then(j)
    33	    // 기본 chat(MLX) 우선, 없으면 첫 원격 chat.
    34	    const mlx = models.find((m) => m.is_default) ?? models.find((m) => m.provider_kind === 'remote') ?? models[0]
    35	    const origCaps = { ...(mlx.capabilities ?? {}) }
    36	    await fetch(`/api/models/${mlx.id}`, {
    37	      method: 'PUT', credentials: 'include', headers: { 'Content-Type': 'application/json' },
    38	      body: JSON.stringify({ name: mlx.name, provider_id: mlx.provider_id, model_id: mlx.model_id,
    39	        kind: mlx.kind, is_default: mlx.is_default, params: mlx.params ?? {},
    40	        capabilities: { ...origCaps, thinking: true }, meta: mlx.meta ?? {} }),
    41	    })
    42	    const ag = await fetch('/api/agents', {
    43	      method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' },
    44	      // 스트리밍 모드(stream 미설정=기본 켜짐) — 서버가 reasoning을 델타로 실시간 스트리밍(스펙 410).
    45	      body: JSON.stringify({ name: 'v410-thinking', config: { model: mlx.name,
    46	        modelParams: { enable_thinking: true } } }),
    47	    }).then(j)
    48	    return { agentId: ag.id, modelId: mlx.id, origCaps }
    49	  })
    50	  ok(!!created?.agentId, '셋업: 단건 thinking 에이전트 생성')
    51	
    52	  // 플레이그라운드 이동 + 에이전트 선택.
    53	  const pg = page.getByText('Playground', { exact: true }).first()
    54	  if (!(await pg.isVisible().catch(() => false))) { await page.locator('button').first().click(); await page.waitForTimeout(500) }
    55	  await pg.waitFor({ timeout: 10000 }); await pg.click(); await page.waitForTimeout(2000)
    56	  const already = await page.getByText('v410-thinking', { exact: false }).first().isVisible().catch(() => false)
    57	  if (!already) {
    58	    await page.locator('button').filter({ hasText: /원격|코드 정의|기본|노드/ }).first().click()
    59	    await page.getByText('v410-thinking', { exact: false }).last().click()
    60	    await page.waitForTimeout(1200)
    61	  }
    62	  // 사고를 유발하는 프롬프트 전송(단건이라 완성까지 시간 소요 — 넉넉히 대기).
    63	  const input = page.getByPlaceholder(/에게 메시지/)
    64	  // 다단계 추론을 확실히 유발하는 문제(rapid-mlx는 유휴 후 첫 요청에서 사고 — 방정식 문제로 유도).
    65	  await input.fill('농장에 닭과 소가 합쳐 43마리, 다리는 총 116개다. 각각 몇 마리인지 방정식을 세워 단계적으로 풀어라.')
    66	  await input.press('Enter')
    67	  console.log('step: 사고 과정 패널 대기(단건 생성 — 최대 180s)')
    68	  await page.getByText('사고 과정', { exact: false }).first().waitFor({ timeout: 180000 })
    69	  ok(true, "① '사고 과정' 패널 등장(@ant-design/x Think — thinking 응답)")
    70	  // 펼쳐 내용 확인.
    71	  await page.getByText('사고 과정', { exact: false }).first().click().catch(() => {})
    72	  await page.waitForTimeout(800)
    73	  await page.screenshot({ path: OUT, fullPage: false })
    74	  console.log('SHOT', OUT)
    75	} catch (e) {
    76	  ok(false, `예외: ${e.message}`)
    77	  await page.screenshot({ path: OUT, fullPage: false }).catch(() => {})
    78	} finally {
    79	  // 정리: 에이전트 삭제 + 모델 능력 원복.
    80	  if (created?.agentId) {
    81	    await page.evaluate(async (c) => {
    82	      await fetch(`/api/agents/${c.agentId}`, { method: 'DELETE', credentials: 'include' }).catch(() => {})
    83	      const models = await fetch('/api/models?kind=chat', { credentials: 'include' }).then((r) => r.json()).catch(() => [])
    84	      const m = models.find((x) => x.id === c.modelId)
    85	      if (m) await fetch(`/api/models/${c.modelId}`, { method: 'PUT', credentials: 'include',
    86	        headers: { 'Content-Type': 'application/json' },
    87	        body: JSON.stringify({ name: m.name, provider_id: m.provider_id, model_id: m.model_id, kind: m.kind,
    88	          is_default: m.is_default, params: m.params ?? {}, capabilities: c.origCaps, meta: m.meta ?? {} }) }).catch(() => {})
    89	    }, created).catch(() => {})
    90	  }
    91	  await browser.close()
    92	}
    93	console.log(fails.length ? `VERIFY410_BROWSER_FAIL(${fails.length})` : 'VERIFY410_BROWSER_OK')
    94	process.exit(fails.length ? 1 : 0)
