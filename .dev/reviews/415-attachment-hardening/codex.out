    85	def _pdf_pypdf(data: bytes) -> str:
    86	    from pypdf import PdfReader
    87	
    88	    reader = PdfReader(io.BytesIO(data))
    89	    if len(reader.pages) > PDF_PAGE_CAP:
    90	        raise _ExtractError(413, f"PDF가 너무 깁니다 — {PDF_PAGE_CAP}페이지까지 지원합니다.")
    91	    return "\n".join((p.extract_text() or "") for p in reader.pages)
    92	
    93	
    94	def _pdf_pdfminer(data: bytes) -> str:
    95	    """pdfminer.six 폴백(스펙 407 P3, 승인된 의존성 — MIT) — CMap 처리가 pypdf보다 견고한
    96	    경우가 있어 pypdf가 깨졌을 때 한 번 더 시도.
    97	
    98	    페이지 캡은 폴백에서도 **거부**(codex 407 P1③: maxpages 절단은 pypdf 실패 경로에서 캡 우회 —
    99	    301페이지 PDF가 앞부분만 조용히 통과). cap+1페이지 존재를 탐지해 413."""
   100	    from pdfminer.high_level import extract_text as _pm_extract
   101	    from pdfminer.pdfpage import PDFPage
   102	
   103	    n_pages = sum(1 for _ in PDFPage.get_pages(io.BytesIO(data), maxpages=PDF_PAGE_CAP + 1))
   104	    if n_pages > PDF_PAGE_CAP:
   105	        raise _ExtractError(413, f"PDF가 너무 깁니다 — {PDF_PAGE_CAP}페이지까지 지원합니다.")
   106	    return _pm_extract(io.BytesIO(data), maxpages=PDF_PAGE_CAP) or ""
