   375	async def build_mcp_tools(
   376	    servers: list[dict],
   377	    calls_sink: list[dict],
   378	    tool_policy: dict | None = None,
   379	    selected_tools: list[str] | None = None,
   380	    force_approval: bool = False,
   381	) -> list[StructuredTool]:
   382	    """등록 MCP 서버에 **실제로 연결**(MultiServerMCPClient)해 활성 도구를 LangChain 툴로 만든다.
   383	
   384	    force_approval(스펙 415 P4): 첨부 유래 턴이면 참 — 정책 없는 도구도 승인 강제(간접 인젝션 봉합).
   385	
   386	    `servers`: `_load_context`가 해석한 dict 리스트
   387	      `{name, url, transport, enabled_tools, auth_token(복호화|None)}`.
   388	    HTTP/streamable만 연결한다(stdio는 스펙 054 §7에서 유예). 각 URL은 연결 이전에 net_guard(스펙
   389	    042)로 SSRF 검사 — 사설/루프백 IP는 차단하되 DB allowlist(스펙 064 `allowed_hosts`)로 dev
   390	    mock(127.0.0.1)을 통과시킨다(루프 전 refresh로 무재시작 반영). 서버 하나가 다운/차단/프로토콜
   391	    오류여도 그 서버만 건너뛰고 나머지는 살린다(부분 실패
   392	    격리 — 에이전트는 계속 실행). 각 도구는 `_wrap_mcp_tool`로 트레이스·HIL·graceful 래핑된다.
   393	    """
   394	    connections, meta = await _prepare_connections(servers)
   395	    if not meta:
   396	        return []
   397	    tools: list[StructuredTool] = []
   398	    for name, s in meta.items():
   399	        try:
   400	            raw_tools = await _raw_tools_cached(s, connections.get(name))
   401	        except Exception:
   402	            continue
   403	        if raw_tools is None:
   404	            continue
   405	        tools.extend(
   406	            _tools_from_raw(
   407	                name, s, raw_tools, calls_sink, tool_policy, selected_tools, force_approval
   408	            )
   409	        )
   410	    return tools
