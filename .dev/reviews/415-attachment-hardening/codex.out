   113	    sessionId: str | None = None  # 이어서 대화할 세션(없으면 새로 생성)
   114	    # mem0 user 축 정체성(스펙 032→387): 쿠키 유저는 인증 주체에서 도출(임의 지정 금지 — 422).
   115	    # **머신 토큰 호출만** userId 지정 가능(owner 전권의 위임 — 외부 시스템이 자기 유저를 대신).
   116	    # 판정은 auth.resolve_memory_user_id 단일 관문. 미지정 시 기존 동작(쿠키=자기 id, 머신=세션 축만).
   117	    userId: str | None = Field(default=None, max_length=80)  # 세션 컬럼 String(80) 정렬
   118	    # Playground "Proxy" 세션 한정 오버라이드(스펙 025). **web 에이전트에만** 적용, 화이트리스트
   119	    # 키만 의미(model/temperature/systemPrompt/mcps/memories/historyDepth). 저장된 에이전트는 불변.
   120	    # 코드 에이전트는 원격 실행이라 무시(bypass).
   121	    overrides: dict | None = None
   122	    # 산출물형 폼 제출(스펙 188 P2) — 이중 입력의 폼 입구. 텍스트 입구는 messages 그대로.
