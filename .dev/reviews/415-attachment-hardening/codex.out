    56	    capabilities: list = field(default_factory=list)
    57	    tool_policy: dict = field(
    58	        default_factory=dict
    59	    )  # 도구 승인 오버라이드(스펙 177 P2, config-only)
    60	    # 모델·온도·이력
    61	    temperature: float | None = None
    62	    history_depth: int = 20
    63	    persist_history: bool = True
    64	    ephemeral: bool = False  # 비영속 1회성 모드(스펙 235)
    65	    model_cfg: dict | None = None  # 원격은 None(로컬 모델 불요)
    66	    mem_cfg: dict | None = None
    67	    # 버전 못박기(스펙 242/370)
    68	    pinned_version: str | None = None
    69	    exec_version: str | None = None
    70	    pins: dict = field(default_factory=dict)
    71	    # 프롬프트 출처(스펙 364) — 라이브러리 매칭 시만 이름/id, 인라인/오버라이드/원격은 None
    72	    prompt_name: str | None = None
    73	    prompt_id: str | None = None
    74	    # MCP·RAG 해석
    75	    mcp_servers: list = field(default_factory=list)
    76	    tool_names: list = field(default_factory=list)
    77	    rag_collections: list = field(default_factory=list)
    78	    rag_unresolved: list = field(default_factory=list)
    79	    rag_min_scores: dict = field(default_factory=dict)  # {컬렉션명: 최소 유사도}(스펙 191)
    80	    # 세션(스펙 049/068) — resume 시 chat_approval이 수령 후 갱신
    81	    session_pk: int | None = None
    82	    session_id: str = ""
    83	    session_pending: dict | None = None
    90	      1. **도구 기본**(P1) = `_base_approval` — tools_meta, 없으면 레거시 폴백.
    91	      2. **에이전트 오버라이드**(P2) = `_apply_approval_override` — tool_policy로 덮음.
    92	    approver는 승인 인가에 쓰인다(`approvals._may_resolve`): admin=관리자만, self=요청 소유자 본인.
    93	    permission 문자열은 표시·감사·레거시 하위호환용(인가는 approver 필드로 — 세그먼트 이스케이프 무관).
    94	    """
    95	    required, approver, permission = _base_approval(server, tool, tools_meta)
    96	    required, approver = _apply_approval_override(required, approver, server, tool, tool_policy)
    97	    if not required:
    98	        return None
    99	    return {
   100	        "permission": permission,
   101	        "approver": approver if approver in ("admin", "self") else "admin",
   102	    }
   103	
   104	
   105	# 실 도구 호출 전체 deadline(초). per-read 타임아웃은 전체 데드라인이 아니므로(learning 046)
   106	# asyncio.timeout으로 호출 전체를 감싼다 — 느린/멈춘 서버가 에이전트를 무한 대기시키지 않게.
   107	_TOOL_TIMEOUT_S = 30
   108	
   109	
   110	def _wrap_mcp_tool(
   111	    server: str, rt: BaseTool, calls_sink: list[dict], approval: dict | None
   112	) -> StructuredTool:
   113	    """실 MCP 도구(rt)를 트레이스·HIL 게이트·graceful 래퍼로 감싼다.
   114	
   115	    rt.args_schema(JSON 스키마 dict)를 그대로 보존해 LLM이 원 도구 시그니처대로 호출하게 한다.
   116	    `approval`(호출부 `resolve_tool_approval`가 해석, 스펙 177 = `{permission, approver}` 또는 None)이
   117	    non-None인 도구는 **rt.ainvoke(부수효과) 이전에 interrupt()** 로 그래프를 멈춰 승인을 받는다(스펙 041
   118	    불변식, 실 도구 위에서 재성립). approver(admin/self)는 interrupt 페이로드로 실려 Approval에 스탬프됨
   119	    → `approvals._may_resolve` 인가에 쓰인다. 도구 실행 실패(서버 다운·프로토콜·타임아웃)는 잡아 graceful
   120	    문자열 + calls_sink status="error"로 — 에이전트 크래시 금지.
   121	    """
   122	    permission = approval["permission"] if approval else None
   123	    approver = (approval.get("approver") or "admin") if approval else "admin"
   124	    forced = (approval.get("forced") if approval else None) or None  # 스펙 415 P4 — 첨부 턴 강제 표식
   125	
   126	    # 도구 실패를 이 래퍼의 단일 except로 모은다(스펙 320). langchain-mcp-adapters는 MCP
   127	    # `isError=True`를 ToolException(_MCPToolExecutionError)으로 만든 뒤 tool.handle_tool_error로
   128	    # **삼켜 정상 문자열**로 돌려준다("Error executing tool …") → status=ok로 오기록돼 사유가 사라진다.
   129	    # handle_tool_error를 끄면 그 예외가 아래 except로 전파돼 status=error + 실제 사유(str(exc))를
   130	    # 붙잡는다(전송/프로토콜 실패는 원래 ToolException이 아니라 이미 전파 — 한 경로로 수렴).
   131	    with contextlib.suppress(Exception):  # rt 타입이 예상 밖이면 조용히 넘어감(무회귀)
   132	        rt.handle_tool_error = False
   133	
   134	    async def _execute(kwargs: dict, t0: float, sink: list[dict]) -> str:
   135	        # 실 부수효과: 실제 MCP 서버 도구를 호출한다. 승인됐거나 비위험 도구일 때만 도달.
   136	        reason: str | None = None  # 실패 사유(스펙 320) — 성공 시 None
   137	        try:
   138	            async with asyncio.timeout(_TOOL_TIMEOUT_S):
   139	                raw = await rt.ainvoke(kwargs)
   140	            text = _content_text(raw)
   141	            status = "ok"
   142	        except Exception as exc:
   143	            # 예외 타입에서 앞 밑줄 제거 — 어댑터 내부 클래스명(_MCPToolExecutionError)이 그대로
   144	            # UI에 새어 지저분해지지 않게(정돈=신뢰). 밑줄 없는 표준 예외명은 그대로 유지.
   145	            etype = type(exc).__name__.lstrip("_")
   146	            status = "error"
   147	            # 실제 사유(str(exc))를 붙잡아 인스펙터에 표면화(스펙 320) — 예외 타입만으론 "왜"를 못 본다.
   148	            # 마스킹+캡 백스톱 통과(사유가 새 노출 표면 — 토큰/입력값 누출 차단, learning 092).
   149	            reason = _sanitize_preview(f"{etype}: {exc}", _ERR_CAP)
   150	            # 모델-facing 텍스트에도 사유를 싣는다(스펙 320): handle_tool_error를 끄며 어댑터의 상세
   151	            # 오류 문자열이 사라지므로, 트레이스뿐 아니라 에이전트도 "왜 실패했는지"를 보고 적응·재시도할
   152	            # 수 있게(toolbox.py agent-call 실패가 str(exc)를 싣는 선례와 동형). reason은 이미 마스킹+캡됨.
   153	            text = f"도구 실행 실패({server}.{rt.name}): {reason}"
   154	        sink.append(
   155	            {
   156	                "server": server,
   157	                "tool": rt.name,
   158	                "status": status,
   159	                "ms": int((time.perf_counter() - t0) * 1000) + 1,
   160	                "args": _redact_args(
   161	                    kwargs
   162	                ),  # 스펙 087: 민감 키 마스킹 전 적재(형제 표면 누출 차단)
   163	                # 스펙 211: 직접 MCP 결과도 브로커/RAG와 같은 정화 경로(_sanitize_preview=비밀 마스킹+캡).
   164	                # 사용=공용 전환으로 타인이 크레덴셜 MCP를 배선할 수 있어(사용자 결정: 전부 공용), 결과에
   165	                # 섞인 토큰/비밀이 trace·응답으로 새지 않게 마스킹(codex 211 P2). 구 _cap은 마스킹 없었음.
   166	                "result": _sanitize_preview(text, _RESULT_CAP),
   167	                **({"error": reason} if reason else {}),  # 실패 사유(스펙 320) — 성공 기록엔 미포함
   168	            }
   169	        )
   170	        return text
   171	
   172	    async def _run(config: RunnableConfig = None, **kwargs: Any) -> str:
   173	        t0 = time.perf_counter()
   174	        sink = _sink_from(config, calls_sink)
   175	        if permission is None:
   176	            return await _execute(kwargs, t0, sink)
   177	        # 위험 도구: 실 부수효과 이전에 일시정지. interrupt()는 첫 호출 시 그래프를 멈추고,
   178	        # admin이 Command(resume={"decision":...})로 재개하면 그 값을 반환한다(도구는 처음부터
   179	        # 재실행되지만 interrupt 이전엔 부수효과가 없어 정확히 1회만 ainvoke — 스펙 041 probe로 검증).
   180	        decision = interrupt(
   181	            {
   182	                "permission": permission,
   183	                "approver": approver,  # 스펙 177 P2 — Approval에 스탬프돼 _may_resolve 인가에 쓰임
   184	                "server": server,
   185	                "tool": rt.name,
   186	                "action": f"{server}.{rt.name}",
   187	                "args": _redact_args(
   188	                    kwargs
   189	                ),  # 스펙 087: Approval.args(DB 영속)·ApprovalsView로 새기 전 마스킹
   190	                "summary": (
   191	                    f"{server}.{rt.name} 실행 — "
   192	                    + ("첨부 문서가 있는 대화라 " if forced == "attachment" else "")
   193	                    + f"{'본인' if approver == 'self' else '관리자'} 승인 필요"
   194	                ),
   195	                **({"forced": forced} if forced else {}),  # 스펙 415 P4 — 감사·UI 표식
   196	            }
   197	        )
   198	        approved = isinstance(decision, dict) and decision.get("decision") == "approve"
   199	        if not approved:
   200	            # 거부: 부수효과 0(ainvoke·sink 미emit) — 에이전트는 이 사실로 마무리.
   201	            return "거부됨 — 관리자가 실행을 승인하지 않았습니다."
   202	        return await _execute(kwargs, t0, sink)
   203	
   204	    desc = rt.description or f"{server} 서버의 {rt.name} 도구."
   205	    if permission is not None:
   206	        desc += " ⚠ 위험 작업: 호출 시 관리자 승인 전까지 일시정지됩니다."
   207	    return StructuredTool.from_function(
   208	        coroutine=_run,
   209	        name=_safe_name(server, rt.name),
   210	        description=desc,
   211	        args_schema=rt.args_schema,
   212	    )
   213	
   214	
   215	def mcp_connection(server: dict) -> dict | None:
   216	    """서버 dict(`{name,url,transport,auth_token}`)를 `MultiServerMCPClient` 연결 dict로 변환.
   217	
   218	    미지원 transport(stdio 등)나 SSRF 차단 URL이면 None(호출부가 그 서버를 스킵). `build_mcp_tools`(그래프
   219	    preload)와 능력 브로커 `McpProvider`(동적 discover→invoke, 스펙 101)가 **이 한 함수를 공유**해
   220	    transport·Bearer·리다이렉트 하드닝(`mcp_http_client_factory`) 정책이 한 곳에서만 산다(드리프트 0).
   320	        await net_guard.refresh_allowed_hosts()  # DB allowlist 무재시작 반영(스펙 064)
   321	    for server in servers:
   322	        if server not in pending:
   323	            meta[server["name"]] = server  # 캐시 적중 예정 — 연결 준비 불요(스펙 371 D1)
   324	            continue
   325	        conn = mcp_connection(
   326	            server
   327	        )  # transport 검사·SSRF 가드 공유 헬퍼(브로커와 드리프트 0, 스펙 101)
   328	        if conn is None:
   329	            continue  # 미지원 transport 또는 SSRF 차단 → 그 서버만 스킵
   330	        connections[server["name"]] = conn
   331	        meta[server["name"]] = server
   332	    return connections, meta
   333	
   334	
   335	def forced_attachment_approval(action: str) -> dict:
   336	    """첨부 유래 턴 강제 승인 payload(스펙 415 P4) — 정책 없는 부수효과 도구에 합성한다.
   337	
   338	    간접 인젝션(첨부 속 숨은 지시)이 도구를 실행시키는 경로를 사람 확인으로 봉합 — 공격자는
   339	    첨부이지 요청자가 아니므로 approver=self(세션 소유자 본인)가 방어로 충분하다."""
   340	    return {
   341	        "permission": action,
   342	        "approver": "self",
   343	        "forced": "attachment",  # 표시·감사용 — 승인 UI가 "첨부 턴 강제"임을 알 수 있게
   344	    }
   345	
   346	
   347	def _tools_from_raw(
   348	    name: str,
   349	    s: dict,
   350	    raw_tools: list,
   351	    calls_sink: list[dict],
   352	    tool_policy: dict | None,
   353	    selected_tools: list[str] | None,
   354	    force_approval: bool = False,
   355	) -> list[StructuredTool]:
   356	    """서버 하나의 raw 도구를 필터(enabled·selected)·승인 해석·래핑해 반환(스펙 397 분해)."""
   357	    enabled = set(s.get("enabled_tools") or [])
   358	    sel = selected_for_server(name, selected_tools)  # 도구 단위 배선 필터(스펙 276)
   359	    tools: list[StructuredTool] = []
   360	    for rt in raw_tools:
   361	        if enabled and rt.name not in enabled:
   362	            continue  # enabled_tools 밖 도구는 노출 안 함(서버측 강제)
   363	        if sel is not None and _safe_name(name, rt.name) not in sel:
   364	            continue  # 에이전트가 고른 도구 밖 — 노출 안 함(스펙 276 도구 단위 배선)
   365	        # 스펙 177 단일 리졸버 — 도구 기본(tools_meta) ◁덮음◁ 에이전트 오버라이드(tool_policy).
   366	        appr = resolve_tool_approval(name, rt.name, s.get("tools_meta"), tool_policy)
   367	        # 첨부 유래 턴(스펙 415 P4): 정책 없는 MCP 도구도 승인 강제 — MCP는 부수효과를 알 수 없어
   368	        # 보수적으로 전부(읽기 전용 면제는 자체 분류가 있는 브로커 축에서만).
   369	        if appr is None and force_approval:
   370	            appr = forced_attachment_approval(f"mcp.{name}.{rt.name}")
   371	        tools.append(_wrap_mcp_tool(name, rt, calls_sink, appr))
   372	    return tools
   373	
   374	
   375	async def build_mcp_tools(
   376	    servers: list[dict],
   377	    calls_sink: list[dict],
   378	    tool_policy: dict | None = None,
   379	    selected_tools: list[str] | None = None,
   380	    force_approval: bool = False,
   381	) -> list[StructuredTool]:
   382	    """등록 MCP 서버에 **실제로 연결**(MultiServerMCPClient)해 활성 도구를 LangChain 툴로 만든다.
   383	
   384	    force_approval(스펙 415 P4): 첨부 유래 턴이면 참 — 정책 없는 도구도 승인 강제(간접 인젝션 봉합).
   385	
   386	    `servers`: `_load_context`가 해석한 dict 리스트
   387	      `{name, url, transport, enabled_tools, auth_token(복호화|None)}`.
   388	    HTTP/streamable만 연결한다(stdio는 스펙 054 §7에서 유예). 각 URL은 연결 이전에 net_guard(스펙
   389	    042)로 SSRF 검사 — 사설/루프백 IP는 차단하되 DB allowlist(스펙 064 `allowed_hosts`)로 dev
   390	    mock(127.0.0.1)을 통과시킨다(루프 전 refresh로 무재시작 반영). 서버 하나가 다운/차단/프로토콜
   391	    오류여도 그 서버만 건너뛰고 나머지는 살린다(부분 실패
   392	    격리 — 에이전트는 계속 실행). 각 도구는 `_wrap_mcp_tool`로 트레이스·HIL·graceful 래핑된다.
   393	    """
   394	    connections, meta = await _prepare_connections(servers)
   395	    if not meta:
   396	        return []
   397	    tools: list[StructuredTool] = []
   398	    for name, s in meta.items():
   399	        try:
   400	            raw_tools = await _raw_tools_cached(s, connections.get(name))
   401	        except Exception:
   402	            continue
   403	        if raw_tools is None:
   404	            continue
   405	        tools.extend(
   406	            _tools_from_raw(
   407	                name, s, raw_tools, calls_sink, tool_policy, selected_tools, force_approval
   408	            )
   409	        )
   410	    return tools
   411	
   412	
   413	# NOTE(스펙 051): 채팅 인-챗 자가기록 도구(`save_agent_knowledge` /
   414	# build_agent_memory_tool)는 제거됐다. LLM이 도구 설명("유저 개인정보 금지")을 어기고 유저
   415	# 개인사실을 agent_id(교차사용자) 스코프에 써서 누출시켰다(learning 031 "도구 프롬프트 ≠ 격리").
   416	# agent_id 메모리는 이제 **어드민 저작 전용**(agents.py CRUD) — 인간 게이트만 둔다. 회상은 유지.
     1	"""정책 게이트 코어(스펙 100→101) — `PolicyScopedBroker`·RBAC 술어·`build_broker`.
     2	
     3	정책(allowlist∩RBAC·deny-by-default·존재비노출·단일 `_permitted`)은 여기 살고, kind별 메커닉은
     4	`providers/*`가 든다. 정책 판정은 provider 호출 **전에** 브로커가 수행한다(게이트 단일 지점,
     5	체크리스트 §3 드리프트 0). 서브스텝 HIL(§3.5)은 전송(부수효과) 이전 interrupt — 기존 파이프라인
     6	(interrupt→__interrupt__→SSE→Approval→Command(resume)) 재사용(새 배선 0).
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import time
    12	from collections.abc import Callable
    13	from typing import TYPE_CHECKING, Any
    14	
    15	from agent.runtime import Capability, InvokeResult
    16	
    17	if TYPE_CHECKING:
    18	    import casbin
    19	
    20	    from ..models import User
    21	from .common import (
    22	    CAP_KIND_AGENT,
    23	    CAP_KIND_MCP,
    24	    CapabilityNotFoundError,
    25	    _cap_resource,
    26	    _CapabilityProvider,
    27	    _kind_of,
    28	    _parse_mcp,
    29	)
    30	from .composition import BrokerContext, build_providers
