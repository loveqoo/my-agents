   171	class AttachmentOut(BaseModel):
   172	    filename: str
   173	    text: str  # 추출 전문(캡 적용) — 클라이언트가 ChatRequest.attachments로 되보낸다
   174	    chars: int
   175	    truncated: bool  # 3만자 캡으로 잘렸는가(UI가 정직하게 표시)
   176	
   177	
   178	@router.post("/attachments", response_model=AttachmentOut)
   179	async def extract_attachment(
   180	    file: UploadFile, principal: User | str = Depends(current_principal)
   181	) -> AttachmentOut:
   182	    """파일 → 평문 추출(무상태). txt/md/텍스트류=UTF-8, pdf=pypdf — 이미지 PDF·바이너리는 400.
   183	
   184	    raw 캡은 **읽으면서 누적**으로 검사한다(learning: .content 위 카운트는 막은 척 —
   185	    Content-Length 신뢰 금지, 5MB 초과 시점에 즉시 413).
   186	    """
   187	    _rate_check(str(principal.id) if isinstance(principal, User) else str(principal))
   188	    data = bytearray()
   189	    while chunk := await file.read(64 * 1024):
   190	        data += chunk
   191	        if len(data) > RAW_CAP:
   192	            raise HTTPException(
   193	                status_code=413,
   194	                detail=f"파일이 너무 큽니다 — 첨부는 파일당 {RAW_CAP // (1024 * 1024)}MB까지입니다.",
   195	            )
   196	    if not data:
   197	        raise HTTPException(status_code=400, detail="빈 파일입니다.")
   198	    try:
   199	        # 스레드 격리+시간 상한(codex 404 P1): pypdf 동기 파싱이 이벤트루프를 점유하지 않게.
   200	        # (wait_for 취소가 스레드를 죽이진 못하지만 페이지 캡이 작업량 자체를 유계로 만든다.)
   201	        text = await asyncio.wait_for(
   202	            asyncio.to_thread(_extract_sync, file.filename or "", file.content_type, bytes(data)),
   203	            timeout=EXTRACT_TIMEOUT_S,
   204	        )
   205	    except _ExtractError as exc:
   206	        raise HTTPException(status_code=exc.status, detail=exc.detail) from exc
   207	    except TimeoutError as exc:
   208	        raise HTTPException(
   209	            status_code=408,
   210	            detail=f"추출 시간 초과({EXTRACT_TIMEOUT_S}s) — 더 작은 파일로 시도하세요.",
   211	        ) from exc
   212	    text = text.strip()
   213	    if not text:
   214	        raise HTTPException(
   215	            status_code=400, detail="추출된 텍스트가 없습니다(이미지 PDF·빈 문서는 지원 밖)."
   216	        )
   217	    truncated = len(text) > TEXT_CAP
   218	    if truncated:
   219	        text = text[:TEXT_CAP]
   220	    return AttachmentOut(
   221	        filename=(file.filename or "(이름 없음)")[:200],
   222	        text=text,
   223	        chars=len(text),
   224	        truncated=truncated,
   225	    )
   226	
