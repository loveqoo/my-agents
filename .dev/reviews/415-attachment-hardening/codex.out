   204	async def _recall_prompt(ctx: ChatContext, user_id: str | None, user_text: str) -> str:
   205	    """A2A 서빙 회상(스펙 387→388 P1) — 켜져 있으면 프롬프트에 "# 관련 기억" 부착(메인 chat 미러).
   206	
   207	    스코프 = user 축(387, userId 위임) + run 축(388 P1 — 세션이 생겨 contextId 대화 단위) +
   208	    agent 축(스펙 029 미러). 실패는 memory.search가 흡수([] — 회상 없이 진행)."""
   209	    # 비영속(스펙 235) 전면 off — 메인 chat used_memory 게이트 미러.
   210	    if ctx.ephemeral or not (memory.memory_enabled(ctx.memories) and ctx.mem_cfg):
   211	        return ctx.prompt
   212	    recall_scope = {"user_id": user_id, "run_id": ctx.session_id, "agent_id": ctx.ext_agent_id}
   213	    mem_hits = await asyncio.to_thread(memory.search, recall_scope, user_text, ctx.mem_cfg)
   214	    if not mem_hits:
   215	        return ctx.prompt
   216	    recalled = memory.format_memory_hits(mem_hits)
   217	    return f"{ctx.prompt}\n\n# 관련 기억(회상됨)\n{recalled}"
