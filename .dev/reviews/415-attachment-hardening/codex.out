    83	async def _load_session_conversation(
    84	    session_id: str | None, agent_pk: uuid.UUID, limit: int | None = None
    85	) -> list[dict]:
    86	    """세션의 영속 대화를 {role, content} 리스트로 로드(스펙 270 재개 + 289 P1 서버 재구성 공용).
    87	
    88	    limit(스펙 289 — 캐시 대신 읽기량 상수 고정): 최신 N개만 역순 조회 후 정순 반환. None=전체
    89	    (재개 경로 무회귀). 세션·메시지 없으면 빈 리스트(graceful — 새/타인 세션 id는 해석 단계에서
    90	    이미 빈 새 세션으로 접혀 있어 여기서 자연히 [])."""
    91	    if not session_id:
    92	        return []
    93	    async with SessionLocal() as db:
    94	        sess_pk = (
    95	            await db.execute(
    96	                select(Session.id).where(
    97	                    Session.session_id == session_id, Session.agent_pk == agent_pk
    98	                )
    99	            )
   100	        ).scalar_one_or_none()
   101	        if sess_pk is None:
   102	            return []
   103	        q = select(Message).where(Message.session_pk == sess_pk).order_by(Message.id.desc())
   104	        if limit is not None and limit >= 0:
   105	            q = q.limit(limit)
   106	        rows = list((await db.execute(q)).scalars().all())
   107	        return [{"role": m.role, "content": m.content} for m in reversed(rows)]
