   239	async def _e5_context_detection(c: httpx.AsyncClient, aid: str) -> None:
   240	    print("== E5 첨부 컨텍스트 판정(재생 구멍) ==")
   241	    # 첨부와 함께 1턴 → 세션에 주입본 영속. 다음 턴(첨부 없음)에 펜스 마커가 히스토리로 재생됨을
   242	    # 서버 영속 메시지로 확인(판정식 "⟦첨부 "가 대화에 존재 → 강제 유지의 근거 데이터).
   243	    body = {
   244	        "messages": [{"role": "user", "content": "첨부 요약"}],
   245	        "attachments": [{"filename": "doc.txt", "text": "V415-MARK 본문"}],
   246	    }
   247	    session_id = None
   248	    async with c.stream("POST", f"/agents/{aid}/chat", json=body) as resp:
   249	        async for line in resp.aiter_lines():
   250	            if line.startswith("data: ") and session_id is None:
   251	                try:
   252	                    obj = json.loads(line[6:])
   253	                    if isinstance(obj, dict) and "session" in obj:
   254	                        session_id = obj["session"]
   255	                except json.JSONDecodeError:
   256	                    pass
   257	    check(session_id is not None, f"E5a 첨부 턴 세션 생성 (got {session_id})")
   258	    from sqlalchemy import select
   259	
   260	    from api.chat_history import _load_session_conversation
   261	    from api.db import SessionLocal
   262	    from api.models import Agent
   263	
   264	    async with SessionLocal() as s:
   265	        agent_pk = (
   266	            await s.execute(select(Agent.id).where(Agent.id == uuid.UUID(aid)))
   267	        ).scalar_one()
   268	    conv = await _load_session_conversation(session_id, agent_pk)
   269	    has_marker = any("⟦첨부 " in (m.get("content") or "") for m in conv)
   270	    check(has_marker, "E5b 영속 대화에 펜스 마커 — 후속 턴 재생 시 판정식이 참(강제 유지)")
   271	
   272	
   273	async def main() -> None:
   274	    async with httpx.AsyncClient(base_url=BASE, headers=_auth(), timeout=180) as c:
   275	        ag = (
   276	            await c.post(
   277	                "/agents",
   278	                json={"name": f"v415-{uuid.uuid4().hex[:6]}", "config": {"model": "mock-llm"}},
   279	            )
   280	        ).json()
   281	        aid = ag["id"]
   282	        try:
   283	            await _e1_body_limit(c)
   284	            await _e2_turn_budget(c, aid)
   285	            await _e3_rate_limit(c)
   286	            _e4_unit()
   287	            await _e4_approval_stamp()
   288	            await _e5_context_detection(c, aid)
   289	        finally:
   290	            await c.delete(f"/agents/{aid}")
   291	
   292	    print()
   293	    if _fails:
   294	        print(f"FAILED: {len(_fails)}건")
   295	        for f in _fails:
   296	            print("  -", f)
   297	        sys.exit(1)
   298	    print(f"VERIFY415_OK — {passed}건 전부 통과")
   299	
   300	
   301	if __name__ == "__main__":
   302	    asyncio.run(main())

