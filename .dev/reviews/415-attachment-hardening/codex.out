    61	# 통합 principal — 세션 쿠키 유저(fastapi-users) OR 머신 Bearer 토큰 둘 다 허용(하위호환).
    62	# 도메인 라우터의 게이트로 쓴다(반환값은 인증 주체: User 또는 "machine"). 민감 라우트는 추가로
    63	# authz.require(obj, act)로 보호한다. auth.py 임포트 시점에 users를 끌어오지 않도록 지연 import. 스펙 031.
    64	def _make_current_principal() -> Callable[..., Awaitable[User | str]]:
    65	    from fastapi import Depends
    66	
    67	    from .users import current_user_optional
    68	
    69	    async def _principal(
    70	        authorization: str | None = Header(default=None),
    71	        user: User | None = Depends(current_user_optional),
    72	    ) -> User | str:
    73	        if user is not None:  # 세션 쿠키 인증
    74	            audit.set_actor(audit.actor_of(user))  # 감사 actor(스펙 343) — 이메일 로컬파트
    75	            return user
    76	        if is_valid_machine_token(authorization):  # 머신 토큰 인증
    77	            audit.set_actor(audit.SYSTEM_ACTOR)  # 사람 아닌 주체
    78	            return "machine"
    79	        raise HTTPException(status_code=401, detail="인증 필요")
    80	
    81	    return _principal
    82	
