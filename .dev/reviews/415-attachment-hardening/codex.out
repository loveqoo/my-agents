   117	async def _e3_rate_limit(c: httpx.AsyncClient) -> None:
   118	    print("== E3 업로드 rate limit(P3) ==")
   119	    # E1에서 이미 2회 사용 — 남은 윈도를 소진해 11회째 429 확인.
   120	    last = None
   121	    got_429 = False
   122	    for _i in range(12):
   123	        r = await c.post(
   124	            "/chat/attachments", files={"file": ("r.txt", b"rate probe", "text/plain")}
   125	        )
   126	        last = r.status_code
   127	        if r.status_code == 429:
   128	            got_429 = True
   129	            check("업로드가 너무" in r.text, "E3b 한국어 사유(분당 10회 안내)")
   130	            break
   131	    check(got_429, f"E3a 연속 업로드 → 429 도달 (last {last})")
