   134	def _e4_unit() -> None:
   135	    print("== E4 승인 강제(P4) 단위 ==")
   136	    from api.chat_context_types import ChatContext
   137	    from api.chat_graph_build import _graph_fingerprint
   138	    from api.runtime_mcp import forced_attachment_approval
   139	
   140	    fa = forced_attachment_approval("mcp.srv.tool")
   141	    check(
   142	        fa["approver"] == "self" and fa["forced"] == "attachment" and fa["permission"],
   143	        f"E4a 강제 payload 형태(self·forced=attachment) (got {fa})",
   144	    )
   145	
   146	    # 그래프 지문 분리 — 첨부 턴/비첨부 턴이 같은 캐시를 쓰면 강제가 조용히 우회된다.
   147	    base = {
   148	        "agent_pk": uuid.uuid4(),
   149	        "model_cfg": {"base_url": "http://x", "model_id": "m", "api_key": ""},
   150	    }
   151	    c1 = ChatContext(**base)
   152	    c2 = ChatContext(**base)
   153	    c2.attachment_context = True
   154	    f1, f2 = _graph_fingerprint(c1), _graph_fingerprint(c2)
   155	    check(
   156	        f1 is not None and f2 is not None and f1 != f2,
   157	        "E4b 그래프 지문이 attachment_context로 갈라짐(캐시 분리)",
   158	    )
   159	
   160	    # 브로커 _gate 합성 — 정책 없는 MCP/agent cap은 payload 합성, RAG(읽기 전용)는 면제.
   161	    import api.broker.core as core
   162	
   163	    class _FakeProvider:
   164	        def __init__(self, kind: str) -> None:
   165	            self.kind = kind
   166	
   167	        def approval_for(self, _row, _cap, _args, _tp=None):  # noqa: ANN001, ANN202
   168	            return None  # 정책 없음(즉시 실행 상태)
   169	
   170	    captured: list[dict] = []
   171	
   172	    def _fake_interrupt(payload):  # noqa: ANN001, ANN202
   173	        captured.append(payload)
   174	        return {"decision": "approve"}  # 승인으로 재개된 셈 — _gate는 None(전송 진행) 반환
   175	
   176	    import langgraph.types as lg_types
   177	
   178	    orig = lg_types.interrupt
   179	    lg_types.interrupt = _fake_interrupt
   180	    try:
   181	        broker = core.PolicyScopedBroker(
   182	            ["mcp:srv"], lambda *_a: True, [], force_approval=True
   183	        )
   184	        res = broker._gate(_FakeProvider("mcp"), object(), "mcp:srv/tool", {"x": 1})
   185	        check(
   186	            res is None and len(captured) == 1 and captured[0].get("forced") == "attachment",
   187	            f"E4c MCP cap 정책 없음+강제 → 승인 interrupt 발생 (captured {len(captured)})",
   188	        )
   189	        res = broker._gate(_FakeProvider("agent"), object(), "agent:sub-agent", {})
   190	        check(len(captured) == 2, "E4d agent 위임 cap도 강제")
   191	        res = broker._gate(_FakeProvider("rag"), object(), "rag:kb", {})
   192	        check(
   193	            res is None and len(captured) == 2,
   194	            "E4e RAG(읽기 전용) cap은 면제(interrupt 미발생)",
   195	        )
   196	        # 강제 꺼짐(비첨부 턴) — 종전 동작.
   197	        broker_off = core.PolicyScopedBroker(["mcp:srv"], lambda *_a: True, [])
   198	        res = broker_off._gate(_FakeProvider("mcp"), object(), "mcp:srv/tool", {})
   199	        check(
   200	            res is None and len(captured) == 2,
   201	            "E4f 비첨부 턴은 종전 동작(정책 없으면 즉시 실행)",
   202	        )
   203	    finally:
   204	        lg_types.interrupt = orig
   205	
