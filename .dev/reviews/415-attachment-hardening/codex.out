    55	async def require_auth(authorization: str | None = Header(default=None)) -> None:
    56	    """`Authorization: Bearer <token>` 검증. 누락/형식오류/불일치 → 401."""
    57	    if not is_valid_machine_token(authorization):
    58	        raise HTTPException(status_code=401, detail="유효하지 않은 토큰")
    59	
