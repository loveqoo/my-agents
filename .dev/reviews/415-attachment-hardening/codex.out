   222	@router.post("/mcp-servers/{id}/test-tool", response_model=McpToolTestOut)
   223	async def test_mcp_tool(
   224	    id: uuid.UUID,
   225	    body: McpToolTestIn,
   226	    session: AsyncSession = Depends(get_session),
   227	) -> Any:
   228	    """저장된 MCP 서버의 도구를 **실제로 호출**해 본다(스펙 326 — 상세 드로어 '도구 시험').
   229	
   230	    실행 경로는 채팅과 같은 `build_mcp_tools`를 재사용한다(새 연결 코드 금지) — SSRF 가드·
   231	    allowed_hosts·자격증명 복호·어댑터 swallow 해제·결과/사유 마스킹+캡(스펙 320)이 전부 그
   232	    경로에 이미 산다. 결과는 래퍼의 calls_sink에서 회수(직접 반환값이 아니라 **채팅이 기록하는
   233	    것과 동일한 표면**을 보여준다 — 시험이 곧 실전 리허설).
   234	
   235	    승인 정책(스펙 177) 도구는 confirm=True 없이 400 — 시험 통로가 HIL을 소리 없이 우회하지
   236	    않게 백엔드에서 강제. 승인 래핑 자체는 tools_meta에서 approval을 걷어낸 사본으로 비활성화
   237	    (그래프 밖 interrupt() 불가 — confirm 게이트가 그 자리를 대신한다).
   238	
   239	    연결 실패·도구 미발견은 조용한 스킵 대신 원인 명시(스펙 322 footgun의 시험판 방지)."""
   240	    from .runtime import build_mcp_tools
   241	
   242	    obj = await get_or_404(session, McpServer, id)
   243	    tool_name = (body.tool or "").strip()
   244	    _validate_tool_testable(obj, tool_name, bool(body.confirm))
   245	    server = _build_test_server(obj, tool_name)
   246	    calls_sink: list[dict] = []
   247	    tools = await build_mcp_tools([server], calls_sink)
