   148	
   149	# 업로드 rate limit(스펙 415 P3, 승인값 분당 10회/유저) — PDF 파싱은 CPU 유계 작업이라 반복 요청이
   150	# 워커를 점유할 수 있다(codex 404 P1②). 인메모리 슬라이딩 윈도(단일 인스턴스 전제 — 개인 플랫폼,
   151	# k8s 멀티 인스턴스는 백로그 별항). 키=인증 주체(유저 id | 머신 토큰 문자열).
   152	RATE_LIMIT_N = 10
   153	RATE_WINDOW_S = 60.0
   154	_rate: dict[str, collections.deque] = {}
   155	
   156	
   157	def _rate_check(key: str) -> None:
   158	    """윈도 내 호출 수 검사 — 초과 시 429. 오래된 타임스탬프는 그 자리에서 청소(무한 증가 방지)."""
   159	    now = time.monotonic()
   160	    dq = _rate.setdefault(key, collections.deque())
   161	    while dq and now - dq[0] > RATE_WINDOW_S:
   162	        dq.popleft()
   163	    if len(dq) >= RATE_LIMIT_N:
   164	        raise HTTPException(
   165	            status_code=429,
   166	            detail=f"업로드가 너무 잦습니다 — 분당 {RATE_LIMIT_N}회까지 가능합니다. 잠시 후 다시 시도하세요.",
   167	        )
   168	    dq.append(now)
