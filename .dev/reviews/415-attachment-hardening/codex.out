   188	def run() -> None:
   189	    from pathlib import Path
   190	
   191	    import uvicorn
   192	
   193	    # 기본은 loopback(외부 비노출). Tailscale 노출은 API_HOST로만 켠다.
   194	    # 예: API_HOST=100.72.45.58 → 이 맥 + tailnet에서만 닿고 그 외 인터페이스는 안 열림.
   195	    host = os.environ.get("API_HOST", "127.0.0.1")
   196	    port = int(os.environ.get("API_PORT", "8000"))
   197	    # 개발 편의: 코드 변경 자동 반영. reload_dirs에 **api·agent 소스를 둘 다** 명시한다 —
   198	    # uvicorn 기본 watch는 CWD 하나라 packages/agent 수정이 반영 안 돼, 노드/flow 코드를 고친 뒤
   199	    # 수동 재기동이 필요했다(스펙 302 회귀=produce_node config가 그 함정에 오래 숨음). 두 워크스페이스
   200	    # 소스를 watch해 agent flow도 hot-reload. 배포/프로덕션 실행은 uvicorn을 직접(reload 없이) 띄운다.
   201	    src = Path(__file__).resolve()
   202	    reload_dirs = [str(src.parents[1]), str(src.parents[4] / "packages" / "agent" / "src")]
   203	    # timeout_graceful_shutdown(스펙 335) — SSE 이벤트 스트림(/events)은 장수명 연결이라 기본
   204	    # graceful shutdown이 "연결 종료 대기"에 영원히 갇힌다(브라우저 EventSource가 열려 있으면
   205	    # reload가 중간에 멈춰 서버가 죽은 척). 5초 뒤 강제 종료 — EventSource는 자동 재연결한다.
   206	    uvicorn.run(
   207	        "api.main:app",
   208	        host=host,
   209	        port=port,
   210	        reload=True,
