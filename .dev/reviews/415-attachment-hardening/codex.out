   207	async def _e4_approval_stamp() -> None:
   208	    print("== E4g Approval 스탬프 ==")
   209	    from sqlalchemy import delete, select
   210	
   211	    from api.chat_approval import _create_approval
   212	    from api.chat_context_types import ChatContext
   213	    from api.db import SessionLocal
   214	    from api.models import Agent, Approval
   215	
   216	    async with SessionLocal() as s:
   217	        agent_pk = (await s.execute(select(Agent.id).limit(1))).scalar_one()
   218	    ctx = ChatContext(agent_pk=agent_pk)
   219	    ctx.session_id = None
   220	    ctx.attachment_context = True
   221	    apid = await _create_approval(
   222	        ctx, f"v415-{uuid.uuid4().hex[:8]}", {"permission": "p", "args": {"a": 1}}, None
   223	    )
   224	    try:
   225	        async with SessionLocal() as s:
   226	            row = (
   227	                await s.execute(select(Approval).where(Approval.approval_id == apid))
   228	            ).scalar_one()
   229	            check(
   230	                row.args.get("_attachment_context") is True and row.args.get("a") == 1,
   231	                f"E4g 첨부 턴 Approval args 스탬프+원 args 보존 (got {row.args})",
   232	            )
   233	    finally:
   234	        async with SessionLocal() as s:
   235	            await s.execute(delete(Approval).where(Approval.approval_id == apid))
   236	            await s.commit()
   237	
