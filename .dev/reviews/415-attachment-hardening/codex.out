     2	
     3	실행은 broker.invoke 경유(재귀 가드·HIL·격리 승계 전부 브로커 소유). 파사드는 runtime.py.
     4	"""
     5	
     6	from typing import Any
     7	
     8	from langchain_core.tools import StructuredTool
     9	
    10	from .runtime_mcp import _safe_name
    11	
    12	
    13	def _wrap_agent_tool(broker: Any, cap: Any) -> StructuredTool:
    14	    """에이전트-호출 도구(스펙 318) — 노드가 다른 에이전트에 위임하는 도구. 실행은 `broker.invoke`
    15	    경유라 **재귀 가드**(방문 집합=체인 내 재방문 금지·깊이·너비 예산)·HIL 승인 게이트(interrupt)·
    16	    위임 결과의 데이터 채널 격리가 전부 브로커에서 그대로 적용된다(스펙 100~256, 새 코드 0). 도구
    17	    이름 `agent__{agent_id}`(MCP `_safe_name` 관례) — 노드 `tools` 목록의 이름과 일치해 `_resolve_tool`
    18	    이 여느 도구처럼 바인딩. 트레이스는 broker.invocations(brokerCalls)가 담당(calls_sink 불요).
    19	    결과는 InvokeResult.text로 접고, 실패는 graceful 문자열(에이전트를 죽이지 않음)."""
    20	    cap_id = cap.id
    21	    label = cap.name or cap_id
    22	
    23	    async def _delegate(text: str = "") -> str:
    24	        res = await broker.invoke(cap_id, {"text": text})
    25	        if getattr(res, "error", None):
    26	            return f"에이전트 '{label}' 호출 실패: {res.error}"
    27	        return getattr(res, "text", "") or ""
    28	
    29	    hook = (cap.hook or "").strip()
    30	    desc = f"에이전트 '{label}'에게 하위 작업을 위임한다"
    31	    if hook:
    32	        desc += f" — {hook}"
    33	    desc += ". 입력: text(위임할 질문/지시). 이 에이전트가 답을 만들어 돌려준다."
    34	    return StructuredTool.from_function(
    35	        coroutine=_delegate,
    36	        name=_safe_name("agent", cap_id),
    37	        description=desc,
    38	    )
    39	
    40	
    41	def build_agent_tools(broker: Any, agent_caps: list) -> list[StructuredTool]:
    42	    """허가된 kind=agent 능력마다 위임 도구 하나(스펙 318). 후보=broker가 이미 스코프한 것
    43	    (allowlist∩RBAC) — 이 빌더는 권한을 새로 열지 않는다(브로커가 유일한 정책 게이트, confused-deputy
    44	    0). 노드는 자기 `tools`에서 `agent__{id}`를 골라 바인딩(build_mcp_tools·build_rag_tool과 같은
    45	    풀 합류 패턴)."""
    46	    return [_wrap_agent_tool(broker, cap) for cap in agent_caps]

