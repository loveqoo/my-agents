   119	@router.get("/{approval_id}", response_model=ApprovalOut)
   120	async def get_approval(
   121	    approval_id: str,
   122	    session: AsyncSession = Depends(get_session),
   123	    principal: User | str = Depends(current_principal),
   124	) -> ApprovalOut:
   125	    """승인 **1건** 조회(스펙 350) — 폴링을 O(전체 테이블)에서 O(1)로.
   126	
   127	    플레이그라운드는 승인 1건의 상태를 알려고 `GET /approvals`(전 상태·LIMIT 없음)를 2.5초마다
   128	    최대 60회 불렀다 — 승인 행이 쌓일수록 폴링 한 번의 비용이 같이 커지는 구조였다(저장 누수가
   129	    대역폭 누수로 증폭).
   130	
   131	    인가는 목록과 **같은 규칙**(스펙 066): 일반 유저는 자기 것만. 볼 수 없는 건 403이 아니라
   132	    **404로 접는다**(존재 비노출 — learning 068).
   133	    """
   134	    own = authz.own_scope(principal, "approvals", "resolve")
   135	    conds = [Approval.approval_id == approval_id]
   136	    if own is not None:
   137	        conds.append(Approval.user_id == own)  # SELECT-WHERE로 밀어 거부행은 로드조차 안 함
   138	    row = (await session.execute(select(Approval).where(*conds))).scalars().first()
   139	    if row is None:
   140	        raise HTTPException(status_code=404, detail="not found")
   141	    amap = await agent_id_map(session)
   142	    return approval_to_out(row, amap.get(row.agent_pk))
   143	
   144	
   145	@router.post("/{approval_id}/resolve", response_model=ApprovalOut)
   146	async def resolve_approval(
   147	    approval_id: str,
   148	    body: ResolveIn,
   149	    session: AsyncSession = Depends(get_session),
   150	    principal: Any = Depends(
   151	        current_principal
   152	    ),  # User | "machine" — resolved_by 스탬프가 .id를 직접 참조
   153	) -> ApprovalOut:
   154	    result = await session.execute(select(Approval).where(Approval.approval_id == approval_id))
   155	    p = result.scalar_one_or_none()
   156	    if p is None:
   157	        raise HTTPException(status_code=404, detail="not found")
   158	    # 열거 오라클 차단(스펙 066 적대리뷰 Low#1): 비-admin이 *볼 수 없는* 행(자기 것 아님·NULL-owner)은
   159	    # 존재 자체를 숨긴다 → 부재(404)와 동일 응답. 안 그러면 approval_id 추측으로 404↔403을 갈라
   160	    # 타인 승인 행의 존재를 캐낼 수 있다(목록은 이미 스코핑돼 안 보이는데 resolve가 새는 격). 단,
   161	    # *자기* 행이지만 권한 미달(민감 perm)은 403 유지 — 이미 자기 목록에 보여 존재는 알려진 상태다.
   162	    own = authz.own_scope(principal, "approvals", "resolve")
   163	    if own is not None and p.user_id != own:
   164	        raise HTTPException(status_code=404, detail="not found")
   165	    # 인가 3-way(스펙 066): admin/머신=전체, owner+self_approve=자기 것, 그 외 403. 조회 *후* 판정 —
   166	    # 권한 없으면 어떤 부수효과(status flip·재개)도 일어나기 전에 닫힌다.
   167	    if not _may_resolve(p, principal):
   168	        raise HTTPException(status_code=403, detail="이 승인을 결정할 권한이 없습니다")
   169	    decision = "approve" if body.decision == "approve" else "reject"
   170	    new_status = "approved" if decision == "approve" else "rejected"
   171	    # 이중 처리 가드(스펙 041 불변식): **원자적 조건부 UPDATE** — pending→결정으로 박되 status가
   172	    # 이미 pending이 아니면 0행. read-then-write로 두면 동시 두 resolve가 둘 다 가드를 통과해 위험
   173	    # 도구가 2회 실행되는 TOCTOU가 생긴다. WHERE status='pending'를 DB가 한 번에 판정해 정확히
   174	    # 한 요청만 재개로 진입(나머지는 409). 재개는 부수효과를 동반하므로 멱등이 아니다.
   175	    res = await session.execute(
   176	        update(Approval)
   177	        .where(Approval.approval_id == approval_id, Approval.status == "pending")
   178	        # 처리 감사(스펙 181) — status와 같은 원자 UPDATE에 처리 시각·처리자를 함께 박는다
   179	        # (별도 write 입구 안 늘림). resolved_by가 user_id(요청자)와 같으면 본인 승인.
   180	        # 머신 토큰(str principal)은 .id가 없어 500이었다(스펙 292 타입 주석 작업이 적발) —
   181	        # 센티널 "machine"으로 스탬프(유저 UUID와 충돌 없음, 감사 정보 보존).
   182	        .values(
   183	            status=new_status,
   184	            resolved_at=func.now(),
   185	            resolved_by="machine" if isinstance(principal, str) else str(principal.id),
   186	        )
   187	    )
   188	    if res.rowcount == 0:
   189	        raise HTTPException(status_code=409, detail="이미 처리되었거나 처리 중인 승인입니다.")
   190	    await session.commit()

