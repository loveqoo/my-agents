    24	@lru_cache(maxsize=1)
    25	def _token() -> str:
    26	    import os
    27	
    28	    tok = (os.environ.get("API_AUTH_TOKEN") or "").strip()
    29	    if tok:
    30	        return tok
    31	    # auth.py = packages/api/src/api/auth.py → parents[4] = repo 루트
    32	    path = Path(__file__).resolve().parents[4] / ".dev" / ".api_token"
    33	    if path.exists():
    34	        existing = path.read_text().strip()
    35	        if existing:  # 빈 파일이면 무시하고 재생성(빈 토큰 인증 방지)
    36	            return existing
    37	    tok = "mat_" + secrets.token_urlsafe(24)
    38	    path.parent.mkdir(parents=True, exist_ok=True)
    39	    path.write_text(tok)
    40	    log.warning(
    41	        "API_AUTH_TOKEN 미설정 — %s에 개발용 토큰 생성. UI는 같은 값을 VITE_API_TOKEN로.", path
    42	    )
    43	    return tok
