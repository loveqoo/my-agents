    59	# 문자권 일관성 게이트(스펙 407 P2) — 한글 PDF의 ToUnicode 매핑 부재 시 pypdf가 타 문자권
    60	# 글자(구르무키 등)로 오추출한다. 깨진 텍스트를 "성공"으로 통과시키면 주입·기억까지 오염되므로
    61	# 허용 문자권 밖 비율이 임계를 넘으면 부정합 판정(정직 400). 실측 표본: 구남님 이력서 PDF.
    62	_COHERENT_RANGES = (
    63	    (0x0020, 0x007E),  # ASCII
    64	    (0x00C0, 0x024F),  # 라틴 확장(서구권 문서)
    65	    (0x1100, 0x11FF),  # 한글 자모
    66	    (0x2000, 0x206F),  # 일반 문장부호(•·— 등)
    67	    (0x3000, 0x303F),  # CJK 문장부호
    68	    (0x3130, 0x318F),  # 한글 호환 자모
    69	    (0x4E00, 0x9FFF),  # CJK 한자
    70	    (0xAC00, 0xD7A3),  # 한글 음절
    71	    (0xFF00, 0xFFEF),  # 전각
    72	)
    73	COHERENCE_MIN_RATIO = 0.7  # 비공백 문자 중 허용 문자권 비율 최소치
    74	
    75	
    76	def is_extract_coherent(text: str) -> bool:
    77	    """추출 텍스트가 문자권 일관성을 갖는가 — 짧은 텍스트(<20자)는 판정 보류(통과)."""
    78	    chars = [c for c in text if not c.isspace()]
    79	    if len(chars) < 20:
    80	        return True
    81	    okc = sum(1 for c in chars if any(lo <= ord(c) <= hi for lo, hi in _COHERENT_RANGES))
    82	    return okc / len(chars) >= COHERENCE_MIN_RATIO
