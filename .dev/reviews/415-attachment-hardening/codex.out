    93	@router.get("", response_model=list[ApprovalOut])
    94	async def list_approvals(
    95	    status: str | None = None,
    96	    session: AsyncSession = Depends(get_session),
    97	    principal: User | str = Depends(current_principal),
    98	) -> list[ApprovalOut]:
    99	    # pending 먼저, 그 다음 requested_at 내림차순.
   100	    # status를 주면 그 상태만 — 사이드바 배지·승인 큐는 'pending'만 본다(045 정직화).
   101	    # 기본(None)은 전 상태 반환(기존 소비처 회귀 방지).
   102	    # 일반 유저는 **자기 것만**(스펙 066 D5) — NULL-owner(머신/레거시)는 숨김. admin/머신은 전체.
   103	    pending_first = case((Approval.status == "pending", 0), else_=1)
   104	    conds = []
   105	    if status is not None:
   106	        conds.append(Approval.status == status)
   107	    own = authz.own_scope(principal, "approvals", "resolve")
   108	    if own is not None:
   109	        conds.append(Approval.user_id == own)
   110	    stmt = select(Approval)
   111	    if conds:
   112	        stmt = stmt.where(*conds)
   113	    stmt = stmt.order_by(pending_first, Approval.requested_at.desc())
   114	    result = await session.execute(stmt)
   115	    amap = await agent_id_map(session)
   116	    return [approval_to_out(p, amap.get(p.agent_pk)) for p in result.scalars().all()]
