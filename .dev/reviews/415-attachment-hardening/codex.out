   367	def _seed_and_sent(
   368	    conversation: list[dict],
   369	    ctx: ChatContext,
   370	    pipeline: bool,
   371	    prompt_prompt: str,
   372	    system_in_seed: bool = False,
   373	) -> tuple[list[dict], list[dict], list[dict]]:
   374	    """윈도 절단·전송 전문·그래프 시드 — 반환 (messages, sent_messages, seed_messages).
   375	
   376	    실행 컨텍스트를 historyDepth로 절단(최근 N개만 모델에 전달). 스펙 289 P1: 원천=conversation
   377	    (서버 모드면 DB 재구성분 포함) — 절단 규칙은 동일. 전송 프롬프트 전문(스펙 131)은 실제 그래프
   378	    입력을 캡·마스킹해 캡처. 노드형(스펙 270): 대화를 히스토리 프록시가 노드별 depth로 슬라이스하므로
   379	    그래프엔 **현재 턴만** 시드(이전 대화는 프록시가 각 노드에 주입). 비노드형은 윈도된 전체를 그대로
   380	    시드(무회귀). sent_messages는 에이전트-레벨 뷰로 유지(상속 노드=동일 집합, 커스텀 depth는 node
   381	    timeline 192·historyWindows로 관측)."""
   382	    messages = _window(conversation, ctx.history_depth)
   383	    sent_messages = _build_sent_messages(prompt_prompt, messages)
   384	    seed_messages = messages[-1:] if (pipeline and messages) else messages
   385	    if system_in_seed and prompt_prompt:
   386	        # promptless 그래프(스펙 371 D3) — 시스템 프롬프트를 그래프 입력 선두로(스파이크 실증:
   387	        # system_prompt=None + 단일 선두 system = 기존과 동일 동작, 상태에 1개만).
   388	        seed_messages = [{"role": "system", "content": prompt_prompt}, *seed_messages]
