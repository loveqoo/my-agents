    65	class PolicyScopedBroker:
    66	    """정책으로 미리 스코프된 능력 브로커. `agent.runtime.CapabilityBroker` Protocol 적합.
    67	
    68	    `allowlist` = 호출 에이전트 config `capabilities`(cap id 목록, 없으면 [] = deny-by-default).
    69	    `rbac_allows(kind)` = 유저 RBAC 판정 클로저(casbin enforce 등을 이미 바인딩). 둘의 **교집합**만
    70	    발견·호출된다. cap_id에서 kind를 파싱해 provider로 라우팅하되, 정책 판정은 provider **호출 전에**
    71	    브로커가 수행한다(게이트 단일 지점). 서브스텝 HIL은 브로커가 전송 이전 interrupt로 게이트(§3.5).
    72	    """
    73	
    74	    def __init__(
    75	        self,
    76	        allowlist: list[str] | None,
    77	        rbac_allows: Callable[..., bool],  # 실호출 (kind) 또는 (kind, name) 2형태 — _permitted 참조
    78	        providers: list[
    79	            _CapabilityProvider
    80	        ],  # 스펙 294 — 조립은 외부(build_providers), 소비만 여기
    81	        *,
    82	        tool_policy: dict
    83	        | None = None,  # config.toolPolicy(스펙 177 P2) — McpProvider 승인 오버라이드
    84	        force_approval: bool = False,  # 첨부 유래 턴(스펙 415 P4) — 정책 없는 부수효과 cap도 승인 강제
    85	    ) -> None:
    86	        # 스펙 294: 브로커는 `_CapabilityProvider` 추상에만 의존한다 — provider를 **주입받고** 구체를
    87	        # 모른다(생성 배선은 composition.build_providers 단일 출처). anti-leak(user_id)·delegation·
    88	        # rag_min_scores 등 조립 인자는 BrokerContext로 build_providers에 실려 이미 provider에 박혔다.
    89	        self._allow: set[str] = set(allowlist or [])
    90	        self._rbac_allows = rbac_allows
    91	        self._tool_policy = tool_policy
    92	        self._force_approval = force_approval
    93	        self._providers: list[_CapabilityProvider] = providers
    94	        self._by_kind = {p.kind: p for p in providers}
    95	        # 관측(설계결정 7) — invoke 이력. broker.invoke가 invisible하지 않음을 보증(호출별 노드 프레임).
    96	        self.invocations: list[dict] = []
    97	
    98	    def _permitted(self, cap_id: str, kind: str | None = None) -> bool:
    99	        """**단일 판정 헬퍼**(체크리스트 §3, drift 0) — allowlist ∩ RBAC. deny-by-default.
   100	        kind별 매칭은 헬퍼 *내부*: mcp는 정확 툴 항목 **또는** 서버 전체(`mcp:<server>`)가 그 툴을 덮음.
   101	        RBAC는 **per-cap 포함**(스펙 112): kind-레벨(`capability:{kind}`) OR 능력별
   102	        (`capability:{kind}:{resource}`) — admin이 kind 전체 대신 특정 cap만 member에 부여 가능."""
   103	        if not cap_id:
   104	            return False
   105	        kind = kind or _kind_of(cap_id)
   106	        if not self._rbac_allows(kind, _cap_resource(cap_id, kind)):
   107	            return False
   108	        if kind == CAP_KIND_MCP:
   109	            server, _tool = _parse_mcp(cap_id)
   110	            return cap_id in self._allow or f"{CAP_KIND_MCP}:{server}" in self._allow
   111	        return cap_id in self._allow
   112	
   113	    async def _gather_permitted(self) -> list[Capability]:
   114	        """kind-게이트 통과 provider들의 후보를 per-cap 필터로 수집(스펙 112)."""
   115	        caps: list[Capability] = []
   116	        for provider in self._providers:
   117	            # DB 미접촉 게이트(존재 누출 0 보존): 이 kind에 **어떤 부여도 없으면** provider를 안 부른다.
   118	            # `rbac_allows(kind)`(name=None) = "kind-레벨 OR 이 kind의 per-cap이 하나라도 있나"(스펙 112).
   119	            # kind 전체 거부인데 per-cap 부여가 있으면 여기 통과 → 아래서 후보를 **per-cap 개별 필터**한다
   120	            # (kind-gate만 두면 per-cap 부여 능력이 discover에 안 떠 오케스트레이션서 못 쓴다).
   121	            if not self._rbac_allows(provider.kind):
   122	                continue
   123	            for cap in await provider.candidates(self._allow):
   124	                # 특정 판정: kind-레벨이면 전체 통과, per-cap 전용이면 부여된 cap만(같은 술어 재사용).
   125	                if self._rbac_allows(cap.kind, _cap_resource(cap.id, cap.kind)):
   126	                    caps.append(cap)
   127	        return caps
   128	
   129	    @staticmethod
   130	    def _rank(caps: list[Capability], query: str) -> list[Capability]:
   131	        """lexical 겹침 랭킹 — **하드 필터가 아니라 랭킹 신호**(스펙 124). 예전엔 `q in cap-text` 하드
   132	        필터로 자연어 쿼리가 짧은 능력 이름의 부분문자열일 리 없어 **허가된 능력이 전부 탈락→조율형이
   133	        아무 능력도 못 씀**(버그). 이제 쿼리 토큰과 겹치는 수가 많은 순으로 **정렬만** 하고(0 겹침도
   134	        유지), 안정 정렬로 동수는 기존 순서 보존. (allowlist∩RBAC 게이트는 수집 단계에서 이미 적용 —
   135	        이 후처리는 허가 범위를 넓히지 않는다.)"""
   136	        q_tokens = [t for t in (query or "").strip().lower().split() if t]
   137	        if q_tokens:
   138	            caps.sort(
   139	                key=lambda c: sum(t in f"{c.name} {c.id} {c.hook}".lower() for t in q_tokens),
   140	                reverse=True,
   141	            )
   142	        return caps
   143	
   144	    async def discover(self, query: str, *, limit: int = 5) -> list[Capability]:
   145	        # deny-by-default: allowlist 비었으면 모집단 공집합(존재조차 안 샘 — DB 미접촉).
   146	        if not self._allow:
   147	            return []
   148	        return self._rank(await self._gather_permitted(), query)[:limit]
   149	
   150	    async def agent_capabilities(self) -> list[Capability]:
   151	        """kind=agent 허가 능력 전량(스펙 318 — 노드 도구 빌더가 소비). discover와 달리 랭킹·limit
   152	        없이 허가된 agent cap을 **전부** 돌려준다(노드가 이름으로 개별 바인딩하므로 모집단이 필요).
   153	        allowlist∩RBAC는 _gather_permitted가 이미 적용 — 이 메서드는 범위를 넓히지 않는다."""
   154	        if not self._allow:
   155	            return []
   156	        return [c for c in await self._gather_permitted() if c.kind == CAP_KIND_AGENT]
   157	
   158	    async def _resolve(self, cap_id: str) -> tuple[Any, Any]:
   159	        """허가+로드된 (row, provider) 또는 (None, None). 미허가·미존재·kind불명 모두 (None,None)
   160	        — 상관 튜플(row None ⇔ provider None)이라 provider도 Any(호출측이 row로 판별).
   161	        (존재 비노출). _permitted가 provider.load **이전**에 서므로 거부 경로는 DB/네트워크 미접촉."""
   162	        kind = _kind_of(cap_id)
   163	        provider = self._by_kind.get(kind)
   164	        if provider is None or not self._permitted(cap_id, kind):
   165	            return None, None
   166	        row = await provider.load(cap_id)
   167	        if row is None:
   168	            return None, None
   169	        return row, provider
   170	
   171	    async def describe(self, cap_id: str) -> Capability:
   172	        row, provider = await self._resolve(cap_id)
   173	        if row is None:
   174	            raise CapabilityNotFoundError(cap_id)  # 미존재·미허가 동일 처리(존재 비노출)
   175	        return provider.describe(row)
