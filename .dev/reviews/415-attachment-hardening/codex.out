    33	def _build_frame(node: str, cap_id: str, ms: int, res: InvokeResult) -> dict:
    34	    """관측 프레임 1개(설계결정 7 — broker.invoke는 invisible 금지). 순수 함수.
    35	    args/result 원문은 안 담고(087/092 — 원문 누출 0) provider raw의 표시용 메타만 통과."""
    36	    inv: dict = {"node": node, "cap_id": cap_id, "ms": ms}
    37	    raw = res.raw if isinstance(res.raw, dict) else {}
    38	    # 표시용 메타(스펙 130) — provider가 raw에 실은 숫자만 통과(hits/topScore), args 불포함.
    39	    # hitsDetail(스펙 191)=히트별 카드+최소 유사도 기준선+검색 질의(RAG 위임 검색 가독성).
    40	    for key in ("hits", "topScore", "hitsDetail"):
    41	        if key in raw:
    42	            inv[key] = raw[key]
    43	    if raw.get("local"):
    44	        inv["local"] = True  # 로컬 인프로세스 위임(스펙 256)
    45	    for key in ("subTraceNodes", "minScore", "query"):
    46	        if key in raw:
    47	            inv[key] = raw[key]
    48	    if res.error:
    49	        # 실패 사유 문자열 보존(스펙 320) — 구 `True` 불리언은 "왜"를 버렸다(예: "capability not found"·
    50	        # "대상 없음"). 마스킹+캡 백스톱(사유가 새 노출 표면). 비어있지 않은 문자열은 truthy라 프론트
    51	        # `b.error ? …` 태그 분기 무회귀 + 사유 표시만 추가.
    52	        from ..memory import _sanitize  # 지연 — 순환 import 방지
    53	
    54	        inv["error"] = _sanitize(str(res.error), cap=500) or True
    55	    if res.text:
    56	        # 결과 본문 프리뷰(스펙 131) — 직접 MCP의 result(2000캡, 087)와 동일 계약으로 브로커도
    57	        # 노출(플레이그라운드=정밀 디버깅). 비밀 마스킹 백스톱(125 _sanitize) + 캡. 원문 전문은
    58	        # 여전히 미저장(캡 절단), args는 계속 불포함.
    59	        from ..memory import _sanitize  # 지연 — 순환 import 방지
    60	
    61	        inv["resultPreview"] = _sanitize(res.text, cap=2000)
    62	    return inv
    63	
    64	
    65	class PolicyScopedBroker:
    66	    """정책으로 미리 스코프된 능력 브로커. `agent.runtime.CapabilityBroker` Protocol 적합.
    67	
    68	    `allowlist` = 호출 에이전트 config `capabilities`(cap id 목록, 없으면 [] = deny-by-default).
    69	    `rbac_allows(kind)` = 유저 RBAC 판정 클로저(casbin enforce 등을 이미 바인딩). 둘의 **교집합**만
    70	    발견·호출된다. cap_id에서 kind를 파싱해 provider로 라우팅하되, 정책 판정은 provider **호출 전에**
    71	    브로커가 수행한다(게이트 단일 지점). 서브스텝 HIL은 브로커가 전송 이전 interrupt로 게이트(§3.5).
    72	    """
    73	
    74	    def __init__(
    75	        self,
    76	        allowlist: list[str] | None,
    77	        rbac_allows: Callable[..., bool],  # 실호출 (kind) 또는 (kind, name) 2형태 — _permitted 참조
    78	        providers: list[
    79	            _CapabilityProvider
    80	        ],  # 스펙 294 — 조립은 외부(build_providers), 소비만 여기
    81	        *,
    82	        tool_policy: dict
    83	        | None = None,  # config.toolPolicy(스펙 177 P2) — McpProvider 승인 오버라이드
    84	        force_approval: bool = False,  # 첨부 유래 턴(스펙 415 P4) — 정책 없는 부수효과 cap도 승인 강제
    85	    ) -> None:
    86	        # 스펙 294: 브로커는 `_CapabilityProvider` 추상에만 의존한다 — provider를 **주입받고** 구체를
    87	        # 모른다(생성 배선은 composition.build_providers 단일 출처). anti-leak(user_id)·delegation·
    88	        # rag_min_scores 등 조립 인자는 BrokerContext로 build_providers에 실려 이미 provider에 박혔다.
    89	        self._allow: set[str] = set(allowlist or [])
    90	        self._rbac_allows = rbac_allows
    91	        self._tool_policy = tool_policy
    92	        self._force_approval = force_approval
    93	        self._providers: list[_CapabilityProvider] = providers
    94	        self._by_kind = {p.kind: p for p in providers}
    95	        # 관측(설계결정 7) — invoke 이력. broker.invoke가 invisible하지 않음을 보증(호출별 노드 프레임).
    96	        self.invocations: list[dict] = []
    97	
    98	    def _permitted(self, cap_id: str, kind: str | None = None) -> bool:
    99	        """**단일 판정 헬퍼**(체크리스트 §3, drift 0) — allowlist ∩ RBAC. deny-by-default.
   100	        kind별 매칭은 헬퍼 *내부*: mcp는 정확 툴 항목 **또는** 서버 전체(`mcp:<server>`)가 그 툴을 덮음.
   101	        RBAC는 **per-cap 포함**(스펙 112): kind-레벨(`capability:{kind}`) OR 능력별
   102	        (`capability:{kind}:{resource}`) — admin이 kind 전체 대신 특정 cap만 member에 부여 가능."""
   103	        if not cap_id:
   104	            return False
   105	        kind = kind or _kind_of(cap_id)
   106	        if not self._rbac_allows(kind, _cap_resource(cap_id, kind)):
   107	            return False
   108	        if kind == CAP_KIND_MCP:
   109	            server, _tool = _parse_mcp(cap_id)
   110	            return cap_id in self._allow or f"{CAP_KIND_MCP}:{server}" in self._allow
   111	        return cap_id in self._allow
   112	
   113	    async def _gather_permitted(self) -> list[Capability]:
   114	        """kind-게이트 통과 provider들의 후보를 per-cap 필터로 수집(스펙 112)."""
   115	        caps: list[Capability] = []
   116	        for provider in self._providers:
   117	            # DB 미접촉 게이트(존재 누출 0 보존): 이 kind에 **어떤 부여도 없으면** provider를 안 부른다.
   118	            # `rbac_allows(kind)`(name=None) = "kind-레벨 OR 이 kind의 per-cap이 하나라도 있나"(스펙 112).
   119	            # kind 전체 거부인데 per-cap 부여가 있으면 여기 통과 → 아래서 후보를 **per-cap 개별 필터**한다
   120	            # (kind-gate만 두면 per-cap 부여 능력이 discover에 안 떠 오케스트레이션서 못 쓴다).
   121	            if not self._rbac_allows(provider.kind):
   122	                continue
   123	            for cap in await provider.candidates(self._allow):
   124	                # 특정 판정: kind-레벨이면 전체 통과, per-cap 전용이면 부여된 cap만(같은 술어 재사용).
   125	                if self._rbac_allows(cap.kind, _cap_resource(cap.id, cap.kind)):
   126	                    caps.append(cap)
   127	        return caps
   128	
   129	    @staticmethod
   130	    def _rank(caps: list[Capability], query: str) -> list[Capability]:
   131	        """lexical 겹침 랭킹 — **하드 필터가 아니라 랭킹 신호**(스펙 124). 예전엔 `q in cap-text` 하드
   132	        필터로 자연어 쿼리가 짧은 능력 이름의 부분문자열일 리 없어 **허가된 능력이 전부 탈락→조율형이
   133	        아무 능력도 못 씀**(버그). 이제 쿼리 토큰과 겹치는 수가 많은 순으로 **정렬만** 하고(0 겹침도
   134	        유지), 안정 정렬로 동수는 기존 순서 보존. (allowlist∩RBAC 게이트는 수집 단계에서 이미 적용 —
   135	        이 후처리는 허가 범위를 넓히지 않는다.)"""
   136	        q_tokens = [t for t in (query or "").strip().lower().split() if t]
   137	        if q_tokens:
   138	            caps.sort(
   139	                key=lambda c: sum(t in f"{c.name} {c.id} {c.hook}".lower() for t in q_tokens),
   140	                reverse=True,
   141	            )
   142	        return caps
   143	
   144	    async def discover(self, query: str, *, limit: int = 5) -> list[Capability]:
   145	        # deny-by-default: allowlist 비었으면 모집단 공집합(존재조차 안 샘 — DB 미접촉).
   146	        if not self._allow:
   147	            return []
   148	        return self._rank(await self._gather_permitted(), query)[:limit]
   149	
   150	    async def agent_capabilities(self) -> list[Capability]:
   151	        """kind=agent 허가 능력 전량(스펙 318 — 노드 도구 빌더가 소비). discover와 달리 랭킹·limit
   152	        없이 허가된 agent cap을 **전부** 돌려준다(노드가 이름으로 개별 바인딩하므로 모집단이 필요).
   153	        allowlist∩RBAC는 _gather_permitted가 이미 적용 — 이 메서드는 범위를 넓히지 않는다."""
   154	        if not self._allow:
   155	            return []
   156	        return [c for c in await self._gather_permitted() if c.kind == CAP_KIND_AGENT]
   157	
   158	    async def _resolve(self, cap_id: str) -> tuple[Any, Any]:
   159	        """허가+로드된 (row, provider) 또는 (None, None). 미허가·미존재·kind불명 모두 (None,None)
   160	        — 상관 튜플(row None ⇔ provider None)이라 provider도 Any(호출측이 row로 판별).
   161	        (존재 비노출). _permitted가 provider.load **이전**에 서므로 거부 경로는 DB/네트워크 미접촉."""
   162	        kind = _kind_of(cap_id)
   163	        provider = self._by_kind.get(kind)
   164	        if provider is None or not self._permitted(cap_id, kind):
   165	            return None, None
   166	        row = await provider.load(cap_id)
   167	        if row is None:
   168	            return None, None
   169	        return row, provider
   170	
   171	    async def describe(self, cap_id: str) -> Capability:
   172	        row, provider = await self._resolve(cap_id)
   173	        if row is None:
   174	            raise CapabilityNotFoundError(cap_id)  # 미존재·미허가 동일 처리(존재 비노출)
   175	        return provider.describe(row)
   176	
   177	    def _gate(
   178	        self, provider: _CapabilityProvider, row: Any, cap_id: str, args: dict
   179	    ) -> InvokeResult | None:
   180	        """서브스텝 HIL(§3.5) — 승인 요구 cap이면 전송(부수효과) **이전** interrupt로 부모 그래프 pause.
   181	        interrupt는 재개 시 delegate 재실행에도 이 지점 이전 부수효과 0 = 전송 1회(멱등, 체크리스트 §7).
   182	        거부면 거부 결과를, 승인·무승인 cap(payload None)이면 None(전송 진행)을 돌린다."""
   183	        payload = provider.approval_for(row, cap_id, args, self._tool_policy)
   184	        # 첨부 유래 턴(스펙 415 P4): 정책 없는 **부수효과** cap도 승인 강제. 대상=MCP(부수효과 미상 —
   185	        # 보수적 전부)·에이전트 위임(하위가 무엇이든 할 수 있음). RAG·메모리 읽기는 approval_for가
   186	        # 늘 None인 읽기 전용이라 면제, 메모리 쓰기/수정은 이미 항상 non-None(무영향).
   187	        if payload is None and self._force_approval and _kind_of(cap_id) in (
   188	            CAP_KIND_MCP,
   189	            CAP_KIND_AGENT,
   190	        ):
   191	            from ..runtime_mcp import forced_attachment_approval
   192	
   193	            payload = {
   194	                **forced_attachment_approval(cap_id),
   195	                "action": cap_id,
   196	                "args": {},  # 강제 게이트는 원 args 마스킹 책임이 provider 밖 — 안전측 비노출
   197	                "summary": "첨부 문서가 있는 대화라 본인 승인 필요 — " + cap_id,
   198	            }
   199	        if payload is None:
   200	            return None
   201	        from langgraph.types import interrupt  # 지연 임포트(그래프 밖 호출 시 부담 0)
   202	
   203	        decision = interrupt(payload)  # 첫 호출=그래프 멈춤, 재개 시 decision 반환
   204	        if not (isinstance(decision, dict) and decision.get("decision") == "approve"):
   205	            return InvokeResult(
   206	                text="거부됨 — 관리자가 실행을 승인하지 않았습니다.", trust="untrusted"
   207	            )
   208	        return None
   209	
   210	    async def invoke(self, cap_id: str, args: dict) -> InvokeResult:
   211	        # 호출 경계 **재검증**(discover 결과 신뢰 안 함 — TOCTOU/우회 차단, 체크리스트 §2).
   212	        row, provider = await self._resolve(cap_id)
   213	        if row is None:
   214	            return InvokeResult(error="capability not found", trust="untrusted")  # 존재 비노출
   215	        denied = self._gate(provider, row, cap_id, args)
   216	        if denied is not None:
   217	            return denied
   218	        t0 = time.perf_counter()
   219	        res = await provider.invoke(row, args)  # 승인된(또는 무승인) 경우만 전송(부수효과 1회)
   220	        ms = int((time.perf_counter() - t0) * 1000)
   221	        # 관측: broker.invoke 1회 = 노드 프레임 1개(설계결정 7 — invisible 금지). args/result는 안 담음
   222	        # (087/092 — 원문 누출 0). interrupt payload만 _redact_args로 마스킹된 args를 싣는다.
   223	        self.invocations.append(_build_frame(provider.node_label(row), cap_id, ms, res))
   224	        return res
   225	
   226	
   227	def _subject_closure(enforcer: casbin.AsyncEnforcer, subject: str) -> set[str]:
   228	    """주체 본인 + 상속 역할(transitive) 집합 — user→role→role 전이 폐쇄(작은 정책셋,
   229	    순환 방지 위해 visited 체크). AsyncEnforcer의 implicit 헬퍼가 async라 sync 정책 열거로 우회
   230	    (get_grouping_policy는 in-memory sync)."""
   231	    subjects = {subject}
   232	    grouping = enforcer.get_grouping_policy()
   233	    frontier = [subject]
   234	    while frontier:
   235	        cur = frontier.pop()
   236	        for group in grouping:
   237	            if len(group) >= 2 and group[0] == cur and group[1] not in subjects:
   238	                subjects.add(group[1])
   239	                frontier.append(group[1])
   240	    return subjects
   241	
   242	
   243	def _has_any_percap(enforcer: casbin.AsyncEnforcer, subject: str, kind: str) -> bool:
   244	    """이 kind에 per-cap 부여가 하나라도 있나 — 주체+상속 역할의 정책에서 obj가
   245	    `capability:{kind}:` prefix인 invoke를 찾는다(casbin 암묵 권한 열거, get_policy는 sync)."""
   246	    subjects = _subject_closure(enforcer, subject)
   247	    prefix = f"capability:{kind}:"
   248	    return any(
   249	        len(p) >= 3 and p[0] in subjects and p[1].startswith(prefix) and p[2] == "invoke"
   250	        for p in enforcer.get_policy()
   251	    )
   252	
   253	
   254	def _has_direct_grant(enforcer: casbin.AsyncEnforcer, subject: str, kind: str, name: str) -> bool:
   255	    """특정 능력 부여 판정 — 능력별(`capability:{kind}:{name}`) 직접 부여 OR mcp 서버단위 부여."""
   256	    if enforcer.enforce(subject, f"capability:{kind}:{name}", "invoke"):
   257	        return True
   258	    # mcp 서버단위 부여(`capability:mcp:{server}`)는 그 서버의 **모든 툴**을 덮는다 — allowlist
   259	    # 시맨틱(`mcp:{server}`가 툴 항목을 포함)과 일치시켜 per-cap 부여가 서버 입도로도 동작(codex 112 P2).
   260	    if kind == CAP_KIND_MCP and "/" in name:
    50	
    51	async def _create_approval(
    52	    ctx: ChatContext, thread_id: str, payload: dict, user_id: str | None
    53	) -> str:
    54	    """위험 도구가 그래프를 멈춘 순간 런타임 Approval(pending) 생성. checkpoint=thread_id가 재개 키.
    55	
    56	    DB 접근은 API 계층(여기)에서만 — 도구는 순수(interrupt payload만 만든다). 이 row가
    57	    ApprovalsView에 뜨고, resolve하면 resume_approval이 같은 thread_id로 그래프를 재개한다.
    58	
    59	    user_id = 요청 주체(쿠키 유저 UUID str, 머신이면 None). owner self-승인(스펙 066)의 대조 기준 —
    60	    여기서 박지 않으면 self-승인 자체가 불가능하고, NULL은 admin 전용으로 fail-closed.
    61	    """
    62	    apid = "apr-" + secrets.token_hex(4)
    63	    async with SessionLocal() as db:
    64	        # 0턴 미영속(스펙 049)이라도 *승인 게이트에 도달한 턴은 실 상호작용*이므로 여기서 세션 행을
    65	        # 보장한다. 그래야 resume_approval의 _load_context가 같은 session_id로 세션을 찾아(새 id를
    66	        # 안 만들고) 최종 답변을 원 세션에 영속한다(approval-resume 연속성 보존).
    67	        sess = await _resolve_session_for_persist(db, ctx)
    68	        if sess is not None:
    69	            ctx.session_pk = sess.id
    70	            ctx.session_pending = None
    71	            # 스펙 068 D6: 승인 게이트에 도달한 턴은 실 상호작용이므로 *생성 시점*에 소유자를 박는다.
    72	            # 이게 없으면 세션이 NULL-owned로 남아, D1(소유자 스코프 resume) 도입 후 그 턴을 시작한
    73	            # member가 *자기 세션을* 이어가지 못한다(무회귀 깨짐). next_owner라 기존 소유자 보존·안전.
    74	            sess.user_id = next_owner(sess.user_id, user_id)
    75	        db.add(
    76	            Approval(
    77	                approval_id=apid,
    78	                session_id=ctx.session_id,
    79	                user_id=user_id,
    80	                agent_pk=ctx.agent_pk,
    81	                agent_name=ctx.agent_name,
