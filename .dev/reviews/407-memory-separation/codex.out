   122	async def _final_frames(
   123	    ctx: ChatContext,
   124	    turn: ChatTurnRuntime,
   125	    *,
   126	    errored: bool,
   127	    acc: list[str],
   128	    t0: float,
   129	    capture: trace_capture.TraceCaptureHandler,
   130	    messages: list[dict],
   131	    sent_messages: list[dict],
   132	    observed: list,
   133	    impl: CustomAgent,
   134	    user_text: str,
   135	    user_id: str | None,
   136	    history_restore: dict | None,
   137	    thread_id: str | None = None,
   138	) -> AsyncIterator[str]:
   139	    """턴 종결 — 브로커 서브스텝 합류·trace 조립·영속·자동 기억·trace/done 프레임."""
   140	    # 브로커 서브스텝 호출을 관측 타임라인에 합류(스펙 100/101 설계결정 7 — broker.invoke가
   141	    # invisible하지 않게). delegate 노드 update와 별개로 cap별 broker_invoke:<kind>:<...> 노드를
   142	    # 남긴다(A2A는 broker_invoke:agent:*, MCP는 broker_invoke:mcp:<server>/<tool>). 위임이 없던
   143	    # 턴은 invocations가 비어 무영향(무회귀).
   144	    for inv in turn.broker.invocations:
   145	        observed.append({"node": inv["node"], "ms": inv.get("ms", 0)})
   146	    full = "".join(acc)
   147	    total_ms = int((time.perf_counter() - t0) * 1000)
   148	    # 오류 턴은 영속/메모리 저장하지 않는다 (부분/실패 응답 오염 방지).
   149	    will_add_memory = (not errored) and turn.used_memory and bool(full)
   150	    trace, tokens = _final_trace(
   130	        trace["toolDiag"] = {
   131	            "bound": [getattr(tl, "name", "?") for tl in turn.tools][:20],
   132	            "called": len(turn.calls_sink),
   133	        }
   134	    # 전송 프롬프트(스펙 205): 콜백 실측(마지막 모델 호출 — 커스텀 impl의 계획·도구 안내 포함)
   135	    # 우선, 콜백 미발화면 기존 재구성(131) 폴백. 출처를 표기해 UI가 정직하게 라벨링.
   136	    if capture.calls:
   137	        trace["sentMessages"] = _format_sent_measured(capture.calls[-1])
   138	        trace["modelCalls"] = len(capture.calls)
   139	        trace["sentMessagesSource"] = "measured"
   140	    else:
   141	        trace["sentMessages"] = sent_messages  # 전송 프롬프트 전문(스펙 131, 메시지당 2000자 캡)
   142	        trace["sentMessagesSource"] = "reconstructed"
   143	
   144	
   145	def _annotate_context_sources(
   146	    trace: dict,
   147	    ctx: ChatContext,
   148	    turn: "ChatTurnRuntime",
   149	    *,
   150	    user_text: str,
   151	    history_restore: dict | None,
   152	) -> None:
   153	    """맥락 출처 주석 — 오버라이드(134)·재구성 실측(289)·브로커(130)·RAG(037)·메모리(079/268/270)."""
   154	    ov_trace = _overrides_trace(ctx.overrides, ctx.overrides_nodes_status)
   155	    if ov_trace:
   156	        # 이 턴에 적용된 오버라이드(스펙 134) — 세션에 설정 다른 턴이 섞여도 턴별 구분 가능.
   157	        trace["overrides"] = ov_trace
   158	    if history_restore:
   159	        # 히스토리 서버 재구성 실측(스펙 289 P1) — 몇 개를 몇 ms에 이어붙였나(캐시 재론의 근거 데이터).
   160	        trace["historyRestore"] = history_restore
   161	    if ctx.attachments_trace:
   162	        # 파일첨부(스펙 404) — 무엇이 주입됐나(파일명·글자수·마스킹 프리뷰). 미첨부 턴은 필드 없음.
   163	        trace["attachments"] = ctx.attachments_trace
   164	    if turn.broker.invocations:
   165	        # 브로커 호출 상세(스펙 130) — 조율형의 RAG 검색이 인스펙터에 "N건·최고 유사도"로 보이게.
   166	        # 위임 없던 턴은 필드 자체가 없음(무회귀).
   167	        trace["brokerCalls"] = _broker_calls_trace(turn.broker.invocations)
   168	    if ctx.rag_collections:
   169	        # 구성된 RAG 컬렉션 — 호출 안 해도 인스펙터에 노출(실제 호출은 trace["mcp"]의 server="rag").
   170	        trace["ragCollections"] = [c["name"] for c in ctx.rag_collections]
   171	    if ctx.rag_unresolved:
   172	        # 요청됐으나 해석 실패한 이름 — 도구가 조용히 비는 footgun을 인스펙터에 드러냄(타자검증 F).
   173	        trace["ragUnresolved"] = ctx.rag_unresolved
   174	    # 회상 쿼리 표시=원발화(스펙 407) — 실제 검색 쿼리와 표시가 일치해야 한다.
   175	    _annotate_memory_observations(trace, turn, user_text=ctx.memory_user_text or user_text)
   176	
   177	
   178	def _annotate_memory_observations(trace: dict, turn: "ChatTurnRuntime", *, user_text: str) -> None:
   179	    """메모리 관측 주석 — 회상 스코프/쿼리(079)·노드별 회상(268 P2)·단기 기억 창(270)."""
   180	    if turn.used_memory:
   181	        # None이 아닌 회상 축만 — {"user_id","run_id","agent_id"} 부분집합 (Inspector가 축별 렌더).
   182	        trace["memoryScope"] = {k: v for k, v in turn.recall_scope.items() if v}
   183	        # 회상에 쓴 쿼리(=user_text)를 에코 — 0건 회상이어도 "조회 행위"를 인스펙터에 남긴다(스펙 079).
   184	        # 표시 전용·길이상한(방금 그 유저가 보낸 텍스트라 경계 이동 없음).
   185	        trace["memoryQuery"] = user_text[:300]
   186	    if turn.memory_recalls:
   187	        # 노드별 회상 기록(스펙 268 P2) — (node, query, hits, cached). 프록시가 조회마다 남김
   188	        # (082 조회 행위 계측). 인스펙터가 노드 행에 귀속 렌더.
   189	        trace["memoryRecalls"] = turn.memory_recalls
   190	    if turn.history_windows:
   191	        # 노드별 단기 기억 창 기록(스펙 270) — (node, depth, count). 프록시가 첫 진입에 남김
   192	        # (082 조회 계측). 내용 아닌 건수만(누출 0). 인스펙터가 노드 행에 귀속 렌더.
   193	        trace["historyWindows"] = turn.history_windows
   194	
   195	
   196	def _final_trace(
   197	    ctx: ChatContext,
   198	    turn: "ChatTurnRuntime",
   199	    *,
   200	    capture: trace_capture.TraceCaptureHandler,
   201	    full: str,
   202	    total_ms: int,
   203	    messages: list[dict],
   204	    sent_messages: list[dict],
   205	    observed: list,
   206	    impl: CustomAgent,
   207	    user_text: str,
   208	    history_restore: dict | None,
   209	) -> tuple[dict, dict]:
   210	    """정상/오류 종결 턴의 trace·tokens 조립 — 반환 (trace, tokens)."""
   211	    prompt_chars = sum(len(m["content"]) for m in messages)
   212	    # 토큰(스펙 205): 모델 usage 실측 우선, 부재 시 추정 폴백(estimated로 정직 표기).
   213	    if capture.usage_seen:
   214	        tokens = {"in": capture.tokens_in, "out": capture.tokens_out, "estimated": False}
   215	    else:
   216	        tokens = {**runtime.estimate_tokens(prompt_chars, len(full)), "estimated": True}
   217	    trace = runtime.assemble_trace(
   218	        agent_id=ctx.ext_agent_id,
   219	        memories=turn.mem_hits,
   220	        mcp_calls=turn.calls_sink,
   200	        ctx,
   201	        user_text,
   202	        form_msg,
   203	        form_trace,
   204	        form_tokens,
   205	        ctx.persist_history,
   206	        user_id=user_id,
   207	        turn_id=thread_id,
   208	    )
   209	    yield _mid_frame(mid)  # 스펙 209 P1.5
   210	    yield f"event: trace\ndata: {json.dumps(form_trace, ensure_ascii=False)}\n\n"
   211	    yield "event: done\ndata: [DONE]\n\n"
   212	
   213	
   214	def _pending_approval_trace(
   215	    ctx: ChatContext,
   216	    turn: ChatTurnRuntime,
   217	    *,
   218	    t0: float,
   219	    apid: str,
   220	    action: str,
   221	    user_text: str,
   222	    sent_messages: list[dict],
   223	) -> dict:
   224	    """승인 대기 턴 trace(스펙 041/079/130/131/134) — 일시정지 이전에 이미 실행된 관측을 표면화."""
   225	    pending_trace = {
   226	        "latencyMs": int((time.perf_counter() - t0) * 1000),
   227	        "tokens": {"in": 0, "out": 0},
   228	        "promptRef": ctx.ext_agent_id,
   229	        "memories": turn.mem_hits,
   230	        "mcp": turn.calls_sink,
   231	        "graph": [],
   232	        "approval": {"id": apid, "action": action, "status": "pending"},
   233	        **({"agentVersion": ctx.exec_version} if ctx.exec_version else {}),
   234	    }
   235	    # 승인대기 턴도 회상 조회 이력 일관 노출(스펙 079).
   236	    if turn.used_memory:
   237	        pending_trace["memoryQuery"] = (ctx.memory_user_text or user_text)[:300]
   238	    if turn.broker.invocations:
   239	        # 일시정지 **이전에 이미 실행된** 선행 브로커 호출 표면화(스펙 130, codex #2).
   240	        pending_trace["brokerCalls"] = _broker_calls_trace(turn.broker.invocations)
   241	    if turn.history_windows:
   242	        # 일시정지 이전 carry 노드가 이미 기록한 단기 기억 창 표면화(codex 270 Low — 관측 일관).
   243	        pending_trace["historyWindows"] = turn.history_windows
   244	    pending_trace["sentMessages"] = sent_messages  # 승인대기 턴도 전송 전문(스펙 131)
   245	    ov_trace_p = _overrides_trace(ctx.overrides, ctx.overrides_nodes_status)
   246	    if ov_trace_p:
   247	        pending_trace["overrides"] = ov_trace_p  # 스펙 134
   248	    if ctx.rag_collections:
   249	        pending_trace["ragCollections"] = [c["name"] for c in ctx.rag_collections]
   250	    return pending_trace
