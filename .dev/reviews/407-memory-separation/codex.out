   179	def apply_attachments(body: ChatRequest) -> list[dict] | None:
   180	    """첨부를 마지막 user 메시지에 경계 블록으로 주입 — 반환: trace용 메타(없으면 None).
   181	
   182	    캡 재강제 지점(단일 관문): 추출 엔드포인트를 안 거친 클라이언트가 임의 텍스트를 보내도
   183	    여기서 개수·길이를 다시 자른다. 주입 후의 content가 그대로 영속·히스토리 재구성에 쓰인다.
   184	    """
   185	    atts = body.attachments or []
