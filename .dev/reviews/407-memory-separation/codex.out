   253	async def _approval_frames(
   254	    ctx: ChatContext,
   255	    interrupted: dict,
   256	    turn: ChatTurnRuntime,
   257	    *,
   258	    thread_id: str,
   259	    user_id: str | None,
   260	    user_text: str,
   261	    t0: float,
   262	    sent_messages: list[dict],
   263	) -> AsyncIterator[str]:
   264	    """위험 도구가 그래프를 멈췄다 → 런타임 Approval 생성 + "대기" 프레임 후 종료(정상 턴 영속 안 함).
   265	    부수효과(canned·calls_sink)는 interrupt 이전이라 0 — 승인 전 무실행 불변식(스펙 041 §3.3)."""
   266	    if ctx.pinned_version:
   267	        # 버전 미리보기(스펙 242) — 승인 재개는 서빙 config로 돌아 버전이 어긋난다(drift).
   268	        # Approval을 만들지 않고 명시 안내(235 비영속 게이트와 동형). 도구는 interrupt 이전이라 미실행.
   269	        yield f"data: {json.dumps({'error': '버전 미리보기에서는 승인이 필요한 도구를 사용할 수 없습니다 — 활성 버전에서 실행하거나 승인 없는 도구를 사용하세요.'}, ensure_ascii=False)}\n\n"
   270	        yield "event: done\ndata: [DONE]\n\n"
