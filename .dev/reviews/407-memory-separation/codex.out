    65	async def _memory_inputs(
    66	    ctx: ChatContext, impl: CustomAgent, user_id: str | None, user_text: str
    67	) -> tuple[dict, dict, bool, list[dict], _MemoryRecallProxy | None, list[dict]]:
    68	    """회상 입력 준비 — 반환 (add_scope, recall_scope, used_memory, mem_hits, mem_proxy, memory_recalls).
    69	
    70	    메모리 스코프(다층 — 스펙 020/029). 회상(search)과 자동 쓰기(add)는 **축이 다르다**:
    71	    - recall_scope: user_id(세션 가로지름)+run_id(세션 단기)+agent_id(에이전트 전용 — 스펙 029).
    72	      search는 축별로 따로 검색해 합집합 병합(mem0 필터는 AND이므로 — memory.py 참고).
    73	    - add_scope: user_id+run_id만. **agent_id는 자동 add에 절대 태깅하지 않는다** — 유저 턴
    74	      자동추출이 agent_id로 새면 user A의 사적 사실이 다른 유저에게 회상된다(스펙 020 누출 차단).
    75	      agent_id 쓰기는 **관리자 저작(agents.py CRUD)으로만** — 채팅 자가기록은 제거됨(스펙 051).
    76	
    77	    스펙 233 발견 봉합: 회상은 impl 실행 전 플랫폼 선처리라 impl의 consumes를 무시했다 — 편집 폼은
    78	    "이 실행 방식은 기억을 무시합니다"라 경고하는데(스펙 206) 런타임은 회상해 **거짓 표시**였다.
    79	    사용자 결정(타입별 게이트): impl이 "memories" 표면을 consumes로 선언했을 때만 회상·자동기록.
    80	    consumes=None(미선언)은 게이트 안 함(스펙 206 "폼 전부 노출" 계약과 정합 — 무회귀).
    81	    노드형(스펙 268 P2): 선(先)조회 대신 **캐싱 회상 프록시**를 주입 — 노드가 각자 조회하고 같은
    82	    키워드는 캐시로 수렴(비용 1회). 선조회를 함께 돌리면 이중 검색이라 노드형은 mem_hits=[]."""
    83	    add_scope = {"user_id": user_id, "run_id": ctx.session_id}
    84	    recall_scope = {**add_scope, "agent_id": ctx.ext_agent_id}
    85	    consumes = impl.describe().consumes
    86	    reads_memory = consumes is None or "memories" in consumes
    87	    used_memory = (
    88	        not ctx.ephemeral  # 비영속(스펙 235): 회상·자동기록 전면 off(stateless)
    89	        and reads_memory
    90	        and memory.memory_enabled(ctx.memories)
    91	        and ctx.mem_cfg is not None
    92	    )
    93	    pipeline = ctx.nodes_resolved is not None
    94	    mem_hits = (
    95	        await asyncio.to_thread(
    96	            memory.search, recall_scope, ctx.memory_user_text or user_text, ctx.mem_cfg
    97	        )
    98	        if used_memory and not pipeline
    99	        else []
   100	    )
   101	    memory_recalls: list[dict] = []
   102	    mem_proxy = (
   103	        _MemoryRecallProxy(
   104	            recall_scope, ctx.mem_cfg, ctx.memory_user_text or user_text, memory_recalls
   105	        )
   106	        if (used_memory and pipeline)
   107	        else None
   108	    )
   109	    return add_scope, recall_scope, used_memory, mem_hits, mem_proxy, memory_recalls
   110	
