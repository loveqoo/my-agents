    93	def _spawn_memory_task(
    94	    add_scope: dict, user_text: str, full: str, mem_cfg: dict | None, mid: str | None
    95	) -> asyncio.Task:
    96	    """저장 태스크 생성·등록(스펙 314) — done yield **전**에 호출된다(codex P0: yield 뒤에 만들면
    97	    done 직후 취소 시 태스크 자체가 안 생겨 저장 유실). 강참조 유지, 완료 콜백이 스스로 제거."""
    98	    task = asyncio.ensure_future(_bg_memory_add(add_scope, user_text, full, mem_cfg, mid))
    99	    _BG_MEMORY_TASKS.add(task)  # 강참조 유지(GC/취소 방지) — 완료 콜백이 스스로 제거
   100	    task.add_done_callback(_BG_MEMORY_TASKS.discard)
   101	    return task
   102	
   103	
   104	async def _trailing_memory_frame(task: asyncio.Task, mid: str) -> str | None:
   105	    """done 뒤 트레일링 memory 이벤트(스펙 314) — 완료를 기다려 조용히 알린다(status 무관 —
   106	    none/error도 pending 해제용). shield로 클라이언트 취소로부터 태스크를 보호하고, wait_for로
   107	    대기 상한을 둬 저장이 비정상적으로 오래 걸려도 연결을 무한정 붙들지 않는다(codex P1 —
   108	    태스크는 계속 완료돼 영속 trace를 갱신하므로 새로고침 시 반영). 취소(클라이언트 이탈)는
   109	    재전파해 제너레이터를 정리한다. 반환 None=이벤트 생략(태스크·영속은 계속)."""
   110	    try:
   111	        summary = await asyncio.wait_for(asyncio.shield(task), timeout=_TRAILING_EVENT_TIMEOUT_S)
   112	    except asyncio.CancelledError:
   113	        raise
   114	    except Exception:  # TimeoutError 포함 — 트레일링 이벤트만 생략(태스크·영속은 계속)
   115	        return None
   116	    return (
   117	        "event: memory\n"
   118	        f"data: {json.dumps({'mid': str(mid), 'memorySaved': summary}, ensure_ascii=False)}\n\n"
   119	    )
