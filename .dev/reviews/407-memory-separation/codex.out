    34	def search(scope: dict, query: str, mem_cfg: dict | None, limit: int = 4) -> list[dict]:
    35	    """관련 메모리 top-k(챗 회상). [{type, text, score, scope}]. 무력화/실패 시 [].
    36	
    37	    챗 경로는 **견고**해야 한다(회상 실패가 대화 턴을 500내면 안 됨) — backend.search가 전 축 실패로
    38	    던지면(스펙 158) 여기서 흡수해 []. 실패의 *표면화*는 진단(recall_diag)·브로커(InvokeResult.error)
    39	    담당이고, 챗은 조용히 회상 없이 진행한다."""
    40	    backend = resolve_backend(mem_cfg)
    41	    if not backend:
    42	        return []
    43	    try:
    44	        return backend.search(scope, query, limit)
    45	    except Exception as exc:
    46	        # 타입명만 로그(스펙 158, codex High) — 예외 메시지에 임베더 비밀이 섞일 수 있어 raw 금지.
    47	        _log.warning("memory.search failed — chat recall skipped: %s", type(exc).__name__)
    48	        return []
