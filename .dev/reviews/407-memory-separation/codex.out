    51	async def _create_approval(
    52	    ctx: ChatContext, thread_id: str, payload: dict, user_id: str | None
    53	) -> str:
    54	    """위험 도구가 그래프를 멈춘 순간 런타임 Approval(pending) 생성. checkpoint=thread_id가 재개 키.
    55	
    56	    DB 접근은 API 계층(여기)에서만 — 도구는 순수(interrupt payload만 만든다). 이 row가
    57	    ApprovalsView에 뜨고, resolve하면 resume_approval이 같은 thread_id로 그래프를 재개한다.
    58	
    59	    user_id = 요청 주체(쿠키 유저 UUID str, 머신이면 None). owner self-승인(스펙 066)의 대조 기준 —
    60	    여기서 박지 않으면 self-승인 자체가 불가능하고, NULL은 admin 전용으로 fail-closed.
    61	    """
    62	    apid = "apr-" + secrets.token_hex(4)
    63	    async with SessionLocal() as db:
    64	        # 0턴 미영속(스펙 049)이라도 *승인 게이트에 도달한 턴은 실 상호작용*이므로 여기서 세션 행을
    65	        # 보장한다. 그래야 resume_approval의 _load_context가 같은 session_id로 세션을 찾아(새 id를
    66	        # 안 만들고) 최종 답변을 원 세션에 영속한다(approval-resume 연속성 보존).
    67	        sess = await _resolve_session_for_persist(db, ctx)
    68	        if sess is not None:
    69	            ctx.session_pk = sess.id
    70	            ctx.session_pending = None
    71	            # 스펙 068 D6: 승인 게이트에 도달한 턴은 실 상호작용이므로 *생성 시점*에 소유자를 박는다.
    72	            # 이게 없으면 세션이 NULL-owned로 남아, D1(소유자 스코프 resume) 도입 후 그 턴을 시작한
    73	            # member가 *자기 세션을* 이어가지 못한다(무회귀 깨짐). next_owner라 기존 소유자 보존·안전.
    74	            sess.user_id = next_owner(sess.user_id, user_id)
    75	        db.add(
    76	            Approval(
    77	                approval_id=apid,
    78	                session_id=ctx.session_id,
    79	                user_id=user_id,
    80	                agent_pk=ctx.agent_pk,
    81	                agent_name=ctx.agent_name,
    82	                permission=payload.get("permission", ""),
    83	                approver=payload.get(
    84	                    "approver"
    85	                ),  # 스펙 177 P2 — MCP 도구만 값 有, 그 외 None→Casbin 폴백
    86	                action=payload.get("action", ""),
    87	                args=payload.get("args", {}),
    88	                summary=payload.get("summary", ""),
    89	                checkpoint=thread_id,
    90	                # 위상 정체 스냅샷(스펙 171) — 재개 시 impl이 바뀌었으면 stale checkpoint에
    91	                # 다른 그래프를 resume하지 않도록 대조 기준. "" = 기본(DefaultUiAgent).
    92	                impl=ctx.impl or "",
    93	                status="pending",
    94	            )
    95	        )
    96	        await db.commit()
    97	    return apid
    98	
    99	
   100	async def _build_resume_broker(
   101	    user_id: str | None,
   102	    capabilities: list[str] | None,
   103	    tool_policy: dict | None = None,
   104	    *,
   105	    delegation_chain: tuple = (),
   106	    delegation_budget: dict | None = None,
   107	) -> PolicyScopedBroker:
   108	    """재개용 스코프 브로커 — 원 요청자(user_id)의 RBAC를 재구성해 request-time 게이트를 그대로 복원.
   109	
   110	    build_broker(principal, ...)와 **동일 술어**를 principal 객체 없이 재현한다: superuser면 우회(원
   111	    요청과 동일 안전판), 아니면 casbin `enforce(user_id, capability:{kind}, invoke)`. user_id가 없으면
   112	    deny(머신 발 — 이 경로는 애초에 브로커 interrupt를 못 만들므로 실질 미도달, 안전측 기본).
   113	
   114	    로컬 위임(스펙 256) 봉합(codex 256 [P2]): 재개도 원 턴과 동일하게 (1) **원 요청자 principal 객체**를
   115	    AgentProvider에 관통해야 하위 eval_run_agent→build_broker가 principal.id로 스코프를 재구성한다
   116	    (없으면 크래시 → 승인된 로컬 위임이 조용히 미실행). (2) **delegation_chain**(루트 agent_id)을
   117	    관통해야 재개 후 재위임에서도 순환·깊이 게이트가 원 턴과 동일하게 성립한다."""
   118	    is_super = False
   119	    requester = None  # 원 요청자 User 객체(AgentProvider가 로컬 위임 하위 실행의 RBAC 주체로 사용)
   120	    if user_id:
   121	        try:
   122	            async with SessionLocal() as s:
   123	                u = await s.get(User, uuid.UUID(user_id))
   124	                requester = u  # 로드된 속성(id·is_superuser)은 세션 종료 후 접근 가능
   125	                is_super = bool(u and u.is_superuser)
   126	        except (ValueError, TypeError):
   127	            is_super = False  # user_id가 UUID 형식이 아니면 casbin 경로로만(우회 없음)
   128	
   129	    def rbac_allows(kind: str, name: str | None = None) -> bool:
   130	        # per-cap 부여 지원(스펙 112) — build_broker와 **동일 술어**(`_rbac_allows`, drift 0).
   131	        if not user_id:
   132	            return False
   133	        if is_super:
   134	            return True
   135	        from .broker import _rbac_allows
   136	
   137	        return _rbac_allows(authz.get_enforcer(), user_id, kind, name)
   138	
   139	    # user_id 주입(스펙 104) — MemoryProvider가 재개 경로에서도 원 요청자 스코프를 복원한다. 없으면
   140	    # 재개 시 `memory:user`가 사라져 자기 기억 접근이 깨진다(fail-closed지만 기능 회귀, 적대 리뷰 104 P2).
   141	    # principal(원 요청자)·delegation_chain(루트) 관통 — 로컬 위임 재개 봉합(codex 256 [P2]).
   142	    # 스펙 294: 조립은 build_providers(BrokerContext) 단일 출처 — 브로커는 소비만.
   143	    providers = build_providers(
   144	        BrokerContext(
   145	            principal=requester,
   146	            user_id=user_id,
   147	            delegation_chain=delegation_chain,
   148	            delegation_budget=delegation_budget,
   149	        )
   150	    )
   151	    return PolicyScopedBroker(capabilities, rbac_allows, providers, tool_policy=tool_policy)
   152	
   153	
   154	def _impl_drifted(snap_impl: str | None, cur_impl: str | None) -> bool:
   155	    """스펙 171 — 재개 시 impl(그래프 위상)이 생성 시점과 달라졌나. 순수 함수(단위 검증 가능).
   156	
   157	    - snap None = 스펙 171 마이그레이션 이전에 만든 행 = 스냅샷 부재 = 대조 불가 → False(스킵, 하위호환).
   158	    - "" = 기본(DefaultUiAgent). cur도 None/""면 기본이므로 `cur or ""`로 정규화해 대조.
   159	    - snap이 있고 현재와 다르면 True → 재개는 미정의 동작(다른 그래프를 stale checkpoint에 resume)이라 거부.
   160	    """
   161	    if snap_impl is None:
   162	        return False
   163	    return snap_impl != (cur_impl or "")
   164	
   165	
   166	# ---------------------------- resume_approval 단계 헬퍼 (스펙 291 분해) ----------------------------
   167	
   168	
   169	async def _load_resume_target(
   170	    approval: Approval,
   171	) -> "tuple[ChatContext, CustomAgent, AsyncPostgresSaver, str] | None":
   172	    """재개 가능성 가드 — 통과 시 (ctx, impl, ckpt, thread_id), 불가면 None(graceful 무시).
   173	
   174	    가드: checkpoint(thread_id)·agent_pk 없으면 재개 불가. code/external 소스는 로컬 그래프가
   175	    아니므로 애초에 approval을 만들지 않는다(여기 도달 시 graceful 무시).
   176	
   177	    impl-drift 가드(스펙 171): approval은 생성 시점 impl의 그래프 topology로 checkpoint를 만들었다.
   178	    그 사이 admin이 `config.impl`을 다른 impl로 바꾸면 그 checkpoint는 현 그래프와 위상이 어긋난다 —
   179	    다른 그래프를 stale checkpoint에 resume하는 건 LangGraph 미정의 동작이라 **graceful 거부**
   180	    (approval은 이미 결재됨·세션 무파손·approved-but-not-executed=안전방향). 다중 HIL impl 출하 중
   181	    (DefaultUiAgent·orchestrate·orchestrate_ranked)이라 이 스왑은 실제 도달 가능(deep-reasoner 적대
   182	    검토). 방아쇠는 admin의 impl 교체(agents:manage)에 갇혀 권한상승은 아니다. impl 스냅샷이 None인
   183	    행(171 마이그레이션 이전)은 대조 불가라 스킵하고 supports_hil 가드로만 넘긴다(하위호환)."""
   184	
   185	    thread_id = approval.checkpoint
   186	    if not thread_id or not approval.agent_pk:
   187	        log.warning("resume 건너뜀: checkpoint/agent_pk 없음 (approval %s)", approval.approval_id)
   188	        return None
   189	    ckpt = checkpointer.get_checkpointer()
   190	    if ckpt is None:
   191	        log.warning("resume 불가: 체크포인터 비활성 (approval %s)", approval.approval_id)
   192	        return None
   193	    # 원 턴과 동일하게 컨텍스트·도구·프롬프트를 재구성(같은 세션 id → 기존 세션 로딩, 새로 안 만듦).
   194	    ctx = await _load_context(approval.agent_pk, approval.session_id)
   195	    try:
   196	        impl = resolve_agent_runtime(ctx)
   197	    except AgentConfigError as e:
   198	        # 선언한 구현이 미해결(스펙 089) — 재개 불가, graceful 무시(approval은 이미 결재됨, 세션 무파손).
   199	        log.warning("resume 불가: 설정 실패 impl '%s' (approval %s)", e, approval.approval_id)
   200	        return None
   201	    if impl is None or ctx.model_cfg is None:
   202	        log.warning("resume 불가: 비로컬/모델없음 소스 (approval %s)", approval.approval_id)
   203	        return None
   204	    if _impl_drifted(approval.impl, ctx.impl):
   205	        log.warning(
   206	            "resume 불가: impl drift — 생성 '%s' vs 현재 '%s' (checkpoint 위상 불일치, approval %s)",
   207	            approval.impl or "(기본)",
   208	            ctx.impl or "(기본)",
   209	            approval.approval_id,
   210	        )
   211	        return None
   212	    # 잔여 방어(codex F2 원본): 현 런타임이 HIL 미지원이면 애초 interrupt/checkpoint를 만들 수 없으므로
   213	    # 재개 불가. impl-drift 가드가 impl 변경을 이미 잡으므로 대개 이 지점 도달 = impl 불변 + 원래
   214	    # HIL 지원이나, 방어적으로 유지(예: 마이그레이션 이전 None-snap 행이 non-HIL로 바뀐 경우).
   215	    if not impl.describe().supports_hil:
   216	        log.warning(
   217	            "resume 불가: 현 런타임(%s)이 HIL 미지원 — checkpoint 생성 그래프와 drift (approval %s)",
   218	            type(impl).__name__,
   219	            approval.approval_id,
   220	        )
   221	        return None
   222	    return ctx, impl, ckpt, thread_id
   223	
   224	
   225	def _resume_uses_memory(ctx: ChatContext, impl: CustomAgent) -> bool:
   226	    """재개 턴 회상 게이트 — 비영속(235 대칭)·consumes 선언(233)·메모리 on·mem_cfg 존재 모두 충족."""
   227	    consumes = impl.describe().consumes
   228	    reads_memory = consumes is None or "memories" in consumes
   229	    return (
   230	        not ctx.ephemeral
   231	        and reads_memory
   232	        and memory.memory_enabled(ctx.memories)
   233	        and ctx.mem_cfg is not None
   234	    )
   235	
   236	
   237	async def _resume_memory_inputs(
   238	    ctx: ChatContext, impl: CustomAgent, approval: Approval
   239	) -> "tuple[bool, list[dict], _MemoryRecallProxy | None, list[dict]]":
   240	    """재개 경로 회상 입력 — 반환 (used_memory, mem_hits, mem_proxy, resume_recalls).
   241	
   242	    user 축 = 원 요청자(approval.user_id — 브로커 RBAC 재확인과 동일 재료, codex 268 P2): 재개 후
   243	    노드 회상이 원 요청자의 세션-가로지름 기억을 그대로 쓰게(원 턴과 동일 스코프). 없으면 None(머신 발).
   244	    스펙 233 봉합(이중 배선 축 — 신규 chat과 동일 게이트를 재개 경로에도): impl이 "memories"를
   245	    consumes로 선언할 때만 회상(폼 "무시됩니다"를 재개 경로에서도 참으로).
   246	    재개 주체=admin이라 user/run 축 회상은 의미가 약하나, 프롬프트 톤 유지를 위해 agent 축 회상만이라도
   247	    접목(없어도 무해). 자동 메모리 add는 user_id 부재로 생략(빚). 노드형은 선조회 생략(메인 경로 대칭,
   248	    스펙 268 P2) — 프록시가 노드별 조회(기본 키워드=approval.summary, 원 턴과 동일 재료)."""
   249	
   250	    recall_scope = {
   251	        "user_id": str(approval.user_id) if approval.user_id else None,
   252	        "run_id": ctx.session_id,
   253	        "agent_id": ctx.ext_agent_id,
   254	    }
   255	    used_memory = _resume_uses_memory(ctx, impl)
   256	    mem_hits = (
   257	        await asyncio.to_thread(memory.search, recall_scope, approval.summary or "", ctx.mem_cfg)
   258	        if used_memory and ctx.nodes_resolved is None
   259	        else []
   260	    )
   261	    resume_recalls: list[dict] = []
   262	    mem_proxy = (
   263	        _MemoryRecallProxy(recall_scope, ctx.mem_cfg, approval.summary or "", resume_recalls)
   264	        if (used_memory and ctx.nodes_resolved is not None)
   265	        else None
   266	    )
   267	    return used_memory, mem_hits, mem_proxy, resume_recalls
   268	
   269	
   270	async def _rebuild_resume_graph(
   271	    ctx: ChatContext,
   272	    impl: CustomAgent,
   273	    ckpt: "AsyncPostgresSaver",
   274	    approval: Approval,
   275	    mem_hits: list[dict],
   276	    mem_proxy: "_MemoryRecallProxy | None",
   277	) -> "tuple[CompiledStateGraph, list[dict], PolicyScopedBroker, list[dict]] | None":
   278	    """원 턴과 동일 재료로 그래프 재구성 — 반환 (graph, calls_sink, resume_broker, history_windows).
   279	    그래프 조립 시점 설정 실패(스펙 317 — 코드 노드 impl 미등록 등)는 None(재개 불가 graceful).
   280	
     1	"""로컬(ui) 에이전트 A2A 서빙 — chat_stream.py에서 분할+Command화(스펙 392 P2/P3).
     2	
     3	스펙 061(서빙)→387(userId·기억)→388(contextId 세션·승인 브리지)의 로컬 서빙 경로.
     4	파사드는 chat.py(재수출 계약: prepare_serve_turn·LocalServeTurn·ServeOutcome 계열).
     5	
     6	설계(codex 자문 + Replace Function with Command):
     7	- async generator는 값을 반환할 수 없어(PEP 525) 구현이 mutable dict `state`를 out-param으로
     8	  넘겨 "스트림 소진 후 읽어라"를 암묵 계약으로 삼았다 — 시간 순서가 타입에 없어 취약했다.
     9	- `LocalServeTurn`(Command)이 스트림과 최종 결과를 함께 소유한다: `prepare()`가 그래프·재료를
    10	  조립하고, `chunks()`가 텍스트를 스트리밍하며, 소진 후 `outcome`이 ServeOutcome을 준다.
    11	  소진 전 접근은 RuntimeError(암묵 계약의 명시화).
    12	- 옛 `_serve_*` 헬퍼 6종이 인자로 나르던 공통 문맥(ctx·user_id·thread_id·has_ckpt…)은 전부
    13	  인스턴스 필드로 흡수(Introduce Parameter Object — 인자 10개 → self).
    14	"""
    15	
    16	import asyncio
    17	import logging
    18	import uuid
    19	from collections.abc import AsyncIterator
    20	from dataclasses import dataclass, field
    21	from typing import TYPE_CHECKING
    22	
    23	from agent.runtime import AgentBuildContext, AgentConfigError, CustomAgent
    24	
    25	if TYPE_CHECKING:
    26	    from langgraph.graph.state import CompiledStateGraph
    27	
    28	from . import checkpointer, memory, observability, runtime
    29	from .chat_context import ChatContext, _load_context
    30	from .chat_graph_build import _rag_tools_for, resolve_agent_runtime
    31	from .chat_history import _history_load_limit, _load_session_conversation, _window
    32	from .chat_persist import _persist
    33	
    34	log = logging.getLogger("api.chat")
    35	
    36	
    37	# ── 서빙 턴 결과(스펙 392 P3 — out-param dict의 타입화) ─────────────────────────
    38	
    39	
    40	@dataclass(frozen=True)
    41	class ServeCompleted:
    42	    """정상 완주 — reply는 소진된 전체 응답(영속·기억 저장 완료 후)."""
    43	
    44	    reply: str
    45	
    46	
    47	@dataclass(frozen=True)
    48	class ServeApprovalRequired:
    49	    """승인 대기 전환(스펙 388 P2) — a2a_server가 input-required Task/이벤트로 표현."""
    50	
    51	    id: str
    52	    action: str
    53	    approver: str | None
    54	
    55	
    56	@dataclass(frozen=True)
    57	class ServeFailed:
    58	    """실행 불가 안내(비영속 승인 불가 등) — a2a_server가 JSON-RPC error/failed로 표현."""
    59	
    60	    message: str
    61	
    62	
    63	ServeOutcome = ServeCompleted | ServeApprovalRequired | ServeFailed
    64	
    65	
    66	@dataclass
    67	class LocalServeTurn:
    68	    """한 A2A 서빙 턴의 Command 객체 — 재료(필드)·스트림(chunks)·결과(outcome)를 함께 소유.
    69	
    70	    사용 규약: `turn = await prepare_serve_turn(...)` → `async for text in turn.chunks()` →
    71	    스트림 소진 후 `turn.outcome`. 소진 전 outcome 접근은 RuntimeError(구 state dict의
    72	    "소진 후 읽기" 암묵 계약을 타입·예외로 명시화). 클라이언트 중간 이탈 시 GeneratorExit로
    73	    영속·기억 저장이 생략될 수 있음은 종전과 동일한 정직한 경계(스펙 388)."""
    74	
    75	    ctx: ChatContext
