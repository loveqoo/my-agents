    65	def recall_probe(
    66	    scope: dict, query: str, mem_cfg: dict | None, limit: int = 4
    67	) -> list[dict] | None:
    68	    """회상 *시험*용(스펙 084) — `search`와 같되 백엔드 **가용성**을 결과와 구분해 돌린다.
    69	
    70	    백엔드 미가용(mem_cfg None·llm/embedder 누락·초기화 실패로 resolve_backend가 None 흡수) → None.
    71	    가용 → top-k 리스트(limit로 방어적 슬라이스). `search`가 두 경우를 모두 []로 뭉개는 것과 다르다:
    72	    시험 도구가 *구성됐으나 깨진* 백엔드를 "기억 없음(빈 results)"으로 오인하면 진단이 거짓이 된다
    73	    (적대 리뷰 084 P2a). 호출자는 `hits is None`으로 enabled=False를, `[]`로 "가용·회상 0건"을
    74	    구분한다. chat 경로(`search`)는 무변경 — drift 0.
    75	
   180	        # mem0의 숨은 기본 0.1이 저유사도(arctic query-prefix 미주입·약한 질의 등)를 전부 컷해 "정상·0건"
   181	        # 위장을 만들던 것을 종료 — 낮은 점수까지 보여 사용자가 원인(임베더/질의 유사도)을 자가진단.
   182	        diag["results"] = backend.search(scope, query, n, threshold=0.0)[:n]
   183	    except Exception as exc:
   184	        diag["error"] = "검색 실행 실패: " + _sanitize(exc, secrets=secrets)
   185	        return diag
   186	    # 정직한 0건 진단(스펙 158): 예외는 없는데 저장>0·회상0이면 유사도/필터/벡터공간 심층 문제.
   187	    if not diag["results"] and diag["stored"]:
   188	        diag["error"] = (
   189	            f"스코프에 {diag['stored']}건이 저장돼 있으나 회상 0건입니다 — 질의-기억 유사도가 매우 낮거나"
   190	            "(질의 어휘·임베더 query prefix 문제), 저장 시 임베더와 현재 임베더가 달라 벡터공간이"
   191	            " 어긋났을 수 있습니다(다르면 재인덱싱 필요). 필터 축 불일치도 확인하세요."
   192	        )
   193	    return diag
