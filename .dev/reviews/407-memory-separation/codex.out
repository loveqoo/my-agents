   112	async def _turn_tools(
   113	    ctx: ChatContext, cached: dict | None, calls_sink: list[dict]
   114	) -> tuple[list, float, float]:
   115	    """턴 도구 확보(스펙 396 분해) — 캐시 적중=tools 재사용(빌드 생략), 미스=MCP+RAG 빌드.
   116	    반환 (tools, t_mcp, t_rag) — buildMs 계측 시각 포함(적중 시 두 시각 동일=0ms)."""
   117	    if cached is not None:
   118	        graph_cache_stats["hits"] += 1
   119	        now = time.perf_counter()
   120	        return cached["tools"], now, now
   121	    tools = await runtime.build_mcp_tools(
   122	        ctx.mcp_servers, calls_sink, ctx.tool_policy, ctx.tool_names
   123	    )
   124	    t_mcp = time.perf_counter()
   125	    # 채팅 자가기록 도구는 제거됨(스펙 051) — agent_id 메모리는 어드민 저작 전용. 회상은 유지.
   126	    # RAG 검색 도구 — vectorTables가 실 컬렉션으로 해석됐을 때만(스펙 037). 노드형은 컬렉션별 도구
   127	    # 추가(스펙 268 P1 — _rag_tools_for).
   128	    tools.extend(_rag_tools_for(ctx, calls_sink))
   129	    return tools, t_mcp, time.perf_counter()
   130	
   131	
   132	def _graph_for_turn(
   133	    fp: str | None, cached: dict | None, impl: CustomAgent, build_ctx: AgentBuildContext
   134	) -> tuple[Any, str]:
   135	    """그래프 획득 3분기(스펙 396 분해) — 반환 (graph, seed_hint).
   136	
   137	    ① 캐시 적중: 그대로 재사용. ② 지문 적격 미스: promptless 빌드(스펙 371 D3 — 시스템 프롬프트는
   138	    seed 선두 SystemMessage로, 스파이크 실증) 후 캐시 저장(+최고령 축출). discovery 힌트는 도구
   139	    집합의 함수라 캐시 엔트리에 동봉. ③ 비적격(fp=None): 종전 그대로 직접 빌드."""
   140	    if cached is not None:
   141	        return cached["graph"], cached["hint"]
   142	    if fp is not None:
   143	        from agent.toolbox import DISCOVERY_HINT, effective_tools
   144	
   145	        _, _discovery = effective_tools(build_ctx.tools)
   146	        seed_hint = f"\n\n# 도구 안내\n{DISCOVERY_HINT}" if _discovery else ""
   147	        graph = impl.build_graph(
   148	            AgentBuildContext(
   149	                prompt="",
   150	                model_cfg=build_ctx.model_cfg,
   151	                tools=build_ctx.tools,
   152	                checkpointer=build_ctx.checkpointer,
   153	                params=build_ctx.params,
   154	                memories=build_ctx.memories,
   155	                overrides=build_ctx.overrides,
   156	                broker=build_ctx.broker,
   157	                memory_recall=build_ctx.memory_recall,
   158	                history_window=build_ctx.history_window,
   159	                impl_config=build_ctx.impl_config,
   160	            )
   161	        )
   162	        graph_cache_stats["misses"] += 1
   163	        if len(_GRAPH_CACHE) >= _GRAPH_CACHE_MAX:
   164	            _GRAPH_CACHE.pop(next(iter(_GRAPH_CACHE)))  # 최고령 축출(삽입순)
   165	        _GRAPH_CACHE[fp] = {"graph": graph, "tools": build_ctx.tools, "hint": seed_hint}
   166	        return graph, seed_hint
   167	    return impl.build_graph(build_ctx), ""
   168	
