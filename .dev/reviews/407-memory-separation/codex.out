   461	
   462	    반환 (status, reply, session_id): "resumed"=재개 완료(reply=최종 답변·session_id=contextId
   463	    에코용) · "already"=이미 처리(409 의미) · "not_found"=승인 없음/스코프 불일치(**접기** —
   464	    열거 오라클 0: 타 에이전트·타 userId의 approval_id는 부재와 동일 응답) · "forbidden"=
   465	    결재 권한 없음(REST와 동일 — 자기 행이라 존재는 아는 상태, 403 의미).
   466	
   467	    **결재 인가는 REST와 단일 출처**(codex 388 P2 P1 봉합): approvals._may_resolve를 공유 —
   468	    admin/머신=전체, 비-admin은 approver="self" 스탬프 또는 casbin self_approve만. 이게 없으면
   469	    비-admin 쿠키 유저가 A2A로 자기 승인을 스스로 approve해 위험 도구를 실행할 수 있었다.
   470	    require_agent_pk/require_user_id: A2A 입구 스코프 — 이 에이전트의(+이 유저의) 승인만 결정 가능.
   471	    """
   472	    async with SessionLocal() as db:
   473	        p = (
   474	            await db.execute(select(Approval).where(Approval.approval_id == approval_id))
   475	        ).scalar_one_or_none()
   476	        if p is None:
   477	            return "not_found", None, None
   478	        if require_agent_pk is not None and p.agent_pk != require_agent_pk:
   479	            return "not_found", None, None
   480	        if require_user_id is not None and p.user_id != require_user_id:
   481	            return "not_found", None, None
   482	        from .approvals import (
   483	            _may_resolve,
   484	        )  # 지연 import(approvals→chat_approval 역방향이라 순환 회피)
   485	
   486	        if not _may_resolve(p, principal):
   487	            return "forbidden", None, None
   488	        new_status = "approved" if decision == "approve" else "rejected"
   489	        res = await db.execute(
   490	            sa_update(Approval)
   491	            .where(Approval.approval_id == approval_id, Approval.status == "pending")
   492	            .values(status=new_status, resolved_at=sa_func.now(), resolved_by=resolved_by)
   493	        )
   494	        if res.rowcount == 0:
   495	            return "already", None, None
   496	        await db.commit()
   497	        await db.refresh(p)
   498	    reply = await resume_approval(p, decision)
   499	    return "resumed", reply, p.session_id
     1	"""플레이그라운드 파일첨부(스펙 404, A안 — 1회성 대화 주입).
     2	
     3	무상태 2박자: ① `POST /chat/attachments`가 파일에서 텍스트만 추출해 돌려주고(서버 보관 없음),
     4	② 클라이언트가 그 텍스트를 `ChatRequest.attachments`로 되보내면 `apply_attachments`가 마지막
     5	user 메시지 앞에 **경계 블록**으로 주입한다. 주입된 최종 메시지가 그대로 영속되므로 히스토리
     6	재구성(스펙 289)·재개가 공짜(별도 저장소·TTL 없음).
     7	
     8	첨부는 **데이터(지시 아님)** — 경계 표기(`[첨부 문서: …]…[첨부 끝]`)로 본문과 구분한다.
     9	캡 3종(파일 raw 5MB·추출 3만자·턴당 3개)은 2026-07-19 승인값(스펙 404 — 사용자 가시 한계).
    10	서버가 주입 시점에 **재강제**한다(추출 엔드포인트만 믿으면 클라 우회로 캡이 뚫린다).
    11	"""
    12	
    13	import asyncio
    14	import io
    15	import logging
    16	import re
    17	import secrets
    18	
    19	from fastapi import APIRouter, HTTPException, UploadFile
    20	from pydantic import BaseModel
    21	
    22	from . import rag_ingest
    23	from .memory import _sanitize
    24	from .schemas import ChatRequest
    25	
    26	log = logging.getLogger("api.chat_attachments")
    27	
    28	router: APIRouter = APIRouter(prefix="/chat", tags=["attachments"])
    29	
    30	RAW_CAP = 5 * 1024 * 1024  # 파일당 5MB(승인값) — raw 바이트에서 누적 검사
    31	TEXT_CAP = 30_000  # 파일당 추출 텍스트 3만자(승인값) — 초과는 앞부분+잘림 명시
    32	COUNT_CAP = 3  # 턴당 첨부 수(승인값) — 총합 상한은 3×3만=9만자(스펙 404 명시 계약)
    33	PDF_PAGE_CAP = 300  # PDF 페이지 캡(codex 404 P1 — 무제한 파싱은 CPU 폭탄)
    34	EXTRACT_TIMEOUT_S = 20  # 추출 시간 상한(스레드 격리 위에서 — 이벤트루프 무점유)
    35	
    36	
    37	class _ExtractError(Exception):
    38	    """추출 실패(스레드 안에서 HTTPException 대신) — (status, detail)."""
    39	
    40	    def __init__(self, status: int, detail: str) -> None:
    41	        self.status, self.detail = status, detail
    42	
    43	
    44	# 문자권 일관성 게이트(스펙 407 P2) — 한글 PDF의 ToUnicode 매핑 부재 시 pypdf가 타 문자권
    45	# 글자(구르무키 등)로 오추출한다. 깨진 텍스트를 "성공"으로 통과시키면 주입·기억까지 오염되므로
    46	# 허용 문자권 밖 비율이 임계를 넘으면 부정합 판정(정직 400). 실측 표본: 개발자 이력서 PDF.
    47	_COHERENT_RANGES = (
    48	    (0x0020, 0x007E),  # ASCII
    49	    (0x00C0, 0x024F),  # 라틴 확장(서구권 문서)
    50	    (0x1100, 0x11FF),  # 한글 자모
    51	    (0x2000, 0x206F),  # 일반 문장부호(•·— 등)
    52	    (0x3000, 0x303F),  # CJK 문장부호
    53	    (0x3130, 0x318F),  # 한글 호환 자모
    54	    (0x4E00, 0x9FFF),  # CJK 한자
    55	    (0xAC00, 0xD7A3),  # 한글 음절
    56	    (0xFF00, 0xFFEF),  # 전각
    57	)
    58	COHERENCE_MIN_RATIO = 0.7  # 비공백 문자 중 허용 문자권 비율 최소치
    59	
    60	
    61	def is_extract_coherent(text: str) -> bool:
    62	    """추출 텍스트가 문자권 일관성을 갖는가 — 짧은 텍스트(<20자)는 판정 보류(통과)."""
    63	    chars = [c for c in text if not c.isspace()]
    64	    if len(chars) < 20:
    65	        return True
    66	    okc = sum(1 for c in chars if any(lo <= ord(c) <= hi for lo, hi in _COHERENT_RANGES))
    67	    return okc / len(chars) >= COHERENCE_MIN_RATIO
    68	
    69	
    70	def _pdf_pypdf(data: bytes) -> str:
    71	    from pypdf import PdfReader
    72	
    73	    reader = PdfReader(io.BytesIO(data))
    74	    if len(reader.pages) > PDF_PAGE_CAP:
    75	        raise _ExtractError(413, f"PDF가 너무 깁니다 — {PDF_PAGE_CAP}페이지까지 지원합니다.")
    76	    return "\n".join((p.extract_text() or "") for p in reader.pages)
    77	
    78	
    79	def _pdf_pdfminer(data: bytes) -> str:
    80	    """pdfminer.six 폴백(스펙 407 P3, 승인된 의존성 — MIT) — CMap 처리가 pypdf보다 견고한
    81	    경우가 있어 pypdf가 깨졌을 때 한 번 더 시도. maxpages로 작업량 유계(폴백 경로 한정 절단)."""
    82	    from pdfminer.high_level import extract_text as _pm_extract
    83	
    84	    return _pm_extract(io.BytesIO(data), maxpages=PDF_PAGE_CAP) or ""
    85	
    86	
    87	def _extract_sync(filename: str, content_type: str | None, data: bytes) -> str:
    88	    """동기 추출(스레드에서 실행) — 판별은 **매직 바이트 우선**(codex 404 P2: MIME/확장자는
    89	    위조 가능 — %PDF- 실물이면 이름과 무관하게 PDF, .pdf 이름인데 실물이 아니면 위조 400).
    90	
    91	    PDF는 pypdf → (파싱 실패·문자권 부정합 시) pdfminer 폴백 → 그래도 부정합이면 정직 400(스펙 407)."""
    92	    if data[:5] == b"%PDF-":
    93	        text: str | None = None
    94	        try:
    95	            text = _pdf_pypdf(data)
    96	        except _ExtractError:
    97	            raise
    98	        except Exception:
    99	            text = None  # pypdf 파싱 실패 — pdfminer 폴백으로
   100	        if text is not None and is_extract_coherent(text):
   101	            return text
   102	        try:
   103	            alt = _pdf_pdfminer(data)
   104	        except Exception:
   105	            alt = ""
   106	        if alt.strip() and is_extract_coherent(alt):
   107	            return alt
   108	        if text is None and not alt.strip():
   109	            raise _ExtractError(400, "PDF를 파싱할 수 없습니다.")
   110	        raise _ExtractError(
   111	            400,
   112	            "PDF 텍스트가 깨진 형태로 추출됩니다(폰트 매핑 문제) — "
   113	            "텍스트 저장본(txt)이나 다른 PDF로 시도해 주세요.",
   114	        )
   115	    if rag_ingest.is_pdf(filename, content_type):
   116	        raise _ExtractError(400, "PDF 형식이 아닙니다(확장자/타입 위조 — %PDF- 시그니처 부재).")
   117	    try:
   118	        return data.decode("utf-8")
   119	    except UnicodeDecodeError as exc:
   120	        raise _ExtractError(
   121	            400, "텍스트를 추출할 수 없습니다 — txt·md·pdf 등 텍스트류만 지원합니다."
   122	        ) from exc
   123	
   124	
   125	class AttachmentOut(BaseModel):
   126	    filename: str
   127	    text: str  # 추출 전문(캡 적용) — 클라이언트가 ChatRequest.attachments로 되보낸다
   128	    chars: int
   129	    truncated: bool  # 3만자 캡으로 잘렸는가(UI가 정직하게 표시)
   130	
   131	
   132	@router.post("/attachments", response_model=AttachmentOut)
   133	async def extract_attachment(file: UploadFile) -> AttachmentOut:
   134	    """파일 → 평문 추출(무상태). txt/md/텍스트류=UTF-8, pdf=pypdf — 이미지 PDF·바이너리는 400.
   135	
   136	    raw 캡은 **읽으면서 누적**으로 검사한다(learning: .content 위 카운트는 막은 척 —
   137	    Content-Length 신뢰 금지, 5MB 초과 시점에 즉시 413).
   138	    """
   139	    data = bytearray()
   140	    while chunk := await file.read(64 * 1024):
   141	        data += chunk
   142	        if len(data) > RAW_CAP:
   143	            raise HTTPException(
   144	                status_code=413,
   145	                detail=f"파일이 너무 큽니다 — 첨부는 파일당 {RAW_CAP // (1024 * 1024)}MB까지입니다.",
   146	            )
   147	    if not data:
   148	        raise HTTPException(status_code=400, detail="빈 파일입니다.")
   149	    try:
   150	        # 스레드 격리+시간 상한(codex 404 P1): pypdf 동기 파싱이 이벤트루프를 점유하지 않게.
   151	        # (wait_for 취소가 스레드를 죽이진 못하지만 페이지 캡이 작업량 자체를 유계로 만든다.)
   152	        text = await asyncio.wait_for(
   153	            asyncio.to_thread(_extract_sync, file.filename or "", file.content_type, bytes(data)),
   154	            timeout=EXTRACT_TIMEOUT_S,
   155	        )
   156	    except _ExtractError as exc:
   157	        raise HTTPException(status_code=exc.status, detail=exc.detail) from exc
   158	    except TimeoutError as exc:
   159	        raise HTTPException(
   160	            status_code=408,
   161	            detail=f"추출 시간 초과({EXTRACT_TIMEOUT_S}s) — 더 작은 파일로 시도하세요.",
   162	        ) from exc
   163	    text = text.strip()
   164	    if not text:
   165	        raise HTTPException(
   166	            status_code=400, detail="추출된 텍스트가 없습니다(이미지 PDF·빈 문서는 지원 밖)."
   167	        )
   168	    truncated = len(text) > TEXT_CAP
   169	    if truncated:
   170	        text = text[:TEXT_CAP]
   171	    return AttachmentOut(
   172	        filename=(file.filename or "(이름 없음)")[:200],
   173	        text=text,
   174	        chars=len(text),
   175	        truncated=truncated,
   176	    )
