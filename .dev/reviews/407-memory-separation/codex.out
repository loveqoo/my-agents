   196	def _clamp_limit(limit: Any) -> int:  # 브로커 args의 비검증 입력 정규화가 존재 이유 — Any가 정직
   197	    """recall 상한을 정수 [1,10]로 정규화(엔드포인트 스키마와 동일 경계). 비정수/음수/거대 방어."""
   198	    try:
   199	        return max(1, min(int(limit), 10))
