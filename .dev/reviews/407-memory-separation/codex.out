    44	@dataclass
    45	class ChatTurnRuntime:
    46	    """턴 실행 재료(스펙 396 — 구 turn dict의 타입화, 필드 1:1). _build_turn_runtime이 생성."""
    47	
    48	    graph: Any  # CompiledStateGraph(런타임 타입)
