    57	    mem_hits: list[dict]
    58	    memory_recalls: list[dict]
    59	    history_windows: list[dict]
    60	    prompt_in_messages: bool  # 스펙 371 D3 — promptless 그래프면 시스템 프롬프트를 seed 선두로
    61	    seed_system: str
    62	    build_ms: dict = field(default_factory=dict)
