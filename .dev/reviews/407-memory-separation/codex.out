   360	def _extract_turn_texts(result: object) -> tuple[str, str]:
   361	    """최종 상태에서 (사용자 질문, 최종 AI 답변) 추출 — 체크포인트가 보유(Approval에 user_text 미저장)."""
   362	    msgs = result.get("messages", []) if isinstance(result, dict) else []
   363	    user_text = next(
   364	        (getattr(m, "content", "") for m in msgs if getattr(m, "type", "") == "human"), ""
   365	    )
   366	    reply = next(
   367	        (
   368	            getattr(m, "content", "")
   369	            for m in reversed(msgs)
   370	            if getattr(m, "type", "") == "ai" and getattr(m, "content", "")
   371	        ),
   372	        "",
   373	    )
   374	    return user_text, reply
