   204	async def _recall_prompt(ctx: ChatContext, user_id: str | None, user_text: str) -> str:
   205	    """A2A 서빙 회상(스펙 387→388 P1) — 켜져 있으면 프롬프트에 "# 관련 기억" 부착(메인 chat 미러).
