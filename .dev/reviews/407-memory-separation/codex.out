   202	            check(r.status_code == 400, f"E7 위조 PDF(시그니처 부재) 400 (got {r.status_code})")
   203	
   204	            # ── E8 메모리 축 분리(스펙 407): 회상 쿼리는 주입 전 원발화만 ──
