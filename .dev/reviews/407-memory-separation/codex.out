    70	def _pdf_pypdf(data: bytes) -> str:
    71	    from pypdf import PdfReader
    72	
    73	    reader = PdfReader(io.BytesIO(data))
    74	    if len(reader.pages) > PDF_PAGE_CAP:
    75	        raise _ExtractError(413, f"PDF가 너무 깁니다 — {PDF_PAGE_CAP}페이지까지 지원합니다.")
    76	    return "\n".join((p.extract_text() or "") for p in reader.pages)
    77	
    78	
    79	def _pdf_pdfminer(data: bytes) -> str:
    80	    """pdfminer.six 폴백(스펙 407 P3, 승인된 의존성 — MIT) — CMap 처리가 pypdf보다 견고한
    81	    경우가 있어 pypdf가 깨졌을 때 한 번 더 시도. maxpages로 작업량 유계(폴백 경로 한정 절단)."""
    82	    from pdfminer.high_level import extract_text as _pm_extract
    83	
    84	    return _pm_extract(io.BytesIO(data), maxpages=PDF_PAGE_CAP) or ""
    85	
    86	
    87	def _extract_sync(filename: str, content_type: str | None, data: bytes) -> str:
    88	    """동기 추출(스레드에서 실행) — 판별은 **매직 바이트 우선**(codex 404 P2: MIME/확장자는
    89	    위조 가능 — %PDF- 실물이면 이름과 무관하게 PDF, .pdf 이름인데 실물이 아니면 위조 400).
    90	
    91	    PDF는 pypdf → (파싱 실패·문자권 부정합 시) pdfminer 폴백 → 그래도 부정합이면 정직 400(스펙 407)."""
