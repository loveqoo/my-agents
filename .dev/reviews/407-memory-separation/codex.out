   170	async def _build_turn_runtime(
   171	    ctx: ChatContext,
   172	    impl: CustomAgent,
   173	    principal: User | str,
   174	    user_id: str | None,
   175	    user_text: str,
   176	    conversation: list[dict],
   177	) -> ChatTurnRuntime:
   178	    """그래프 빌드 재료(회상·창 프록시·도구·브로커·프롬프트) 준비 — ChatTurnRuntime 반환."""
   179	    # 빌드 단계별 계측(스펙 368) — 매턴 재구성 비용을 분해해 trace.buildMs로 노출(캐시 367-D의 잣대).
   180	    # 단계 사이 소량 글루(프록시 생성·프롬프트 결합)는 인접 단계에 귀속(오차 서브 ms).
     1	"""턴 종결·백그라운드 기억 저장 — chat.py에서 분할(스펙 396 P2). 스펙 314 계약의 정의 모듈.
     2	
     3	계약(동결): 답변+trace+done을 먼저 흘려 '처리 중'을 즉시 해제, 무거운 자동 기억 저장은
     4	detached task — **done을 yield하기 전에 태스크 생성**(done 직후 클라이언트가 끊어도 저장 보장,
     5	verify_314가 직접 핀). memoryPending은 **라이브 trace 전용**(영속 trace 미포함 — 서버 재시작
     6	시 스피너 영구 회전 차단). done 뒤 trailing `event: memory`로 pending 해제(프론트 api.ts 소비).
     7	_final_frames(구 CC 13)는 태스크 스폰(_spawn_memory_task)·트레일링 프레임(_trailing_memory_frame)
     8	추출로 분해. 파사드는 chat.py(재수출 계약).
     9	"""
    10	
    11	import asyncio
    12	import json
    13	import logging
    14	import time
    15	from collections.abc import AsyncIterator
    16	
    17	from agent.runtime import CustomAgent
    18	
    19	from . import memory, trace_capture
    20	from .chat_context import ChatContext
    21	from .chat_persist import _mid_frame, _persist
    22	from .chat_trace import _final_trace, _finalize_memory_trace, _summarize_saved
    23	from .chat_turn_runtime import ChatTurnRuntime
    24	
    25	log = logging.getLogger("api.chat")
    26	
    27	# 백그라운드 자동 기억 저장 태스크 참조(스펙 314) — 스트림(제너레이터)이 끝나거나 클라이언트가 떠나도
    28	# 태스크가 GC/취소되지 않도록 강참조를 유지. 완료 시 콜백으로 스스로 제거한다.
    29	_BG_MEMORY_TASKS: set[asyncio.Task] = set()
    30	_MEMORY_ADD_TIMEOUT_S = (
    31	    30  # 백그라운드 저장(mem0 LLM 추출) 대기 상한 — 초과 시 pending만 해제(codex P1)
    32	)
    33	_TRAILING_EVENT_TIMEOUT_S = (
    34	    60  # 트레일링 이벤트 대기 상한 — 연결 무한 보유 방지(태스크는 계속, codex P1)
    35	)
    36	
    37	
    38	async def _bg_memory_add(
    39	    add_scope: dict, user_text: str, full: str, mem_cfg: dict | None, mid: str | None
    40	) -> dict:
    41	    """백그라운드 자동 기억 저장(스펙 314) — done 이후 실행. **자기완결**(예외 삼킴): 저장→요약→영속
    42	    trace 갱신을 모두 여기서 끝내, 클라이언트가 떠나도 저장·영속이 보장된다. 반환=요약(트레일링
    43	    이벤트용). 자동 add scope는 user_id+run_id만(agent_id 미포함 — 누출 차단, 스펙 029/020).
    44	    mem0 저장이 비정상적으로 오래 걸리면 상한(_MEMORY_ADD_TIMEOUT_S)에서 손을 떼고 error 요약으로
    45	    마감한다(codex P1 — 무한 hang 시 pending이 안 풀리는 걸 방지; 스레드는 유실되나 드묾)."""
    46	    try:
    47	        saved = await asyncio.wait_for(
    48	            asyncio.to_thread(
    49	                memory.add,
    50	                add_scope,
    51	                [{"role": "user", "content": user_text}, {"role": "assistant", "content": full}],
    52	                mem_cfg,
    53	            ),
    54	            timeout=_MEMORY_ADD_TIMEOUT_S,
    55	        )
    56	        summary = _summarize_saved(saved)
    57	    except TimeoutError:
    58	        log.warning("자동 기억 저장 시간 초과(백그라운드 %ss)", _MEMORY_ADD_TIMEOUT_S)
    59	        summary = {"status": "error", "count": 0, "items": []}
    60	    except Exception:
    61	        log.exception("백그라운드 자동 기억 저장 실패")
    62	        summary = {"status": "error", "count": 0, "items": []}
    63	    if mid:
    64	        try:
    65	            await _finalize_memory_trace(mid, summary)
    66	        except Exception:
    67	            log.exception("영속 trace 기억 갱신 실패")
    68	    return summary
