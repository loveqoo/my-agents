   279	    except AgentConfigError as e:
   280	        return StreamingResponse(_config_error_stream(str(e)), media_type="text/event-stream")
   281	    if impl is None:
   282	        return StreamingResponse(
   283	            _a2a_stream(ctx, user_text, user_id), media_type="text/event-stream"
   284	        )
   285	
   286	    conversation, history_restore = await _prepare_conversation(ctx, body)
   287	    try:
   288	        turn = await _build_turn_runtime(ctx, impl, principal, user_id, user_text, conversation)
   289	    except AgentConfigError as e:
   290	        # 그래프 조립 시점 설정 실패(스펙 317 — 코드 노드 impl 미등록 등)도 resolve 실패와 동일하게
   291	        # 정직 통보(default 만회·조용한 스킵 금지, 089 패턴).
   292	        return StreamingResponse(_config_error_stream(str(e)), media_type="text/event-stream")
   293	    graph = turn.graph
   294	    thread_id, graph_input, pending_artifact = _resolve_graph_entry(ctx, body, user_text)
   295	    capture = trace_capture.TraceCaptureHandler()
   296	    config = _turn_config(ctx, thread_id, user_id, capture, calls_sink=turn.calls_sink)
   297	    messages, sent_messages, seed_messages = _seed_and_sent(
   298	        conversation,
   299	        ctx,
   300	        turn.pipeline,
   301	        turn.seed_system,  # 캐시 경로: 프롬프트+회상+discovery 힌트(비캐시=prompt_prompt 동일)
   302	        system_in_seed=turn.prompt_in_messages,
   303	    )
   304	
   305	    # interrupt 수집 리스트를 **턴 스코프로 끌어올린다**(스펙 346, codex P1): 관문(아래 event_stream의
   306	    # finally)이 "그래프가 멈춘 채인가"를 알아야 한다. 승인 행 커밋·폼 포인터 등록은 interrupt보다
   307	    # **나중**이라, 그 사이 취소되면 핀이 아직 없다 — 이 리스트가 유일한 증거다.
   308	    interrupts: list[dict] = []
   309	
   310	    async def _run_turn() -> AsyncIterator[str]:
   311	        t0 = time.perf_counter()
   312	        yield f"data: {json.dumps({'session': ctx.session_id}, ensure_ascii=False)}\n\n"
   313	        acc: list[str] = []
   314	        errored = False
   315	        # updates 발화 레코드 [{node, ms(실측), summary}] — 스펙 085(노드열) + 086(실측·요약).
   316	        observed: list[dict] = []
   317	        t_prev = t0
   318	        try:
   319	            # 멀티 stream_mode: "messages"=토큰 스트림(기존), "updates"=노드 업데이트에서 __interrupt__
   320	            # 감지(위험 도구가 그래프를 멈춘 신호). probe로 검증한 형태.
   321	            async for stream_mode, chunk in graph.astream(
   322	                graph_input if graph_input is not None else {"messages": seed_messages},
   323	                config=config,
   324	                stream_mode=["messages", "updates"],
   325	                # durability="exit"(스펙 346) — 슈퍼스텝마다 쓰지 않고 **그래프가 끝날 때만** 박는다.
   326	                # 실측: 3노드 턴이 checkpoints 3행 → 1행. interrupt도 "끝남"이라 HIL 정지 상태는
   327	                # 그대로 박히고 재개도 된다(probe로 실증 — 재개 결과 정확). 중간 크래시 시 그 턴의
   328	                # 진행이 소실되지만, 턴은 어차피 처음부터 재시도라 잃을 게 없다.
   329	                durability="exit",
   330	            ):
     1	"""턴 런타임 준비(회상·도구·브로커·그래프 팩토리 캐시) — chat.py에서 분할(스펙 396 P4).
     2	
     3	그래프 팩토리 캐시(스펙 371 D3, 개발자 설계)의 정의 모듈. _build_turn_runtime(구 CC 15)은
     4	그래프 획득 3분기(_graph_for_turn — 캐시 적중/promptless 미스/비적격)를 추출해 분해했고,
     5	반환은 dict → **ChatTurnRuntime dataclass**(스펙 396 명시 개선 — 필드 1:1, mypy 안전망).
     6	캐시 hit 계약(스펙 371): tools는 재사용·per-turn calls_sink는 config 주입(트레이스 격리).
