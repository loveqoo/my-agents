     1	"""런타임 해석·도구 조립·그래프 지문·회상 프록시 — chat.py에서 하강(스펙 392 P4, 순환 제거).
     2	
     3	chat.py 파사드가 재수출하는 심볼을 chat_stream 계열·chat_approval이 **지연 import로 역참조**하던
     4	순환(chat → chat_stream/chat_approval → chat)의 근인이 이 네 심볼이 chat.py 안에 있던 것.
     5	제3의 모듈로 내려 의존을 단방향(chat → chat_graph_build ← chat_a2a_serve/chat_approval)으로 편다.
     6	그래프 캐시 딕셔너리 자체는 chat.py 잔류(_graph_fingerprint는 순수 함수라 여기로).
     7	파사드는 chat.py(재수출 계약 유지).
     8	"""
     9	
    10	import asyncio
    11	import hashlib
    12	import json
    13	
    14	from agent.runtime import AgentConfigError, CustomAgent, DefaultUiAgent, get_agent_impl
    15	
    16	from . import memory, runtime
    17	from .chat_context import ChatContext, _is_remote
    18	
    19	
    20	def resolve_agent_runtime(ctx: ChatContext) -> CustomAgent | None:
    21	    """이 에이전트의 **in-process 런타임 구현**을 해석한다(스펙 085 + 089 폴백 교정).
    22	
    23	    - 원격(code/external) → None: 인터페이스 미대상 → 호출측이 `_a2a_stream` fallback(지금처럼).
    24	    - 로컬(ui) + impl 미선언 → `DefaultUiAgent`(레퍼런스 적합, 정상 default).
    25	    - 로컬(ui) + impl 적중(적합) → 그 커스텀 에이전트.
    26	    - 로컬(ui) + impl 선언했으나 미해결(미등록/부적합) → **`AgentConfigError` raise**(스펙 089 교정3):
    27	      `DefaultUiAgent`로 *만회·폴백하지 않는다* — 등록/설정 실수를 default가 가리지 않게 서빙을
    28	      거부한다. 호출측이 잡아 정직히 통보.
    29	
    30	    `impl`은 레지스트리의 *키*일 뿐 코드가 아니다 — eval/import 경로 없음(스펙 085 §보안경계)."""
    31	    if _is_remote(ctx.source):
    32	        return None
    33	    impl_key = ctx.impl
    34	    if not impl_key:
    35	        return DefaultUiAgent()
    36	    inst = get_agent_impl(impl_key)
    37	    if inst is None:
    38	        raise AgentConfigError(impl_key)
    39	    return inst
    40	
    41	
    42	def _rag_tools_for(ctx: ChatContext, calls_sink: list[dict]) -> list:
    43	    """RAG 검색 도구 목록. 기본=전체 컬렉션 단일 도구(search_documents, 무회귀). 노드형(스펙 268 P1)은
    44	    **컬렉션별 도구**(`search_documents__<컬렉션>`, _safe_name — 265 이름 체계)를 추가로 빌드해 노드가
    45	    컬렉션을 골라 참조한다("검색 노드는 A만, 검증 노드는 B만"). 참조 안 된 도구는 노드 필터에서 그냥
    46	    안 쓰임(무해). 구저장 민이름(search_documents)은 전체-컬렉션 도구로 계속 해석."""
    47	    tools: list = []
    48	    if not ctx.rag_collections:
    49	        return tools
    50	    ms = ctx.rag_min_scores
    51	    tools.append(runtime.build_rag_tool(ctx.rag_collections, calls_sink, ms))
    52	    if ctx.nodes_resolved is not None:
    53	        for col in ctx.rag_collections:
    54	            tools.append(
    55	                runtime.build_rag_tool(
    56	                    [col],
    57	                    calls_sink,
    58	                    ms,
    59	                    name=runtime._safe_name("search_documents", col["name"]),
    60	                )
    61	            )
    62	    return tools
    63	
    64	
    65	class _MemoryRecallProxy:
    66	    """노드별 회상 프록시(스펙 268 P2, 사용자 설계) — 노드형 노드가 **각자** 회상을 조회하고, 여기서
    67	    **키워드로 캐싱**한다(같은 키워드=캐시 반환 → 비용 자연 수렴 1회, 다른 키워드=개별 조회). 이로써
    68	    "1회 조회→노드 매핑"과 "노드별 키워드 조회"가 한 메커니즘으로 통일된다.
    69	
    70	    - 수명 = **한 턴**(요청) — 턴을 넘겨 캐시하면 새 기억이 안 보이므로 금지.
    71	    - 스코프는 플랫폼이 생성 시 **고정**(RBAC — 노드가 남의 기억을 못 봄, 브로커 주입 선례).
    72	    - 조회마다 (node, query, hits, cached)를 기록(스펙 082 — 조회 행위 계측) → trace["memoryRecalls"].
    73	    - 반환은 **포맷된 텍스트**(format_memory_hits) — 엔진(agent 패키지)이 api 모듈에 비의존."""
    74	
    75	    def __init__(
    76	        self, scope: dict, mem_cfg: dict | None, default_query: str, records: list[dict]
    77	    ) -> None:
    78	        self._scope = dict(scope)
    79	        self._cfg = mem_cfg
    80	        self._default = default_query or ""
    81	        self._cache: dict[str, tuple[str, list[dict]]] = {}  # query → (포맷 텍스트, 회상 히트)
    82	        self.records = records
    83	
    84	    async def __call__(self, query: str | None = None, node: str = "") -> str:
    85	        q = (query if isinstance(query, str) and query.strip() else self._default).strip()[:300]
    86	        if not q:
    87	            return ""
    88	        cached = q in self._cache
    89	        if not cached:
    90	            hits = await asyncio.to_thread(memory.search, self._scope, q, self._cfg)
    91	            self._cache[q] = (memory.format_memory_hits(hits) if hits else "", hits)
    92	        text, hits = self._cache[q]
    93	        # 기록 쿼리는 비밀 마스킹(codex 268 P3 — 타 트레이스 표면과 정합): input 모드 키워드는 앞 노드
    94	        # 출력이라 비밀이 섞일 수 있음(_sanitize가 sk-… 등 마스킹, 캡 120).
    95	        self.records.append(
    96	            {
    97	                "node": node,
    98	                "query": memory._sanitize(q, cap=120),
    99	                "hits": len(hits),
   100	                "cached": cached,
   101	                # 회상 내용(스펙 359) — 표준 retrieve_memory 경로(t.memories)와 같은
   102	                # {text, score, scope} 리스트로 실어 인스펙터가 MemoryRow로 렌더한다. 내용 마스킹은
   103	                # 표준 경로와 파리티(자기 스코프 저장 기억, 이미 무마스킹 노출 — 새 노출 아님).
