   377	async def resume_approval(approval: Approval, decision: str) -> str | None:
   378	    """admin 결정(approve/reject)으로 멈춘 그래프를 재개하고 최종 메시지를 원 세션에 영속.
   379	
   380	    approvals.resolve_approval이 status 설정 후 호출(상시). 체크포인트(Postgres 공유)에서 그래프를
   381	    재구축해 `Command(resume=...)`로 이어 달린다 — 멀티워커 안전. approve면 도구 실행 후 ReAct가
   382	    마무리 답변을, reject면 도구 미실행으로 마무리한다. 라이브 스트리밍은 빚(§7) — 여기선
   383	    서버사이드로 끝까지 돌려 결과만 세션에 남긴다.
   384	
   385	    반환(스펙 388 P2, 가산): 재개 턴의 최종 답변 텍스트 — A2A 승인 브리지가 외부 호출자에게
   386	    돌려준다. 재개 불가/실패 경로는 None(기존 graceful 유지, REST 소비자는 반환 무시).
   387	    """
   388	    target = await _load_resume_target(approval)
   389	    if target is None:
   390	        return None
   391	    ctx, impl, ckpt, thread_id = target
   392	    used_memory, mem_hits, mem_proxy, resume_recalls = await _resume_memory_inputs(
   393	        ctx, impl, approval
   394	    )
   395	    rebuilt = await _rebuild_resume_graph(ctx, impl, ckpt, approval, mem_hits, mem_proxy)
   396	    if rebuilt is None:
   397	        return None  # 그래프 조립 설정 실패(스펙 317) — 재개 불가 graceful(로그는 rebuild가 남김)
   398	    graph, calls_sink, resume_broker, resume_history_windows = rebuilt
   399	    config = {"configurable": {"thread_id": thread_id}}
   400	    # 관측(스펙 118→328) — 재개 경로도 OTEL이 설정됐을 때만 콜백 부착(미설정=무동작).
   401	    # 비영속(스펙 235) 대칭 가드(codex): 정상 ephemeral은 approval을 못 만들어 미도달이나, "과거 approval +
   402	    # 설정을 ephemeral로 변경" 엣지에서 이 경로가 호출될 수 있어 관측도 대칭으로 스킵(_persist는 이미 차단).
   403	    if not ctx.ephemeral:
   404	        config = observability.with_trace(config, name="chat-resume", user_id=approval.user_id)
   405	
   406	    t0 = time.perf_counter()
   407	    try:
   408	        # durability="exit"(스펙 346) — 재개 경로도 그래프 종료 시점에만 체크포인트를 박는다.
   409	        result = await graph.ainvoke(
   410	            Command(resume={"decision": decision}), config=config, durability="exit"
   411	        )
   412	    except Exception as exc:
   413	        log.error("resume 실패 (approval %s): %s", approval.approval_id, exc)
   414	        return None
   415	
   416	    # 체크포인트 폐기 관문(스펙 346) — 승인이 해소돼 그래프가 끝났으면 이 스레드는 죽은 것이다.
   417	    # 재개 중 **또 멈췄으면**(두 번째 위험 도구) 그 상태가 유일한 재개 근거라 남긴다.
   418	    if "__interrupt__" not in result:
   419	        await checkpoint_retention.release_thread(thread_id)
   420	
   421	    user_text, reply = _extract_turn_texts(result)
   422	    total_ms = int((time.perf_counter() - t0) * 1000)
   423	    tokens = runtime.estimate_tokens(len(user_text), len(reply))
   424	    trace = runtime.assemble_trace(
   425	        agent_id=ctx.ext_agent_id,
   426	        memories=mem_hits,
   427	        mcp_calls=calls_sink,
   428	        used_memory=used_memory,
   429	        total_ms=total_ms,
   430	        tokens=tokens,
   431	    )
   432	    trace["resumedApproval"] = {"id": approval.approval_id, "decision": decision}
   433	    if resume_broker.invocations:
   434	        # 재개 턴의 브로커 호출도 표면화(스펙 130, codex #1).
   435	        trace["brokerCalls"] = _broker_calls_trace(resume_broker.invocations)
