    34	
    35	def _canonical_tokens(
    36	    observed_nodes: list[str],
    37	    calls_sink: list[dict],
    38	    broker_invocations: list[dict],
    39	    used_memory: bool,
    40	) -> list[str]:
    41	    """관측 3형태를 canonical 토큰으로 union — 채점 어휘를 에이전트 형태와 무관하게 통일."""
    42	    tokens: list[str] = list(observed_nodes)
    43	    for inv in broker_invocations:
    44	        node = str(inv.get("node", ""))
    45	        tokens.append(node)
    46	        if node.startswith("broker_invoke:"):
    47	            tokens.append(node[len("broker_invoke:") :])  # canonical: rag:X / mcp:s/t / memory:user
    48	    for call in calls_sink:
    49	        server = str(call.get("server", ""))
    50	        tool = str(call.get("tool", ""))
    51	        tokens.append(f"rag:{tool}" if server == "rag" else f"mcp:{server}/{tool}")
    52	    if used_memory:
    53	        tokens.append("memory:used")
    54	    return tokens
    55	
