    91	def _test_unsubscribe(q: asyncio.Queue) -> None:
    92	    with contextlib.suppress(KeyError):
    93	        _SUBS.remove(q)
     1	"""평가 실행 러너 — 오염 제로 에이전트 턴 + 관측 union (스펙 137 단계 ②).
     2	
     3	`chat()` 재사용은 불가(persistHistory=False여도 세션 lazy-create·turns 갱신·자동 memory.add가
     4	발생 — 137 조사 확정). 이 러너는 `prepare_serve_turn`(A2A 서빙용 순수 컴퓨트) 골격에
     5	`event_stream`의 **관측 수집부**(updates 노드·calls_sink·broker invocations)를 이식하고
     6	**build_broker를 주입**(조율형 위임 채점 지원 — 서빙 경로엔 없어 위임이 안 돌았음)한다.
     7	`_persist`·`memory.add`는 절대 호출하지 않는다(오염 제로). 메모리 **회상(search)은 수행** —
     8	읽기 전용이라 무오염이며, 직접형의 memory 사용 채점(`memory:used` 토큰)의 근거가 된다.
     9	checkpointer=None — HIL 게이트 cap은 interrupt가 예외로 떨어져 error 관측(평가 중 승인 대기 없음).
    10	
    11	관측 union(조사 확정 — 없으면 직접형 도구 사용을 놓쳐 "조용한 초록", 회고 100 대죄):
    12	  trace_nodes = 그래프 노드(원형) ∪ 브로커 canonical(broker_invoke: 접두 제거형 병기)
    13	              ∪ 직접형 calls_sink(`mcp:{server}/{tool}`, rag는 `rag:{tool}`) ∪ `memory:used`.
    14	→ `trace_has("rag:")` 같은 assert가 직접형/조율형 무관하게 채점된다.
    15	"""
    16	
    17	import asyncio
    18	import logging
    19	import uuid
    20	from typing import Any
    21	
    22	from agent.runtime import AgentBuildContext, AgentConfigError, CustomAgent
    23	
    24	from . import memory, observability, runtime
    25	from .broker import build_broker
    26	from .broker.core import PolicyScopedBroker
    27	from .chat import ChatContext, _load_context, _window, resolve_agent_runtime
    28	from .models import User
