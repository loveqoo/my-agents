    60	async def keep_reason(thread_id: str) -> str | None:
    61	    """보존 사유('approval'·'artifact') 또는 None(폐기 가능). 관문과 스윕의 **공통 술어**."""
    62	    if await _is_pinned_by_approval(thread_id):
    63	        return "approval"
    64	    if _is_pinned_by_artifact(thread_id):
    65	        return "artifact"
    66	    return None
    67	
