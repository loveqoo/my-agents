    14	
    15	logger = logging.getLogger(__name__)
    16	
    17	
    18	async def get_or_404[T](
    19	    session: AsyncSession, model: type[T], ident: object, detail: str = "not found"
    20	) -> T:
    21	    """PK 조회 후 없으면 404(정본, 스펙 297). **순수 존재 체크만** — 소유권/가시성 게이트는 호출부가
    22	    별도로 수행한다(이 헬퍼는 SELECT-WHERE 스코프를 대체하지 않는다). session.get은 항상 PK 조회라
    23	    스코프 우회 위험이 없다."""
    24	    obj = await session.get(model, ident)
    25	    if obj is None:
    26	        raise HTTPException(status_code=404, detail=detail)
    27	    return obj
