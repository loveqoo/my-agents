    async def check_connection(conn: ACT) -> None:
        """
        A simple check to verify that a connection is still working.

        Return quietly if the connection is still working, otherwise raise
        an exception.

        Used internally by `check()`, but also available for client usage,
        for instance as `!check` callback when a pool is created.
        """
        if conn.autocommit:
            await conn.execute("")
        else:
            if True:  # ASYNC
                # NOTE: with Psycopg 3.2 we could use conn.set_autocommit() in
                # the sync code too, but we want the pool to be compatible with
                # previous versions too.
                await conn.set_autocommit(True)
                try:
                    await conn.execute("")
                finally:
                    await conn.set_autocommit(False)
            else:
                conn.autocommit = True
                try:
                    conn.execute("")
                finally:
                    conn.autocommit = False

    async def reconnect_failed(self) -> None:
        """
        Called when reconnection failed for longer than `reconnect_timeout`.
        """
        if not self._reconnect_failed:
            return

        await ensure_async(self._reconnect_failed, self)
        # Pool listeners can trigger a reconnection on checkout, as well
        # as the pre-pinger.
        # there are three attempts made here, but note that if the database
        # is not accessible from a connection standpoint, those won't proceed
        # here.

        attempts = 2

        while attempts > 0:
            connection_is_fresh = fairy._connection_record.fresh
            fairy._connection_record.fresh = False
            try:
                if pool._pre_ping:
                    if not connection_is_fresh:
                        if fairy._echo:
                            pool.logger.debug(
                                "Pool pre-ping on connection %s",
                                fairy.dbapi_connection,
                            )
                        result = pool._dialect._do_ping_w_event(
                            fairy.dbapi_connection
                        )
                        if not result:
                            if fairy._echo:
                                pool.logger.debug(
                                    "Pool pre-ping on connection %s failed, "
                                    "will invalidate pool",
                                    fairy.dbapi_connection,
                                )
                            raise exc.InvalidatePoolError()
                    elif fairy._echo:
                        pool.logger.debug(
                            "Connection %s is fresh, skipping pre-ping",
                            fairy.dbapi_connection,
                        )

                pool.dispatch.checkout(
                    fairy.dbapi_connection, fairy._connection_record, fairy
                )
                return fairy
            except exc.DisconnectionError as e:
                if e.invalidate_pool:
                    pool.logger.info(
                        "Disconnection detected on checkout, "
                        "invalidating all pooled connections prior to "
                        "current timestamp (reason: %r)",
                        e,
                    )
                    fairy._connection_record.invalidate(e)
                    pool._invalidate(fairy, e, _checkin=False)
                else:
                    pool.logger.info(
                        "Disconnection detected on checkout, "
                        "invalidating individual connection %s (reason: %r)",
                        fairy.dbapi_connection,
                        e,
                    )
                    fairy._connection_record.invalidate(e)
                try:
                    fairy.dbapi_connection = (
                        fairy._connection_record.get_connection()
                    )
                except BaseException as err:
                    with util.safe_reraise():
                        fairy._connection_record._checkin_failed(
                            err,
                            _fairy_was_created=True,
                        )

                        # prevent _ConnectionFairy from being carried
                        # in the stack trace.  Do this after the
                        # connection record has been checked in, so that
                        # if the del triggers a finalize fairy, it won't
                        # try to checkin a second time.
                        del fairy

     1	# 403 — SSE 이탈 커넥션 풀 오염 봉합(스펙 402 실구멍 보고의 수선)
     2	
     3	> 상태: **초안(승인 대기)** · 2026-07-19
     4	> 발단: 402의 068 조사에서 실측 — 클라이언트가 chat SSE를 중도 이탈(탭 닫기·모바일)하면 ASGI
     5	> 태스크 취소가 in-flight 커넥션을 오염시켜 **후속 요청의 인증 쿼리가 비결정 500**. codex가
     6	> 실사용 재현 조건으로 확인(실구멍). 지금까지는 테스트 하네스(드레인)로 피했을 뿐 앱은 미봉합.
     7	
     8	## 처방(3지점 + 회귀 테스트 — codex 402 스케치 그대로)
     9	
    10	- **P1 메인 엔진 자가치유**: `db.py` `create_async_engine(..., pool_pre_ping=True)` —
    11	  오염(닫힌) 커넥션을 checkout 시 재검증·폐기해 후속 요청이 자가 복구. (오버헤드=checkout당
    12	  SELECT 1 한 번 — 개인/팀 규모에서 무시 가능.)
    13	- **P2 체크포인터 풀 검증**: `checkpointer.py` `AsyncConnectionPool(..., check=
    14	  AsyncConnectionPool.check_connection)` — psycopg 풀도 checkout 시 죽은 커넥션 검출·교체.
    15	- **P3 정리 취소-보호**: `chat.py` `event_stream` finally의 `release_thread`를
    16	  `asyncio.shield`로 감싸 클라 이탈 취소가 정리 도중을 끊지 못하게(끊기면 체크포인터
    17	  커넥션이 "another command in progress"로 오염 — 402 실측). 외곽 CancelledError는 suppress,
    18	  내부 정리는 완주.
    19	- **P4 회귀 테스트 `verify_403_sse_abort.py`**: 실 uvicorn(throwaway)에서 ①SSE 첫 프레임 후
    20	  의도적 abort ×N ②직후 인증 요청(GET /sessions 등) ×M 전부 200(500 무발생) ③정상 채팅 1회
    21	  왕복 그린. 반복(비결정 대비 ≥3회) — 402의 068이 재현기였던 그 패턴을 이번엔 **공격 축**으로.
    22	  +설정 자체 단언(pool_pre_ping·check 배선 — installed≠covering 교훈: 장치가 꺼지면 테스트가 잡게).
    23	
    24	## 완료 기준(수치)
    25	
    26	- [ ] verify_403 그린(abort 폭격 후 500 = 0, 3회 반복).
    27	- [ ] verify_068(드레인 하네스) 무회귀 그린 — 두 테스트가 같은 축의 방어/공격 쌍.
    28	- [ ] make test SUITE_OK + metrics-fast. suite 51/51(실모델 — 정상 경로 무회귀).
    29	- [ ] codex 스팟: shield 패턴이 정상 종료 경로의 정리 시맨틱(스펙 346 폐기 관문)을 안 바꾸는지.
    30	
    31	## OUT
    32	
    33	- 배경 태스크 전반의 취소-보호 일반화(spawn 계층) — 별도.
    34	- pool_size/max_overflow 튜닝(k8s 항목과 합류).
    55	승인 재개 완료. (회고 316: 횡단 정책은 관문 한 곳에 — 잡별로 두면 새 호출부에서 샌다.)
    56	
    57	### L3. TTL 스윕 — 크래시·방치가 남긴 고아 (배치, 24시간)
    58	**기존 배치 서비스에 잡 추가**(`checkpoint-cleanup`, cron 설정 + `dry_run` — 새 스케줄러 금지, 스펙 038/049).
    59	나이 = `checkpoint_id`(UUIDv6)의 타임스탬프. 대상:
    60	- **고아**: 승인·폼 대기가 아닌데 남아 있는 스레드(= L2를 못 탄 크래시 턴) → 삭제
    61	- **방치된 승인 대기**: `requested_at`이 TTL(24h)을 넘긴 pending 승인 →
    62	  **승인을 `status='expired'`로 만료 표시한 뒤** 스레드 삭제
    63	
    64	> **조용한 삭제 금지**: 체크포인트만 지우면 그 승인은 UI에 pending으로 남은 채 재개만 실패한다
    65	> (회고 038의 적대 리뷰가 잡은 바로 그 결함 — "pending approval 삭제로 resume 고아"). 승인의 상태와
    66	> 체크포인트의 수명은 **한 트랜잭션에서 같이 움직인다.**
    67	
    68	### 안전 장치
    69	- **파괴적 노브엔 바닥**(learning 037): TTL이 `None`/0/음수면 **정리 안 함**(0을 delete-all로 매핑 금지).
    70	  cron NULL이면 미등록(기존 계약).
    71	- **dry-run 먼저**(스펙 050): 스윕은 `dry_run=True`로 대상만 집계·표본 반환.
    72	- **진행 중 턴 보호**: 나이 문턱(24h)이 분 단위 진행 턴을 절대 못 건드린다. 추가로 L2의 보존 조건을
    73	  스윕도 **동일 술어**로 재사용한다(가드는 한 술어로 모든 입구에 — learning 050).
    74	
    75	## 완료 조건 (측정 가능)
    76	
    77	- **C1** 10턴 대화(승인 없음) 후 `checkpoints` 행 = **0**(현재 30) — 시체가 안 남는다.
    78	- **C2** 턴당 체크포인트 쓰기 = **1**(현재 3) — `durability="exit"` 실측.
    79	- **C3** HIL 승인 왕복: interrupt 시 스레드 **보존** → 승인 후 재개 성공 → 재개 완료 후 그 스레드도 **0행**.
    80	  (verify_041 무회귀 + 삭제 시점 단언)
    81	- **C4** 산출물 폼(ask/form) 대기 스레드는 다음 입력까지 **보존**(스펙 188/190 무회귀).
    82	- **C5** TTL 스윕 dry-run: 24h 미만 스레드 **0건 대상**, 방치 승인만 대상으로 집계.
    83	- **C6** 만료 처리: TTL 넘긴 pending 승인은 `status='expired'`(조용한 삭제 0) — UI '처리됨'에 노출.
    84	- **C7** codex 적대 검토(파괴 경로 — 인가·경합·비가역) 지적 반영.
    85	- 무회귀: verify_041(HIL)·188/190(폼)·스위트·lint/mypy.
    86	
    87	## 결과 (2026-07-15 실행)
    88	
    89	- **관문**(`checkpoint_retention.release_thread`) + **스윕**(`sweep`) 신설. 호출 지점은 채팅 스트림의
    90	  `finally`(정상·에러·클라 끊김 전부)와 승인 재개 완료 — 두 곳뿐(그래프 실행 지점이 그 둘뿐임을 전수 확인.
    91	  평가·A2A 서빙은 `checkpointer=None`이라 애초에 안 쓴다).
    92	- **`durability="exit"`** 두 지점에 적용. 실측(라이브 HTTP): 폼 대기 스레드의 체크포인트 **1행**(기존 3행).
    93	- **배치 잡** `checkpoint-cleanup`(TTL 24h·매시) + admin 배치 탭 + `expired` 승인 표기.
    94	
    95	### codex 적대 검토가 잡은 P1 — **"핀이 있나"가 아니라 "턴이 정말 끝났나"**
    96	처음 규칙은 *보존 조건(승인 행·폼 포인터)이 있으면 남긴다*였다. 그런데 **핀은 interrupt 이후에 심긴다**
    97	(승인 행 커밋 · `_PENDING_ARTIFACT` 등록). 그 사이에 클라이언트가 끊기면 `finally`가 먼저 돌고,
    98	핀이 아직 없으니 **멈춘 그래프를 지운다** — 아직 아무도 안 가리키지만 **일시정지 상태 자체가 재개의
    99	근거**다. → `release_thread(paused=bool(interrupts))`로 판정 기준을 바꿨다(멈춘 채면 핀 무관하게 보존,
