     1	"""fire-and-forget 백그라운드 태스크의 참조 보관(RUF006) — GC 조기 수거 방지."""
     2	
     3	import asyncio
     4	import logging
     5	from collections.abc import Coroutine
     6	
     7	from . import audit
     8	
     9	logger = logging.getLogger(__name__)
    10	
    11	_TASKS: set[asyncio.Task] = set()
    12	
    13	
    14	def _reap(task: asyncio.Task) -> None:
    15	    """완료 시 참조 해제 + 삼켜질 뻔한 예외를 로그로 표면화(codex 334 P2) — spawn된 잡이
    16	    자체 except 그물 밖에서 죽으면 어디에도 안 보이던 것을 최소한 로그로 남긴다."""
    17	    _TASKS.discard(task)
    18	    if not task.cancelled():
    19	        exc = task.exception()
    20	        if exc is not None:
    21	            logger.error("배경 태스크 미처리 예외: %r", exc, exc_info=exc)
    22	
    23	
    24	async def _as_system(coro: Coroutine) -> object:
    25	    """배경 잡의 감사 actor = system(스펙 343 — 사용자 결정).
    26	
    27	    create_task는 **요청의 contextvar를 승계**하므로, 그냥 두면 배경 잡이 요청자 이름으로 행을
    28	    찍는다. 정책을 잡별로 두면 하나 빠뜨린다(codex 343 P2가 인제스트만 처리된 걸 짚음) — 모든
    29	    배경 잡이 통과하는 **이 관문 한 곳**에서 뒤집는다. 요청 경로의 행(예: documents 생성)은 이미
    30	    사용자 actor로 찍힌 뒤다: "누가 시켰나"는 created_by, "누가 처리했나"는 updated_by.
    31	    """
    32	    audit.set_actor(audit.SYSTEM_ACTOR)
    33	    return await coro
    34	
    35	
    36	def spawn(coro: Coroutine) -> asyncio.Task:
    37	    """참조를 보관하는 create_task — 완료 시 자동 해제 + 예외 표면화 + 감사 actor=system(343)."""
    38	    task = asyncio.create_task(_as_system(coro))
    39	    _TASKS.add(task)
    40	    task.add_done_callback(_reap)
