    69	async def release_thread(thread_id: str, *, paused: bool = False) -> str:
    70	    """**관문** — 턴이 끝난 스레드를 폐기한다. 보존 조건이면 남긴다.
    71	
    72	    반환: 'deleted' · 'kept:paused' · 'kept:approval' · 'kept:artifact' · 'no-checkpointer'.
    73	    호출: 채팅 스트림 종료(정상·에러·클라 끊김 모두 = event_stream의 finally) · 승인 재개 완료.
    74	
    75	    **`paused`가 규칙의 중심이다**(codex 적대 검토 P1): 처음엔 "핀(승인·폼 대기)이 있으면 보존"으로
    76	    짰는데, 핀은 interrupt **이후에** 심긴다(승인 행 커밋 · _PENDING_ARTIFACT 등록). 그 사이에
    77	    클라이언트가 끊기거나 워커가 취소되면 finally가 먼저 돌아 **멈춘 그래프를 지운다** — 아직 아무도
    78	    가리키지 않지만 **일시정지된 상태 자체가 재개의 근거**다. 그래서 판정 기준을 "핀이 있나"가 아니라
    79	    **"턴이 정말 끝났나"**로 바꾼다: 그래프가 멈춘 채면(paused) 핀 유무와 무관하게 남긴다. 진짜로
    80	    버려진 것이면 TTL 스윕이 24h 뒤 회수한다(파괴보다 누수 쪽으로 기운다).
    81	
    82	    **정리 실패가 턴을 죽이면 안 된다** — 예외는 삼키고 경고만(체크포인트 잔류는 스윕이 회수).
    83	    """
    84	    saver = checkpointer.get_checkpointer()
    85	    if saver is None:
    86	        return "no-checkpointer"
    87	    try:
    88	        if paused:
    89	            return "kept:paused"
    90	        reason = await keep_reason(thread_id)
    91	        if reason:
    92	            return f"kept:{reason}"
    93	        await saver.adelete_thread(thread_id)
    94	        return "deleted"
    95	    except Exception as exc:  # 청소는 결코 턴을 깨뜨리지 않는다(스윕이 백스톱)
    96	        log.warning("체크포인트 스레드 폐기 실패(스윕이 회수): %s — %s", thread_id, exc)
    97	        return "error"
    98	
