   100	async def sweep(*, dry_run: bool, ttl_hours: int) -> dict:
   101	    """TTL 스윕 — 관문을 못 탄 고아 + 방치된 승인 대기를 회수한다(배치 잡 본체, 스펙 346).
   102	
   103	    관문(`release_thread`)이 정상 경로를 덮지만, **프로세스가 죽은 턴**은 못 탄다(learning 048 —
   104	    한 수명 경계에 건 보장은 수명 전체를 못 덮는다). 그 고아를 나이로 회수한다.
   105	
   106	    나이는 `checkpoints.checkpoint->>'ts'`(LangGraph가 박는 ISO 타임스탬프). TTL보다 **어린 스레드는
   107	    절대 안 건드린다** — 진행 중인 턴(분 단위)과 프로세스 메모리에만 있는 폼 대기를 이 문턱이 지킨다.
   108	
   109	    방치된 승인 대기는 **조용히 지우지 않는다**: 체크포인트만 지우면 승인은 화면에 pending으로 남은 채
   110	    재개만 실패한다(회고 038의 적대리뷰가 잡은 resume 고아). `status='expired'`로 만료를 기록한 뒤
   111	    스레드를 지운다 — 상태와 수명이 한 트랜잭션에서 같이 움직인다.
   112	
   113	    파괴적 노브엔 바닥(learning 037): ttl_hours가 None/<1이면 **아무 것도 안 지운다**(0=즉시 전량
   114	    삭제로 매핑 금지).
   115	    """
   116	    # 배치는 **별 프로세스**라 API lifespan이 채운 싱글턴이 비어 있다 — 없으면 여기서 연다(멱등).
   117	    # 이 한 줄이 없으면 스윕이 no-checkpointer로 조용히 무동작한다(잡은 초록, 청소는 0).
   118	    saver = checkpointer.get_checkpointer() or await checkpointer.init_checkpointer()
   119	    if saver is None:
   120	        return {"status": "no-checkpointer", "deleted": 0, "expired": 0}
   121	    if ttl_hours is None or ttl_hours < 1:
   122	        return {"status": "disabled", "reason": "ttl_hours<1", "deleted": 0, "expired": 0}
   123	
   124	    cutoff = datetime.now(UTC) - timedelta(hours=ttl_hours)
   125	    async with SessionLocal() as s:
   126	        # TTL보다 오래된 스레드만 후보(그 안의 최신 체크포인트 ts 기준 — 진행 중 턴 보호).
   127	        rows = (
   128	            await s.execute(
   129	                text(
   130	                    "select thread_id, max(checkpoint->>'ts') as last_ts from checkpoints "
   131	                    "group by thread_id having max(checkpoint->>'ts') < :cutoff"
   132	                ),
   133	                {"cutoff": cutoff.isoformat()},
   134	            )
   135	        ).all()
   136	        stale = [r[0] for r in rows]
   137	
   138	        # 나이를 모르는 스레드(ts 없음/NULL — 다른 버전·수기 삽입이 남긴 행): `NULL < cutoff`는 참이
   139	        # 아니라 위 질의에서 **조용히 빠진다** → 영구 잔류(누수). 나이를 모른다고 지우는 건 파괴적이라
   140	        # 지우지는 않되, **세어서 요약에 드러낸다**(안 보이는 누수 < 보이는 누수).
   141	        unknown_age = (
   142	            await s.execute(
   143	                text(
   144	                    "select count(*) from (select thread_id from checkpoints group by thread_id "
   145	                    "having max(checkpoint->>'ts') is null) t"
   146	                )
   147	            )
   148	        ).scalar_one()
   149	        if unknown_age:
   150	            log.warning(
   151	                "나이를 모르는 체크포인트 스레드 %d개 — 스윕 대상 아님(수동 확인 필요)", unknown_age
   152	            )
   153	        if not stale:
   154	            return {
   155	                "status": "dry_run" if dry_run else "ok",
   156	                "ttl_hours": ttl_hours,
   157	                "candidates": 0,
   158	                "deleted": 0,
   159	                "expired": 0,
   160	                "unknown_age": unknown_age,
   161	            }
   162	
   163	        # 방치된 승인 대기 — 만료 대상(체크포인트를 지우면 재개 불가가 되므로 상태를 함께 바꾼다).
   164	        pending = (
   165	            await s.execute(
   166	                select(Approval.approval_id, Approval.checkpoint)
   167	                .where(Approval.checkpoint.in_(stale))
   168	                .where(Approval.status == "pending")
   169	            )
   170	        ).all()
   171	        expiring = [p[0] for p in pending]
   172	
   173	        if dry_run:
   174	            return {
   175	                "status": "dry_run",
   176	                "ttl_hours": ttl_hours,
   177	                "cutoff": cutoff.isoformat(),
   178	                "candidates": len(stale),
   179	                "would_delete": len(stale),
   180	                "would_expire": len(expiring),
   181	                "unknown_age": unknown_age,
   182	                "sample": stale[:20],
   183	            }
   184	
   185	        if expiring:
   186	            await s.execute(
   187	                update(Approval).where(Approval.approval_id.in_(expiring)).values(status="expired")
   188	            )
   189	            await s.commit()
   190	
   191	    deleted = 0
   192	    for tid in stale:
   193	        try:
   194	            await saver.adelete_thread(tid)
   195	            deleted += 1
   196	        except Exception as exc:
   197	            log.warning("스윕 삭제 실패(다음 회차 재시도): %s — %s", tid, exc)
   198	
   199	    log.info("체크포인트 스윕: 삭제 %d · 승인 만료 %d (TTL %dh)", deleted, len(expiring), ttl_hours)
   200	    return {
   201	        "status": "ok",
   202	        "ttl_hours": ttl_hours,
   203	        "cutoff": cutoff.isoformat(),
   204	        "candidates": len(stale),
   205	        "deleted": deleted,
   206	        "expired": len(expiring),
   207	        "unknown_age": unknown_age,
   208	    }
