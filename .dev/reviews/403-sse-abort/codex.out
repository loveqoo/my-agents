    83	def _alembic_config() -> Config:
    84	    """packages/api/alembic.ini 기준으로 Alembic Config 구성."""
    85	    # db.py = packages/api/src/api/db.py -> parents[2] = packages/api
    86	    api_root = Path(__file__).resolve().parents[2]
    87	    # 임베디드 실행 시 alembic env.py의 fileConfig가 uvicorn 로깅을 덮어쓰지 않도록.
    88	    os.environ.setdefault("ALEMBIC_EMBEDDED", "1")
    89	    cfg = Config(str(api_root / "alembic.ini"))
    90	    cfg.set_main_option("script_location", str(api_root / "alembic"))
    91	    return cfg
