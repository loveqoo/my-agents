    42	
    43	def _mask_dsn(dsn: str) -> str:
    44	    """로그용 DSN — 비밀번호만 ***로 가린다(비밀값 비노출)."""
    45	    # postgresql+asyncpg://user:PASSWORD@host:port/db → 가운데 :pw@ 구간만 마스킹.
    46	    if "://" not in dsn:
    47	        return dsn
    48	    scheme, rest = dsn.split("://", 1)
    49	    if "@" not in rest:
    50	        return dsn
    51	    creds, host = rest.split("@", 1)
    52	    if ":" in creds:
    53	        user = creds.split(":", 1)[0]
    54	        creds = f"{user}:***"
    55	    return f"{scheme}://{creds}@{host}"
    56	
