    57	async def _recall_memory(ctx: ChatContext, user_text: str) -> tuple[bool, list, str]:
    58	    """메모리 회상(읽기 전용 — 무오염) → (used_memory, mem_hits, prompt_prompt). add는 절대 안 함."""
    59	    used_memory = memory.memory_enabled(ctx.memories) and ctx.mem_cfg is not None
    60	    recall_scope = {"user_id": None, "run_id": None, "agent_id": ctx.ext_agent_id}
    61	    mem_hits = (
    62	        await asyncio.to_thread(memory.search, recall_scope, user_text, ctx.mem_cfg)
    63	        if used_memory
    64	        else []
    65	    )
    66	    prompt_prompt = ctx.prompt
    67	    if mem_hits:
    68	        prompt_prompt = (
    69	            f"{prompt_prompt}\n\n# 관련 기억(회상됨)\n{memory.format_memory_hits(mem_hits)}"
    70	        )
    71	    return used_memory, mem_hits, prompt_prompt
