    74	async def _build_eval_graph(
    75	    ctx: ChatContext,
    76	    impl: CustomAgent,
    77	    prompt_prompt: str,
    78	    mem_hits: list,
    79	    calls_sink: list[dict],
    80	    principal: User | str,
    81	    delegation_chain: tuple,
    82	    delegation_budget: dict | None,
    83	) -> tuple[Any, PolicyScopedBroker]:
    84	    """평가용 그래프를 도구·브로커 주입으로 빌드 → (graph, broker)."""
    85	    tools = await runtime.build_mcp_tools(
    86	        ctx.mcp_servers, calls_sink, ctx.tool_policy, ctx.tool_names
    87	    )
    88	    if ctx.rag_collections:
    89	        tools.append(runtime.build_rag_tool(ctx.rag_collections, calls_sink))
    90	    # 브로커 주입(조율형 위임 채점) — 실행 주체(principal)의 RBAC로 스코프(chat 경로와 동일 술어).
    91	    # 스펙 256 v2(깊이 N): 호출 체인에 자기 자신을 덧붙여 하위 브로커에 관통 — 체인 내 재방문만
    92	    # 차단(순환 0), 새 에이전트로는 계속 하강 가능.
    93	    chain = tuple(delegation_chain) + ((ctx.ext_agent_id,) if ctx.ext_agent_id else ())
    94	    broker = build_broker(
    95	        principal,
    96	        ctx.capabilities,
    97	        ctx.tool_policy,
    98	        delegation_chain=chain,
    99	        delegation_budget=delegation_budget,
   100	    )
   101	    # 노드 에이전트-호출 도구(스펙 318) — 평가도 실제 파이프라인(위임 포함)을 태운다(317 입구 정합).
   102	    # pipeline만·broker가 이미 스코프(권한 상승 0).
   103	    if ctx.impl == "pipeline":
   104	        tools.extend(runtime.build_agent_tools(broker, await broker.agent_capabilities()))
   105	    run_params = {} if ctx.temperature is None else {"temperature": ctx.temperature}
   106	    build_ctx = AgentBuildContext(
   107	        prompt=prompt_prompt,
   108	        model_cfg=ctx.model_cfg,
   109	        tools=tools,
   110	        checkpointer=None,  # HIL cap은 fail-closed(interrupt→예외→error 관측)
   111	        params=run_params,
   112	        memories=mem_hits,
   113	        broker=broker,
   114	        # impl_config — 노코드 impl 설정 통로(codex 317 P1: eval 입구 누락 봉합). 이게 없으면 노드형/
   115	        # 산출물형 평가가 **기본 단일 노드로 조용히 퇴화**해 실제 서빙과 다른 것을 채점했고, 미등록
   116	        # 코드 노드도 설정 오류 대신 폴백 실행됐다. 채팅·A2A 서빙·승인 재개와 동일 주입(네 번째 입구).
   117	        impl_config=(
   118	            {"nodes": ctx.nodes_resolved} if ctx.nodes_resolved is not None else ctx.artifact_spec
   119	        ),
   120	    )
   121	    return impl.build_graph(build_ctx), broker
