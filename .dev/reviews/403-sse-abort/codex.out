    26	# 구독자 큐 집합 — 상한 초과 시 그 구독자의 이벤트만 드롭(no-block: 느린 브라우저 하나가
    27	# 배경 잡을 못 막는다). 발행은 동기·비대기.
    28	_SUBS: set[asyncio.Queue] = set()
    29	_QUEUE_MAX = 100
    30	_HEARTBEAT_SEC = 15
    31	# 동시 구독 상한(codex 335 P2) — 인증 유저 전제여도 탭 방치/스크립트로 fanout O(N)이 무한히
    32	# 크지 않게. 초과는 429(알림은 UX 겹이라 거절해도 기능 손실 없음 — 진실은 문서 status).
    33	_MAX_SUBS = 20
    34	
    35	
    36	def publish(event: dict) -> None:
    37	    """이벤트 발행(비블로킹) — 배경 잡이 부른다. 구독자 없으면 무동작(알림은 best-effort)."""
    38	    for sub in list(_SUBS):
    39	        try:
    40	            sub.put_nowait(event)
    41	        except asyncio.QueueFull:
    42	            # 느린 구독자 — 이 이벤트만 드롭(상태의 진실은 문서 status라 유실 무해).
    43	            logger.debug("이벤트 구독자 큐 가득 — 드롭: %s", event.get("type"))
    44	
    45	
    46	def _frame(event: dict) -> str:
    47	    """SSE data 프레임 직렬화(순수 함수) — ensure_ascii=False로 한글 원문."""
    48	    return f"data: {json.dumps(event, ensure_ascii=False)}\n\n"
    49	
    50	
    51	@router.get("")
    52	async def stream_events(
    53	    _principal: User | str = Depends(current_principal),
    54	) -> StreamingResponse:
    55	    """SSE 이벤트 스트림 — 로그인 유저 전용(EventSource는 쿠키 동행). 15초 heartbeat로 연결
    56	    유지, 클라이언트가 끊으면 finally가 구독 해제(누수 없음). EventSource가 자동 재연결한다."""
    57	    if len(_SUBS) >= _MAX_SUBS:
    58	        from fastapi import HTTPException
    59	
    60	        raise HTTPException(status_code=429, detail="이벤트 구독이 너무 많습니다 — 잠시 후 재시도")
    61	    q: asyncio.Queue = asyncio.Queue(maxsize=_QUEUE_MAX)
    62	
    63	    async def gen() -> AsyncIterator[str]:
    64	        _SUBS.add(q)
    65	        try:
    66	            yield ": connected\n\n"
    67	            while True:
    68	                try:
    69	                    ev = await asyncio.wait_for(q.get(), timeout=_HEARTBEAT_SEC)
    70	                except TimeoutError:
    71	                    yield ": ping\n\n"  # heartbeat — 프록시/브라우저 idle 타임아웃 방지
    72	                    continue
    73	                yield _frame(ev)
    74	        finally:
    75	            _SUBS.discard(q)
    76	
    77	    return StreamingResponse(
    78	        gen(),
    79	        media_type="text/event-stream",
    80	        headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"},
    81	    )
    82	
    83	
    84	def _test_subscribe() -> asyncio.Queue:
    85	    """검증 전용 구독(HTTP 없이 버스 관통) — 프로덕션 코드는 쓰지 않는다."""
    86	    q: asyncio.Queue = asyncio.Queue(maxsize=_QUEUE_MAX)
    87	    _SUBS.add(q)
    88	    return q
    89	
