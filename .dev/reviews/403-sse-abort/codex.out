    26	from . import checkpointer
    27	from .db import SessionLocal
    28	from .models import Approval
    29	
    30	log = logging.getLogger("api.checkpoint_retention")
    31	
    32	# 방치된 승인 대기의 기본 만료 시한(사용자 결정, 스펙 346). BatchConfig로 덮어쓸 수 있다.
    33	DEFAULT_TTL_HOURS = 24
