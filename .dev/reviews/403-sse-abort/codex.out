   395	            cleanup = asyncio.ensure_future(
   396	                checkpoint_retention.release_thread(thread_id, paused=bool(interrupts))
   397	            )
   398	            with _ctx.suppress(asyncio.CancelledError):
   399	                await asyncio.shield(cleanup)
