packages/api/src/api/checkpoint_retention.py:69:async def release_thread(thread_id: str, *, paused: bool = False) -> str:
packages/api/src/api/checkpoint_retention.py:103:    관문(`release_thread`)이 정상 경로를 덮지만, **프로세스가 죽은 턴**은 못 탄다(learning 048 —
     1	"""로컬(ui) 에이전트 A2A 서빙 — chat_stream.py에서 분할+Command화(스펙 392 P2/P3).
     2	
     3	스펙 061(서빙)→387(userId·기억)→388(contextId 세션·승인 브리지)의 로컬 서빙 경로.
     4	파사드는 chat.py(재수출 계약: prepare_serve_turn·LocalServeTurn·ServeOutcome 계열).
     5	
     6	설계(codex 자문 + Replace Function with Command):
     7	- async generator는 값을 반환할 수 없어(PEP 525) 구현이 mutable dict `state`를 out-param으로
     8	  넘겨 "스트림 소진 후 읽어라"를 암묵 계약으로 삼았다 — 시간 순서가 타입에 없어 취약했다.
     9	- `LocalServeTurn`(Command)이 스트림과 최종 결과를 함께 소유한다: `prepare()`가 그래프·재료를
    10	  조립하고, `chunks()`가 텍스트를 스트리밍하며, 소진 후 `outcome`이 ServeOutcome을 준다.
    11	  소진 전 접근은 RuntimeError(암묵 계약의 명시화).
    12	- 옛 `_serve_*` 헬퍼 6종이 인자로 나르던 공통 문맥(ctx·user_id·thread_id·has_ckpt…)은 전부
    13	  인스턴스 필드로 흡수(Introduce Parameter Object — 인자 10개 → self).
    14	"""
    15	
    16	import asyncio
    17	import logging
    18	import uuid
    19	from collections.abc import AsyncIterator
    20	from dataclasses import dataclass, field
    21	from typing import TYPE_CHECKING
    22	
    23	from agent.runtime import AgentBuildContext, AgentConfigError, CustomAgent
    24	
    25	if TYPE_CHECKING:
    26	    from langgraph.graph.state import CompiledStateGraph
    27	
    28	from . import checkpointer, memory, observability, runtime
    29	from .chat_context import ChatContext, _load_context
    30	from .chat_graph_build import _rag_tools_for, resolve_agent_runtime
    31	from .chat_history import _history_load_limit, _load_session_conversation, _window
    32	from .chat_persist import _persist
    33	
    34	log = logging.getLogger("api.chat")
    35	
    36	
    37	# ── 서빙 턴 결과(스펙 392 P3 — out-param dict의 타입화) ─────────────────────────
    38	
    39	
    40	@dataclass(frozen=True)
    41	class ServeCompleted:
    42	    """정상 완주 — reply는 소진된 전체 응답(영속·기억 저장 완료 후)."""
    43	
    44	    reply: str
    45	
    46	
    47	@dataclass(frozen=True)
    48	class ServeApprovalRequired:
    49	    """승인 대기 전환(스펙 388 P2) — a2a_server가 input-required Task/이벤트로 표현."""
    50	
    51	    id: str
    52	    action: str
    53	    approver: str | None
    54	
    55	
    56	@dataclass(frozen=True)
    57	class ServeFailed:
    58	    """실행 불가 안내(비영속 승인 불가 등) — a2a_server가 JSON-RPC error/failed로 표현."""
    59	
    60	    message: str
    61	
    62	
    63	ServeOutcome = ServeCompleted | ServeApprovalRequired | ServeFailed
    64	
    65	
    66	@dataclass
    67	class LocalServeTurn:
    68	    """한 A2A 서빙 턴의 Command 객체 — 재료(필드)·스트림(chunks)·결과(outcome)를 함께 소유.
    69	
    70	    사용 규약: `turn = await prepare_serve_turn(...)` → `async for text in turn.chunks()` →
    71	    스트림 소진 후 `turn.outcome`. 소진 전 outcome 접근은 RuntimeError(구 state dict의
    72	    "소진 후 읽기" 암묵 계약을 타입·예외로 명시화). 클라이언트 중간 이탈 시 GeneratorExit로
    73	    영속·기억 저장이 생략될 수 있음은 종전과 동일한 정직한 경계(스펙 388)."""
    74	
    75	    ctx: ChatContext
    76	    graph: object  # CompiledStateGraph(런타임 타입, agent 패키지)
    77	    messages: list[dict]
    78	    cfg: dict
    79	    thread_id: str
    80	    user_id: str | None
    81	    user_text: str
    82	    prompt_chars: int
    83	    has_ckpt: bool
    84	    _outcome: ServeOutcome | None = field(default=None, init=False, repr=False)
    85	    _started: bool = field(default=False, init=False, repr=False)
    86	
    87	    @property
    88	    def context_id(self) -> str:
    89	        """A2A contextId = 우리 session_id(스펙 388 P1, 서버 발급·클라 에코)."""
    90	        return self.ctx.session_id
    91	
    92	    @property
    93	    def outcome(self) -> ServeOutcome:
    94	        """스트림 소진 후의 최종 결과. 소진 전 접근은 프로그래밍 오류로 즉시 죽인다(fail-loud)."""
    95	        if self._outcome is None:
    96	            raise RuntimeError("chunks() 소진 전 outcome 접근 — 스트림을 끝까지 소비한 뒤 읽으세요")
    97	        return self._outcome
    98	
    99	    async def chunks(self) -> AsyncIterator[str]:
   100	        """서빙 턴 스트림(스펙 388) — 텍스트 청크 yield, 소진 후 outcome 확정·영속·기억 저장.
   101	
