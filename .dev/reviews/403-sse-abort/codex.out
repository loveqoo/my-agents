    58	async def _preflight() -> None:
    59	    """DB 연결 프리플라이트 — 도달 불가면 명확한 조치 메시지로 RuntimeError.
    60	
    61	    init_db 맨 앞에 둬 운영자가 raw asyncpg 트레이스 대신 조치를 보게 하고, "연결 실패"와
    62	    "마이그레이션 실패"(스펙 330 fail-fast)를 다른 메시지로 구분한다(여기 통과 = DB 도달 가능).
    63	    """
    64	    try:
    65	        async with engine.connect() as conn:
    66	            await conn.execute(text("SELECT 1"))
    67	    except Exception as e:
    68	        masked = _mask_dsn(DATABASE_URL)
    69	        logger.error(
    70	            "DB 연결 실패 — 부팅을 중단합니다.\n"
    71	            "  DATABASE_URL = %s\n"
    72	            "  · postgres 미기동? `docker compose up -d postgres` 후 재시도\n"
    73	            "  · 호스트/포트/자격증명(.env)·방화벽 확인\n"
    74	            "  원본 오류: %s",
    75	            masked,
    76	            e,
    77	        )
    78	        raise RuntimeError(
    79	            f"DB 연결 실패: {masked} — postgres 기동 여부와 DATABASE_URL을 확인하세요."
    80	        ) from e
