   290	async def prepare_serve_turn(
   291	    agent_id: uuid.UUID,
   292	    user_text: str,
   293	    user_id: str | None = None,
   294	    context_id: str | None = None,
   295	) -> LocalServeTurn:
   296	    """로컬(ui) 에이전트의 A2A 서빙 턴을 조립 — 반환 LocalServeTurn(Command).
   297	
   298	    a2a_server가 노출된 로컬 에이전트의 JSON-RPC 호출을 받아 실 LangGraph 런타임을 돌릴 때 쓴다.
