    36	async def _is_pinned_by_approval(thread_id: str) -> bool:
    37	    """미해결 승인이 이 스레드를 재개 키로 잡고 있나(DB — 워커·프로세스 무관)."""
    38	    async with SessionLocal() as s:
    39	        row = (
    40	            await s.execute(
    41	                select(Approval.id)
    42	                .where(Approval.checkpoint == thread_id)
    43	                .where(Approval.status == "pending")
    44	                .limit(1)
    45	            )
    46	        ).first()
    47	    return row is not None
    48	
    49	
    50	def _is_pinned_by_artifact(thread_id: str) -> bool:
    51	    """산출물 폼/질문이 이 스레드에서 사용자 입력을 기다리나(스펙 188 — 프로세스 메모리).
    52	
    53	    지연 import: `chat_approval`이 이 모듈을 부르는 쪽이라 모듈 최상단에서 끌면 순환이 된다.
    54	    """
    55	    from .chat_approval import _PENDING_ARTIFACT
    56	
    57	    return any(p.get("thread_id") == thread_id for p in _PENDING_ARTIFACT.values())
    58	
