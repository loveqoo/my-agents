   113	        await s.commit()
   114	        await s.refresh(bare)
   115	        bare_id = bare.id
   116	    try:
   117	        # model_cfg는 연결 cfg(base_url/model_id/params — name 없음): 기본 mock 모델의 model_id로 단언.
   118	        ctx = await chat._load_context(bare_id, None, {"capabilities": []}, own=None)
   119	        check(
   120	            (ctx.model_cfg or {}).get("model_id") == "mock-chat",
   121	            f"B6a 모델 미지정+model 키 없는 오버라이드 → 400 없이 기본 해석(got {(ctx.model_cfg or {}).get('model_id')!r})",
   122	        )
   123	        ctx = await chat._load_context(bare_id, None, {"model": None}, own=None)
   124	        check(
   125	            (ctx.model_cfg or {}).get("model_id") == "mock-chat",
   126	            f"B6b overrides={{model: None}} → 동일 폴백(got {(ctx.model_cfg or {}).get('model_id')!r})",
   127	        )
   128	        try:
   129	            await chat._load_context(bare_id, None, {"model": "없는모델401"}, own=None)
   130	            check(False, "B6c 명시 미등록 이름이 통과함(290 회귀!)")
   131	        except _HTTPExc as e:
   132	            check(
   133	                e.status_code == 400 and "없는모델401" in str(e.detail),
   134	                f"B6c 명시 미등록 이름 → 400 유지(스펙 290) (got {e.status_code}, {e.detail!r})",
   135	            )

