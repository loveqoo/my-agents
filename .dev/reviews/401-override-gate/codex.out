    71	def _coerce_history_depth(cfg: dict, agent: Agent) -> None:
    72	    """historyDepth 형 가드(codex 287 Low) — 비정수(예: 문자열)는 _window의 `depth < 0` 비교에서
    73	    TypeError 500. 정수화 실패 시 저장값 폴백(요청 하나로 500 못 만들게)."""
    74	    if isinstance(cfg.get("historyDepth"), int):
    75	        return
    76	    try:
    77	        cfg["historyDepth"] = int(cfg["historyDepth"])
    78	    except (TypeError, ValueError):
    79	        cfg["historyDepth"] = (agent.config or {}).get("historyDepth", 20)
