    52	async def _probe(
    53	    base_url: str, api_key: str | None, model_id: str, kind: str = "chat"
    54	) -> ModelProbeResult:
    55	    """kind별 연결 테스트. 비밀은 결과에 미포함.
    56	
    57	    - chat:      `{base_url}/models` 목록에 model_id가 있는지(가용성) 확인.
    58	    - embedding: `{base_url}/embeddings`를 샘플 입력으로 호출해 벡터가 돌아오는지(기능) 확인.
    59	    """
    60	    if not base_url:
    61	        return ModelProbeResult(
    62	            ok=False, reachable=False, modelAvailable=False, latencyMs=0, detail="base_url 없음"
    63	        )
    64	    headers = {"Authorization": f"Bearer {api_key}"} if api_key else {}
    65	    base = base_url.rstrip("/")
    66	    t0 = time.perf_counter()
    67	    if kind == "embedding":
    68	        try:
    69	            async with httpx.AsyncClient(timeout=10) as client:
    70	                r = await client.post(
    71	                    base + "/embeddings",
    72	                    headers=headers,
    73	                    json={"model": model_id, "input": "ping"},
    74	                )
    75	        except Exception:
    76	            ms = int((time.perf_counter() - t0) * 1000)
    77	            return ModelProbeResult(
    78	                ok=False, reachable=False, modelAvailable=False, latencyMs=ms, detail="연결 실패"
    79	            )
    80	        ms = int((time.perf_counter() - t0) * 1000)
    81	        if r.status_code != 200:
    82	            return ModelProbeResult(
    83	                ok=False,
    84	                reachable=True,
    85	                modelAvailable=False,
    86	                latencyMs=ms,
    87	                detail=f"HTTP {r.status_code}",
    88	            )
    89	        try:
    90	            vec = ((r.json().get("data") or [{}])[0]).get("embedding") or []
    91	        except Exception:
    92	            vec = []
    93	        if vec:
    94	            return ModelProbeResult(
    95	                ok=True,
    96	                reachable=True,
    97	                modelAvailable=True,
    98	                latencyMs=ms,
    99	                detail=f"임베딩 OK · {len(vec)}차원",
   100	                dims=len(vec),
   101	            )
   102	        return ModelProbeResult(
   103	            ok=True,
   104	            reachable=True,
   105	            modelAvailable=False,
   106	            latencyMs=ms,
   107	            detail="연결됨 · 임베딩 응답 없음",
   108	        )
   109	
   110	    # kind == "chat" (기본)
   111	    try:
   112	        async with httpx.AsyncClient(timeout=10) as client:
   113	            r = await client.get(base + "/models", headers=headers)
   114	    except Exception:
   115	        ms = int((time.perf_counter() - t0) * 1000)
   116	        return ModelProbeResult(
   117	            ok=False, reachable=False, modelAvailable=False, latencyMs=ms, detail="연결 실패"
   118	        )
   119	    ms = int((time.perf_counter() - t0) * 1000)
   120	    if r.status_code != 200:
   121	        # 본문은 키를 에코할 수 있어 노출 안 함 — 상태코드만.
   122	        return ModelProbeResult(
   123	            ok=False,
   124	            reachable=True,
   125	            modelAvailable=False,
   126	            latencyMs=ms,
   127	            detail=f"HTTP {r.status_code}",
   128	        )
   129	    try:
   130	        ids = [m.get("id") for m in (r.json().get("data") or [])]
   131	    except Exception:
   132	        ids = []
   133	    if not model_id:
   134	        # 프로바이더 레벨 테스트(특정 모델 미지정, 스펙 164) — 목록 존재 여부로 판정한다.
   135	        # 빈 model_id를 "미발견"으로 오판하던 버그: 프로바이더는 잘 붙었고 모델도 있는데
   136	        # "연결됨 · 모델 미발견"이 떠 사용자가 오해했다(등록 화면엔 모델이 주르륵). 개수로 정직하게.
   137	        n = len(ids)
   138	        return ModelProbeResult(
   139	            ok=True,
   140	            reachable=True,
   141	            modelAvailable=n > 0,
   142	            latencyMs=ms,
   143	            detail=f"연결됨 · 모델 {n}개 발견" if n else "연결됨 · 모델 목록 비어있음",
   144	        )
   145	    available = model_id in ids
   146	    detail = "연결됨" + (" · 모델 사용 가능" if available else " · 모델 미발견")
   147	    return ModelProbeResult(
   148	        ok=True, reachable=True, modelAvailable=available, latencyMs=ms, detail=detail
   149	    )
   150	
   151	
   152	async def _clear_other_defaults(
   153	    session: AsyncSession, kind: str, exclude_id: uuid.UUID | None = None
   154	) -> None:
   155	    """kind별 기본값은 하나만 — 나머지 is_default를 끈다(codex P2).
   156	
   157	    해제를 **즉시 flush** — 부분 유니크 인덱스(uq_models_default_per_kind, 스펙 150)는 문장 단위로
   158	    검사되므로, 해제 UPDATE가 새 기본 지정보다 먼저 실행됨을 보장해야 자기 트랜잭션과 안 충돌한다."""
   159	    rows = (
   160	        (
   161	            await session.execute(
   162	                select(ModelConfig).where(
   163	                    ModelConfig.kind == kind, ModelConfig.is_default.is_(True)
   164	                )
   165	            )
   166	        )
   167	        .scalars()
   168	        .all()
   169	    )
   170	    changed = False
   171	    for row in rows:
   172	        if exclude_id is None or row.id != exclude_id:
   173	            row.is_default = False
   174	            changed = True
   175	    if changed:
   176	        await session.flush()
   177	
   178	
   179	async def _get_with_provider(session: AsyncSession, model_id: uuid.UUID) -> ModelConfig | None:
   180	    """모델 1건을 provider 관계와 함께 로드(직렬화·테스트에 provider 필요)."""
   181	    return (
   182	        await session.execute(
   183	            select(ModelConfig)
   184	            .where(ModelConfig.id == model_id)
   185	            .options(selectinload(ModelConfig.provider))
   186	        )
   187	    ).scalar_one_or_none()
