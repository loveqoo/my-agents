    47	async def unit_checks() -> None:
    48	    from agent.capabilities import SETTING_KEYS, resolve_effective
    49	    from api.chat_context_models import MODEL_PARAM_OVERRIDE_KEYS, _resolve_node_models
    50	    from api.schemas.agents import AgentConfig
    51	
    52	    # U1 파생 파리티 — 화이트리스트가 서술자에서 나온다(별도 하드코딩 아님).
    53	    check(tuple(MODEL_PARAM_OVERRIDE_KEYS) == tuple(SETTING_KEYS), "U1a 화이트리스트=SETTING_KEYS 파생")
    54	    check("stream" in SETTING_KEYS and "enable_thinking" in SETTING_KEYS, "U1b 설정 키 목록 존재")
    55	    # U1c 노드 정규화가 화이트리스트만 보존(evil/temperature 드롭 — 설정 아님).
    56	    cfg = AgentConfig(
    57	        nodes=[{"prompt": "p", "modelParams": {"stream": False, "enable_thinking": True, "evil": 1, "temperature": 0.9}}]
    58	    )
    59	    check(
    60	        cfg.nodes[0].get("modelParams") == {"stream": False, "enable_thinking": True},
    61	        f"U1c 노드 modelParams 화이트리스트만 (got {cfg.nodes[0].get('modelParams')})",
    62	    )
    63	
    64	    # U2 유효값 게이트 — 능력 AND 설정. 능력 false면 어느 층도 못 켬.
    65	    check(resolve_effective("streaming", {"streaming": True}, {}, {}) is True, "U2a streaming 능력 true 기본 켬")
    66	    check(resolve_effective("streaming", {"streaming": False}, {"stream": True}, {}) is False, "U2b streaming 능력 false→못 켬")
    67	    check(resolve_effective("thinking", {"thinking": True}, {"enable_thinking": True}, {}) is True, "U2c thinking 능력 true+want→켬")
    68	    check(resolve_effective("thinking", {"thinking": False}, {"enable_thinking": True}, {}) is False, "U2d thinking 능력 false→못 켬(408은 미게이트였음)")
    69	    check(resolve_effective("thinking", {}, {"enable_thinking": True}, {}) is False, "U2e thinking 능력 미선언(기본 false)→못 켬")
    70	
    71	    # U3 노드 캐스케이드 — DB 미접촉(노드에 명시 모델 없음 → 상속 default_cfg에 노드 층만 덮음).
    72	    # default_cfg는 **에이전트 해석본**(프로덕션에선 _resolve_model이 에이전트 modelParams를 이미 병합).
    73	    # 여기선 에이전트가 enable_thinking=on을 켠 상태로 가정(default_cfg params에 반영).
    74	    default_cfg = {"base_url": "b", "model_id": "m", "params": {"stream": True, "enable_thinking": True}}
    75	    nodes = [
    76	        {"prompt": "A", "modelParams": {"stream": False}},  # 노드가 에이전트 위 stream만 덮음
    77	        {"prompt": "B"},  # 미명시 → 상속
    78	    ]
    79	    resolved = await _resolve_node_models(None, nodes, default_cfg, None, agent_cfg=None)
    80	    a_params = resolved[0]["model_cfg"]["params"]
    81	    b_params = resolved[1]["model_cfg"]["params"]
    82	    check(a_params.get("stream") is False, f"U3a 노드A stream=off(노드가 덮음) (got {a_params.get('stream')})")
    83	    check(a_params.get("enable_thinking") is True, f"U3b 노드A enable_thinking=on(에이전트 상속 — 노드 미덮음) (got {a_params.get('enable_thinking')})")
    84	    check(b_params.get("stream") is True, f"U3c 노드B stream=on(에이전트 상속 — 노드 미명시) (got {b_params.get('stream')})")
    85	
    86	    # U4 세션 > 노드(codex P1① — 세션이 노드 층 뒤에 재적용돼 이긴다). 노드 stream=off + 세션 stream=on → on.
    87	    resolved2 = await _resolve_node_models(
    88	        None,
    89	        [{"prompt": "A", "modelParams": {"stream": False}}],
    90	        {"base_url": "b", "model_id": "m", "params": {"stream": True}},
    91	        None,
    92	        agent_cfg=None,
    93	        session_mp={"stream": True},
    94	    )
    95	    check(
    96	        resolved2[0]["model_cfg"]["params"].get("stream") is True,
    97	        f"U4 세션 stream=on이 노드 stream=off를 이김(최상위 층) (got {resolved2[0]['model_cfg']['params'].get('stream')})",
    98	    )
    99	
   100	    # U5 문자열 "false" 게이트 우회 차단(codex P1②) — clean_* 드롭 + resolve_effective _as_bool.
   101	    from agent.capabilities import clean_capabilities, clean_setting_params
   102	
   103	    check(clean_capabilities({"streaming": "false", "thinking": "false"}) == {}, "U5a 비-bool 능력 드롭")
   104	    check(clean_setting_params({"stream": "false", "enable_thinking": "true", "evil": True}) == {}, "U5b 비-bool/미지 설정 드롭")
   105	    check(
   106	        resolve_effective("thinking", {"thinking": "false"}, {"enable_thinking": True}) is False,
   107	        "U5c 문자열 능력('false')은 thinking 못 켬(bool('false')==True 함정 봉인)",
   108	    )
