    22	class Provider(AuditMixin, Base):
    23	    """LLM provider = 엔드포인트 + 자격증명 (스펙 035). 모델 1:N로 매달림.
    24	
    25	    provider 1회 등록 → 하위 모델 다수가 base_url/api_key를 공유(중복 제거).
    26	    `protocol`은 와이어 포맷(openai-compatible 등)으로, 모델의 `kind`(chat/embedding)와 별개 축.
    27	    """
    28	
    29	    __tablename__ = "providers"
    30	    id: Mapped[uuid.UUID] = _pk()
    31	    name: Mapped[str] = mapped_column(String(120), unique=True)  # 표시·참조용 이름
    32	    protocol: Mapped[str] = mapped_column(String(40), default="openai-compatible")
    33	    base_url: Mapped[str] = mapped_column(String(400), default="")
    34	    api_key: Mapped[str | None] = mapped_column(String(400), default=None)  # 암호화 저장
    35	    # 표시·배지용(스펙 047 #6) — local=실서버, mock=내장 테스트목, remote=외부. 라벨 혼란 해소.
    36	    kind: Mapped[str] = mapped_column(String(20), default="remote", server_default="remote")
    37	    description: Mapped[str] = mapped_column(
    38	        String(400), default="", server_default=""
    39	    )  # 한 줄 설명
    40	    version: Mapped[int] = mapped_column(Integer, default=1, server_default="1")  # 스펙 369
    41	
    42	    models: Mapped[list["ModelConfig"]] = relationship(back_populates="provider")
    43	
    44	
    45	class ModelConfig(AuditMixin, Base):
    46	    """LLM/임베딩 모델 설정 레지스트리. 에이전트가 이름으로 골라 실행에 사용.
    47	
    48	    연결처(base_url/api_key)는 자신이 매달린 `Provider`에서 상속한다(스펙 035).
    49	    """
    50	
    51	    __tablename__ = "models"
    52	    id: Mapped[uuid.UUID] = _pk()
    53	    name: Mapped[str] = mapped_column(String(120), unique=True)  # 표시·참조용 이름
    54	    # provider 삭제 시 매달린 모델이 있으면 차단(RESTRICT) — 실수로 모델 고아화 방지.
    55	    provider_id: Mapped[uuid.UUID] = mapped_column(
    56	        ForeignKey("providers.id", ondelete="RESTRICT"), nullable=False
    57	    )
    58	    model_id: Mapped[str] = mapped_column(String(200), default="")  # API에 보내는 모델 id
    59	    kind: Mapped[str] = mapped_column(String(20), default="chat")  # chat | embedding
    60	    is_default: Mapped[bool] = mapped_column(Boolean, default=False)
    61	    # kind당 기본 1개 DB 불변식(스펙 150 — 동시 지정 레이스 봉인). alembic(a1b2c3d4e5f7)과 정합 —
    62	    # metadata에도 같은 인덱스를 선언해 autogenerate diff 0 유지.
    63	    __table_args__ = (
    64	        Index(
    65	            "uq_models_default_per_kind", "kind", unique=True, postgresql_where=text("is_default")
    66	        ),
    67	    )
    68	    params: Mapped[dict] = mapped_column(JSONB, default=dict)  # temperature 등(런타임 파라미터)
    69	    # 능력 선언(스펙 408, 2층 원칙의 능력 층 — 오버라이드 불가): 서빙 서버가 할 수 있는 것의 사실
    70	    # 기록. streaming=false면 비스트리밍 안전 실행, vision은 C안 게이트 선반영, thinking=모드 보유.
    71	    capabilities: Mapped[dict] = mapped_column(
    72	        JSONB,
    73	        default=lambda: dict(DEFAULT_CAPABILITIES),
    74	        # server_default(SQL text)는 DEFAULT_CAPABILITIES 값과 정합해야 한다(마이그레이션과 동일).
    75	        server_default='{"streaming": true, "thinking": false, "vision": false}',
    76	    )
    77	    # models.dev 카탈로그 파생 메타(스펙 047 #7) — context·modalities·cost·capabilities. params와 분리.
    78	    meta: Mapped[dict] = mapped_column(JSONB, default=dict, server_default="{}")
    79	    version: Mapped[int] = mapped_column(Integer, default=1, server_default="1")  # 스펙 369
    80	
    81	    provider: Mapped["Provider"] = relationship(back_populates="models")
    35	    if cond:
    36	        passed += 1
