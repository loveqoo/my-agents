    53	def _as_bool(value: object, default: bool) -> bool:
    54	    """**진짜 bool만** 값으로 인정하고 그 외(문자열 "false"·정수·None)는 default로 폴백(스펙 409
    55	    codex P1②). `bool("false")`가 True인 함정을 실행부에서 봉인 — 능력/설정 게이트가 문자열 주입으로
    56	    뚫리지 않는다(인제스션 검증과 이중 방어: installed-guard-isnt-covering-guard)."""
    57	    return value if isinstance(value, bool) else default
