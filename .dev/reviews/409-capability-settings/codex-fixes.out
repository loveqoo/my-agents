   138	        #   미리 병합해 노드가 세션을 되덮던 버그 — 세션 modelParams를 별도로 받아 마지막에 얹는다).
   139	        node_cfg = cfg if cfg is not None else default_cfg
   140	        if cfg is not None and agent_cfg:
   141	            node_cfg = _apply_agent_model_params(cfg, agent_cfg)
   142	        node_mp = node.get("modelParams")
   143	        if node_cfg is not None and isinstance(node_mp, dict) and node_mp:
   144	            node_cfg = _apply_agent_model_params(node_cfg, {"modelParams": node_mp})
   145	        if node_cfg is not None and isinstance(session_mp, dict) and session_mp:
   146	            node_cfg = _apply_agent_model_params(node_cfg, {"modelParams": session_mp})
   147	        resolved.append({**node, "model_cfg": node_cfg})
