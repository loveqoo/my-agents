    15	# ----------------------------- 에이전트 -----------------------------
    16	class AgentConfig(BaseModel):
    17	    model: str = "mock-llm"  # 미지정 시 기본 모델(스펙 059)
    18	    prompt: str = ""  # 프롬프트 이름(블록 참조)
    19	    temperature: float | None = (
    20	        None  # 에이전트 영속 온도(스펙 077). None=자동(모델 등록 params 적용)
    21	    )
    22	    # 모델 설정 오버라이드(스펙 408 캐스케이드) — 화이트리스트 키(enable_thinking·stream)만 실효.
    23	    # temperature는 위 기존 필드가 에이전트 층 정본(이중 거처 금지). 미명시 키=모델 기본 상속.
    24	    modelParams: dict[str, Any] = Field(default_factory=dict)
