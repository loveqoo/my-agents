   215	@router.post("/test", response_model=ModelProbeResult)
   216	async def test_model_config(
   217	    body: ModelProbeIn, session: AsyncSession = Depends(get_session)
   218	) -> ModelProbeResult:
   219	    """입력값(새 모델/편집)으로 연결 테스트. 연결처는 선택한 provider에서 취득."""
   220	    p = await get_or_404(session, Provider, body.provider_id, detail="provider not found")
   221	    return await _probe(p.base_url, crypto.decrypt(p.api_key), body.model_id, body.kind)
