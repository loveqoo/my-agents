    43	async def _commit_or_409(session: AsyncSession, detail: str) -> None:
    44	    """유니크 충돌(kind당 기본 1개 부분 인덱스·이름)을 500 대신 409로(스펙 150 — 동시 지정 레이스)."""
    45	    try:
    46	        await session.commit()
    47	    except IntegrityError as err:
    48	        await session.rollback()
    49	        raise HTTPException(status_code=409, detail=detail) from err
    50	
