   200	@router.get("", response_model=list[ModelOut])
   201	async def list_models(
   202	    kind: str | None = None, session: AsyncSession = Depends(get_session)
   203	) -> list[ModelOut]:
   204	    stmt = (
   205	        select(ModelConfig)
   206	        .options(selectinload(ModelConfig.provider))
   207	        .order_by(ModelConfig.kind, ModelConfig.name)
   208	    )
   209	    if kind:
   210	        stmt = stmt.where(ModelConfig.kind == kind)
   211	    rows = (await session.execute(stmt)).scalars().all()
   212	    return [model_to_out(m) for m in rows]
