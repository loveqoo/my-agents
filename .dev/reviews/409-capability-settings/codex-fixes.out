    60	def resolve_effective(cap: str, capabilities: dict, *layers: dict) -> bool:
    61	    """유효값 = **능력 AND 설정**(스펙 409 원칙 — 능력 false면 어느 층도 못 켬, 부분집합 불가침).
    62	
    63	    설정값은 층을 **뒤에서 앞으로**(우선순위 높은 층이 뒤) 훑어 처음 명시된 값을 취하고, 없으면
    64	    서술자 default. layers 예: build_chat_openai에서 `(params, cfg_params)` — 호출자(세션)가 최우선.
    65	    비-bool 값은 인정하지 않는다(문자열 "false"로 게이트 우회 차단 — _as_bool).
    66	    """
    67	    d = _BY_CAP[cap]
    68	    capable = _as_bool(capabilities.get(cap), d.cap_default)
    69	    want = d.default
    70	    if d.setting is not None:
    71	        for layer in layers:
    72	            if layer and isinstance(layer.get(d.setting), bool):
    73	                want = layer[d.setting]
    74	                break
    75	    return capable and want
