   161	    if not isinstance(agent_mp, dict) or not agent_mp:
   162	        return model_cfg
   163	    merged = dict(model_cfg.get("params") or {})
   164	    for key in MODEL_PARAM_OVERRIDE_KEYS:
   165	        if key in agent_mp and agent_mp[key] is not None:
   166	            merged[key] = agent_mp[key]
   167	    return {**model_cfg, "params": merged}
