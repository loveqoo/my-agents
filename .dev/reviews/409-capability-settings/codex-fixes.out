    29	async def require_model_manage(
    30	    principal: User | str = Depends(current_principal),
    31	) -> User | str:
    32	    """모델/프로바이더 변이 게이트(스펙 150, codex High) — 기본 모델·연결처는 채팅·메모리·평가의
    33	    전역 동작과 비용면을 바꾸므로 특권(머신 토큰·superuser·admin)만. member는 403.
    34	    (읽기·연결 테스트는 인증만 — 기존과 동일.)"""
    35	    if not is_privileged(principal):
    36	        raise HTTPException(status_code=403, detail="모델 관리 권한이 없습니다")
    37	    return principal
