   110	
   111	async def main() -> None:
   112	    await unit_checks()
   113	    from agent.capabilities import SETTING_KEYS
   114	
   115	    tag = f"v409-{uuid.uuid4().hex[:6]}"
   116	    async with httpx.AsyncClient(base_url=BASE, headers=_auth(), timeout=120) as c:
   117	        # H1 서술자 엔드포인트 = 정본
   118	        r = await c.get("/models/capabilities/descriptors")
   119	        check(r.status_code == 200, f"H1a 서술자 200 (got {r.status_code})")
   120	        descs = r.json()
   121	        caps = {d["cap"] for d in descs}
   122	        check({"streaming", "thinking", "vision"} <= caps, f"H1b 능력 3종 노출 (got {caps})")
   123	        tunable = {d["setting"] for d in descs if d["setting"]}
   124	        check(tunable == set(SETTING_KEYS), f"H1c 튜닝 설정=SETTING_KEYS 파리티 (got {tunable})")
   125	        vis = next(d for d in descs if d["cap"] == "vision")
   126	        check(vis["setting"] is None, "H1d vision은 능력만(setting=None)")
   127	
   128	        # H2 노드별 오버라이드 저장/로드 왕복
   129	        ag = (
   130	            await c.post(
   131	                "/agents",
   132	                json={
   133	                    "name": f"{tag}-pipe",
   134	                    "config": {
   135	                        "impl": "pipeline",
   136	                        "nodes": [
   137	                            {"prompt": "분석해", "model": "mock-llm", "modelParams": {"stream": False}},
   138	                            {"prompt": "정리해", "model": "mock-llm"},
   139	                        ],
   140	                    },
   141	                },
   142	            )
   143	        ).json()
   144	        try:
   145	            got = (await c.get(f"/agents/{ag['id']}")).json()
   146	            nodes = got.get("config", {}).get("nodes") or got.get("nodes") or []
   147	            n0mp = nodes[0].get("modelParams") if nodes else None
   148	            check(n0mp == {"stream": False}, f"H2a 노드0 modelParams 저장/로드 왕복 (got {n0mp})")
   149	            check("modelParams" not in (nodes[1] if len(nodes) > 1 else {}), "H2b 노드1 미명시=키 없음(상속)")
   150	        finally:
   151	            await c.delete(f"/agents/{ag['id']}")
   152	
   153	    print(f"\n{passed} passed, {len(_fails)} failed")
   154	    if _fails:
   155	        sys.exit(1)
   156	    print("VERIFY409_OK")
   157	
   158	
   159	if __name__ == "__main__":
   160	    asyncio.run(main())

