    84	class ModelOut(AuditOut):
    85	    id: uuid.UUID
    86	    name: str
    87	    provider_id: uuid.UUID
    88	    provider_name: str  # 표시용(denormalized)
    89	    provider_kind: str = ""  # provider.kind(local|mock|remote) — mock 필터 등에 사용(스펙 218)
    90	    base_url: str  # provider에서 상속(표시용)
    91	    model_id: str
    92	    kind: str
    93	    is_default: bool
    94	    params: dict[str, Any] = Field(default_factory=dict)
    95	    capabilities: dict[str, Any] = Field(
     1	/* 능력→설정 오버라이드 단일 컴포넌트(스펙 409). 에이전트 폼·플레이그라운드 오버라이드·노드
     2	   편집기가 **공유**한다(사본 금지 — 회고 261 "사본이면 드리프트"의 설정 축 교정). 서술자 목록
     3	   (백엔드 정본)으로 렌더하므로 설정이 늘면 이 컴포넌트를 안 고쳐도 자동 반영된다.
     4	
     5	   상속(키 없음)/켬/끔 3상. 능력이 아니라 **사용값**을 덮는다 — 모델이 못 하는 걸 켤 수는 없어
     6	   (부분집합 불가침), 능력 false인 축은 '켬'을 비활성하고 사유를 표시한다. */
     7	import { Flex, Select, Typography } from 'antd'
     8	import { useEffect, useState } from 'react'
     9	import { getCapabilityDescriptors, type CapabilityDescriptor } from '../../../api'
    10	
    11	const { Text } = Typography
    12	
    13	// 서술자는 사실상 정적(백엔드 상수) — 프로세스 1회 fetch 후 캐시(프롭 배관 없이 어느 소비처든 훅 호출).
    14	let _cache: CapabilityDescriptor[] | null = null
    15	let _inflight: Promise<CapabilityDescriptor[]> | null = null
    16	
    17	export function useCapabilityDescriptors(): CapabilityDescriptor[] {
    18	  const [d, setD] = useState<CapabilityDescriptor[]>(_cache ?? [])
    19	  useEffect(() => {
    20	    if (_cache) return
    21	    if (!_inflight) _inflight = getCapabilityDescriptors().then((r) => (_cache = r))
    22	    // 실패 시 _inflight를 비워 재마운트가 재시도하게(codex P2① — 최초 1회 네트워크 실패가 4화면
    23	    // 설정을 영구 빈 UI로 고착시키던 것 봉인). 성공 값만 전역 캐시.
    24	    _inflight.then(setD).catch(() => {
    25	      _inflight = null
    26	    })
    27	  }, [])
    28	  return d
    29	}
    30	
    31	type ModelParams = Record<string, boolean | undefined>
    32	
    33	/** 이 층에서 상속했을 때 실제로 켜질지(모델 params → 서술자 default, 능력 false면 무조건 끔). */
    34	function inheritedOn(d: CapabilityDescriptor, capable: boolean, modelDefaults?: Record<string, unknown>): boolean {
    35	  if (!capable || !d.setting) return false
    36	  const v = modelDefaults?.[d.setting]
    37	  return v === undefined ? d.default : Boolean(v)
    38	}
    39	
    40	export function CapabilitySettings({
    41	  descriptors,
    42	  capabilities,
    43	  value,
    44	  onChange,
    45	  modelDefaults,
    46	  size = 'small',
    47	}: {
    48	  descriptors: CapabilityDescriptor[]
    49	  capabilities: Record<string, boolean> | undefined
    50	  value: ModelParams
    51	  onChange: (next: ModelParams) => void
    52	  modelDefaults?: Record<string, unknown> // 선택 모델의 params(상속 값 표시용)
    53	  size?: 'small' | 'middle'
    54	}) {
    55	  const tunable = descriptors.filter((d) => d.setting)
    56	  if (!tunable.length) return null
    57	  return (
    58	    <Flex vertical gap={12}>
    59	      {tunable.map((d) => {
    60	        const key = d.setting as string
    61	        // 능력 판정은 백엔드 resolve_effective와 **일치**(codex P2②): 키가 진짜 bool이면 그 값,
    62	        // 아니면(누락·비-bool) 서술자 capDefault. capabilities=undefined(미조회)면 낙관적 허용.
    63	        const raw = capabilities?.[d.cap]
    64	        const capable = capabilities ? (typeof raw === 'boolean' ? raw : d.capDefault) : true
    65	        const cur = value[key] === undefined ? 'inherit' : value[key] ? 'on' : 'off'
    66	        const inh = inheritedOn(d, capable, modelDefaults)
    67	        return (
    68	          <Flex vertical gap={2} key={d.cap}>
    69	            <Text style={{ fontSize: 13, fontWeight: 600 }}>{d.label}</Text>
    70	            <Select
    71	              size={size}
    72	              style={{ width: 220 }}
    73	              value={cur}
    74	              onChange={(v) => {
    75	                const mp = { ...value }
    76	                if (v === 'inherit') delete mp[key]
    77	                else mp[key] = v === 'on'
    78	                onChange(mp)
    79	              }}
    80	              options={[
    81	                { value: 'inherit', label: `모델 기본(상속 — ${inh ? '켬' : '끔'})` },
    82	                { value: 'on', label: '켬', disabled: !capable },
    83	                { value: 'off', label: '끔' },
    84	              ]}
    85	            />
    86	            <Text type="secondary" style={{ fontSize: 12 }}>
    87	              {capable
    88	                ? `모델 기본값을 이 층에서 덮습니다(상속=모델 설정 따름).`
    89	                : `이 모델은 ${d.label}을(를) 지원하지 않아 켤 수 없습니다(능력 우선).`}
    90	            </Text>
    91	          </Flex>
    92	        )
    93	      })}
    94	    </Flex>
    95	  )
    96	}

