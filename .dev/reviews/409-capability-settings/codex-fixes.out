    78	def clean_setting_params(mp: object) -> dict:
    79	    """설정 오버라이드(modelParams) 정리 — 화이트리스트 설정 키의 **진짜 bool만** 보존(스펙 409).
    80	    에이전트/노드/세션 저장 경계가 공유(하드코딩 없음 — 서술자 파생). 비-bool·미지 키는 드롭."""
    81	    if not isinstance(mp, dict):
