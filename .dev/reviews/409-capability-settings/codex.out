   117	/** 로그인 — fastapi-users 인증 라우터는 OAuth2 폼(username=email). 성공 시 204 + Set-Cookie. */
   118	export async function login(email: string, password: string): Promise<void> {
   119	  const body = new URLSearchParams({ username: email, password })
   120	  const res = await fetch(`${BASE}/auth/login`, {
   121	    method: 'POST',
   122	    credentials: 'include',
   123	    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
   124	    body,
   125	  })
   126	  // 400 = 자격증명 불일치/비활성(LOGIN_BAD_CREDENTIALS). 그 외 비정상도 메시지로 던진다.
   127	  if (!res.ok) throw new Error(res.status === 400 ? '이메일 또는 비밀번호가 올바르지 않습니다' : `로그인 실패: ${res.status}`)
   128	}
   129	
   130	/** 로그아웃 — DatabaseStrategy 토큰 행 삭제 = 진짜 무효화. */
   131	export const logout = () => post('/auth/logout')
   132	
   133	/** 현재 로그인 사용자. 미인증이면 null(전역 401 핸들러는 건너뛴다 — 초기 탐색용). */
   134	export async function getMe(): Promise<Me | null> {
   135	  const res = await fetch(`${BASE}/users/me`, {
   136	    credentials: 'include',
   137	    headers: authHeaders(false),
   138	  })
   139	  if (res.status === 401) return null
   140	  if (!res.ok) throw new Error(`GET /users/me → ${res.status}`)
   141	  return res.json() as Promise<Me>
   142	}
