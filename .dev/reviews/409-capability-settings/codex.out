    36	export function CapabilitySettings({
    37	  descriptors,
    38	  capabilities,
    39	  value,
    40	  onChange,
    41	  modelDefaults,
    42	  size = 'small',
    43	}: {
    44	  descriptors: CapabilityDescriptor[]
    45	  capabilities: Record<string, boolean> | undefined
    46	  value: ModelParams
    47	  onChange: (next: ModelParams) => void
    48	  modelDefaults?: Record<string, unknown> // 선택 모델의 params(상속 값 표시용)
    49	  size?: 'small' | 'middle'
    50	}) {
    51	  const tunable = descriptors.filter((d) => d.setting)
    52	  if (!tunable.length) return null
    53	  return (
    54	    <Flex vertical gap={12}>
    55	      {tunable.map((d) => {
    56	        const key = d.setting as string
