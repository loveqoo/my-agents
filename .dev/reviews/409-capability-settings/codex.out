    26	def _node_patch_fields(base_n: dict) -> set[str]:
    27	    """이 노드에 병합 가능한 오버라이드 필드(스펙 317) — 설정 노드=화이트리스트 전체, 코드 노드=
    28	    manifest.overridable ∩ 화이트리스트(나머지는 코드가 소유 — 세션 패치로 못 바꾼다). 미등록
    29	    impl은 빈 집합(fail-closed — 어차피 실행이 설정 오류로 거부됨)."""
    30	    impl = base_n.get("impl")
    31	    if not isinstance(impl, str) or not impl.strip():
    32	        return _NODE_OVERRIDE_FIELDS
    33	    from agent.nodes import get_node_impl
    34	
    35	    node_impl = get_node_impl(impl)
    36	    if node_impl is None:
    37	        return set()
    38	    return _NODE_OVERRIDE_FIELDS & set(node_impl.describe().overridable)
