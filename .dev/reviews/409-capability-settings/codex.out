    41	def _merge_one_node(base_n: object, ov_n: object) -> tuple[dict, bool] | None:
    42	    """노드 하나 병합 — (병합본, 코드소유 필드 드롭 여부). 형식 오류는 None(mismatch 신호)."""
    43	    if not isinstance(base_n, dict) or not isinstance(ov_n, dict):
    44	        return None
    45	    allowed = _node_patch_fields(base_n)
    46	    patch = {k: v for k, v in ov_n.items() if k in allowed}
    47	    dropped = any(k in _NODE_OVERRIDE_FIELDS and k not in allowed for k in ov_n)
    48	    return {**base_n, **patch}, dropped
    49	
