     1	/* 능력→설정 오버라이드 단일 컴포넌트(스펙 409). 에이전트 폼·플레이그라운드 오버라이드·노드
     2	   편집기가 **공유**한다(사본 금지 — 회고 261 "사본이면 드리프트"의 설정 축 교정). 서술자 목록
     3	   (백엔드 정본)으로 렌더하므로 설정이 늘면 이 컴포넌트를 안 고쳐도 자동 반영된다.
     4	
     5	   상속(키 없음)/켬/끔 3상. 능력이 아니라 **사용값**을 덮는다 — 모델이 못 하는 걸 켤 수는 없어
     6	   (부분집합 불가침), 능력 false인 축은 '켬'을 비활성하고 사유를 표시한다. */
     7	import { Flex, Select, Typography } from 'antd'
     8	import { useEffect, useState } from 'react'
     9	import { getCapabilityDescriptors, type CapabilityDescriptor } from '../../../api'
    10	
    11	const { Text } = Typography
    12	
    13	// 서술자는 사실상 정적(백엔드 상수) — 프로세스 1회 fetch 후 캐시(프롭 배관 없이 어느 소비처든 훅 호출).
    14	let _cache: CapabilityDescriptor[] | null = null
    15	let _inflight: Promise<CapabilityDescriptor[]> | null = null
    16	
    17	export function useCapabilityDescriptors(): CapabilityDescriptor[] {
    18	  const [d, setD] = useState<CapabilityDescriptor[]>(_cache ?? [])
    19	  useEffect(() => {
    20	    if (_cache) return
    21	    if (!_inflight) _inflight = getCapabilityDescriptors().then((r) => (_cache = r))
    22	    _inflight.then(setD).catch(() => {})
    23	  }, [])
    24	  return d
    25	}
    26	
    27	type ModelParams = Record<string, boolean | undefined>
    28	
    29	/** 이 층에서 상속했을 때 실제로 켜질지(모델 params → 서술자 default, 능력 false면 무조건 끔). */
    30	function inheritedOn(d: CapabilityDescriptor, capable: boolean, modelDefaults?: Record<string, unknown>): boolean {
    31	  if (!capable || !d.setting) return false
    32	  const v = modelDefaults?.[d.setting]
    33	  return v === undefined ? d.default : Boolean(v)
    34	}
    35	
    36	export function CapabilitySettings({
    37	  descriptors,
    38	  capabilities,
    39	  value,
    40	  onChange,
    41	  modelDefaults,
    42	  size = 'small',
    43	}: {
    44	  descriptors: CapabilityDescriptor[]
    45	  capabilities: Record<string, boolean> | undefined
    46	  value: ModelParams
    47	  onChange: (next: ModelParams) => void
    48	  modelDefaults?: Record<string, unknown> // 선택 모델의 params(상속 값 표시용)
    49	  size?: 'small' | 'middle'
    50	}) {
    51	  const tunable = descriptors.filter((d) => d.setting)
    52	  if (!tunable.length) return null
    53	  return (
    54	    <Flex vertical gap={12}>
    55	      {tunable.map((d) => {
    56	        const key = d.setting as string
    57	        // 능력 미조회(capabilities=undefined)면 낙관적 허용 — 저장 시 백엔드가 최종 게이트.
    58	        const capable = capabilities ? capabilities[d.cap] !== false : true
    59	        const cur = value[key] === undefined ? 'inherit' : value[key] ? 'on' : 'off'
    60	        const inh = inheritedOn(d, capable, modelDefaults)
    61	        return (
    62	          <Flex vertical gap={2} key={d.cap}>
    63	            <Text style={{ fontSize: 13, fontWeight: 600 }}>{d.label}</Text>
    64	            <Select
    65	              size={size}
    66	              style={{ width: 220 }}
    67	              value={cur}
    68	              onChange={(v) => {
    69	                const mp = { ...value }
    70	                if (v === 'inherit') delete mp[key]
    71	                else mp[key] = v === 'on'
    72	                onChange(mp)
    73	              }}
    74	              options={[
    75	                { value: 'inherit', label: `모델 기본(상속 — ${inh ? '켬' : '끔'})` },
    76	                { value: 'on', label: '켬', disabled: !capable },
    77	                { value: 'off', label: '끔' },
    78	              ]}
    79	            />
    80	            <Text type="secondary" style={{ fontSize: 12 }}>
    81	              {capable
    82	                ? `모델 기본값을 이 층에서 덮습니다(상속=모델 설정 따름).`
    83	                : `이 모델은 ${d.label}을(를) 지원하지 않아 켤 수 없습니다(능력 우선).`}
    84	            </Text>
    85	          </Flex>
    86	        )
    87	      })}
    88	    </Flex>
    89	  )
    90	}
     1	/* 어드민 백엔드 API 클라이언트 (007 Phase 3).
     2	   타입은 admin/mockData.ts와 일원화 — 백엔드 출력이 동일 shape다. */
     3	import type { Agent, Approval, Audit, BlockCategory, PipelineNode, Session } from './admin/mockData'
     4	import { httpError } from './httpError'
     5	
     6	// 기본은 same-origin 상대경로 `/api` — vite dev 프록시(vite.config.ts)가 127.0.0.1:8000으로 넘긴다.
     7	// 브라우저는 API 호스트를 모르므로 tailscale 도메인/IP/scheme가 바뀌어도 무설정 동작(CORS·mixed-content·cert 회피).
     8	// 별도 호스트로 직접 붙고 싶을 때만 VITE_API_BASE로 절대 URL을 준다.
     9	const BASE = import.meta.env.VITE_API_BASE ?? '/api'
    10	// 인증은 세션 쿠키(fastapi-users, 스펙 031)가 기본 — same-origin이라 쿠키가 자동 동행한다.
    11	// VITE_API_TOKEN은 머신 Bearer 토큰 하위호환용(헤드리스/E2E). 있으면 함께 보낸다.
    12	const TOKEN = import.meta.env.VITE_API_TOKEN ?? ''
    13	
    14	export type { Agent, Approval, Audit, BlockCategory, Session }
    15	
    16	export interface ChatMessage {
    17	  role: 'user' | 'assistant'
    18	  content: string
    19	}
    20	
    21	/* 파일첨부(스펙 404, A안) — 추출 결과를 클라이언트가 들고 있다가 전송 시 되보낸다(무상태). */
    22	export interface ChatAttachmentDraft {
    23	  filename: string
    24	  text: string
    25	  chars: number
    26	  truncated: boolean
    27	}
    28	
    29	export async function uploadChatAttachment(file: File): Promise<ChatAttachmentDraft> {
    30	  const fd = new FormData()
    31	  fd.append('file', file)
    32	  // FormData는 브라우저가 boundary 포함 Content-Type을 정한다 — 수동 지정 금지(hasBody=false).
    33	  const res = await fetch(`${BASE}/chat/attachments`, {
    34	    method: 'POST',
    35	    credentials: 'include',
    36	    headers: authHeaders(false),
    37	    body: fd,
    38	  })
    39	  if (!res.ok) throw await httpError(res, 'POST', '/chat/attachments')
    40	  return res.json()
    41	}
    42	
    43	// 401(세션 만료·미인증) 전역 핸들러 — AuthGate가 등록해 로그인 화면으로 되돌린다.
    44	let unauthorizedHandler: (() => void) | null = null
    45	export function setUnauthorizedHandler(fn: (() => void) | null): void {
    46	  unauthorizedHandler = fn
    47	}
    48	
    49	/** 모든 요청 공통 헤더 (머신 Bearer 토큰 하위호환 + 본문 시 JSON). */
    50	function authHeaders(hasBody: boolean): Record<string, string> {
    51	  const h: Record<string, string> = {}
    52	  if (TOKEN) h.Authorization = `Bearer ${TOKEN}`
    53	  if (hasBody) h['Content-Type'] = 'application/json'
    54	  return h
    55	}
    56	
    57	async function j<T>(path: string, init?: RequestInit): Promise<T> {
    58	  const res = await fetch(`${BASE}${path}`, {
    59	    ...init,
    60	    credentials: 'include', // 세션 쿠키 동행(절대 URL/크로스오리진에서도)
    61	    headers: { ...authHeaders(!!init?.body), ...(init?.headers as Record<string, string>) },
    62	  })
    63	  if (res.status === 401) {
    64	    unauthorizedHandler?.()
    65	    throw new Error(`${init?.method ?? 'GET'} ${path} → 401`)
    66	  }
    67	  if (!res.ok) throw await httpError(res, init?.method ?? 'GET', path)
    68	  if (res.status === 204) return undefined as T
    69	  return res.json() as Promise<T>
    70	}
