    30	async def _pinned_model_cfg(db: AsyncSession, pins: dict | None, name: str) -> dict | None:
    31	    """pin이 head와 다를 때만 이력 payload로 model_cfg 구성(스펙 370) — 369 경계 그대로
    32	    저작 내용(model_id·params·provider_id)은 pin, 연결처 비밀(base_url·api_key)은 라이브 provider."""
    33	    from .block_versions import resolve_pinned
    34	    from .models import Provider as _Provider
    35	
    36	    payload = await resolve_pinned(db, pins, "model", name)
    37	    if payload is None:
    38	        return None
    39	    prov = None
    40	    if payload.get("provider_id"):
    41	        try:
    42	            prov = await db.get(_Provider, uuid.UUID(str(payload["provider_id"])))
    43	        except ValueError:
    44	            prov = None
    45	    if prov is None or not prov.base_url or not payload.get("model_id"):
    46	        return None  # 불완전 pin — head 폴백(정직 degrade)
    47	    # 능력은 스냅샷하지 않는다(스펙 408) — 서버 능력은 **라이브 사실**이라 pin과 무관하게 현재
    48	    # 등록 행에서 읽는다(구버전 pin이라도 지금 서버가 스트리밍을 껐으면 지금 사실을 따라야 함).
    49	    live = await _registry_chat_model(db, name)
    50	    caps = dict(live.capabilities or {}) if live is not None else {}
    51	    return {
    52	        "base_url": prov.base_url,
    53	        "api_key": crypto.decrypt(prov.api_key),
    54	        "model_id": payload["model_id"],
    55	        "params": dict(payload.get("params") or {}),
    56	        "capabilities": caps,
    57	    }
    58	
