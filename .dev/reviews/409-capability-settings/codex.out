    20	def model_usable(cm: ModelConfig | None) -> TypeGuard[ModelConfig]:
    21	    """기본 chat/embedding 모델이 실사용 가능한가 — provider·base_url·model_id 완비(정본, 스펙 300).
    22	    TypeGuard: positive 분기(`if model_usable(cm):`)서 mypy가 cm을 ModelConfig로 narrow(연결 dict 조립부).
    23	    값-유효성 체크라 TypeIs는 불건전(빈 base_url 모델도 False) — positive만 narrow하는 TypeGuard가 건전."""
    24	    return (
    25	        cm is not None
    26	        and cm.provider is not None
    27	        and bool(cm.provider.base_url)
    28	        and bool(cm.model_id)
    29	    )
    30	
    31	
    32	def llm_cfg_of(cm: ModelConfig) -> dict:
    33	    """ModelConfig → LLM 연결 cfg(정본, 스펙 300). **api_key 평문 복호화** — API 응답에 넣지 말 것
    34	    (serializers 마스킹과 반대 목적, 런타임 ChatOpenAI 구성용). `model_usable`로 검증 후 호출."""
    35	    assert cm.provider is not None  # model_usable 검증 후 호출 전제(provider 보장)
    36	    return {
    37	        "base_url": cm.provider.base_url,
    38	        "api_key": crypto.decrypt(cm.provider.api_key),
    39	        "model_id": cm.model_id,
    40	        # 능력 선언 동봉(스펙 408) — 실행부(agent/model.py)가 streaming 능력에 맞춰 클라이언트 구성.
    41	        "capabilities": dict(cm.capabilities or {}),
    42	    }
    43	
    44	
    45	def _build_mem_cfg(chat_m: ModelConfig | None, emb_m: ModelConfig | None) -> dict | None:
    46	    """레지스트리 chat+embedding 모델 → mem0 mem_cfg(llm+embedder dict, 복호화 포함).
    47	    연결처는 각 모델의 provider에서 상속(스펙 035). 어느 쪽이라도 provider base_url/model_id가
    48	    없으면 None. get_all/update/delete는 embedder만 쓰지만 mem0 인스턴스화에 llm 자리가 필요하다
    49	    (스펙 030 공유 빌더). 호출 측은 provider 관계를 eager-load해야 한다."""
    50	    if model_usable(chat_m) and model_usable(emb_m):
    51	        return {"llm": llm_cfg_of(chat_m), "embedder": llm_cfg_of(emb_m)}
    52	    return None
    53	
