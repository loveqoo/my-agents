   109	async def _resolve_node_models(
   110	    db: AsyncSession,
   111	    nodes: list,
   112	    default_cfg: dict | None,
   113	    pins: dict | None = None,
   114	    agent_cfg: dict | None = None,
   115	) -> list[dict]:
   116	    """노드형(스펙 259) 노드별 모델을 레지스트리에서 미리 해석해 `model_cfg`를 심는다(085 U2 — impl은
   117	    DB 미접촉). 에이전트 모델 해석과 **동일 조회**(`ModelConfig.name==name, kind=="chat"`, provider
   118	    상속) — 드리프트 0. 미지정/미존재 이름은 `default_cfg`(에이전트 기본 chat 모델)로 폴백. 같은 모델
   119	    이름은 1회만 조회해 재사용(N 노드 M 중복 모델 → distinct 쿼리). 순수 데이터 반환(잡 노드는 통과 —
   120	    정규화는 impl의 normalize_nodes가)."""
   121	    resolved: list[dict] = []
   122	    cache: dict[str, dict | None] = {}
   123	    for node in nodes:
   124	        if not isinstance(node, dict):
   125	            continue
   126	        name = node.get("model")
   127	        cfg = None
   128	        if isinstance(name, str) and name.strip():
   129	            if name not in cache:
   130	                cache[name] = await _chat_model_cfg(db, name, pins)
   131	            cfg = cache[name]
   132	        # 심은 model_cfg는 해석된 노드 모델(없으면 에이전트 기본으로 폴백 — impl의 _model_from_node).
   133	        # 캐스케이드(스펙 409): 모델 기본 → 에이전트 modelParams → **노드 modelParams**(노드형만).
   134	        # - 노드 명시 모델(cfg): 에이전트 층 관통(codex P1②) 후 노드 층을 덮는다.
   135	        # - 상속(default_cfg): 에이전트 층은 _resolve_model서 이미 반영 — 노드 층만 더 덮는다.
   136	        node_cfg = cfg if cfg is not None else default_cfg
   137	        if cfg is not None and agent_cfg:
   138	            node_cfg = _apply_agent_model_params(cfg, agent_cfg)
   139	        node_mp = node.get("modelParams")
   140	        if node_cfg is not None and isinstance(node_mp, dict) and node_mp:
   141	            node_cfg = _apply_agent_model_params(node_cfg, {"modelParams": node_mp})
   142	        resolved.append({**node, "model_cfg": node_cfg})
   143	    return resolved
