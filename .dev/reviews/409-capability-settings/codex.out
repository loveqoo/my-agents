   242	@router.post("", response_model=ModelOut, status_code=201, dependencies=[_manage])
   243	async def create_model(body: ModelIn, session: AsyncSession = Depends(get_session)) -> ModelOut:
   244	    await _require_provider(session, body.provider_id)
   245	    if body.is_default:
   246	        await _clear_other_defaults(session, body.kind)
   247	    m = ModelConfig(
   248	        name=body.name,
   249	        provider_id=body.provider_id,
   250	        model_id=body.model_id,
   251	        kind=body.kind,
   252	        is_default=body.is_default,
   253	        params=body.params,
   254	        capabilities=body.capabilities,  # 능력 선언(스펙 408)
   255	        meta=body.meta,
   256	    )
   257	    session.add(m)
   258	    await _commit_or_409(session, "동시 변경 충돌 또는 중복 — 다시 시도하세요.")
   259	    await session.refresh(m)
   260	    await record_block_version(session, "model", m)  # v1 이력(스펙 369)
   261	    await session.commit()
   262	    reloaded = await _get_with_provider(session, m.id)
   263	    assert reloaded is not None  # 방금 커밋한 행의 재로드 — 동시 삭제 레이스 외엔 불가
   264	    return model_to_out(reloaded)
