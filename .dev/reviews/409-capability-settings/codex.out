   228	/* 능력·설정 편집(스펙 409) — 등록 모델 행의 소형 popover. 서술자 목록으로 **능력당 한 블록**을
   229	   렌더한다(능력 토글 + 능력 ON이고 설정 있는 축이면 그 아래 '기본값' 하나). 408이 능력·사용을 두
   230	   줄로 겹쳐 표시(스트리밍·thinking 두 번)하던 중복을 제거. 참조 중 모델은 삭제가 막히므로(093) 이
   231	   편집이 유일한 수정 경로다. PUT은 전체 body 계약이라 행 값 그대로 되보낸다. */
   232	function CapsEditor({ reg, onSaved }: { reg: Model; onSaved: () => void }) {
   233	  const [busy, setBusy] = useState(false)
   234	  const descriptors = useCapabilityDescriptors()
   235	  const savedCaps = (reg.capabilities ?? {}) as Record<string, boolean>
   236	  const usage = reg.params ?? {}
   237	  const save = async (capsPatch: Record<string, boolean>, usagePatch: Record<string, unknown>) => {
   238	    setBusy(true)
   239	    try {
   240	      await updateModel(reg.id, {
   241	        name: reg.name, provider_id: reg.provider_id, model_id: reg.model_id,
   242	        kind: reg.kind, is_default: reg.is_default,
   243	        params: { ...usage, ...usagePatch },
   244	        capabilities: { ...savedCaps, ...capsPatch },
   245	        meta: reg.meta ?? {},
   246	      })
   247	      onSaved()
   248	    } catch (e) {
   249	      message.error(e instanceof Error ? e.message : String(e))
   250	    } finally {
   251	      setBusy(false)
   252	    }
   253	  }
   254	  return (
   255	    <Popover
   256	      trigger="click"
   257	      title="모델 능력·설정"
   258	      content={
   259	        <Flex vertical gap={12} style={{ minWidth: 260 }}>
   260	          {descriptors.map((d) => {
   261	            const capable = savedCaps[d.cap] === undefined ? d.capDefault : savedCaps[d.cap]
   262	            const usageOn = usage[d.setting ?? ''] === undefined ? d.default : Boolean(usage[d.setting ?? ''])
   263	            return (
   264	              <Flex vertical gap={4} key={d.cap}>
   265	                <Checkbox
   266	                  checked={capable}
   267	                  disabled={busy}
   268	                  onChange={(e) => void save({ [d.cap]: e.target.checked }, {})}
   269	                >
   270	                  {d.label} 지원 <span style={{ fontSize: 11, color: 'var(--color-text-tertiary)' }}>(서버가 할 수 있는 것)</span>
   271	                </Checkbox>
   272	                {d.setting && capable && (
   273	                  <Flex align="center" gap={8} style={{ marginLeft: 24 }}>
   274	                    <span style={{ fontSize: 12, color: 'var(--color-text-tertiary)' }}>요청 기본값</span>
   275	                    <Segmented
   276	                      size="small"
   277	                      disabled={busy}
   278	                      value={usageOn ? 'on' : 'off'}
   279	                      onChange={(v) => void save({}, { [d.setting as string]: v === 'on' })}
   280	                      options={[{ label: '켬', value: 'on' }, { label: '끔', value: 'off' }]}
   281	                    />
   282	                  </Flex>
   283	                )}
   284	              </Flex>
   285	            )
   286	          })}
   287	        </Flex>
   288	      }
   289	    >
   290	      <Button size="small">능력·설정</Button>
   291	    </Popover>
   292	  )
   293	}
