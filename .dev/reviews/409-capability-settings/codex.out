   165	async def _resolve_model(
   166	    db: AsyncSession, cfg: dict, overrides: dict | None, pins: dict | None = None
   167	) -> dict:
   168	    """chat 모델을 레지스트리에서만 해석(env 안 봄) — 반환 model_cfg dict(연결처는 provider 상속, 스펙 035).
   169	
   170	    에이전트가 고른 이름 → 없으면 기본(is_default) chat 모델 → 그것도 없으면 명확히 400.
   171	    명시 오버라이드 모델이 미등록이면 **시끄럽게 거절**(스펙 290 — learning 092: 조용한 폴백은
   172	    호출자가 다른 모델로 실행된 걸 모른 채 지나간다). 저장 설정의 미지정·미등록은 기존 기본 폴백
   173	    유지(graceful — 범위 밖, 백로그)."""
   174	    model_name = cfg.get("model")
   175	    if model_name:
   176	        pinned = await _pinned_model_cfg(db, pins, model_name)  # pin 우선(스펙 370)
   177	        if pinned is not None:
   178	            return _apply_agent_model_params(pinned, cfg)
   179	    m = await _registry_chat_model(db, model_name) if model_name else None
   180	    if m is None:
   181	        # 거절은 **실명을 댄** 오버라이드에만(스펙 401) — 모델 미지정 에이전트(model_name=None)에
   182	        # model 키 없는(또는 null) 오버라이드가 오면 None==None으로 오폭하던 것을 실명 요구로 봉합.
   183	        # 미선언은 기본 폴백(learning 092: 선언-but-broken만 거절).
   184	        if overrides and overrides.get("model") and overrides.get("model") == model_name:
   185	            raise HTTPException(
   186	                status_code=400,
   187	                detail=f"오버라이드 모델 '{model_name}'이(가) 등록돼 있지 않습니다 — 모델 이름을 확인하세요.",
   188	            )
   189	        m = await _default_chat_registry(db)
   190	    if m is None:
   191	        raise HTTPException(
   192	            status_code=400,
   193	            detail="등록된 채팅 모델이 없습니다 — 모델을 먼저 등록하세요.",
   194	        )
   195	    return _apply_agent_model_params(_model_cfg_from_row(m), cfg)
