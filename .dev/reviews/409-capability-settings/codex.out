    20	export interface Overrides {
    21	  model: string
    22	  temperature: number | null // null = 자동(모델 등록 params 적용)
    23	  systemPrompt: string
    24	  mcps: string[]
    25	  tools: string[] // 도구 단위 배선(스펙 276) — 런타임명 목록. mcps는 서버 합집합 파생.
    26	  memories: string[]
    27	  capabilities: string[] // 조율형 위임 대상(cap id 목록, 스펙 122). 직접형은 항상 빈 배열.
