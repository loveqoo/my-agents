    59	
    60	/* 카탈로그 메타 → 사람이 읽는 칩 텍스트. 숫자는 K/M 축약. */
    61	const fmtNum = (n?: number | null): string | null => {
    62	  if (n == null) return null
    63	  if (n >= 1_000_000) return `${+(n / 1_000_000).toFixed(1)}M`
    64	  if (n >= 1000) return `${+(n / 1000).toFixed(0)}K`
    65	  return String(n)
    66	}
    67	function CatalogChips({ c }: { c: CatalogMeta | null }) {
    68	  if (!c) {
    69	    return <span style={{ fontSize: 12, color: 'var(--color-text-quaternary)' }}>카탈로그 미수록</span>
    70	  }
    71	  const chips: string[] = []
    72	  const ctx = fmtNum(c.context)
    73	  if (ctx) chips.push(`${ctx} ctx`)
    74	  const inp = c.modalities?.input?.join('+')
    75	  const out = c.modalities?.output?.join('+')
    76	  if (inp || out) chips.push(`${inp || '?'}→${out || '?'}`)
    77	  if (c.cost?.input != null || c.cost?.output != null)
    78	    chips.push(`$${c.cost?.input ?? '?'}/$${c.cost?.output ?? '?'} per Mtok`)
    79	  const caps = c.capabilities || {}
    80	  const capNames = [
    81	    caps.reasoning && 'reasoning',
    82	    caps.tool_call && 'tools',
    83	    caps.structured_output && 'structured',
    84	    caps.attachment && 'vision',
    85	  ].filter(Boolean) as string[]
    86	  return (
    87	    <span style={{ display: 'inline-flex', flexWrap: 'wrap', gap: 6, alignItems: 'center' }}>
    88	      {chips.map((t) => (
    89	        <Tag key={t} style={{ fontSize: 11, marginInlineEnd: 0 }}>
    90	          {t}
    91	        </Tag>
    92	      ))}
    93	      {capNames.map((t) => (
    94	        <Tag key={t} color="purple" style={{ fontSize: 11, marginInlineEnd: 0 }}>
    95	          {t}
    96	        </Tag>
    97	      ))}
    98	    </span>
    99	  )
   100	}
