    35	
    36	const codeStyle = { fontFamily: 'var(--font-family-code)', fontSize: 12 }
    37	
    38	/* kind 배지: 색 + 라벨 + 한 줄 힌트(#6 라벨 혼란 해소). */
    39	const KIND: Record<ProviderKind, { color: string; label: string; hint: string }> = {
    40	  local: { color: 'green', label: 'Local', hint: '내 머신에서 실행되는 모델' },
    41	  mock: { color: 'gold', label: 'Mock', hint: '라이브 없이 결정적 응답을 주는 내장 목' },
    42	  remote: { color: 'geekblue', label: 'Remote', hint: '외부 API 엔드포인트' },
    43	}
    44	const KIND_OPTS = (Object.keys(KIND) as ProviderKind[]).map((k) => ({
    45	  label: `${KIND[k].label} — ${KIND[k].hint}`,
    46	  value: k,
    47	}))
    48	
    49	function KindBadge({ kind }: { kind: ProviderKind }) {
    50	  const m = KIND[kind] ?? KIND.remote
    51	  return (
    52	    <Tooltip title={m.hint}>
    53	      <Tag color={m.color} style={{ marginInlineEnd: 0 }}>
    54	        {m.label}
    55	      </Tag>
    56	    </Tooltip>
