   300	async def set_default_model(
   301	    model_id: uuid.UUID, session: AsyncSession = Depends(get_session)
   302	) -> ModelOut:
   303	    """이 모델을 그 kind(chat/embedding)의 기본으로 지정 — 같은 kind의 기존 기본은 자동 해제
   304	    (스펙 150, 실사용 버그 #1: 등록 모달에만 기본 스위치가 있어 삭제 후 재등록으로만 전환 가능했다).
   305	    전용 액션인 이유: 프론트가 부분 데이터로 full PUT을 재구성하면 params/meta 유실 위험."""
   306	    m = await get_or_404(session, ModelConfig, model_id)
   307	    if m.kind not in ("chat", "embedding"):
   308	        # 레거시/수동 행 방어(codex 150) — 런타임은 chat/embedding 기본만 읽으므로 그 외 kind의
   309	        # "기본 지정 성공"은 아무 효과 없는 거짓 성공이 된다.
   310	        raise HTTPException(
   311	            status_code=400,
   312	            detail=f"kind={m.kind!r}는 기본 지정 대상이 아닙니다(chat/embedding만).",
   313	        )
   314	    await _clear_other_defaults(session, m.kind, exclude_id=m.id)
   315	    m.is_default = True
   316	    await _commit_or_409(
   317	        session, "동시에 다른 기본 지정이 있었습니다 — 새로고침 후 다시 시도하세요."
   318	    )
   319	    reloaded = await _get_with_provider(session, m.id)
   320	    assert reloaded is not None  # 방금 커밋한 행의 재로드 — 동시 삭제 레이스 외엔 불가
   321	    return model_to_out(reloaded)
