   100	/* Temperature 컨트롤(스펙 077) — 직접형·노드형 세부가 공유(287 후속: 노드형도 소비 실측으로 복귀).
   101	   null=자동(모델 등록 params), 켜면 0–2 수동. */
   102	function TemperatureField({ value, onChange, hint }: { value: number | null; onChange: (v: number | null) => void; hint?: string }) {
   103	  return (
   104	    <Field
   105	      group
