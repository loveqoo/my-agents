    60	async def _registry_chat_model(db: AsyncSession, name: str) -> ModelConfig | None:
    61	    """레지스트리 chat 모델 단건 조회(name, kind=chat, provider 상속) — 해석 3경로 공유 조회."""
    62	    return (
    63	        await db.execute(
    64	            select(ModelConfig)
    65	            .where(ModelConfig.name == name, ModelConfig.kind == "chat")
    66	            .options(selectinload(ModelConfig.provider))
    67	        )
    68	    ).scalar_one_or_none()
    69	
    70	
    71	async def _default_chat_registry(db: AsyncSession) -> ModelConfig | None:
    72	    """기본(is_default) chat 모델 조회 — 저장 설정 미지정/미등록의 graceful 폴백 대상."""
    73	    return (
    74	        (
    75	            await db.execute(
    76	                select(ModelConfig)
    77	                .where(ModelConfig.kind == "chat", ModelConfig.is_default.is_(True))
    78	                .options(selectinload(ModelConfig.provider))
    79	            )
    80	        )
    81	        .scalars()
    82	        .first()
    83	    )
