   146	# 설정 오버라이드 화이트리스트는 서술자 목록(agent.capabilities)에서 **파생**한다(스펙 409 —
   147	# 하드코딩 두 곳 소멸, 설정 추가=서술자 한 줄). 캐스케이드: 모델 params 기본 → 에이전트
   148	# config.modelParams → 노드 modelParams(노드형) → 세션 오버라이드. 능력(capabilities)은 층에 없다
   149	# (사실은 불가침). temperature는 제외 — AgentConfig.temperature(스펙 077)가 이미 에이전트 층 정본.
   150	MODEL_PARAM_OVERRIDE_KEYS = SETTING_KEYS
   151	
   152	
   153	def _apply_agent_model_params(model_cfg: dict, cfg: dict) -> dict:
   154	    """모델 params 위에 에이전트/노드 modelParams(화이트리스트만)를 덮는다 — 미명시 키는 상속."""
   155	    agent_mp = cfg.get("modelParams") or {}
   156	    if not isinstance(agent_mp, dict) or not agent_mp:
   157	        return model_cfg
   158	    merged = dict(model_cfg.get("params") or {})
   159	    for key in MODEL_PARAM_OVERRIDE_KEYS:
   160	        if key in agent_mp and agent_mp[key] is not None:
   161	            merged[key] = agent_mp[key]
   162	    return {**model_cfg, "params": merged}
