    98	async def _chat_model_cfg(db: AsyncSession, name: str, pins: dict | None = None) -> dict | None:
    99	    """레지스트리 chat 모델(name→provider 상속) 해석 — pin 우선(스펙 370), 미존재/불완전이면 None."""
   100	    pinned = await _pinned_model_cfg(db, pins, name)
   101	    if pinned is not None:
   102	        return pinned
   103	    m = await _registry_chat_model(db, name)
   104	    if model_usable(m):
   105	        return {**llm_cfg_of(m), "params": dict(m.params or {})}
   106	    return None
