   100	const post = (p: string, body?: unknown) =>
   101	  j(p, { method: 'POST', body: body === undefined ? undefined : JSON.stringify(body) })
   102	const put = (p: string, body: unknown) => j(p, { method: 'PUT', body: JSON.stringify(body) })
   103	const patch = (p: string, body: unknown) => j(p, { method: 'PATCH', body: JSON.stringify(body) })
   104	const del = (p: string) => j<void>(p, { method: 'DELETE' })
