    29	  modelParams: Record<string, boolean | undefined> // 세션 층 모델 설정 오버라이드(스펙 409) — 최상위 층
    30	  /** 노드형 노드 필드 오버라이드(스펙 287) — 구조 불변(개수·순서·이름은 서버가 저장본 유지). */
