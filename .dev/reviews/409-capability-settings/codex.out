    72	/* ---------- 배경 잡 이벤트(SSE, 스펙 335) ---------- */
    73	export interface IngestEvent {
    74	  type: 'ingest'
    75	  status: 'ready' | 'error'
    76	  filename: string
    77	  collection: string
    78	  document_id: string
    79	  collection_id: string
    80	  chunks?: number
    81	  error?: string
    82	}
    83	/** 전역 이벤트 스트림 구독 — EventSource(쿠키 동행·자동 재연결). 반환값 호출=구독 해제.
    84	 *  이벤트는 알림이지 진실이 아니다(끊긴 동안 발생분 유실 — 상태의 진실은 문서 status).
    85	 *  경계(codex 335): EventSource는 Authorization 헤더를 못 실어 **VITE_API_TOKEN 단독 모드에선
    86	 *  알림만 미동작**(쿠키 로그인 UI는 정상, 나머지 기능 무영향 — 세션 만료 시 브라우저가 재시도를
    87	 *  멈추고 재로그인 후 AdminShell 재마운트가 새로 구독). */
    88	export function openEventStream(onEvent: (ev: IngestEvent) => void): () => void {
    89	  const es = new EventSource(`${BASE}/events`, { withCredentials: true })
    90	  es.onmessage = (m) => {
    91	    try {
    92	      onEvent(JSON.parse(m.data) as IngestEvent)
    93	    } catch {
    94	      /* 형식 밖 프레임 무시(heartbeat는 comment라 onmessage에 안 온다) */
    95	    }
    96	  }
    97	  return () => es.close()
    98	}
