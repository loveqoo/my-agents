    34	/* 에이전트 저장 설정에서 패널 기본값을 만든다. Agent엔 temperature 필드가 없어 자동(null).
    35	   tools 구저장 하이드레이션(스펙 276)은 컴포넌트가 blocks 카탈로그로 수행(여기선 저장값 그대로). */
    36	export function overrideDefaults(a: Agent): Overrides {
    37	  return {
    38	    model: a.model ?? '',
    39	    temperature: null,
    40	    systemPrompt: a.systemPrompt ?? '',
    41	    mcps: [...(a.mcps ?? [])],
    42	    tools: [...(a.tools ?? [])],
    43	    memories: [...(a.memories ?? [])],
    44	    capabilities: [...(a.capabilities ?? [])],
    45	    historyDepth: a.historyDepth ?? 20,
    46	    modelParams: { ...(a.modelParams ?? {}) }, // 세션 베이스=에이전트 저장 설정(변경분만 전송)
    47	
    48	    // 노드형(스펙 287→316) — 베이스는 **해석된 유효 노드**(resolvedNodes: 참조를 등록 config로 치환한
    49	    // 파생, 서버도 해석→병합 순서라 인덱스 정렬 일치). resolvedNodes가 없으면(구 응답) 저장 nodes로
    50	    // 폴백하되, 참조 항목이 남아 있으면(미해결) 편집 불가 — undefined로 두고 패널이 Alert로 안내.
    51	    // 깊은 복사: 에디터가 필드를 편집해도 원본 불변.
    52	    nodes: (() => {
    53	      if (a.impl !== 'pipeline') return undefined
    54	      const base = a.resolvedNodes ?? a.nodes
    55	      if (!base || base.some(isNodeRef)) return undefined
    56	      return structuredClone(base as PipelineNode[])
    57	    })(),
    58	  }
    59	}
    60	
    61	const sameSet = (a: string[], b: string[]) =>
    62	  a.length === b.length && [...a].sort().join('\n') === [...b].sort().join('\n')
    63	
    64	/* 적용된 오버라이드를 에이전트 기본값과 비교해 **변경된 키만** 담은 전송 페이로드.
    65	   비어 있으면(=변경 없음) 호출부가 overrides를 안 보내 저장 설정 그대로 실행(무회귀).
    66	   catalog(스펙 287): 노드형 노드가 바뀌면 풀(mcps/vectorTables/memories)을 파생해 동봉해야
    67	   실효(백엔드 ctx.tools/rag가 풀에서 빌드) — 폼 저장과 같은 derivePipelinePool 단일 출처. */
    68	export function overridePayload(
    69	  applied: Overrides,
    70	  base: Overrides,
    71	  catalog?: { mcpItems: { name: string; tools?: string[] }[]; collections: { name: string }[] },
    72	): Record<string, unknown> {
    73	  const p: Record<string, unknown> = {}
    74	  if (applied.model && applied.model !== base.model) p.model = applied.model
    75	  if (applied.temperature != null && applied.temperature !== base.temperature) p.temperature = applied.temperature
    76	  // 빈 systemPrompt로 prompt를 지우지 않도록 — 비어있지 않고 달라진 경우만.
    77	  if (applied.systemPrompt.trim() && applied.systemPrompt !== base.systemPrompt) p.systemPrompt = applied.systemPrompt
    78	  if (!sameSet(applied.mcps, base.mcps)) p.mcps = applied.mcps
    79	  // 도구 단위 배선(스펙 276) — tools가 달라지면 mcps(서버 로드 원천)도 함께 보낸다(토글이 파생 유지).
    80	  if (!sameSet(applied.tools, base.tools)) p.tools = applied.tools
    81	  if (!sameSet(applied.memories, base.memories)) p.memories = applied.memories
    82	  // 조율형 위임 대상(스펙 122) — 변경 시만 전송. 안 건드리면 저장분 그대로(무회귀).
    83	  if (!sameSet(applied.capabilities, base.capabilities)) p.capabilities = applied.capabilities
    84	  if (applied.historyDepth !== base.historyDepth) p.historyDepth = applied.historyDepth
    85	  // 세션 층 모델 설정(스펙 409) — 저장분과 다르면 전송(빈 객체로 되돌려도 명시 전송해 상속 복귀 반영).
    86	  if (JSON.stringify(applied.modelParams) !== JSON.stringify(base.modelParams)) p.modelParams = applied.modelParams
    87	  // 노드형(스펙 287) — 노드 필드가 바뀌면 nodes(서버가 구조 불변 merge) + 파생 풀 동봉.
    88	  if (applied.nodes && base.nodes && JSON.stringify(applied.nodes) !== JSON.stringify(base.nodes)) {
    89	    p.nodes = applied.nodes
    90	    if (catalog) {
    91	      const pool = derivePipelinePool(applied.nodes, catalog.mcpItems, catalog.collections)
    92	      p.mcps = pool.mcps
    93	      p.vectorTables = pool.vectorTables
    94	      p.memories = pool.memories
    95	    }
    96	  }
    97	  return p
    98	}
