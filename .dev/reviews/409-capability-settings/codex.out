   275	@router.put("/{model_id}", response_model=ModelOut, dependencies=[_manage])
   276	async def update_model(
   277	    model_id: uuid.UUID, body: ModelIn, session: AsyncSession = Depends(get_session)
   278	) -> ModelOut:
   279	    m = await get_or_404(session, ModelConfig, model_id)
   280	    await _require_provider(session, body.provider_id)
   281	    m.name = body.name
   282	    m.provider_id = body.provider_id
   283	    m.model_id = body.model_id
   284	    m.kind = body.kind
   285	    if body.is_default:
   286	        await _clear_other_defaults(session, body.kind, exclude_id=m.id)
   287	    m.is_default = body.is_default
   288	    m.params = body.params
   289	    m.capabilities = body.capabilities  # 능력 선언(스펙 408)
   290	    m.meta = body.meta
   291	    # is_default·meta는 payload 제외(스펙 369 §2) — 운영-only 변경은 버전 무증가.
   292	    await record_block_version(session, "model", m)
   293	    await _commit_or_409(session, "동시 변경 충돌 또는 중복 — 다시 시도하세요.")
   294	    reloaded = await _get_with_provider(session, m.id)
