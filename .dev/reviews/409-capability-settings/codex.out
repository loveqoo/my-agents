    70	    capabilities: dict[str, Any] = Field(
    71	        default_factory=lambda: dict(DEFAULT_CAPABILITIES)
    72	    )
    73	    meta: dict[str, Any] = Field(default_factory=dict)  # models.dev 카탈로그 메타(스펙 047 #7)
