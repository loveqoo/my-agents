   106	/* ---------- 인증 (세션 쿠키, 스펙 031) ---------- */
   107	export interface Me {
   108	  id: string
   109	  email: string
   110	  is_active: boolean
   111	  is_superuser: boolean
   112	  is_verified: boolean
   113	  source: string
   114	  display_name: string | null
