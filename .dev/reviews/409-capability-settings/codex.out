   806	}
   807	
   808	export interface ChatCallbacks {
   809	  onToken: (t: string) => void
   810	  onSession?: (sessionId: string) => void
   811	  onTrace?: (trace: Record<string, unknown>) => void
   812	  // 위험 도구가 그래프를 멈춰 승인 대기 프레임({text, approval, approver})이 오면 승인 id를 넘긴다(179).
   813	  // 요청자 UI가 이 id로 승인 상태를 폴링해, 해소되면 재개 결과를 세션에서 불러온다(라이브 push 부재 보완).
   814	  // approver(admin/self, 스펙 180)로 대화 내 인라인 승인 가능 여부를 판정한다.
   815	  onApproval?: (approvalId: string, approver?: string) => void
   816	  // 산출물형 폼 프레임(스펙 188) — 채팅에 폼을 렌더하고, 제출은 streamChat의 form 파라미터로.
   817	  onForm?: (formId: string, form: ChatFormFrame) => void
   818	  // 산출물 완성 프레임(스펙 188) — 임베드 시 JS 콜백이 받을 페이로드 그대로.
   819	  onArtifact?: (artifact: ChatArtifact) => void
   820	  // 저장된 assistant 메시지 id(스펙 209 P1.5) — 이 응답에 피드백(👍/👎)을 부착하기 위해.
   821	  onMessageId?: (id: string) => void
   822	  // 턴 논리 완료([DONE]) — 스펙 314: 스트림은 이후에도 열려 있을 수 있어(백그라운드 기억 저장 완료
   823	  // 이벤트 대기), 스피너 해제 등 '완료' 처리는 이 콜백으로 한다(스트림 종료가 아님).
   824	  onDone?: () => void
   825	  // 백그라운드 자동 기억 저장 완료(스펙 314) — done 뒤 트레일링. mid로 그 턴을 조용히 패치.
   826	  onMemory?: (mid: string, memorySaved: unknown) => void
   827	}
   828	
   829	function handleFrame(frame: string, cb: ChatCallbacks): boolean {
   830	  const lines = frame.split('\n')
   831	  const event = lines.find((l) => l.startsWith('event: '))?.slice(7)
   832	  const dataLine = lines.find((l) => l.startsWith('data: '))
   833	  if (!dataLine) return false
   834	  const data = dataLine.slice(6)
   835	  // 스펙 314: [DONE]은 '턴 논리 완료'일 뿐 스트림 종료가 아니다 — 이후 트레일링 event: memory가 올 수
   836	  // 있어 계속 읽는다(리더는 서버가 스트림을 닫을 때/abort 시 끝난다). 완료 처리는 onDone로.
   837	  if (data === '[DONE]') {
   838	    cb.onDone?.()
   839	    return false
   840	  }
   841	  try {
   842	    const parsed = JSON.parse(data)
   843	    if (event === 'trace') cb.onTrace?.(parsed)
   844	    else if (event === 'memory' && typeof parsed.mid === 'string') cb.onMemory?.(parsed.mid, parsed.memorySaved)
   845	    else if (event === 'message_id' && typeof parsed.id === 'string') cb.onMessageId?.(parsed.id)
   846	    else if (typeof parsed.text === 'string') cb.onToken(parsed.text)
   847	    else if (typeof parsed.session === 'string') cb.onSession?.(parsed.session)
   848	    else if (typeof parsed.error === 'string') cb.onToken(`\n[오류] ${parsed.error}`)
   849	    // 승인 대기 프레임은 text와 approval을 함께 실어 온다 — text는 위에서 토큰으로 표시하고,
   850	    // approval id는 별도로 표면화(else-if 아님)해 요청자 폴링을 트리거한다(스펙 179).
   851	    if (typeof parsed.approval === 'string')
   852	      cb.onApproval?.(parsed.approval, typeof parsed.approver === 'string' ? parsed.approver : undefined)
   853	    // 산출물형 프레임(스펙 188) — form(입력 요청)·artifact(완성 페이로드).
   854	    if (parsed.form && typeof parsed.formId === 'string') cb.onForm?.(parsed.formId, parsed.form)
   855	    if (parsed.artifact && typeof parsed.artifact.kind === 'string') cb.onArtifact?.(parsed.artifact)
   856	  } catch {
   857	    /* 비-JSON 프레임 무시 */
   858	  }
   859	  return false
   860	}
