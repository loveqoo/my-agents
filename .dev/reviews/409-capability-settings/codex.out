   198	async def _resolve_mem_cfg(db: AsyncSession, model_cfg: dict | None) -> dict | None:
   199	    """mem0용 모델 설정(레지스트리) — llm=해석된 chat 모델, embedder=기본 embedding 모델.
   200	
   201	    임베딩 모델이 없으면 None → 메모리 비활성(graceful)."""
   202	    if not model_cfg:
   203	        return None
   204	    emb = (
   205	        (
   206	            await db.execute(
   207	                select(ModelConfig)
