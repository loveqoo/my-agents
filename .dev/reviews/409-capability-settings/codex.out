    62	          <Flex vertical gap={2} key={d.cap}>
    63	            <Text style={{ fontSize: 13, fontWeight: 600 }}>{d.label}</Text>
    64	            <Select
    65	              size={size}
    66	              style={{ width: 220 }}
    67	              value={cur}
    68	              onChange={(v) => {
    69	                const mp = { ...value }
    70	                if (v === 'inherit') delete mp[key]
    71	                else mp[key] = v === 'on'
    72	                onChange(mp)
    73	              }}
    74	              options={[
    75	                { value: 'inherit', label: `모델 기본(상속 — ${inh ? '켬' : '끔'})` },
    76	                { value: 'on', label: '켬', disabled: !capable },
    77	                { value: 'off', label: '끔' },
    78	              ]}
