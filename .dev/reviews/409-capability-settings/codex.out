     1	"""능력→설정 서술자 단일 정본(스펙 409).
     2	
     3	능력(capability)=모델이 선언하는 사실(불가침) / 설정(usage)=능력에서 파생하는 요청별 조정값.
     4	**이 목록 하나**가 백엔드 화이트리스트·유효값 계산·유효성·admin 4화면(모델·에이전트·플레이그라운드·
     5	노드)을 전부 구동한다. 설정을 추가하려면 이 목록에 **한 줄**만 더하면 된다(스펙 408이 키 두 개를
     6	다섯 곳에 하드코딩해 "설정마다 재구현"이 된 뿌리를 교정 — 회고 261 "사본이면 드리프트"의 설정 축 판).
     7	
     8	agent 패키지에 둔 이유: agent(model.py)와 api가 모두 임포트해야 하는데 agent가 하위 층이라 순환이
     9	없다(api→agent 단방향). SDK 배선(ChatOpenAI 인자 매핑)만 build_chat_openai가 축별로 갖고, 그 외
    10	파생은 전부 여기서 나온다.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	from dataclasses import dataclass
    16	
    17	
    18	@dataclass(frozen=True)
    19	class CapabilityDescriptor:
    20	    """능력 하나와 그로부터 파생하는 요청별 설정.
    21	
    22	    - cap: `ModelConfig.capabilities` JSONB 키(사실, 불가침).
    23	    - setting: 요청별 조정 키(usage). None이면 **능력만** 있는 축(요청별 토글 없음 — 예 vision).
    24	    - label: admin UI 라벨.
    25	    - default: 모델 층 설정 기본값(설정 있는 축만 의미) — 미명시 상속의 바닥.
    26	    - cap_default: 능력 기본값(신규 모델·누락 보정) — 마이그레이션 server_default와 단일 출처.
    27	    """
    28	
    29	    cap: str
    30	    setting: str | None
    31	    label: str
    32	    default: bool
    33	    cap_default: bool
    34	
    35	
    36	# 정본 목록 — 여기에 한 줄 = 4화면+백엔드 전체 반영. vision은 능력만(요청별 설정 없음 — 첨부/비전
    37	# 처리는 별 축, 스펙 408 OUT). streaming/thinking은 요청별로 켜고 끌 수 있는 설정을 가진다.
    38	CAPABILITY_SETTINGS: tuple[CapabilityDescriptor, ...] = (
    39	    CapabilityDescriptor("streaming", "stream", "스트리밍", True, True),
    40	    CapabilityDescriptor("thinking", "enable_thinking", "Thinking 모드", False, False),
    41	    CapabilityDescriptor("vision", None, "비전(이미지)", False, False),
    42	)
    43	
    44	_BY_CAP: dict[str, CapabilityDescriptor] = {d.cap: d for d in CAPABILITY_SETTINGS}
    45	
    46	# 요청별 조정 가능한 설정 키(화이트리스트 파생) — 에이전트/노드/세션 오버라이드는 이 집합만 수용.
    47	SETTING_KEYS: tuple[str, ...] = tuple(d.setting for d in CAPABILITY_SETTINGS if d.setting)
    48	
    49	# 능력 기본값 dict(신규 모델·누락 보정) — 마이그레이션 server_default와 같은 값이어야 한다.
    50	DEFAULT_CAPABILITIES: dict[str, bool] = {d.cap: d.cap_default for d in CAPABILITY_SETTINGS}
    51	
    52	
    53	def resolve_effective(cap: str, capabilities: dict, *layers: dict) -> bool:
    54	    """유효값 = **능력 AND 설정**(스펙 409 원칙 — 능력 false면 어느 층도 못 켬, 부분집합 불가침).
    55	
    56	    설정값은 층을 **뒤에서 앞으로**(우선순위 높은 층이 뒤) 훑어 처음 명시된 값을 취하고, 없으면
    57	    서술자 default. layers 예: build_chat_openai에서 `(params, cfg_params)` — 호출자(세션)가 최우선.
    58	    """
    59	    d = _BY_CAP[cap]
    60	    capable = bool(capabilities.get(cap, d.cap_default))
    61	    want = d.default
    62	    if d.setting is not None:
    63	        for layer in layers:
    64	            if layer and d.setting in layer and layer[d.setting] is not None:
    65	                want = bool(layer[d.setting])
    66	                break
    67	    return capable and bool(want)
    68	
    69	
    70	def descriptors_public() -> list[dict]:
    71	    """admin 공급용 서술자(GET /model-capabilities/descriptors) — FE가 이걸 받아 4화면을 렌더.
    72	
    73	    FE/BE 드리프트 0(사본 금지). setting=None 축은 그대로 실어 FE가 '능력만' 블록으로 구분한다.
    74	    """
    75	    return [
    76	        {
    77	            "cap": d.cap,
    78	            "setting": d.setting,
    79	            "label": d.label,
    80	            "default": d.default,
    81	            "capDefault": d.cap_default,
    82	        }
    83	        for d in CAPABILITY_SETTINGS
    84	    ]
    45	    cfg: dict | None,
    46	    params: dict | None = None,
    47	    *,
    48	    default_temperature: float = 0.7,
    49	    on_missing: str = "raise",
    50	    error_label: str = _MISSING_MSG,
    51	) -> ChatOpenAI | None:
    52	    """model_cfg → ChatOpenAI. base_url/model_id 없으면 `on_missing`: "raise"(기본)면 명확히 실패,
    53	    "none"이면 None 반환(모델 없이도 도는 경로용 — artifact ask-only). temperature 우선순위:
    54	    호출자 params > 모델 등록 params > `default_temperature`."""
    55	    cfg = cfg or {}
    56	    base_url = cfg.get("base_url") or ""
    57	    model_id = cfg.get("model_id") or ""
    58	    if not base_url or not model_id:
    59	        if on_missing == "none":
    60	            return None
    61	        raise RuntimeError(error_label)
    62	    cfg_params = cfg.get("params") or {}
    63	    params = params or {}
    64	    temperature = params.get("temperature", cfg_params.get("temperature", default_temperature))
    65	    # 능력→설정 유효값(스펙 409): 서술자 목록(capabilities.py) 단일 정본이 "능력 AND 설정"을 계산.
    66	    # 층 우선순위=호출자 params(세션) > cfg params(모델·에이전트·노드 병합). 능력 false면 어느 층도
    67	    # 못 켠다(부분집합 불가침) — streaming뿐 아니라 thinking도 능력 게이트(408은 thinking 미게이트였음).
    68	    # SDK 배선만 축별로 다르다: stream→disable_streaming, enable_thinking→extra_body(그 매핑이 유일한
    69	    # 축별 코드). 스트리밍 꺼짐=LangChain이 astream을 ainvoke로 접어 완성문 1회 yield(SSE 계약 유지).
    70	    caps = cfg.get("capabilities") or {}
    71	    stream_effective = resolve_effective("streaming", caps, params, cfg_params)
    72	    enable_thinking = resolve_effective("thinking", caps, params, cfg_params)
    73	    api_key = cfg.get("api_key") or "sk-noauth"
    74	    # 클라이언트 풀(스펙 371 D2) — 같은 연결·모델·파라미터면 인스턴스 재사용(ChatOpenAI는 호출간
    75	    # 무상태·async-safe). 목적은 생성 비용(~0.1ms)이 아니라 **커넥션 재사용**(실 프로바이더 TLS
    76	    # 핸드셰이크 — mock 루프백 사각지대). 키에 api_key 지문 포함 → 로테이션=새 인스턴스.
    77	    # 루프별 격리 — httpx async 클라이언트는 자기 이벤트 루프에 묶인다. 서버는 루프 하나라 늘
    78	    # 적중하고, 루프를 새로 여는 컨텍스트(in-process 테스트의 asyncio.run 반복)는 루프마다 새
    79	    # 인스턴스(죽은 루프의 엔트리는 LRU가 축출). 루프 밖(동기)이면 풀 미사용.
    80	    try:
    81	        loop_id = id(asyncio.get_running_loop())
    82	    except RuntimeError:
    83	        loop_id = None
    84	    key = (
    85	        loop_id,
    86	        base_url,
    87	        hashlib.sha256(api_key.encode()).hexdigest()[:8],
    88	        model_id,
    89	        temperature,
    90	        enable_thinking,
    91	        stream_effective,  # 스트리밍 모드가 다르면 다른 클라이언트(풀 키 분리 — 스펙 408)
    92	    )
    93	    pooled = _CLIENT_POOL.get(key) if loop_id is not None else None
    94	    if pooled is not None:
    95	        return pooled
    96	    client = ChatOpenAI(
    97	        base_url=base_url,
    98	        api_key=api_key,
    99	        model=model_id,
   100	        temperature=temperature,
   101	        # 능력 없음/사용 끔 → astream이 ainvoke로 접혀 완성문 1회 yield(비스트리밍 안전 실행).
   102	        disable_streaming=not stream_effective,
   103	        extra_body={"chat_template_kwargs": {"enable_thinking": enable_thinking}},
   104	    )
   105	    if loop_id is not None:
   106	        if len(_CLIENT_POOL) >= _CLIENT_POOL_MAX:
   107	            _CLIENT_POOL.pop(next(iter(_CLIENT_POOL)))  # 최고령 축출(삽입순)
   108	        _CLIENT_POOL[key] = client
   109	    return client
     1	"""모델·mem0 설정 해석 — chat_context.py에서 분할(스펙 394 P3).
