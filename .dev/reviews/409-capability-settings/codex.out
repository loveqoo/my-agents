   546	            // 적용 전에 구조가 어떻게 되는지 즉시 보인다. 순환은 빨간 마커(실행 시 자동 차단).
   547	            <div style={{ border: '1px solid var(--color-border-secondary)', borderRadius: 8, padding: '10px 14px' }}>
   548	              <div style={{ fontSize: 12, color: 'var(--color-text-tertiary)', marginBottom: 6 }}>위임 구조 미리보기</div>
   549	              <DelegationGraph rootAgentId={agent.agentId} agents={agents} rootCapsOverride={draft.capabilities} />
