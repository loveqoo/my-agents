   552	          <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
   553	
   554	          {/* 세부(스펙 249: 단계가 이미 구획이라 Collapse 해제·평면 나열) — Temperature·채팅 히스토리. */}
   555	          <TemperatureField value={draft.temperature} onChange={(v) => set('temperature', v)} />
   556	          {/* 세션 층 모델 설정(스펙 409) — 이 대화에서만 스트리밍/thinking을 덮는다(최상위 층). */}
   557	          <Field label="모델 설정">
