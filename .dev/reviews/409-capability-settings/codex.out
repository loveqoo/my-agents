   102	/* ── 프로바이더 등록/수정 모달 (kind·description 포함) ───────────────────────── */
   103	interface ProviderForm {
   104	  name: string
   105	  kind: ProviderKind
   106	  description: string
   107	  protocol: string
   108	  base_url: string
   109	  api_key: string
   110	}
   111	const blankProvider: ProviderForm = {
   112	  name: '',
   113	  kind: 'remote',
   114	  description: '',
   115	  protocol: 'openai-compatible',
   116	  base_url: '',
   117	  api_key: '',
   118	}
   119	
   120	function ProviderModal({
   121	  open,
   122	  editing,
   123	  onCancel,
   124	  onSubmit,
   125	}: {
   126	  open: boolean
   127	  editing: Provider | null
   128	  onCancel: () => void
   129	  onSubmit: (data: ProviderForm) => void
   130	}) {
   131	  const [f, setF] = useState<ProviderForm>(blankProvider)
   132	  const [testing, setTesting] = useState(false)
   133	  const [probe, setProbe] = useState<ModelProbeResult | null>(null)
   134	
   135	  useEffect(() => {
   136	    if (open) {
   137	      setF(
   138	        editing
   139	          ? {
   140	              name: editing.name,
   141	              kind: editing.kind,
   142	              description: editing.description,
   143	              protocol: editing.protocol,
   144	              base_url: editing.base_url,
   145	              api_key: editing.api_key ?? '',
   146	            }
   147	          : blankProvider,
   148	      )
   149	      setProbe(null)
   150	    }
   151	  }, [open, editing])
   152	
   153	  const set = <K extends keyof ProviderForm>(k: K, v: ProviderForm[K]) => {
   154	    setProbe(null)
   155	    setF((s) => ({ ...s, [k]: v }))
   156	  }
   157	
   158	  const runTest = async () => {
   159	    setTesting(true)
   160	    setProbe(null)
   161	    try {
   162	      setProbe(await testProviderConfig({ base_url: f.base_url, api_key: f.api_key }))
   163	    } catch (e) {
   164	      setProbe({
   165	        ok: false, reachable: false, modelAvailable: false, latencyMs: 0,
