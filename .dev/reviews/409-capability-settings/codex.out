   211	        )
   212	        .scalars()
   213	        .first()
   214	    )
   215	    if emb is None or emb.provider is None:
   216	        return None
   217	    return {
   218	        "llm": {
   219	            "base_url": model_cfg["base_url"],
   220	            "api_key": model_cfg["api_key"],
   221	            "model_id": model_cfg["model_id"],
   222	        },
   223	        "embedder": llm_cfg_of(emb),
   224	    }
