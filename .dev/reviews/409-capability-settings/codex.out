    86	def _model_cfg_from_row(m: ModelConfig) -> dict:
    87	    """모델 행 → model_cfg dict — 불완전(provider base_url/model_id 부재)은 400(명확한 안내)."""
    88	    base_url = m.provider.base_url if m.provider else ""
    89	    if not base_url or not m.model_id:
    90	        raise HTTPException(
    91	            status_code=400,
    92	            detail=f"모델 '{m.name}' 설정이 불완전합니다 (provider base_url/model_id 필요).",
    93	        )
    94	    # 등록 없음·설정 불완전이 각각 다른 에러 메시지라 model_usable로 접지 않음 — dict만 정본화.
    95	    return {**llm_cfg_of(m), "params": dict(m.params or {})}
