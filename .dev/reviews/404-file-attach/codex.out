    18	from . import rag_ingest
    19	from .memory import _sanitize
    20	from .schemas import ChatRequest
    21	
    22	log = logging.getLogger("api.chat_attachments")
    23	
    24	router: APIRouter = APIRouter(prefix="/chat", tags=["attachments"])
    25	
    26	RAW_CAP = 5 * 1024 * 1024  # 파일당 5MB(승인값) — raw 바이트에서 누적 검사
    27	TEXT_CAP = 30_000  # 파일당 추출 텍스트 3만자(승인값) — 초과는 앞부분+잘림 명시
    28	COUNT_CAP = 3  # 턴당 첨부 수(승인값)
    29	
    30	
    31	class AttachmentOut(BaseModel):
    32	    filename: str
    33	    text: str  # 추출 전문(캡 적용) — 클라이언트가 ChatRequest.attachments로 되보낸다
    34	    chars: int
    35	    truncated: bool  # 3만자 캡으로 잘렸는가(UI가 정직하게 표시)
    36	
    37	
    38	@router.post("/attachments", response_model=AttachmentOut)
    39	async def extract_attachment(file: UploadFile) -> AttachmentOut:
    40	    """파일 → 평문 추출(무상태). txt/md/텍스트류=UTF-8, pdf=pypdf — 이미지 PDF·바이너리는 400.
    41	
    42	    raw 캡은 **읽으면서 누적**으로 검사한다(learning: .content 위 카운트는 막은 척 —
    43	    Content-Length 신뢰 금지, 5MB 초과 시점에 즉시 413).
    44	    """
    45	    data = bytearray()
    46	    while chunk := await file.read(64 * 1024):
    47	        data += chunk
    48	        if len(data) > RAW_CAP:
    49	            raise HTTPException(
    50	                status_code=413,
    51	                detail=f"파일이 너무 큽니다 — 첨부는 파일당 {RAW_CAP // (1024 * 1024)}MB까지입니다.",
    52	            )
    53	    if not data:
    54	        raise HTTPException(status_code=400, detail="빈 파일입니다.")
    55	    try:
    56	        text = rag_ingest.extract_text(file.filename or "", file.content_type, bytes(data))
    57	    except rag_ingest.IngestError as exc:
    58	        raise HTTPException(
    59	            status_code=400,
    60	            detail=f"텍스트를 추출할 수 없습니다({exc}) — txt·md·pdf(텍스트) 형식만 지원합니다.",
    61	        ) from exc
    62	    text = text.strip()
    63	    if not text:
    64	        raise HTTPException(
    65	            status_code=400, detail="추출된 텍스트가 없습니다(이미지 PDF·빈 문서는 지원 밖)."
    66	        )
    67	    truncated = len(text) > TEXT_CAP
    68	    if truncated:
    69	        text = text[:TEXT_CAP]
    70	    return AttachmentOut(
    71	        filename=(file.filename or "(이름 없음)")[:200],
    72	        text=text,
    73	        chars=len(text),
    74	        truncated=truncated,
    75	    )
    76	
    77	
    78	def apply_attachments(body: ChatRequest) -> list[dict] | None:
    79	    """첨부를 마지막 user 메시지에 경계 블록으로 주입 — 반환: trace용 메타(없으면 None).
    80	
    81	    캡 재강제 지점(단일 관문): 추출 엔드포인트를 안 거친 클라이언트가 임의 텍스트를 보내도
    82	    여기서 개수·길이를 다시 자른다. 주입 후의 content가 그대로 영속·히스토리 재구성에 쓰인다.
    83	    """
    84	    atts = body.attachments or []
    85	    if not atts:
    86	        return None
    87	    if len(atts) > COUNT_CAP:
    88	        raise HTTPException(
    89	            status_code=422, detail=f"첨부는 턴당 {COUNT_CAP}개까지 보낼 수 있습니다."
    90	        )
    91	    if not body.messages or body.messages[-1].role != "user":
    92	        raise HTTPException(status_code=422, detail="첨부는 user 메시지와 함께 보내야 합니다.")
    93	    blocks: list[str] = []
    94	    meta: list[dict] = []
    95	    for a in atts:
    96	        text = a.text[:TEXT_CAP]  # 재강제(추출 캡과 동일 상한)
    97	        name = a.filename[:200]
    98	        blocks.append(f"[첨부 문서: {name}]\n{text}\n[첨부 끝]")
    99	        # 프리뷰는 캡+비밀 마스킹(trace 누출 규율 087/092/125 — resultPreview와 동일).
   100	        meta.append({"filename": name, "chars": len(text), "preview": _sanitize(text, cap=200)})
   101	    body.messages[-1].content = "\n\n".join([*blocks, body.messages[-1].content])
   102	    return meta
     1	"""RAG 인제스트 파이프라인 헬퍼 — 파싱 → 청킹 → 임베딩 (스펙 036).
     2	
     3	쓰기 경로만 담당. retrieval(질의·유사도 검색)은 037.
     4	- 파싱: PDF는 pypdf, 그 외는 UTF-8 텍스트로 디코드.
     5	- 청킹: langchain RecursiveCharacterTextSplitter(컬렉션별 chunk_size/overlap).
     6	- 임베딩: OpenAI 호환 `/embeddings` 배치 호출(provider base_url/복호화 키).
     7	"""
     8	
     9	import io
    10	import os
    11	
    12	import httpx
    13	from langchain_text_splitters import RecursiveCharacterTextSplitter
    14	
    15	
    16	class IngestError(Exception):
    17	    """인제스트 실패 — 메시지를 Document.error에 보존(no silent death)."""
    18	
    19	
    20	def _reject_nonstandard_const(name: str) -> None:
    21	    """json.loads parse_constant 훅 — NaN/Infinity/-Infinity 거부(표준 JSON 아님·JSONB 저장 불가)."""
    22	    raise ValueError(f"비표준 JSON 상수({name})는 허용되지 않습니다")
    23	
    24	
    25	def is_pdf(filename: str, content_type: str | None) -> bool:
    26	    """PDF 판별(단일 출처) — 추출(extract_text)과 편집 가능 판정(스펙 331)이 같은 기준을 공유해야
    27	    'PDF인데 편집 허용' 같은 드리프트가 없다."""
    28	    return (content_type or "").lower().endswith("pdf") or filename.lower().endswith(".pdf")
    29	
    30	
    31	def extract_text(filename: str, content_type: str | None, data: bytes) -> str:
    32	    """업로드 바이트에서 평문 추출. PDF는 pypdf, 그 외는 UTF-8 디코드.
    33	
    34	    이미지 PDF·OCR·기타 형식(docx/html)은 범위 밖 — 텍스트가 안 나오면 IngestError.
    35	    """
    36	    if is_pdf(filename, content_type):
    37	        try:
    38	            from pypdf import PdfReader
    39	
    40	            reader = PdfReader(io.BytesIO(data))
    41	            pages = [(page.extract_text() or "") for page in reader.pages]
    42	        except Exception as exc:
    43	            raise IngestError(f"PDF 파싱 실패: {exc}") from exc
    44	        text = "\n\n".join(p for p in pages if p.strip())
    45	    else:
    46	        try:
    47	            text = data.decode("utf-8")
    48	        except UnicodeDecodeError as exc:
    49	            raise IngestError(
    50	                "UTF-8 텍스트로 디코드할 수 없습니다(지원 형식: PDF·UTF-8 텍스트)."
    51	            ) from exc
    52	    if not text.strip():
    53	        raise IngestError("문서에서 추출된 텍스트가 없습니다(이미지 전용 PDF 등은 미지원).")
    54	    return text
    55	
    56	
    57	# ----------------------------- 엔티티 인제스트 (스펙 149) -----------------------------
    58	# JSONL 행 단위: {"metadata": {...id들}, "data": {...임베딩 소스} | "문자열"} — 1행=1청크(분할 없음).
    59	def _env_int(name: str, default: int) -> int:
    60	    """env 정수 파싱 — 오타(비숫자)로 import-time 부팅 실패하지 않게 기본값 폴백(codex 334 P3)."""
    61	    try:
    62	        return max(1, int(os.environ.get(name, str(default))))
    63	    except ValueError:
    64	        return default
    65	
    66	
    67	# 파일당 행 수 캡 — 초과 시 400(조용한 축소 금지). 기본 50,000은 사용자 승인 수치(스펙 334,
    68	# 2026-07-14 — 구 5,000은 149 때 미승인 휴리스틱이라 재결정). env로 조정 가능.
    69	ENTITY_MAX_ROWS = _env_int("RAG_ENTITY_MAX_ROWS", 50000)
    70	ENTITY_MAX_TEXT_CHARS = 8000  # 행당 임베딩 텍스트 캡 — 초과 시 400(임베딩 입력 한계)
    71	ENTITY_MAX_META_CHARS = 2000  # 행당 metadata 직렬화 캡(codex 149 — 검색 응답 비대 방지)
    72	
    73	
    74	class EntityParseError(IngestError):
    75	    """엔티티 JSONL 형식 위반 — fail-closed(파일 전체 거부). 소스가 SQL 추출물이라 위반=파이프라인
    76	    버그이며, 부분 스킵은 비즈니스 데이터의 조용한 유실이다. 메시지에 행 번호를 포함한다."""
    77	
    78	
    79	def entity_text(data: object) -> str:
    80	    """임베딩 텍스트 직렬화 — 문자열은 그대로, 객체는 `key: value` 줄 평탄화(중첩 값은 JSON).
    81	    키 순서는 입력 순서 보존(사용자의 SELECT 컬럼 순서가 곧 의미 순서). 순수 함수."""
    82	    import json as _json
    83	
    84	    if isinstance(data, str):
    85	        return data.strip()
    86	    if isinstance(data, dict):
    87	        lines = []
    88	        for k, v in data.items():
    89	            if isinstance(v, (dict, list)):
    90	                v = _json.dumps(v, ensure_ascii=False)
    91	            lines.append(f"{k}: {v}")
    92	        return "\n".join(lines).strip()
    93	    return ""
    94	
    95	
    96	def parse_entity_lines(raw: bytes, schema: dict | None = None) -> list[tuple[str, dict]]:
    97	    """JSONL 바이트 → [(임베딩 텍스트, metadata)] — fail-closed(위반 행=EntityParseError, 행 번호 포함).
    98	
    99	    행 계약: JSON 객체 + `metadata`(객체) + `data`(객체|문자열, 직렬화 후 비어있지 않음).
   100	    schema 지정 시 각 행 전체를 JSON Schema로 검증(내용물 드리프트 차단 — SQL 변경으로 id 누락 등).
   101	    빈 줄은 무시(후행 개행 허용). 순수 함수(DB/네트워크 없음)."""
   102	    import json as _json
   103	
   104	    try:
   105	        text = raw.decode("utf-8")
   106	    except UnicodeDecodeError as exc:
   107	        raise EntityParseError("UTF-8 텍스트가 아닙니다 — JSONL(UTF-8) 파일을 올려주세요.") from exc
   108	
   109	    validator = None
   110	    if schema is not None:
   111	        import jsonschema
   112	
   113	        validator = jsonschema.Draft202012Validator(schema)
   114	
   115	    rows: list[tuple[str, dict]] = []
   116	    for lineno, line in enumerate(text.splitlines(), start=1):
   117	        if not line.strip():
   118	            continue  # 빈 줄 허용(후행 개행 등)
   119	        # 캡 검사를 파싱 **앞**에(codex 149 Low) — 5001번째 행의 파싱/스키마 검증 비용도 쓰지 않는다.
   120	        if len(rows) >= ENTITY_MAX_ROWS:
   121	            raise EntityParseError(f"행이 {ENTITY_MAX_ROWS}개를 넘습니다 — 파일을 나눠 올려주세요.")
   122	        try:
   123	            # parse_constant — NaN/Infinity는 표준 JSON이 아니고 JSONB insert에서 500으로 터진다
   124	            # (codex 332 P2, 업로드·편집 두 입구 공통 봉인). ValueError는 아래서 행 번호로 감싸진다.
   125	            obj = _json.loads(line, parse_constant=_reject_nonstandard_const)
   126	        except ValueError as exc:
   127	            raise EntityParseError(f"{lineno}번째 줄: JSON 파싱 실패 — {exc}") from exc
   128	        if not isinstance(obj, dict):
   129	            raise EntityParseError(
   130	                f"{lineno}번째 줄: JSON 객체가 아닙니다(계약: {{metadata, data}})."
   131	            )
   132	        meta = obj.get("metadata")
   133	        if not isinstance(meta, dict):
   134	            raise EntityParseError(f"{lineno}번째 줄: metadata가 객체가 아닙니다.")
   135	        data = obj.get("data")
   136	        if not isinstance(data, (dict, str)):
   137	            raise EntityParseError(f"{lineno}번째 줄: data는 객체 또는 문자열이어야 합니다.")
   138	        if validator is not None:
   139	            err = next(iter(validator.iter_errors(obj)), None)
   140	            if err is not None:
   141	                path = "/".join(str(p) for p in err.absolute_path) or "(루트)"
   142	                raise EntityParseError(
   143	                    f"{lineno}번째 줄: 스키마 위반 — {path}: {err.message[:200]}"
   144	                )
   145	        txt = entity_text(data)
   146	        if not txt:
   147	            raise EntityParseError(f"{lineno}번째 줄: data에서 임베딩할 텍스트가 없습니다.")
   148	        if len(txt) > ENTITY_MAX_TEXT_CHARS:
   149	            raise EntityParseError(
   150	                f"{lineno}번째 줄: 텍스트가 {len(txt)}자 — 행당 최대 {ENTITY_MAX_TEXT_CHARS}자입니다."
   151	            )
   152	        mlen = len(_json.dumps(meta, ensure_ascii=False))
   153	        if mlen > ENTITY_MAX_META_CHARS:
   154	            raise EntityParseError(
   155	                f"{lineno}번째 줄: metadata가 {mlen}자 — 행당 최대 {ENTITY_MAX_META_CHARS}자입니다."
   156	            )
   157	        rows.append((txt, meta))
   158	    if not rows:
   159	        raise EntityParseError("적재할 행이 없습니다(빈 파일).")
   160	    return rows
   161	
   162	
   163	def chunk_text(text: str, chunk_size: int, chunk_overlap: int) -> list[str]:
   164	    """RecursiveCharacterTextSplitter로 컬렉션 설정에 따라 분할. 빈 청크 제거."""
   165	    splitter = RecursiveCharacterTextSplitter(
   166	        chunk_size=max(1, chunk_size),
   167	        chunk_overlap=max(0, min(chunk_overlap, max(0, chunk_size - 1))),
   168	        separators=["\n\n", "\n", " ", ""],
   169	    )
   170	    return [c for c in splitter.split_text(text) if c.strip()]
   171	
   172	
   173	# 임베딩 호출당 최대 입력 수(스펙 334) — 전 청크를 한 요청으로 보내면 대형 파일(수만 행)에서
   174	# 요청 본문이 거대해져 실 provider가 거부하거나 타임아웃. 배치 분할 후 순서 보존 병합.
   175	EMBED_BATCH = _env_int("RAG_EMBED_BATCH", 128)
   176	
   177	
   178	async def embed_texts(
   179	    base_url: str, api_key: str | None, model_id: str, texts: list[str]
   180	) -> list[list[float]]:
   181	    """OpenAI 호환 `/embeddings` 호출 → 입력 순서대로 벡터 리스트.
   182	
   183	    EMBED_BATCH 단위로 분할 호출(스펙 334 — 대형 파일 대비, 인제스트·재인덱싱·편집 공통 관문).
   184	    응답 `data`는 index 필드로 정렬 보장. 실패 시 IngestError(비밀 미포함 메시지).
   185	    """
   186	    if not texts:
   187	        return []
   188	    out: list[list[float]] = []
   189	    for i in range(0, len(texts), EMBED_BATCH):
   190	        out.extend(await _embed_batch(base_url, api_key, model_id, texts[i : i + EMBED_BATCH]))
   191	    return out
   192	
   193	
   194	async def _embed_batch(
   195	    base_url: str, api_key: str | None, model_id: str, texts: list[str]
   196	) -> list[list[float]]:
   197	    """단일 HTTP 호출(배치 1개) — embed_texts가 분할해 부른다."""
   198	    if not base_url:
   199	        raise IngestError("임베딩 provider base_url이 없습니다.")
   200	    headers = {"Authorization": f"Bearer {api_key}"} if api_key else {}
   201	    url = base_url.rstrip("/") + "/embeddings"
   202	    try:
   203	        async with httpx.AsyncClient(timeout=60) as client:
   204	            r = await client.post(url, headers=headers, json={"model": model_id, "input": texts})
   205	    except Exception as exc:
   206	        raise IngestError("임베딩 서버 연결 실패") from exc
   207	    if r.status_code != 200:
   208	        # 본문은 키를 에코할 수 있어 상태코드만 노출.
   209	        raise IngestError(f"임베딩 HTTP {r.status_code}")
   210	    try:
   211	        data = r.json().get("data") or []
   212	        ordered = sorted(data, key=lambda d: d.get("index", 0))
   213	        vectors = [d.get("embedding") or [] for d in ordered]
   214	    except Exception as exc:
   215	        raise IngestError("임베딩 응답 파싱 실패") from exc
   216	    if len(vectors) != len(texts) or any(not v for v in vectors):
   217	        raise IngestError("임베딩 응답이 입력 청크 수와 맞지 않습니다.")
   218	    # index 정합 — 중복·누락 index면 정렬을 신뢰할 수 없어 text↔vector가 조용히 어긋난다.
   219	    # 정확히 0..n-1이어야 위 sorted() 정렬이 입력 순서를 복원한다고 보장된다.
   220	    idxs = [d.get("index") for d in data]
   221	    if any(i is None for i in idxs) or sorted(idxs) != list(range(len(texts))):
   222	        raise IngestError("임베딩 응답 index가 0..n-1과 정확히 일치하지 않습니다(정렬 신뢰 불가).")
   223	    return vectors
