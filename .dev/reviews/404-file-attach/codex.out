   122	                msg_chunk, _meta = chunk
   123	                # A2A 서빙도 도구 원본 응답은 외부 소비자에게 노출 않음(스펙 092, 본문 sink와 동일 술어).
   124	                if runtime.is_tool_message(msg_chunk):
