   110	def _node_history_depths(nodes: list) -> list[int] | None:
   111	    """노드별 historyDepth 수집 — 음수(전체) depth가 하나라도 있으면 None(전량 신호).
   112	    노드 depth None은 '상속'이라 에이전트 값으로 이미 대표된다(스킵)."""
   113	    depths: list[int] = []
   114	    for node in nodes:
   115	        d = node.get("historyDepth")
   116	        if d is None:
   117	            continue
   118	        if isinstance(d, int) and d < 0:
   119	            return None
   120	        if isinstance(d, int):
   121	            depths.append(d)
   122	    return depths
   123	
