   177	def _annotate_memory_observations(trace: dict, turn: "ChatTurnRuntime", *, user_text: str) -> None:
   178	    """메모리 관측 주석 — 회상 스코프/쿼리(079)·노드별 회상(268 P2)·단기 기억 창(270)."""
   179	    if turn.used_memory:
   180	        # None이 아닌 회상 축만 — {"user_id","run_id","agent_id"} 부분집합 (Inspector가 축별 렌더).
   181	        trace["memoryScope"] = {k: v for k, v in turn.recall_scope.items() if v}
   182	        # 회상에 쓴 쿼리(=user_text)를 에코 — 0건 회상이어도 "조회 행위"를 인스펙터에 남긴다(스펙 079).
   183	        # 표시 전용·길이상한(방금 그 유저가 보낸 텍스트라 경계 이동 없음).
   184	        trace["memoryQuery"] = user_text[:300]
   185	    if turn.memory_recalls:
   186	        # 노드별 회상 기록(스펙 268 P2) — (node, query, hits, cached). 프록시가 조회마다 남김
   187	        # (082 조회 행위 계측). 인스펙터가 노드 행에 귀속 렌더.
   188	        trace["memoryRecalls"] = turn.memory_recalls
   189	    if turn.history_windows:
   190	        # 노드별 단기 기억 창 기록(스펙 270) — (node, depth, count). 프록시가 첫 진입에 남김
   191	        # (082 조회 계측). 내용 아닌 건수만(누출 0). 인스펙터가 노드 행에 귀속 렌더.
   192	        trace["historyWindows"] = turn.history_windows
   193	
   194	
   195	def _final_trace(
   196	    ctx: ChatContext,
   197	    turn: "ChatTurnRuntime",
   198	    *,
   199	    capture: trace_capture.TraceCaptureHandler,
   200	    full: str,
   201	    total_ms: int,
   202	    messages: list[dict],
   203	    sent_messages: list[dict],
   204	    observed: list,
   205	    impl: CustomAgent,
   206	    user_text: str,
   207	    history_restore: dict | None,
   208	) -> tuple[dict, dict]:
   209	    """정상/오류 종결 턴의 trace·tokens 조립 — 반환 (trace, tokens)."""
   210	    prompt_chars = sum(len(m["content"]) for m in messages)
   211	    # 토큰(스펙 205): 모델 usage 실측 우선, 부재 시 추정 폴백(estimated로 정직 표기).
   212	    if capture.usage_seen:
   213	        tokens = {"in": capture.tokens_in, "out": capture.tokens_out, "estimated": False}
   214	    else:
   215	        tokens = {**runtime.estimate_tokens(prompt_chars, len(full)), "estimated": True}
   216	    trace = runtime.assemble_trace(
   217	        agent_id=ctx.ext_agent_id,
   218	        memories=turn.mem_hits,
   219	        mcp_calls=turn.calls_sink,
   220	        used_memory=turn.used_memory,
   221	        total_ms=total_ms,
   222	        tokens=tokens,
   223	        graph_observations=observed,
   224	    )
   225	    trace["contextMessages"] = len(messages)  # 모델에 넣은 메시지 수(historyDepth 적용 결과)
   226	    if turn.build_ms:
   227	        trace["buildMs"] = turn.build_ms  # 매턴 그래프 재구성 비용 분해(스펙 368 — 캐시 367-D 잣대)
   228	    _annotate_execution(trace, ctx, turn, capture=capture, sent_messages=sent_messages, impl=impl)
   229	    _annotate_context_sources(
   230	        trace, ctx, turn, user_text=user_text, history_restore=history_restore
   231	    )
   232	    return trace, tokens
