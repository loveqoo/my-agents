    46	    role: str
    47	    content: str
    48	    trace: dict[str, Any] | None = None
    49	    feedback: FeedbackOut | None = None  # 스펙 209 — 요청 사용자의 이 메시지 피드백(없으면 None)
    50	
    51	
    52	class ApprovalOut(BaseModel):
    53	    id: str  # approval_id
    54	    sessionId: str | None = None
    55	    agentId: str | None = None
    56	    agent: str
    57	    permission: str
    58	    action: str
    59	    args: dict[str, Any] = Field(default_factory=dict)
    60	    summary: str
    61	    checkpoint: str | None = None
    62	    status: str
    63	    requestedAt: str | None = None
    64	    approver: str | None = None  # 승인자(스펙 177 P2) — "admin"=관리자·"self"=본인. UI 태그 표기용.
    65	    resolvedAt: str | None = None  # 처리 시각(스펙 181, 감사) — 미처리면 None
    66	    resolvedBySelf: bool | None = (
    67	        None  # 처리자=요청자면 True(본인), 다르면 False(관리자), 미처리 None
    68	    )
    69	
    70	
    71	class ApprovalPage(BaseModel):
    72	    # 승인 페이지 응답(스펙 251) — 세션 페이지와 같은 계약({items, total}).
    73	    items: list[ApprovalOut]
    74	    total: int
    75	
    76	
    77	class ResolveIn(BaseModel):
