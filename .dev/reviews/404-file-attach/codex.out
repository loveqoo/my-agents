   326	                t for t in (_resolve_tool(name) for name in node["tools"]) if t is not None
   327	            ]
   328	            bound = model.bind_tools(node_tools) if node_tools else model
   329	            prompt = node["prompt"]
   330	            clean = node.get("context") == "clean"
   331	            fmt = node.get("format") or "text"
   332	            fields = node.get("fields") or []
   333	            node_mem = node.get("memories") or []
   334	            mem_mode = node.get("memoryQuery") or "user"
   335	            node_hd = node.get(
   336	                "historyDepth"
   337	            )  # 단기 기억 창(스펙 270) — None=에이전트 상속(프록시 기본값)
   338	
   339	            async def _history_block(reentry: bool) -> list:
   340	                # 단기 기억(스펙 270) — 이전 대화 슬라이스를 프롬프트 앞에 주입. clean은 대화 격리(결정 가),
   341	                # 프록시 없으면(비노드형) 빈 리스트. 재진입(도구 루프)에도 주입해 대화가 루프 내내 보이게
   342	                # (무회귀 — 오늘은 시드된 대화가 도구 루프 내내 보임), 단 기록은 첫 진입만(트레이스 스팸 방지).
   343	                if clean or ctx.history_window is None:
   344	                    return []
   345	                try:
   346	                    return await ctx.history_window(node_hd, node=nid, record=not reentry)
   347	                except Exception:
   348	                    log.warning("노드 단기 기억 실패(node=%s) — 대화 없이 진행", nid)
   349	                    return []
   350	
