    27	def _to_base_messages(dicts: list[dict]) -> list:
    28	    """{role, content} dict 리스트 → BaseMessage 리스트(스펙 270 히스토리 프록시용). 엔진이 ainvoke에
    29	    splat하므로 노드 상태의 BaseMessage와 정합해야 함. role: assistant→AI, system→System, 그 외→Human."""
    30	    out: list = []
    31	    for msg in dicts:
    32	        role = msg.get("role")
    33	        content = msg.get("content") or ""
    34	        if role == "assistant":
    35	            out.append(AIMessage(content=content))
    36	        elif role == "system":
    37	            out.append(SystemMessage(content=content))
    38	        else:
    39	            out.append(HumanMessage(content=content))
    40	    return out
