    22	# 트레이스에 기록할 오버라이드 허용 키(스펙 134) — _load_context 병합 allowlist + systemPrompt.
    23	_OVERRIDE_TRACE_KEYS = (
    24	    "model",
    25	    "temperature",
    26	    "historyDepth",
    27	    "mcps",
    28	    "memories",
    29	    "capabilities",
    30	    "tools",
