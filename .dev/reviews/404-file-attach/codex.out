   283	def _resolve_graph_entry(
   284	    ctx: ChatContext, body: ChatRequest, user_text: str
   285	) -> tuple[str, Command | None, dict | None]:
   286	    """산출물 pending 재개/새 thread 결정(스펙 188) — 반환 (thread_id, graph_input, pending_artifact).
   287	    graph_input=None이면 새 실행(호출측이 {"messages": seed}로 채움).
   288	
   289	    thread_id는 **턴별 고유**(세션-안정 아님): 세션-안정으로 두고 매 턴 전체 히스토리를 넘기면
   290	    체크포인트의 add_messages 리듀서가 메시지를 중복 누적한다(무상태 윈도잉과 충돌). 턴마다 새
   291	    thread를 만들어 그 턴의 일시정지/재개에만 쓰고, Approval.checkpoint에 박아 재개 키로 삼는다.
   292	    산출물형 ask/form 대기(스펙 188)면 **그 thread를 이어** Command(resume=union 봉투)로 재개한다
   293	    (새 실행 금지 — produce의 기록된 답 리플레이가 그 체크포인트에 있다). pop = 재개 시도는 1회.
   294	    이중 입력 일급: 폼 대기 중이라도 텍스트가 오면 {"type":"text"}로 재개(병합은 뼈대 ctx.form 소유)."""
   295	    pending_artifact = _PENDING_ARTIFACT.pop(ctx.session_id, None)
   296	    if body.form is not None and (
   297	        pending_artifact is None or body.form.formId != pending_artifact.get("form_id")
   298	    ):
   299	        # 폼 제출인데 대응 pending이 없거나 formId 불일치(스테일/위조/재시작 소실) — 조용히 텍스트로
   300	        # 오인하지 않고 명시적으로 거절(fail-closed). pending은 원복(유효한 폼이 남아 있으면 재사용).
   301	        if pending_artifact is not None:
   302	            _PENDING_ARTIFACT[ctx.session_id] = pending_artifact
   303	        raise HTTPException(
   304	            status_code=409, detail="폼이 만료되었거나 일치하지 않습니다 — 다시 시도해 주세요."
   305	        )
   306	    if pending_artifact:
   307	        thread_id = pending_artifact["thread_id"]
   308	        if body.form is not None and pending_artifact.get("kind") == "form":
   309	            # 서버측 1차 검증(값∈후보·알려진 key만) — 뼈대 ctx.form이 같은 함수로 재검증(이중 게이트).
   310	            from agent.flows.artifact import validate_form_values
   311	
   312	            vals = validate_form_values(pending_artifact.get("fields") or [], body.form.values)
   313	            graph_input = Command(resume={"type": "form", "values": vals})
   314	        else:
   315	            graph_input = Command(resume={"type": "text", "message": user_text})
   316	    else:
   317	        thread_id = f"{ctx.ext_agent_id}:{ctx.session_id}:{secrets.token_hex(4)}"
   318	        graph_input = None
   319	    return thread_id, graph_input, pending_artifact
