    95	        if self._outcome is None:
    96	            raise RuntimeError("chunks() 소진 전 outcome 접근 — 스트림을 끝까지 소비한 뒤 읽으세요")
    97	        return self._outcome
    98	
    99	    async def chunks(self) -> AsyncIterator[str]:
   100	        """서빙 턴 스트림(스펙 388) — 텍스트 청크 yield, 소진 후 outcome 확정·영속·기억 저장.
   101	
   102	        1회용(codex 392 P2): 옛 계약은 async generator 객체라 재소진이 no-op였다 — 재호출을
   103	        허용하면 영속·기억 저장·Approval 생성이 중복 실행되므로 명시적으로 잠근다."""
   104	        if self._started:
   105	            raise RuntimeError("chunks()는 1회용 스트림 — 재실행은 새 턴을 prepare하세요")
   106	        self._started = True
   107	        acc: list[str] = []  # 영속·자동 기억 저장용 어시스턴트 응답 누적
   108	        interrupts: list[dict] = []
   109	        run_kwargs: dict = {"durability": "exit"} if self.has_ckpt else {}  # 스펙 346
   110	        try:
   111	            async for mode, chunk in self.graph.astream(  # type: ignore[attr-defined]
   112	                {"messages": self.messages},
   113	                config=self.cfg,
   114	                stream_mode=["messages", "updates"],
   115	                **run_kwargs,
   116	            ):
   117	                if mode == "updates":
   118	                    # interrupt 수집(스펙 388 P2) — 한 업데이트에 다중 interrupt 가능(메인 chat 미러).
