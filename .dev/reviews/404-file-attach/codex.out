    43	class _HistoryWindowProxy:
    44	    """단기 기억 창 프록시(스펙 270, _MemoryRecallProxy의 형제) — 노드형 노드가 **각자** 자기 depth로
    45	    이전 대화를 슬라이스한다. 원본 대화를 생성 시 고정하고 depth로 캐싱(같은 depth=같은 슬라이스 공유).
    46	
    47	    - 수명 = 한 턴(요청). 스코프 = 원본 대화(요청 것)로 **고정**(RBAC — 노드가 남의 대화 못 봄).
    48	    - 슬라이스 = `_window(전체대화, depth)[:-1]` — 현재 턴은 그래프가 별도 시드하므로 분리(회귀 등가:
    49	      depth=D면 D-1개 이전 대화 + 시드된 현재 턴 = 총 D개, 오늘 _window(conv, D)와 동일 집합).
    50	    - depth=None → 기본(에이전트 historyDepth) 상속. 반환은 **BaseMessage 리스트**(엔진이 splat).
    51	    - 조회마다 (node, depth, count) 기록 → trace["historyWindows"](082 조회 계측). **내용 아닌 건수만**
    52	      기록 → 대화 누출 0(243 ③ 형제 표면 마스킹 규약). record=False면 기록 생략(도구 루프 재진입용)."""
    53	
    54	    def __init__(
    55	        self,
    56	        conversation: list,
    57	        default_depth: int | None,
    58	        records: list[dict],
    59	        drop_last: bool = True,
    60	    ) -> None:
    61	        # drop_last(codex 270 High): 메인 경로의 conversation은 **현재 턴 포함**(body.messages 끝=현재 턴,
    62	        # 그래프가 별도 시드)이라 [:-1]로 분리. 재개 경로의 conversation은 세션 DB서 로드한 **이전 대화만**
    63	        # (현재 턴은 아직 미영속 — 체크포인트가 보유)이라 drop_last=False(안 버림). 이 구분이 없으면 재개가
    64	        # 직전 assistant 메시지를 잘못 떨궈 원 턴과 다른 창을 본다.
    65	        self._conv = conversation
    66	        self._default = default_depth
    67	        self._drop = drop_last
    68	        self._cache: dict = {}  # depth 키 → 슬라이스(BaseMessage 리스트)
    69	        self.records = records
    70	
    71	    async def __call__(self, depth: int | None = None, node: str = "", record: bool = True) -> list:
    72	        d = self._default if depth is None else depth
    73	        key = "all" if (d is None or d < 0) else d
    74	        if key not in self._cache:
    75	            win = _window(self._conv, d) if self._conv else []
    76	            self._cache[key] = win[:-1] if (self._drop and win) else win
    77	        sliced = self._cache[key]
    78	        if record:
    79	            self.records.append({"node": node, "depth": d, "count": len(sliced)})
    80	        return sliced
    81	
