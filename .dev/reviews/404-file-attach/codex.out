   125	def _history_load_limit(ctx: ChatContext) -> int | None:
   126	    """서버 재구성 시 읽을 이전 대화 상한(스펙 289 P1) — 에이전트·노드가 요구할 수 있는 최대 depth.
   127	    None(전체)·음수(전체) depth가 하나라도 있으면 전량(None)."""
   128	    agent_d = ctx.history_depth
   129	    if agent_d is None or (isinstance(agent_d, int) and agent_d < 0):
   130	        return None
   131	    node_depths = _node_history_depths(ctx.nodes_resolved or [])
   132	    if node_depths is None:
   133	        return None
   134	    return max([int(agent_d), *node_depths])
