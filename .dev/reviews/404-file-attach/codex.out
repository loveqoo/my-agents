   141	            # 없어 완료 턴의 체크포인트가 TTL까지 잔류했고, SSE abort 취소 오염 후보도 열려 있었다.
   142	            # 메인 chat과 같은 관문·같은 취소-보호(강참조 shield) — paused=interrupt는 재개 근거 보존.
   143	            from . import checkpoint_retention
   144	
   145	            await checkpoint_retention.shielded_release(self.thread_id, paused=bool(interrupts))
   146	
   147	    async def _interrupt_outcome(self, interrupts: list[dict]) -> ServeOutcome:
   148	        """서빙 interrupt → 승인 대기 변환(스펙 388 P2).
   149	
   150	        도구는 interrupt 이전이라 미실행(부수효과 0, 041 §3.3). 비영속은 승인 불가 안내(235)."""
   151	        if not self.has_ckpt:
   152	            return ServeFailed(
   153	                "비영속(1회성) 에이전트는 승인이 필요한 도구를 사용할 수 없습니다 — "
   154	                "승인·재개에는 기록(DB)이 필요합니다."
   155	            )
   156	        from .chat_approval import _create_approval
   157	
   158	        first = interrupts[0]
   159	        apid = await _create_approval(self.ctx, self.thread_id, first, self.user_id)
   160	        return ServeApprovalRequired(
   161	            id=apid, action=first.get("action", "(작업)"), approver=first.get("approver")
   162	        )
   163	
   164	    async def _persist_turn(self, reply: str) -> None:
   165	        """정상 완주 턴의 영속(스펙 388 P1) — 세션·메시지 저장(0턴 lazy-create·소유자 스탬프는
   166	        _persist가 처리). 트레이스는 최소 정직 표기(서빙은 캡처 없음)·토큰은 추정 폴백(estimated 명시)."""
   167	        if self.ctx.ephemeral:
   168	            return
   169	        tokens = {**runtime.estimate_tokens(self.prompt_chars, len(reply)), "estimated": True}
