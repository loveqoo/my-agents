    36	def _trace_override_value(key: str, v: object) -> str | int | float | bool | list[str] | None:
    37	    """오버라이드 값 1개를 트레이스 표시용으로 정화(131 프레임 재사용) — 기록 제외면 None.
    38	
    39	    문자열=비밀 마스킹+캡 300, 리스트=항목별 캡 100·개수 20, 숫자 통과. systemPrompt는
    40	    _load_context가 **비어있지 않을 때만 적용**(빈/공백은 무시) — 트레이스도 같은 가드를 미러
    41	    (적용 안 된 값을 "적용됨"으로 기록 금지, codex 134 #1)."""
    42	    from .memory import _sanitize
    43	
    44	    if isinstance(v, str):
    45	        if key == "systemPrompt" and not v.strip():
    46	            return None
    47	        return _sanitize(v, cap=300)
    48	    if isinstance(v, (int, float, bool)):
    49	        return v
    50	    if isinstance(v, list):
    51	        return [_sanitize(str(it), cap=100) for it in v[:20]]
    52	    return None
    53	
    54	
    55	def _overrides_trace(overrides: dict | None, nodes_status: str | None = None) -> dict | None:
    56	    """이 턴에 적용된 오버라이드를 트레이스 표시용으로 정화(스펙 134) — 한 세션에 설정이 다른 턴이
    57	    섞여도 턴별로 구분 가능하게 영구 기록. 실제 온 허용 키만 — 없으면 None(필드 미기록=무회귀)."""
    58	    if not isinstance(overrides, dict):
    59	        return None
    60	    out: dict = {}
    61	    for key in _OVERRIDE_TRACE_KEYS:
    62	        if key not in overrides or overrides[key] is None:
    63	            continue
    64	        v = _trace_override_value(key, overrides[key])
    65	        if v is not None:
    66	            out[key] = v
    67	    # 노드 오버라이드(스펙 287) — 프롬프트 전문 대신 요약(개수+적용 상태). mismatch도 기록해
    68	    # "왜 안 먹었는지"를 표면화(스펙 125 계열 — 조용한 드롭 금지).
    69	    if nodes_status is not None and isinstance(overrides.get("nodes"), list):
    70	        out["nodes"] = {"count": len(overrides["nodes"]), "status": nodes_status}
    71	    return out or None
    72	
    73	
    74	def _broker_calls_trace(invocations: list[dict]) -> list[dict]:
    75	    """브로커 호출 이력 → 트레이스 표시용 투영(스펙 130) — **키 화이트리스트 단일 출처**(메인/승인대기/
    76	    재개 세 경로 공유, drift 0). 본문·args 불포함(087/092 원문 누출 0 유지)."""
    77	    return [
    78	        {
    79	            k: v
    80	            for k, v in inv.items()
    81	            if k
    82	            in (
    83	                "node",
    84	                "cap_id",
    85	                "ms",
    86	                "hits",
    87	                "topScore",
    88	                "error",
    89	                "resultPreview",
    90	                "hitsDetail",
    91	                "minScore",
    92	                "query",
    93	                "local",
    94	                "subTraceNodes",
    95	            )
    96	        }
    97	        for inv in invocations
    98	    ]
