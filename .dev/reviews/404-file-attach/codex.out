   235	def _summarize_saved(saved: list[dict]) -> dict:
   236	    """백그라운드 기억 저장 결과를 인스펙터 표시용으로 정화(스펙 314) — 비밀 마스킹+캡. status:
   237	    ok(1건+)/none(0건). count=원 건수(상한 전). items=[{event, text(마스킹)}]. event도 마스킹
   238	    (codex P2: 백엔드 계약상 event는 '원문'이라 custom 백엔드가 secret-like 값을 넣을 수 있음)."""
   239	    items: list[dict] = []
   240	    for row in (saved or [])[:_MEMORY_SAVE_ITEM_CAP]:
   241	        text = memory._sanitize(row.get("text", ""), cap=_MEMORY_SAVE_TEXT_CAP)
   242	        if not text:
   243	            continue
   244	        items.append(
   245	            {"event": memory._sanitize(str(row.get("event") or "ADD"), cap=16), "text": text}
   246	        )
   247	    return {"status": "ok" if items else "none", "count": len(saved or []), "items": items}
   248	
   249	
   250	async def _finalize_memory_trace(mid: str, summary: dict) -> None:
   251	    """저장 완료 후 그 assistant 메시지의 영속 trace에 memorySaved 병합(스펙 314) — 새로고침 시
   252	    인스펙터가 결과를 다시 불러오게 한다. 잘못된/사라진/비-assistant mid는 no-op(codex P2 — 함수
   253	    자체가 '남의 메시지 클로버 금지'를 보장하도록 role까지 확인)."""
   254	    try:
   255	        pk = uuid.UUID(mid)
   256	    except (ValueError, TypeError):
   257	        return
   258	    async with SessionLocal() as db:
   259	        msg = await db.get(Message, pk)
   260	        if msg is None or msg.role != "assistant" or not isinstance(msg.trace, dict):
   261	            return
   262	        trace = dict(
   263	            msg.trace
   264	        )  # 새 dict 대입으로 JSON 컬럼 dirty 플래그 확실히(in-place 변형 아님)
   265	        trace["memorySaved"] = summary
   266	        msg.trace = trace
   267	        await db.commit()
