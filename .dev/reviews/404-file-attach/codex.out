     1	"""플레이그라운드 파일첨부(스펙 404, A안 — 1회성 대화 주입).
     2	
     3	무상태 2박자: ① `POST /chat/attachments`가 파일에서 텍스트만 추출해 돌려주고(서버 보관 없음),
     4	② 클라이언트가 그 텍스트를 `ChatRequest.attachments`로 되보내면 `apply_attachments`가 마지막
     5	user 메시지 앞에 **경계 블록**으로 주입한다. 주입된 최종 메시지가 그대로 영속되므로 히스토리
     6	재구성(스펙 289)·재개가 공짜(별도 저장소·TTL 없음).
     7	
     8	첨부는 **데이터(지시 아님)** — 경계 표기(`[첨부 문서: …]…[첨부 끝]`)로 본문과 구분한다.
     9	캡 3종(파일 raw 5MB·추출 3만자·턴당 3개)은 2026-07-19 승인값(스펙 404 — 사용자 가시 한계).
    10	서버가 주입 시점에 **재강제**한다(추출 엔드포인트만 믿으면 클라 우회로 캡이 뚫린다).
    11	"""
    12	
    13	import logging
    14	
    15	from fastapi import APIRouter, HTTPException, UploadFile
    16	from pydantic import BaseModel
    17	
    18	from . import rag_ingest
    19	from .memory import _sanitize
    20	from .schemas import ChatRequest
    21	
    22	log = logging.getLogger("api.chat_attachments")
    23	
    24	router: APIRouter = APIRouter(prefix="/chat", tags=["attachments"])
    25	
    26	RAW_CAP = 5 * 1024 * 1024  # 파일당 5MB(승인값) — raw 바이트에서 누적 검사
    27	TEXT_CAP = 30_000  # 파일당 추출 텍스트 3만자(승인값) — 초과는 앞부분+잘림 명시
    28	COUNT_CAP = 3  # 턴당 첨부 수(승인값)
    29	
    30	
    31	class AttachmentOut(BaseModel):
    32	    filename: str
    33	    text: str  # 추출 전문(캡 적용) — 클라이언트가 ChatRequest.attachments로 되보낸다
    34	    chars: int
    35	    truncated: bool  # 3만자 캡으로 잘렸는가(UI가 정직하게 표시)
    36	
    37	
    38	@router.post("/attachments", response_model=AttachmentOut)
    39	async def extract_attachment(file: UploadFile) -> AttachmentOut:
    40	    """파일 → 평문 추출(무상태). txt/md/텍스트류=UTF-8, pdf=pypdf — 이미지 PDF·바이너리는 400.
    41	
    42	    raw 캡은 **읽으면서 누적**으로 검사한다(learning: .content 위 카운트는 막은 척 —
    43	    Content-Length 신뢰 금지, 5MB 초과 시점에 즉시 413).
    44	    """
    45	    data = bytearray()
    46	    while chunk := await file.read(64 * 1024):
    47	        data += chunk
    48	        if len(data) > RAW_CAP:
    49	            raise HTTPException(
    50	                status_code=413,
    51	                detail=f"파일이 너무 큽니다 — 첨부는 파일당 {RAW_CAP // (1024 * 1024)}MB까지입니다.",
    52	            )
    53	    if not data:
    54	        raise HTTPException(status_code=400, detail="빈 파일입니다.")
    55	    try:
    56	        text = rag_ingest.extract_text(file.filename or "", file.content_type, bytes(data))
    57	    except rag_ingest.IngestError as exc:
    58	        raise HTTPException(
    59	            status_code=400,
    60	            detail=f"텍스트를 추출할 수 없습니다({exc}) — txt·md·pdf(텍스트) 형식만 지원합니다.",
    61	        ) from exc
    62	    text = text.strip()
    63	    if not text:
    64	        raise HTTPException(
    65	            status_code=400, detail="추출된 텍스트가 없습니다(이미지 PDF·빈 문서는 지원 밖)."
    66	        )
    67	    truncated = len(text) > TEXT_CAP
    68	    if truncated:
    69	        text = text[:TEXT_CAP]
    70	    return AttachmentOut(
    71	        filename=(file.filename or "(이름 없음)")[:200],
    72	        text=text,
    73	        chars=len(text),
    74	        truncated=truncated,
    75	    )
    76	
    77	
    78	def apply_attachments(body: ChatRequest) -> list[dict] | None:
    79	    """첨부를 마지막 user 메시지에 경계 블록으로 주입 — 반환: trace용 메타(없으면 None).
    80	
    81	    캡 재강제 지점(단일 관문): 추출 엔드포인트를 안 거친 클라이언트가 임의 텍스트를 보내도
    82	    여기서 개수·길이를 다시 자른다. 주입 후의 content가 그대로 영속·히스토리 재구성에 쓰인다.
    83	    """
    84	    atts = body.attachments or []
    85	    if not atts:
    86	        return None
    87	    if len(atts) > COUNT_CAP:
    88	        raise HTTPException(
    89	            status_code=422, detail=f"첨부는 턴당 {COUNT_CAP}개까지 보낼 수 있습니다."
    90	        )
    91	    if not body.messages or body.messages[-1].role != "user":
    92	        raise HTTPException(status_code=422, detail="첨부는 user 메시지와 함께 보내야 합니다.")
    93	    blocks: list[str] = []
    94	    meta: list[dict] = []
    95	    for a in atts:
    96	        text = a.text[:TEXT_CAP]  # 재강제(추출 캡과 동일 상한)
    97	        name = a.filename[:200]
    98	        blocks.append(f"[첨부 문서: {name}]\n{text}\n[첨부 끝]")
    99	        # 프리뷰는 캡+비밀 마스킹(trace 누출 규율 087/092/125 — resultPreview와 동일).
   100	        meta.append({"filename": name, "chars": len(text), "preview": _sanitize(text, cap=200)})
   101	    body.messages[-1].content = "\n\n".join([*blocks, body.messages[-1].content])
   102	    return meta
     1	"""schemas.sessions — 007 도메인 스키마(스펙 378 분할).
     2	
     3	원본 schemas.py에서 verbatim 이관."""
     4	
     5	import uuid
     6	from typing import Any, Literal
     7	
