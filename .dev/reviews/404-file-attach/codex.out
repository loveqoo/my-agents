    85	
    86	
    87	class ChatAttachment(BaseModel):
    88	    """파일첨부(스펙 404, A안) — 추출 엔드포인트가 돌려준 텍스트를 클라이언트가 되보내는 운반체.
    89	    캡(개수·길이)은 서버 주입 관문(chat_attachments.apply_attachments)이 재강제한다."""
    90	
    91	    filename: str = Field(max_length=200)
    92	    text: str
    93	
    94	
    95	class ChatFormSubmission(BaseModel):
    96	    """산출물형 폼 제출(스펙 188 P2) — 대기 중 폼 프레임(formId)에 대한 값. 서버가 pending의
    97	    필드 명세로 검증(값∈후보) 후 Command(resume={"type":"form",...})로 그래프를 재개한다."""
    98	
    99	    formId: str
   100	    values: dict
   101	
   102	
   103	class ChatRequest(BaseModel):
   104	    messages: list[ChatMessage]
   105	    sessionId: str | None = None  # 이어서 대화할 세션(없으면 새로 생성)
   106	    # mem0 user 축 정체성(스펙 032→387): 쿠키 유저는 인증 주체에서 도출(임의 지정 금지 — 422).
   107	    # **머신 토큰 호출만** userId 지정 가능(owner 전권의 위임 — 외부 시스템이 자기 유저를 대신).
   108	    # 판정은 auth.resolve_memory_user_id 단일 관문. 미지정 시 기존 동작(쿠키=자기 id, 머신=세션 축만).
   109	    userId: str | None = Field(default=None, max_length=80)  # 세션 컬럼 String(80) 정렬
   110	    # Playground "Proxy" 세션 한정 오버라이드(스펙 025). **web 에이전트에만** 적용, 화이트리스트
   111	    # 키만 의미(model/temperature/systemPrompt/mcps/memories/historyDepth). 저장된 에이전트는 불변.
   112	    # 코드 에이전트는 원격 실행이라 무시(bypass).
   113	    overrides: dict | None = None
   114	    # 산출물형 폼 제출(스펙 188 P2) — 이중 입력의 폼 입구. 텍스트 입구는 messages 그대로.
   115	    form: ChatFormSubmission | None = None
   116	    # 파일첨부(스펙 404) — 마지막 user 메시지에 경계 블록으로 주입(1회성·무상태).
   117	    attachments: list[ChatAttachment] | None = None
   118	    # 버전 지정 실행(스펙 242) — 지정하면 그 AgentVersion의 config로 실행(초안 미리보기·버전별 테스트).
   119	    # 내부(관리 API) 전용 축: A2A·공개 서빙 경로는 이 필드가 없어 활성 버전만 나간다(외부 경계 공짜).
   120	    version: str | None = None
