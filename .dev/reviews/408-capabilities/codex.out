   247	    try:
   248	        impl = resolve_agent_runtime(ctx)
   249	    except AgentConfigError as e:
   250	        # 선언한 in-process 구현 미해결(스펙 089) — 노출 서빙 거부(default 만회 없음).
   251	        log.warning("A2A 노출 거부: 미해결 impl %r (agent %s)", str(e), ctx.ext_agent_id)
   252	        raise ValueError("에이전트 설정 실패: 런타임 구현 미해결(A2A 노출 불가)") from e
   253	    if impl is None or ctx.model_cfg is None:
   254	        raise ValueError("로컬(ui) 에이전트가 아니거나 채팅 모델이 없습니다(A2A 노출 불가)")
   255	    return impl
