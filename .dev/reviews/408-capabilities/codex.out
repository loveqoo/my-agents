   186	
   187	def _annotate_memory_observations(trace: dict, turn: "ChatTurnRuntime", *, user_text: str) -> None:
   188	    """메모리 관측 주석 — 회상 스코프/쿼리(079)·노드별 회상(268 P2)·단기 기억 창(270)."""
   189	    if turn.used_memory:
   190	        # None이 아닌 회상 축만 — {"user_id","run_id","agent_id"} 부분집합 (Inspector가 축별 렌더).
   191	        trace["memoryScope"] = {k: v for k, v in turn.recall_scope.items() if v}
   192	        # 회상에 쓴 쿼리(=user_text)를 에코 — 0건 회상이어도 "조회 행위"를 인스펙터에 남긴다(스펙 079).
   193	        # 표시 전용·길이상한(방금 그 유저가 보낸 텍스트라 경계 이동 없음).
   194	        trace["memoryQuery"] = user_text[:300]
   195	    if turn.memory_recalls:
     1	"""모델 구성 정본(스펙 295) — 주입된 model_cfg로 ChatOpenAI를 만드는 유일한 곳.
     2	
     3	이전엔 route·orchestrate·plan_execute·artifact·pipeline·main 6곳이 같은 구성 블록을 복제했다
     4	(도크스트링이 "동일 규칙"이라 상호참조로 자백). 차이 지점(cfg 출처·미설정 처리·기본 temperature·
     5	에러 문구)만 인자로 뽑아 하나로 합친다. env·DB 미접촉 — 모델은 레지스트리 해석본(cfg)만 쓴다.
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	import asyncio
    11	import hashlib
    12	from typing import Literal, overload
    13	
    14	from langchain_openai import ChatOpenAI
    15	
    16	_MISSING_MSG = "모델 설정이 필요합니다 (base_url/model_id) — 모델을 등록하세요."
    17	
    18	# 프로바이더별 클라이언트 풀(스펙 371 D2) — 프로세스-로컬, 상한 초과 시 최고령 축출.
    19	_CLIENT_POOL: dict[tuple, ChatOpenAI] = {}
    20	_CLIENT_POOL_MAX = 64
    21	
    22	
    23	# on_missing="raise"(기본)면 None 불가 → 호출부가 model을 바로 쓴다. "none"이면 None 가능(artifact).
    24	@overload
    25	def build_chat_openai(
    26	    cfg: dict | None,
    27	    params: dict | None = ...,
    28	    *,
    29	    default_temperature: float = ...,
    30	    on_missing: Literal["raise"] = ...,
    31	    error_label: str = ...,
    32	) -> ChatOpenAI: ...
    33	@overload
    34	def build_chat_openai(
    35	    cfg: dict | None,
    36	    params: dict | None = ...,
    37	    *,
    38	    default_temperature: float = ...,
    39	    on_missing: Literal["none"],
    40	    error_label: str = ...,
    41	) -> ChatOpenAI | None: ...
    42	def build_chat_openai(
    43	    cfg: dict | None,
    44	    params: dict | None = None,
    45	    *,
    46	    default_temperature: float = 0.7,
    47	    on_missing: str = "raise",
    48	    error_label: str = _MISSING_MSG,
    49	) -> ChatOpenAI | None:
    50	    """model_cfg → ChatOpenAI. base_url/model_id 없으면 `on_missing`: "raise"(기본)면 명확히 실패,
    51	    "none"이면 None 반환(모델 없이도 도는 경로용 — artifact ask-only). temperature 우선순위:
    52	    호출자 params > 모델 등록 params > `default_temperature`."""
    53	    cfg = cfg or {}
    54	    base_url = cfg.get("base_url") or ""
    55	    model_id = cfg.get("model_id") or ""
    56	    if not base_url or not model_id:
    57	        if on_missing == "none":
    58	            return None
    59	        raise RuntimeError(error_label)
    60	    cfg_params = cfg.get("params") or {}
    61	    params = params or {}
    62	    temperature = params.get("temperature", cfg_params.get("temperature", default_temperature))
    63	    # thinking 사용값 캐스케이드(스펙 408): 호출자 params(세션) > cfg params(모델·에이전트 병합).
    64	    enable_thinking = params.get("enable_thinking", cfg_params.get("enable_thinking", False))
    65	    # 스트리밍 유효식(스펙 408, 2층): 능력(capabilities.streaming — 사실, 협상 불가) AND
    66	    # 사용값(stream, 기본 켬 — 층별로 끌 수 있음). 능력 없으면 비스트리밍 안전 실행:
    67	    # LangChain이 astream을 ainvoke로 접어 완성문을 1회 yield(SSE 계약·호출부 무변경).
    68	    caps = cfg.get("capabilities") or {}
    69	    stream_effective = bool(caps.get("streaming", True)) and bool(
    70	        params.get("stream", cfg_params.get("stream", True))
    71	    )
    72	    api_key = cfg.get("api_key") or "sk-noauth"
    73	    # 클라이언트 풀(스펙 371 D2) — 같은 연결·모델·파라미터면 인스턴스 재사용(ChatOpenAI는 호출간
    74	    # 무상태·async-safe). 목적은 생성 비용(~0.1ms)이 아니라 **커넥션 재사용**(실 프로바이더 TLS
    75	    # 핸드셰이크 — mock 루프백 사각지대). 키에 api_key 지문 포함 → 로테이션=새 인스턴스.
    76	    # 루프별 격리 — httpx async 클라이언트는 자기 이벤트 루프에 묶인다. 서버는 루프 하나라 늘
    77	    # 적중하고, 루프를 새로 여는 컨텍스트(in-process 테스트의 asyncio.run 반복)는 루프마다 새
    78	    # 인스턴스(죽은 루프의 엔트리는 LRU가 축출). 루프 밖(동기)이면 풀 미사용.
    79	    try:
    80	        loop_id = id(asyncio.get_running_loop())
    81	    except RuntimeError:
    82	        loop_id = None
    83	    key = (
    84	        loop_id,
    85	        base_url,
    86	        hashlib.sha256(api_key.encode()).hexdigest()[:8],
    87	        model_id,
    88	        temperature,
    89	        enable_thinking,
    90	        stream_effective,  # 스트리밍 모드가 다르면 다른 클라이언트(풀 키 분리 — 스펙 408)
    91	    )
    92	    pooled = _CLIENT_POOL.get(key) if loop_id is not None else None
    93	    if pooled is not None:
    94	        return pooled
    95	    client = ChatOpenAI(
    96	        base_url=base_url,
    97	        api_key=api_key,
    98	        model=model_id,
    99	        temperature=temperature,
   100	        # 능력 없음/사용 끔 → astream이 ainvoke로 접혀 완성문 1회 yield(비스트리밍 안전 실행).
   101	        disable_streaming=not stream_effective,
   102	        extra_body={"chat_template_kwargs": {"enable_thinking": enable_thinking}},
   103	    )
   104	    if loop_id is not None:
   105	        if len(_CLIENT_POOL) >= _CLIENT_POOL_MAX:
   106	            _CLIENT_POOL.pop(next(iter(_CLIENT_POOL)))  # 최고령 축출(삽입순)
   107	        _CLIENT_POOL[key] = client
   108	    return client
   210	    p = await get_or_404(session, Provider, body.provider_id, detail="provider not found")
   211	    return await _probe(p.base_url, crypto.decrypt(p.api_key), body.model_id, body.kind)
