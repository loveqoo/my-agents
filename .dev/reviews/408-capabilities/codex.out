   225	async def _require_provider(session: AsyncSession, provider_id: uuid.UUID) -> None:
   226	    if await session.get(Provider, provider_id) is None:
   227	        raise HTTPException(
   228	            status_code=400, detail="provider not found — provider를 먼저 등록하세요."
   229	        )
