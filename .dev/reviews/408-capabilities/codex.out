    46	async def _resolve_judge_llm() -> dict | None:
    47	    """LLM-judge 심판 모델(스펙 139) — 기본 chat 모델(is_default)만 직접 해석. default_mem_cfg는
    48	    embedding까지 요구해 embedding 미설정이 judge를 인질로 잡는다(codex 139 #3) → chat만 본다.
    49	    미설정이면 judge 전부 실패(fail-closed) — run_llm_judge가 사유를 남긴다."""
    50	    from .mem_config import _default_chat_model, llm_cfg_of, model_usable
    51	
    52	    async with SessionLocal() as s:
    53	        _cm = await _default_chat_model(s)
    54	    return llm_cfg_of(_cm) if model_usable(_cm) else None
