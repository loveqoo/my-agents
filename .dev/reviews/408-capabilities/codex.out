   115	        sa_delete(BlockVersion).where(BlockVersion.kind == kind, BlockVersion.block_pk == block_pk)
   116	    )
   117	
   118	
   119	async def ensure_v1_rows(session: AsyncSession) -> int:
   120	    """이력 없는 블록에 v1 백필 + 고아 이력 청소(멱등) — 부트·시드 공용. 기존 DB 이관과 처녀
   121	    빌드가 같은 불변식(블록 행 수 == 이력 보유 블록 수, 고아 0)에 도달한다. 고아 = 라우트 밖
   122	    삭제 경로(테스트 ORM 정리 등)가 남긴 head 없는 이력 — 폴리모픽이라 FK cascade가 없어
   123	    부트가 걷는다(스펙 371 실측: -8 고아가 불변식을 음수로 깼다). 반환: 백필한 블록 수."""
   124	    created = 0
   125	    for kind, (model_cls, _) in BLOCK_KINDS.items():
   126	        # 고아 청소 — head가 사라진 block_pk의 이력 제거.
   127	        head_ids = select(model_cls.id)
   128	        await session.execute(
   129	            sa_delete(BlockVersion).where(
   130	                BlockVersion.kind == kind, BlockVersion.block_pk.not_in(head_ids)
   131	            )
   132	        )
   133	    for kind, (model_cls, to_payload) in BLOCK_KINDS.items():
   134	        have = {
   135	            pk
   136	            for (pk,) in (
   137	                await session.execute(
   138	                    select(BlockVersion.block_pk).where(BlockVersion.kind == kind).distinct()
   139	                )
   140	            ).all()
   141	        }
   142	        for row in (await session.execute(select(model_cls))).scalars():
   143	            if row.id in have:
   144	                continue
   145	            row.version = row.version or 1
   146	            session.add(
   147	                BlockVersion(
   148	                    kind=kind, block_pk=row.id, version=row.version, payload=to_payload(row)
   149	                )
   150	            )
   151	            created += 1
   152	    await session.commit()  # 백필 + 고아 청소 반영(둘 다 멱등)
   153	    return created
   154	
   155	
   156	async def commit_or_409(session: AsyncSession, detail: str) -> None:
   157	    """커밋하되 유니크 충돌(이름 중복·버전 레이스)은 409로 정직 변환."""
   158	    try:
   159	        await session.commit()
   160	    except IntegrityError as e:
   161	        await session.rollback()
   162	        raise HTTPException(status_code=409, detail=detail) from e
   163	
   164	
   165	async def count_missing_history(session: AsyncSession) -> int:
   166	    """검증용(C2) — 이력 없는 블록 수(0이어야 불변식 성립)."""
   167	    missing = 0
   168	    for kind, (model_cls, _) in BLOCK_KINDS.items():
   169	        total = await session.scalar(select(func.count()).select_from(model_cls))
   170	        with_hist = await session.scalar(
   171	            select(func.count(BlockVersion.block_pk.distinct())).where(BlockVersion.kind == kind)
   172	        )
   173	        missing += (total or 0) - (with_hist or 0)
   174	    return missing
