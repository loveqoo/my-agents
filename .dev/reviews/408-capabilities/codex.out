   103	    if ctx.impl == "pipeline":
   104	        tools.extend(runtime.build_agent_tools(broker, await broker.agent_capabilities()))
   105	    run_params = {} if ctx.temperature is None else {"temperature": ctx.temperature}
   106	    build_ctx = AgentBuildContext(
   107	        prompt=prompt_prompt,
   108	        model_cfg=ctx.model_cfg,
   109	        tools=tools,
   110	        checkpointer=None,  # HIL cap은 fail-closed(interrupt→예외→error 관측)
   111	        params=run_params,
