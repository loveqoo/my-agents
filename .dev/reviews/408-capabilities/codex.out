   142	        trace["sentMessagesSource"] = "reconstructed"
   143	
   144	
   145	def _annotate_context_sources(
   146	    trace: dict,
   147	    ctx: ChatContext,
   148	    turn: "ChatTurnRuntime",
   149	    *,
   150	    user_text: str,
   151	    history_restore: dict | None,
   152	) -> None:
   153	    """맥락 출처 주석 — 오버라이드(134)·재구성 실측(289)·브로커(130)·RAG(037)·메모리(079/268/270)."""
   154	    ov_trace = _overrides_trace(ctx.overrides, ctx.overrides_nodes_status)
   155	    if ov_trace:
   156	        # 이 턴에 적용된 오버라이드(스펙 134) — 세션에 설정 다른 턴이 섞여도 턴별 구분 가능.
   157	        trace["overrides"] = ov_trace
   158	    if history_restore:
   159	        # 히스토리 서버 재구성 실측(스펙 289 P1) — 몇 개를 몇 ms에 이어붙였나(캐시 재론의 근거 데이터).
   160	        trace["historyRestore"] = history_restore
   161	    if ctx.attachments_trace:
   162	        # 파일첨부(스펙 404) — 무엇이 주입됐나(파일명·글자수·마스킹 프리뷰). 미첨부 턴은 필드 없음.
   163	        trace["attachments"] = ctx.attachments_trace
   164	    # 응답 방식(스펙 408) — 단건(비스트리밍)일 때만 표기(스트리밍 기본은 무배지). 유효식은
   165	    # 실행부(model.py)와 동일: 능력 AND 사용값.
   166	    _mc = ctx.model_cfg or {}
   167	    _caps = _mc.get("capabilities") or {}
   168	    _mp = _mc.get("params") or {}
   169	    if not (_caps.get("streaming", True) and _mp.get("stream", True)):
   170	        trace["responseMode"] = "single"
   171	    if turn.broker.invocations:
   172	        # 브로커 호출 상세(스펙 130) — 조율형의 RAG 검색이 인스펙터에 "N건·최고 유사도"로 보이게.
   173	        # 위임 없던 턴은 필드 자체가 없음(무회귀).
   174	        trace["brokerCalls"] = _broker_calls_trace(turn.broker.invocations)
   175	    if ctx.rag_collections:
   176	        # 구성된 RAG 컬렉션 — 호출 안 해도 인스펙터에 노출(실제 호출은 trace["mcp"]의 server="rag").
   177	        trace["ragCollections"] = [c["name"] for c in ctx.rag_collections]
   178	    if ctx.rag_unresolved:
   179	        # 요청됐으나 해석 실패한 이름 — 도구가 조용히 비는 footgun을 인스펙터에 드러냄(타자검증 F).
   180	        trace["ragUnresolved"] = ctx.rag_unresolved
   181	    # 회상 쿼리 표시=원발화(스펙 407) — 실제 검색 쿼리와 표시가 일치해야 한다.
   182	    _annotate_memory_observations(
   183	        trace, turn, user_text=user_text if ctx.memory_user_text is None else ctx.memory_user_text
   184	    )
