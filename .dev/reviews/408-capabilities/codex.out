    84	async def _latest(session: AsyncSession, kind: str, block_pk: uuid.UUID) -> BlockVersion | None:
    85	    return await session.scalar(
    86	        select(BlockVersion)
    87	        .where(BlockVersion.kind == kind, BlockVersion.block_pk == block_pk)
    88	        .order_by(BlockVersion.version.desc())
