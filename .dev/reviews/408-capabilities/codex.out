   137	def _apply_agent_model_params(model_cfg: dict, cfg: dict) -> dict:
   138	    """모델 params 위에 에이전트 modelParams(화이트리스트만)를 덮는다 — 미명시 키는 상속."""
   139	    agent_mp = cfg.get("modelParams") or {}
   140	    if not isinstance(agent_mp, dict) or not agent_mp:
   141	        return model_cfg
   142	    merged = dict(model_cfg.get("params") or {})
   143	    for k in MODEL_PARAM_OVERRIDE_KEYS:
   144	        if k in agent_mp and agent_mp[k] is not None:
   145	            merged[k] = agent_mp[k]
   146	    return {**model_cfg, "params": merged}
