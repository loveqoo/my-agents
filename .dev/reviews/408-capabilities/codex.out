   265	@router.put("/{model_id}", response_model=ModelOut, dependencies=[_manage])
   266	async def update_model(
   267	    model_id: uuid.UUID, body: ModelIn, session: AsyncSession = Depends(get_session)
   268	) -> ModelOut:
   269	    m = await get_or_404(session, ModelConfig, model_id)
   270	    await _require_provider(session, body.provider_id)
   271	    m.name = body.name
   272	    m.provider_id = body.provider_id
   273	    m.model_id = body.model_id
   274	    m.kind = body.kind
   275	    if body.is_default:
   276	        await _clear_other_defaults(session, body.kind, exclude_id=m.id)
   277	    m.is_default = body.is_default
   278	    m.params = body.params
   279	    m.capabilities = body.capabilities  # 능력 선언(스펙 408)
   280	    m.meta = body.meta
   281	    # is_default·meta는 payload 제외(스펙 369 §2) — 운영-only 변경은 버전 무증가.
   282	    await record_block_version(session, "model", m)
   283	    await _commit_or_409(session, "동시 변경 충돌 또는 중복 — 다시 시도하세요.")
   284	    reloaded = await _get_with_provider(session, m.id)
   285	    assert reloaded is not None  # 방금 커밋한 행의 재로드 — 동시 삭제 레이스 외엔 불가
   286	    return model_to_out(reloaded)
