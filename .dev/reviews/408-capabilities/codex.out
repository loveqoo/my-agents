    32	def _mcp_payload(o: McpServer) -> dict:
    33	    # status(라이브 헬스)·published(서빙 토글)·auth(비밀)·owner_id(소유)는 제외.
    34	    return {
    35	        "name": o.name,
    36	        "description": o.description,
    37	        "source": o.source,
    38	        "transport": o.transport,
    39	        "url": o.url,
    40	        "endpoint": o.endpoint,
