   289	@router.put("/{model_id}/default", response_model=ModelOut, dependencies=[_manage])
   290	async def set_default_model(
   291	    model_id: uuid.UUID, session: AsyncSession = Depends(get_session)
   292	) -> ModelOut:
   293	    """이 모델을 그 kind(chat/embedding)의 기본으로 지정 — 같은 kind의 기존 기본은 자동 해제
   294	    (스펙 150, 실사용 버그 #1: 등록 모달에만 기본 스위치가 있어 삭제 후 재등록으로만 전환 가능했다).
   295	    전용 액션인 이유: 프론트가 부분 데이터로 full PUT을 재구성하면 params/meta 유실 위험."""
   296	    m = await get_or_404(session, ModelConfig, model_id)
   297	    if m.kind not in ("chat", "embedding"):
   298	        # 레거시/수동 행 방어(codex 150) — 런타임은 chat/embedding 기본만 읽으므로 그 외 kind의
   299	        # "기본 지정 성공"은 아무 효과 없는 거짓 성공이 된다.
   300	        raise HTTPException(
   301	            status_code=400,
   302	            detail=f"kind={m.kind!r}는 기본 지정 대상이 아닙니다(chat/embedding만).",
   303	        )
   304	    await _clear_other_defaults(session, m.kind, exclude_id=m.id)
   305	    m.is_default = True
     1	"""블록 버전 관문(스펙 369) — append-only 단조 불변 버전의 단일 진입점.
     2	
     3	5종 블록(prompt·memory-type·mcp-server·model·provider)의 모든 콘텐츠 변경 경로가
     4	`record_block_version`을 경유한다(PUT·재탐색 동기화·생성). 잡별 삽입 금지 — 미경유 mutate가
     5	남으면 그 경로만 버전 없이 동작이 바뀐다(스펙 369 C6 전수 대장으로 확인).
     6	
     7	경계(스펙 369 §2): payload = 동작을 결정하는 저작 내용만. 운영 상태(status·published·
     8	is_default·meta)·비밀(api_key·auth)은 head 전용 — 이력에 비밀 잔존 금지, 운영 변경은 버전 무증가.
     9	payload 정의는 이 모듈이 단일 출처(마이그레이션 SQL로 중복 정의하지 않는다 — drift 방지).
    10	"""
    11	
