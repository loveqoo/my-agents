   232	@router.post("", response_model=ModelOut, status_code=201, dependencies=[_manage])
   233	async def create_model(body: ModelIn, session: AsyncSession = Depends(get_session)) -> ModelOut:
   234	    await _require_provider(session, body.provider_id)
   235	    if body.is_default:
   236	        await _clear_other_defaults(session, body.kind)
   237	    m = ModelConfig(
   238	        name=body.name,
   239	        provider_id=body.provider_id,
   240	        model_id=body.model_id,
   241	        kind=body.kind,
   242	        is_default=body.is_default,
   243	        params=body.params,
   244	        capabilities=body.capabilities,  # 능력 선언(스펙 408)
   245	        meta=body.meta,
   246	    )
   247	    session.add(m)
   248	    await _commit_or_409(session, "동시 변경 충돌 또는 중복 — 다시 시도하세요.")
   249	    await session.refresh(m)
   250	    await record_block_version(session, "model", m)  # v1 이력(스펙 369)
   251	    await session.commit()
   252	    reloaded = await _get_with_provider(session, m.id)
   253	    assert reloaded is not None  # 방금 커밋한 행의 재로드 — 동시 삭제 레이스 외엔 불가
   254	    return model_to_out(reloaded)
   255	
   256	
   257	@router.get("/{model_id}", response_model=ModelOut)
   258	async def get_model(model_id: uuid.UUID, session: AsyncSession = Depends(get_session)) -> ModelOut:
   259	    m = await _get_with_provider(session, model_id)
   260	    if m is None:
   261	        raise HTTPException(status_code=404, detail="not found")
   262	    return model_to_out(m)
