   107	async def _resolve_node_models(
   108	    db: AsyncSession, nodes: list, default_cfg: dict | None, pins: dict | None = None
   109	) -> list[dict]:
   110	    """노드형(스펙 259) 노드별 모델을 레지스트리에서 미리 해석해 `model_cfg`를 심는다(085 U2 — impl은
   111	    DB 미접촉). 에이전트 모델 해석과 **동일 조회**(`ModelConfig.name==name, kind=="chat"`, provider
   112	    상속) — 드리프트 0. 미지정/미존재 이름은 `default_cfg`(에이전트 기본 chat 모델)로 폴백. 같은 모델
   113	    이름은 1회만 조회해 재사용(N 노드 M 중복 모델 → distinct 쿼리). 순수 데이터 반환(잡 노드는 통과 —
   114	    정규화는 impl의 normalize_nodes가)."""
   115	    resolved: list[dict] = []
   116	    cache: dict[str, dict | None] = {}
   117	    for node in nodes:
   118	        if not isinstance(node, dict):
   119	            continue
   120	        name = node.get("model")
   121	        cfg = None
   122	        if isinstance(name, str) and name.strip():
   123	            if name not in cache:
   124	                cache[name] = await _chat_model_cfg(db, name, pins)
   125	            cfg = cache[name]
   126	        # 심은 model_cfg는 해석된 노드 모델(없으면 에이전트 기본으로 폴백 — impl의 _model_from_node).
   127	        resolved.append({**node, "model_cfg": cfg or default_cfg})
   128	    return resolved
