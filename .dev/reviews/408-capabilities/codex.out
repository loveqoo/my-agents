    20	async def _load_harness_cases(dataset_id: uuid.UUID) -> list[HarnessCase]:
    21	    """문제집 케이스 → 하네스 케이스(순서 보존). 스펙 195: 성적표 식별자(case_name)에 **질문**을
    22	    넣는다 — DB name은 내부 해시라 성적표에 뜨면 유저가 못 알아본다. 표시 상한 200자."""
    23	    async with SessionLocal() as s:
    24	        rows = (
    25	            (
    26	                await s.execute(
    27	                    select(EvalCase)
    28	                    .where(EvalCase.dataset_id == dataset_id)
    29	                    .order_by(EvalCase.order_idx, EvalCase.created_at)
    30	                )
    31	            )
    32	            .scalars()
    33	            .all()
    34	        )
    35	        return [
    36	            HarnessCase(
    37	                name=(c.input or c.name)[:200],
    38	                input=c.input,
    39	                asserts=build_asserts(c.asserts),
    40	                meta={"raw_asserts": c.asserts},
    41	            )
    42	            for c in rows
    43	        ]
    44	
