   214	@router.post("/{model_id}/test", response_model=ModelProbeResult)
   215	async def test_saved_model(
   216	    model_id: uuid.UUID, session: AsyncSession = Depends(get_session)
   217	) -> ModelProbeResult:
   218	    """저장된 모델로 연결 테스트(provider 자격증명 복호화)."""
   219	    m = await _get_with_provider(session, model_id)
   220	    if m is None:
