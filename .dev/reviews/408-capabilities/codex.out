    58	def _provider_payload(o: Provider) -> dict:
    59	    # api_key(비밀) 제외 — 키 로테이션은 운영 행위(버전 무증가, 이력에 비밀 잔존 금지).
    60	    return {
    61	        "name": o.name,
    62	        "protocol": o.protocol,
    63	        "base_url": o.base_url,
    64	        "kind": o.kind,
    65	        "description": o.description,
