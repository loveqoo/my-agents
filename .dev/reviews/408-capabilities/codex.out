    57	async def _persist_report(run_id: uuid.UUID, report) -> None:  # noqa: ANN001 — EvalReport(하네스 타입)
    58	    """성적 영속 — case_results insert 후 run을 ok로 종결(+finished_at). 순서 동결(codex 399)."""
    59	    async with SessionLocal() as s:
    60	        run = await s.get(EvalRun, run_id)
    61	        if run is None:
    62	            return
    63	        for result in report.results:
    64	            s.add(
    65	                EvalCaseResult(
    66	                    run_id=run_id,
    67	                    case_name=result.name,
    68	                    case_passed=result.passed,
    69	                    details=[list(d) for d in result.details],
    70	                    obs=result.obs,
    71	                )
    72	            )
    73	        run.status = "ok"
    74	        run.score = report.score
    75	        run.passed = report.passed
    76	        run.total = report.total
    77	        run.summary = {"summary": report.summary()}
    78	        run.finished_at = datetime.now(UTC)
    79	        await s.commit()
    80	
    81	
    82	async def _mark_run_error(run_id: uuid.UUID, exc: Exception) -> None:
    83	    """실행 실패 박제 — status=error+사유(캡)+finished_at. 박제 실패는 삼킴(배경 태스크 크래시 금지)."""
    84	    try:
    85	        async with SessionLocal() as s:
    86	            run = await s.get(EvalRun, run_id)
    87	            if run is not None:
    88	                run.status = "error"
    89	                run.error = str(exc)[:1000]
    90	                run.finished_at = datetime.now(UTC)
    91	                await s.commit()
    92	    except Exception:
    93	        pass
    94	
