    93	async def record_block_version(session: AsyncSession, kind: str, row: Any) -> bool:
    94	    """콘텐츠 변경 후·commit 전에 호출 — payload가 직전 버전과 다르면 head.version+1 + 이력 append.
    95	
    96	    동일 payload(운영-only 변경·무변경 저장)는 no-op(버전 무증가). 이력이 아예 없으면 v1 기록
    97	    (신규 생성·백필). 동시 편집은 UNIQUE(kind,block_pk,version)가 commit에서 막는다 → 409는
    98	    호출부의 commit_or_409 몫. 반환: 버전이 올랐는가."""
    99	    payload = payload_for(kind, row)
   100	    last = await _latest(session, kind, row.id)
   101	    if last is None:
   102	        row.version = row.version or 1
   103	        session.add(BlockVersion(kind=kind, block_pk=row.id, version=row.version, payload=payload))
   104	        return True
   105	    if last.payload == payload:
   106	        return False  # 저작 내용 동일 — 운영 변경/무변경 저장은 버전 무증가(스펙 369 C4)
   107	    row.version = last.version + 1
   108	    session.add(BlockVersion(kind=kind, block_pk=row.id, version=row.version, payload=payload))
   109	    return True
