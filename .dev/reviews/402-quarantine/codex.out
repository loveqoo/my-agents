   179	async def _validate_entry(
   180	    agent_id: uuid.UUID, body: ChatRequest, principal: User | str
   181	) -> str | None:
   182	    """채팅 진입 게이트 — 사용 권한(147)·버전 지정 권한(242)·재개 턴 버전 승계. 반환: 적용할 version."""
   183	    # 사용 게이트(스펙 147): private 에이전트는 소유자·특권만 — 목록에서 안 보이는 존재이므로
   184	    # 404-fold(068 — 403으로 존재를 알려주지 않는다).
   185	    from .models import Agent as _AgentRow
   186	    from .ownership import may_use_agent
   187	
   188	    async with SessionLocal() as _s:
   189	        arow = await _s.get(_AgentRow, agent_id)
   190	    if arow is None or not may_use_agent(arow, principal):
   191	        raise HTTPException(status_code=404, detail="agent not found")
   192	    req_version = body.version
   193	    if req_version is not None:
   194	        # 버전 지정 실행은 관리 권한(codex 242 #2) — 초안은 미공개 작업본이라 "사용 권한만" 있는
   195	        # 유저의 미리보기는 누출. 버전 목록 자체는 상세에 보이므로 403 명시(404-fold 불요).
   196	        from .ownership import may_manage as _may_manage
   197	
   198	        if not _may_manage(arow, principal):
   199	            raise HTTPException(
   200	                status_code=403, detail="버전 지정 실행은 이 에이전트를 관리할 수 있어야 합니다"
   201	            )
   202	    elif body.sessionId:
   203	        # ask/form 재개 턴의 버전 승계(codex 242 #1) — 미리보기 턴이 만든 pending(체크포인트)은 그
   204	        # 버전 config로만 재개해야 한다(활성 config로 재개하면 drift). 클라이언트가 재개 턴에 version을
   205	        # 안 보내도 서버가 pending에 저장해 둔 버전을 이어받는다.
   206	        pend = _PENDING_ARTIFACT.get(body.sessionId)
   207	        if pend and pend.get("version"):
   208	            req_version = pend["version"]
   209	    return req_version
   210	
