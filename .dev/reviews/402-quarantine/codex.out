    67	    from .users import current_user_optional
    68	
    69	    async def _principal(
    70	        authorization: str | None = Header(default=None),
    71	        user: User | None = Depends(current_user_optional),
    72	    ) -> User | str:
    73	        if user is not None:  # 세션 쿠키 인증
    74	            audit.set_actor(audit.actor_of(user))  # 감사 actor(스펙 343) — 이메일 로컬파트
    75	            return user
