   278	def _assert_source_immutable(data: dict, obj: McpServer) -> None:
   279	    """source(유래)는 생성 후 불변(스펙 152, codex High) — external→local 세탁 후 publish하는
   280	    재공개 우회를 봉인. provenance는 등록 시점의 사실이지 편집 대상이 아니다."""
   281	    if data.get("source") and data["source"] != obj.source:
   282	        raise HTTPException(status_code=400, detail="source(유래)는 생성 후 변경할 수 없습니다.")
   283	
   284	
   285	async def _assert_renameable(session: AsyncSession, obj: McpServer, new_name: str) -> None:
   286	    """이름 변경 가드(스펙 093/148/360) — 이름 규칙·예약 서빙 이름·참조 무결성(409).
   287	
   288	    런타임은 McpServer.name.in_(config["mcps"])로 해석하므로 참조 중인 서버 name을 바꾸면 옛 name이
   289	    dangling 되어 도구가 조용히 사라진다 → 참조가 있으면 rename을 409로 막는다(값은 옛 name 기준)."""
   290	    assert_valid_name(new_name)  # 이름 변경 시에만 규칙(기존은 grandfather, 스펙 148)
   291	    from . import served_mcp
   292	
   293	    if new_name in served_mcp.SERVED_MCPS:
   294	        # 예약 서빙 이름 개명 차단(스펙 360, codex 방어심화) — 생성 게이트와 대칭.
   295	        # 시스템 served 행이 지워진 틈에 사용자 행을 served 이름으로 개명해 SSRF 예외 대상으로
   296	        # 만드는 우회를 봉인한다(그래도 url이 정확 served_url이어야 예외라 임의 내부주소는 불가).
   297	        raise HTTPException(
   298	            status_code=400, detail="예약된 서빙 MCP 이름입니다 — 다른 이름을 쓰세요."
   299	        )
   300	    refs = await agents_referencing(session, "mcps", obj.name)
   301	    if refs:
   302	        raise HTTPException(
   303	            status_code=409, detail=referenced_message(refs, "MCP 서버", action="이름 변경")
   304	        )
