    76	async def _resolve_mcp_servers(
    77	    db: AsyncSession, cfg: dict, pins: dict | None = None
    78	) -> tuple[list[dict], list]:
    79	    """등록된 MCP 서버를 runtime.build_mcp_tools가 붙을 수 있는 dict로 해석(스펙 054).
    80	
    81	    enabled_tools가 비면 서버 전체 도구 노출(get_tools가 결정). 사용=공용(스펙 211, RAG 172 동형)
    82	    — 등록된 MCP는 어떤 에이전트든 배선 가능(구 113 배선 인가 제거). auth 토큰 있는 MCP도 공용
    83	    배선(공유 카탈로그 모델), 관리(수정/삭제)는 여전히 소유자만. 반환 (mcp_servers, tool_names)."""
    84	    mcp_servers: list[dict] = []
    85	    mcps = config_names(cfg, "mcps")  # 삭제 가드와 동일 normalizer(drift 0, codex P2)
    86	    if mcps:
    87	        rows = (await db.execute(select(McpServer).where(McpServer.name.in_(mcps)))).scalars().all()
    88	        for row in rows:
    89	            mcp_servers.append(await _mcp_server_projection(db, row, pins))
