   187	                    kwargs
   188	                ),  # 스펙 087: Approval.args(DB 영속)·ApprovalsView로 새기 전 마스킹
   189	                "summary": f"{server}.{rt.name} 실행 — {'본인' if approver == 'self' else '관리자'} 승인 필요",
   190	            }
   191	        )
   192	        approved = isinstance(decision, dict) and decision.get("decision") == "approve"
   193	        if not approved:
   194	            # 거부: 부수효과 0(ainvoke·sink 미emit) — 에이전트는 이 사실로 마무리.
   195	            return "거부됨 — 관리자가 실행을 승인하지 않았습니다."
   196	        return await _execute(kwargs, t0, sink)
   197	
   198	    desc = rt.description or f"{server} 서버의 {rt.name} 도구."
   199	    if permission is not None:
   200	        desc += " ⚠ 위험 작업: 호출 시 관리자 승인 전까지 일시정지됩니다."
   201	    return StructuredTool.from_function(
   202	        coroutine=_run,
   203	        name=_safe_name(server, rt.name),
   204	        description=desc,
   205	        args_schema=rt.args_schema,
   206	    )
