   178	def _cfg_block_names(cfg: dict) -> list[tuple[str, str]]:
   179	    """에이전트 config가 참조하는 (kind, name) 목록 — freeze 대상의 단일 출처.
   180	
   181	    prompt·model(에이전트 레벨 + 노드형 노드별 model)·mcps·memories. RAG(vectorTables)는 제외(367 —
   182	    라이브). 노드 프롬프트는 인라인 텍스트라 참조 아님."""
   183	    out: list[tuple[str, str]] = []
   184	    if cfg.get("prompt"):
   185	        out.append(("prompt", cfg["prompt"]))
   186	    if cfg.get("model"):
   187	        out.append(("model", cfg["model"]))
   188	    for node in cfg.get("nodes") or []:
   189	        if isinstance(node, dict) and node.get("model"):
   190	            out.append(("model", node["model"]))
   191	    for name in cfg.get("mcps") or []:
   192	        if isinstance(name, str):
   193	            out.append(("mcp-server", name))
   194	    for name in cfg.get("memories") or []:
   195	        if isinstance(name, str):
   196	            out.append(("memory-type", name))
   197	    return out
   198	
   199	
   200	_NAME_COL = {
   201	    "prompt": lambda: Prompt.name,
   202	    "model": lambda: ModelConfig.name,
   203	    "mcp-server": lambda: McpServer.name,
   204	    "memory-type": lambda: MemoryType.name,
   205	}
   206	
   207	
   208	async def _head_versions(session: AsyncSession, kind: str, names: set[str]) -> dict[str, int]:
   209	    """{이름: head 버전} — freeze·stale 비교 공용."""
   210	    if not names:
   211	        return {}
   212	    model_cls = BLOCK_KINDS[kind][0]
   213	    col = _NAME_COL[kind]()
   214	    rows = await session.execute(select(col, model_cls.version).where(col.in_(names)))
   215	    return dict(rows.all())
   216	
   217	
   218	async def freeze_pins(session: AsyncSession, cfg: dict) -> dict:
   219	    """config가 참조하는 블록들의 **현재 head 버전**을 못박는다(스펙 370) — 에이전트 버전 생성/편집
   220	    시점에 호출. 미존재 참조(오탈자·literal 프롬프트)는 pin 없이 통과(런타임이 기존 폴백)."""
   221	    refs = _cfg_block_names(cfg)
   222	    by_kind: dict[str, set[str]] = {}
   223	    for kind, name in refs:
   224	        by_kind.setdefault(kind, set()).add(name)
   225	    pins: dict[str, int] = {}
   226	    for kind, names in by_kind.items():
   227	        for name, ver in (await _head_versions(session, kind, names)).items():
   228	            pins[f"{kind}:{name}"] = ver
   229	    return pins
   230	
   231	
   232	async def resolve_pinned(
   233	    session: AsyncSession, pins: dict | None, kind: str, name: str
   234	) -> dict | None:
   235	    """pins가 못박은 버전의 payload를 이력에서 읽는다 — 없으면 None(호출부가 head 폴백).
   236	
   237	    이름→block_pk는 head 행으로 해석(개명·삭제는 참조 가드가 막으므로 이름이 안정 키)."""
   238	    ver = (pins or {}).get(f"{kind}:{name}")
   239	    if not ver:
   240	        return None
   241	    model_cls = BLOCK_KINDS[kind][0]
   242	    col = _NAME_COL[kind]()
   243	    head = (await session.execute(select(model_cls).where(col == name))).scalars().first()
   244	    if head is None:
   245	        return None
   246	    if head.version == ver:
   247	        return None  # pin == head — 라이브 경로 그대로(오버레이 불필요, 최빈 경로 조회 1회 절약)
   248	    row = await session.scalar(
   249	        select(BlockVersion).where(
   250	            BlockVersion.kind == kind,
   251	            BlockVersion.block_pk == head.id,
   252	            BlockVersion.version == ver,
   253	        )
   254	    )
   255	    return dict(row.payload) if row is not None else None
