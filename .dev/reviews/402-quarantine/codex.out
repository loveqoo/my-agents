   209	def mcp_connection(server: dict) -> dict | None:
   210	    """서버 dict(`{name,url,transport,auth_token}`)를 `MultiServerMCPClient` 연결 dict로 변환.
   211	
   212	    미지원 transport(stdio 등)나 SSRF 차단 URL이면 None(호출부가 그 서버를 스킵). `build_mcp_tools`(그래프
   213	    preload)와 능력 브로커 `McpProvider`(동적 discover→invoke, 스펙 101)가 **이 한 함수를 공유**해
   214	    transport·Bearer·리다이렉트 하드닝(`mcp_http_client_factory`) 정책이 한 곳에서만 산다(드리프트 0).
   215	    호출 전 `net_guard.refresh_allowed_hosts()`는 호출부 책임(루프당 1회 — DB round-trip 중복 방지)."""
   216	    from . import net_guard
   217	
   218	    if (server.get("transport") or "").lower() not in ("http", "streamable_http"):
   219	        return None  # stdio 등 미지원 transport
   220	    url = server.get("url") or ""
   221	    # 스펙 360: 우리 자체 served MCP(플랫폼이 자기 자신에 붙는 127.0.0.1 서빙 엔드포인트)는 SSRF
   222	    # 판정 대상이 아니다 — 목적지가 사용자 입력이 아니라 served_url(name)로 플랫폼이 정한 고정값이라
   223	    # SSRF가 아니다. 데이터 리셋으로 allowed_hosts에서 127.0.0.1이 빠져도 자체 served MCP는 동작해야
   224	    # 한다. 예외는 의도 신호(레지스트리 이름 + served_url 정확 일치)라 사용자가 임의 url로 우회 못 함.
   225	    from .served_mcp import is_own_served_url
   226	
   227	    if not is_own_served_url(server.get("name"), url):
   228	        try:
   229	            net_guard.guard_url(url)
   230	        except net_guard.SsrfBlockedError:
   231	            return None  # SSRF 차단 서버는 연결 자체를 안 함(부수효과 0)
   232	    headers: dict[str, str] = {}
   233	    token = server.get("auth_token")
   234	    if token:
   235	        headers["Authorization"] = f"Bearer {token}"
   236	    return {
   237	        "transport": "streamable_http",
   238	        "url": url,
   239	        "headers": headers or None,
   240	        # 리다이렉트-SSRF 차단(적대 리뷰 H1): 기본 클라이언트는 3xx를 따라가 가드를 우회하고 토큰을
   241	        # 재전송한다 → follow_redirects=False 팩토리로 fail-closed(a2a_client와 동일 정책).
   242	        "httpx_client_factory": net_guard.mcp_http_client_factory,
   243	    }
   244	
   245	
   246	def selected_for_server(server: str, selected: list[str] | None) -> set[str] | None:
   247	    """이 서버에 대한 도구 노출 필터(스펙 276) — None=전체 노출(폴백), set=그 런타임명만.
   248	
   249	    selected 항목은 런타임명(`server__tool`, _safe_name 산출). 서버명은 NAME_RULE(영소문자·숫자·대시,
   250	    밑줄 금지)이라 `server__` 접두 분리가 모호하지 않다(272 불변식 공유). **이 서버 항목이 하나도
   251	    없으면 None(전체)** — 이 폴백 하나가 세 무회귀를 담당: ①구저장(tools 빈 목록)=기존과 동일,
   252	    ②오버라이드로 서버 통째 추가, ③카탈로그에 도구 목록이 없는 서버의 보존."""
   253	    if not selected:
   254	        return None
   255	    prefix = f"{server}__"
   256	    mine = {s for s in selected if isinstance(s, str) and s.startswith(prefix)}
   257	    return mine or None
   258	
