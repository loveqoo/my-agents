   114	async def _assert_removed_tools_unreferenced(
   115	    session: AsyncSession, obj: McpServer, new_tools: list[str]
   116	) -> None:
   117	    """재탐색으로 사라질 도구를 참조하는 에이전트가 있으면 409(없으면 통과).
   118	
   119	    참조 보호(codex 151 Medium): 원격이 일시적으로 도구를 빠뜨리면 재탐색 한 번에 에이전트의
   120	    툴 단위 능력(`mcp:{서버}/{도구}`)이 조용히 사라진다 — 제거될 도구를 참조하는 에이전트가
   121	    있으면 409(rename/삭제 가드와 같은 operation-symmetry). 스캔은 references로 상향(스펙 393)."""
   122	    removed = [t for t in (obj.enabled_tools or []) if t not in set(new_tools)]
   123	    if not removed:
   124	        return
   125	    refs = await agents_referencing_mcp_tools(session, obj.name, removed)
   126	    if refs:
   127	        raise HTTPException(
   128	            status_code=409,
   129	            detail=referenced_message(
   130	                refs, f"MCP 도구({', '.join(removed[:5])})", action="재탐색(도구 제거)"
   131	            ),
   132	        )
