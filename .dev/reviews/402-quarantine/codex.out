    80	def resolve_tool_approval(
    81	    server: str,
    82	    tool: str,
    83	    tools_meta: dict | None = None,
    84	    tool_policy: dict | None = None,
    85	) -> dict | None:
    86	    """도구 승인 정책 리졸버(스펙 177) — 승인이 필요하면 `{"permission", "approver"}`, 아니면 None.
    87	
    88	    **단일 진실원**: 그래프-tools 경로(`_wrap_mcp_tool`)와 브로커 경로
    89	    (`broker.McpProvider.approval_for`)가 이 함수 하나를 공유한다(드리프트 0). 우선순위:
    90	      1. **도구 기본**(P1) = `_base_approval` — tools_meta, 없으면 레거시 폴백.
    91	      2. **에이전트 오버라이드**(P2) = `_apply_approval_override` — tool_policy로 덮음.
    92	    approver는 승인 인가에 쓰인다(`approvals._may_resolve`): admin=관리자만, self=요청 소유자 본인.
    93	    permission 문자열은 표시·감사·레거시 하위호환용(인가는 approver 필드로 — 세그먼트 이스케이프 무관).
    94	    """
    95	    required, approver, permission = _base_approval(server, tool, tools_meta)
    96	    required, approver = _apply_approval_override(required, approver, server, tool, tool_policy)
    97	    if not required:
    98	        return None
    99	    return {
   100	        "permission": permission,
   101	        "approver": approver if approver in ("admin", "self") else "admin",
   102	    }
