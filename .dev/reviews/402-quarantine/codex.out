   187	    approval = ((obj.tools_meta or {}).get(tool_name) or {}).get("approval") or {}
   188	    if approval.get("required") and not confirm:
   189	        raise HTTPException(
   190	            status_code=400,
   191	            detail="승인 정책이 걸린 도구입니다 — 부수효과를 확인하고 confirm으로 재시도하세요.",
   192	        )
