   171	    async def _run(config: RunnableConfig = None, **kwargs: Any) -> str:
   172	        t0 = time.perf_counter()
   173	        sink = _sink_from(config, calls_sink)
   174	        if permission is None:
   175	            return await _execute(kwargs, t0, sink)
   176	        # 위험 도구: 실 부수효과 이전에 일시정지. interrupt()는 첫 호출 시 그래프를 멈추고,
   177	        # admin이 Command(resume={"decision":...})로 재개하면 그 값을 반환한다(도구는 처음부터
   178	        # 재실행되지만 interrupt 이전엔 부수효과가 없어 정확히 1회만 ainvoke — 스펙 041 probe로 검증).
