   261	        etype = type(exc).__name__.lstrip("_")
   262	        return McpToolTestOut(ok=False, error=_sanitize_preview(f"{etype}: {exc}", _ERR_CAP))
   263	    rec = calls_sink[-1] if calls_sink else {}
   264	    return McpToolTestOut(
   265	        ok=rec.get("status") == "ok",
   266	        ms=int(rec.get("ms") or 0),
   267	        result=rec.get("result"),
   268	        error=rec.get("error"),
   269	    )
