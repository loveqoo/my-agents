    41	# HIL 승인 게이트 정책(스펙 041) — approver=admin 권한에 묶인 (server, tool) 도구만.
    42	# 이 도구를 ReAct가 호출하면 **실 부수효과(rt.ainvoke) 이전에** langgraph interrupt로 그래프가
    43	# 일시정지되고, admin 승인 전에는 절대 실행되지 않는다(핵심 불변식). 정책은 코드 한 곳 — verify로 핀.
    44	# 키는 (McpServer.name, 도구이름). seed가 이 서버/도구를 노출한다.
    45	# "local-tools"는 mock_mcp.MOCK_MCP_SERVER_NAME — verify 테스트가 두 상수의 일치를 단언한다(drift 방지).
    46	_APPROVAL_ACTIONS: dict[tuple[str, str], str] = {
    47	    ("local-tools", "delete_record"): "data.delete",
    48	}
    49	
    50	
    51	def _base_approval(server: str, tool: str, tools_meta: dict | None) -> tuple[bool, str, str]:
    52	    """도구 기본 승인(스펙 177 P1) — tools_meta[tool].approval(관리자 데이터) 우선, 없으면 레거시
    53	    _APPROVAL_ACTIONS 폴백(무회귀). 반환 (required, approver, permission)."""
    54	    meta = tools_meta.get(tool) if isinstance(tools_meta, dict) else None
    55	    base = meta.get("approval") if isinstance(meta, dict) else None
    56	    if isinstance(base, dict):
    57	        return bool(base.get("required")), base.get("approver") or "admin", f"mcp.{server}.{tool}"
    58	    # 레거시 폴백(tools_meta에 approval 없을 때만) — delete_record 등 기존 게이트 보존.
    59	    legacy = _APPROVAL_ACTIONS.get((server, tool))
    60	    return legacy is not None, "admin", legacy or f"mcp.{server}.{tool}"
    61	
