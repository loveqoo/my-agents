    45	
    46	def is_valid_machine_token(authorization: str | None) -> bool:
    47	    """머신 Bearer 토큰 유효성(예외 없이 bool). 통합 principal의 fallback에 사용."""
    48	    if not authorization or not authorization.startswith("Bearer "):
    49	        return False
    50	    presented = authorization[7:]
    51	    # 빈 토큰 거부 + 상수시간 비교(타이밍 공격 방지).
    52	    return bool(presented) and secrets.compare_digest(presented, _token())
