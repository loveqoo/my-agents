    34	def _safe_name(server: str, tool_name: str) -> str:
    35	    """LLM 툴 이름 제약([A-Za-z0-9_-])에 맞게 정규화. 원래 server/tool은 트레이스에 유지."""
    36	    raw = f"{server}__{tool_name}"
    37	    safe = re.sub(r"[^A-Za-z0-9_-]", "_", raw)[:60]
    38	    return safe or "tool"
