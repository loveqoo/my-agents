   135	@router.post("/mcp-servers/{id}/rediscover", response_model=McpServerOut)
   136	async def rediscover_mcp_server(
   137	    id: uuid.UUID,
   138	    session: AsyncSession = Depends(get_session),
   139	    principal: User | str = Depends(current_principal),
   140	) -> Any:
   141	    """저장된 MCP 서버의 도구·메타를 재탐색해 갱신(스펙 151 — 상세 화면 '도구 정보 새로 탐색').
   142	
   143	    저장된 자격증명을 **백엔드에서 복호**해 쓴다(프론트는 마스킹 토큰만 가져 재탐색 불가).
   144	    enabled_tools는 새 목록과의 교집합으로 보존(사라진 도구만 떨어냄 — 임의 활성화 없음)."""
   145	    obj = await get_or_404(session, McpServer, id)
   146	    assert_may_manage(obj, principal)  # 소유자/특권만(스펙 112)
   147	    if obj.transport != "http" or not obj.url:
   148	        raise HTTPException(
   149	            status_code=400, detail="http transport + URL이 있는 서버만 재탐색할 수 있습니다."
   150	        )
   151	    token = crypto.decrypt(obj.auth) if obj.auth else None
   152	    result = await _live_discover(obj.url, token)
   153	    if not result.ok:
   154	        raise HTTPException(status_code=502, detail=f"재탐색 실패 — {result.detail}")
   155	    await _assert_removed_tools_unreferenced(session, obj, result.tools)
   156	    obj.tools = result.tools
   157	    # 기존 tools_meta를 넘겨 관리자 승인 정책(approval, 스펙 177)을 이월 보존 — 재탐색이 게이트를 지우지 않게.
   158	    obj.tools_meta = _tools_meta_from_details(
   159	        [d.model_dump() for d in result.toolsDetail], obj.tools_meta
   160	    )
   161	    obj.enabled_tools = [t for t in (obj.enabled_tools or []) if t in result.tools]
   162	    obj.status = "connected"
   163	    # 재탐색도 콘텐츠 변경(tools/tools_meta — 에이전트 동작 결정) → 버전 관문 경유(스펙 369).
   164	    # 도구 무변경 재탐색은 payload 동일이라 자동 no-op.
   165	    await record_block_version(session, "mcp-server", obj)
   166	    await _commit_or_409(session, "동시 편집과 겹쳤습니다 — 다시 시도하세요.")
   167	    await session.refresh(obj)
   168	    return mcp_to_out(obj)
