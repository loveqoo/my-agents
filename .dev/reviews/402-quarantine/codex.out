   110	def _wrap_mcp_tool(
   111	    server: str, rt: BaseTool, calls_sink: list[dict], approval: dict | None
   112	) -> StructuredTool:
   113	    """실 MCP 도구(rt)를 트레이스·HIL 게이트·graceful 래퍼로 감싼다.
   114	
   115	    rt.args_schema(JSON 스키마 dict)를 그대로 보존해 LLM이 원 도구 시그니처대로 호출하게 한다.
   116	    `approval`(호출부 `resolve_tool_approval`가 해석, 스펙 177 = `{permission, approver}` 또는 None)이
   117	    non-None인 도구는 **rt.ainvoke(부수효과) 이전에 interrupt()** 로 그래프를 멈춰 승인을 받는다(스펙 041
   118	    불변식, 실 도구 위에서 재성립). approver(admin/self)는 interrupt 페이로드로 실려 Approval에 스탬프됨
   119	    → `approvals._may_resolve` 인가에 쓰인다. 도구 실행 실패(서버 다운·프로토콜·타임아웃)는 잡아 graceful
   120	    문자열 + calls_sink status="error"로 — 에이전트 크래시 금지.
   121	    """
   122	    permission = approval["permission"] if approval else None
   123	    approver = (approval.get("approver") or "admin") if approval else "admin"
   124	
   125	    # 도구 실패를 이 래퍼의 단일 except로 모은다(스펙 320). langchain-mcp-adapters는 MCP
   126	    # `isError=True`를 ToolException(_MCPToolExecutionError)으로 만든 뒤 tool.handle_tool_error로
   127	    # **삼켜 정상 문자열**로 돌려준다("Error executing tool …") → status=ok로 오기록돼 사유가 사라진다.
   128	    # handle_tool_error를 끄면 그 예외가 아래 except로 전파돼 status=error + 실제 사유(str(exc))를
   129	    # 붙잡는다(전송/프로토콜 실패는 원래 ToolException이 아니라 이미 전파 — 한 경로로 수렴).
   130	    with contextlib.suppress(Exception):  # rt 타입이 예상 밖이면 조용히 넘어감(무회귀)
   131	        rt.handle_tool_error = False
   132	
   133	    async def _execute(kwargs: dict, t0: float, sink: list[dict]) -> str:
   134	        # 실 부수효과: 실제 MCP 서버 도구를 호출한다. 승인됐거나 비위험 도구일 때만 도달.
   135	        reason: str | None = None  # 실패 사유(스펙 320) — 성공 시 None
   136	        try:
   137	            async with asyncio.timeout(_TOOL_TIMEOUT_S):
   138	                raw = await rt.ainvoke(kwargs)
   139	            text = _content_text(raw)
   140	            status = "ok"
   141	        except Exception as exc:
   142	            # 예외 타입에서 앞 밑줄 제거 — 어댑터 내부 클래스명(_MCPToolExecutionError)이 그대로
   143	            # UI에 새어 지저분해지지 않게(정돈=신뢰). 밑줄 없는 표준 예외명은 그대로 유지.
   144	            etype = type(exc).__name__.lstrip("_")
   145	            status = "error"
   146	            # 실제 사유(str(exc))를 붙잡아 인스펙터에 표면화(스펙 320) — 예외 타입만으론 "왜"를 못 본다.
   147	            # 마스킹+캡 백스톱 통과(사유가 새 노출 표면 — 토큰/입력값 누출 차단, learning 092).
   148	            reason = _sanitize_preview(f"{etype}: {exc}", _ERR_CAP)
   149	            # 모델-facing 텍스트에도 사유를 싣는다(스펙 320): handle_tool_error를 끄며 어댑터의 상세
   150	            # 오류 문자열이 사라지므로, 트레이스뿐 아니라 에이전트도 "왜 실패했는지"를 보고 적응·재시도할
   151	            # 수 있게(toolbox.py agent-call 실패가 str(exc)를 싣는 선례와 동형). reason은 이미 마스킹+캡됨.
   152	            text = f"도구 실행 실패({server}.{rt.name}): {reason}"
   153	        sink.append(
   154	            {
   155	                "server": server,
   156	                "tool": rt.name,
   157	                "status": status,
   158	                "ms": int((time.perf_counter() - t0) * 1000) + 1,
   159	                "args": _redact_args(
   160	                    kwargs
   161	                ),  # 스펙 087: 민감 키 마스킹 전 적재(형제 표면 누출 차단)
   162	                # 스펙 211: 직접 MCP 결과도 브로커/RAG와 같은 정화 경로(_sanitize_preview=비밀 마스킹+캡).
   163	                # 사용=공용 전환으로 타인이 크레덴셜 MCP를 배선할 수 있어(사용자 결정: 전부 공용), 결과에
