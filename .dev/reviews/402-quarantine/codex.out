    63	def _apply_approval_override(
    64	    required: bool, approver: str, server: str, tool: str, tool_policy: dict | None
    65	) -> tuple[bool, str]:
    66	    """에이전트 오버라이드(스펙 177 P2) — tool_policy["mcp:{server}/{tool}"].approval의
    67	    required/approver로 덮음(있는 키만). 강화·완화·approver 변경 모두 여기서 — 완화 권한 게이트는
    68	    저장 시점(agents CRUD)에서 강제, 리졸버는 순수 해석만."""
    69	    if isinstance(tool_policy, dict):
    70	        entry = tool_policy.get(f"mcp:{server}/{tool}")
    71	        ov = entry.get("approval") if isinstance(entry, dict) else None
    72	        if isinstance(ov, dict):
    73	            if "required" in ov:
    74	                required = bool(ov["required"])
    75	            if ov.get("approver"):
    76	                approver = ov["approver"]
    77	    return required, approver
