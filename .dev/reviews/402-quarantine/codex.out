   307	def _apply_auth_patch(obj: McpServer, auth_in: str | None) -> None:
   308	    """auth 의미 구분(provider.api_key와 동형): None/마스킹 = 기존 암호화 토큰 보존,
   309	    빈 문자열 = 명시적 제거, 그 외 = 새 평문 암호화. 마스킹값이 그대로 저장되는 버그 방지."""
   310	    if auth_in is None or crypto.is_masked(auth_in):
   311	        return  # 보존
   312	    obj.auth = None if auth_in == "" else crypto.encrypt(auth_in)
