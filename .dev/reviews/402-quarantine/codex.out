   315	@router.put("/mcp-servers/{id}", response_model=McpServerOut)
   316	async def update_mcp_server(
   317	    id: uuid.UUID,
   318	    body: McpServerIn,
   319	    session: AsyncSession = Depends(get_session),
   320	    principal: User | str = Depends(current_principal),
   321	) -> Any:
   322	    obj = await get_or_404(session, McpServer, id)
   323	    assert_may_manage(obj, principal)  # 소유자/특권만(스펙 112)
   324	    data = _norm_description(body.model_dump())
   325	    _assert_source_immutable(data, obj)
   326	    # published=커스텀 외부 서빙 전용(스펙 211, 152 재공개 금지 포함) — 끄기는 항상 허용.
   327	    if data.get("published") and obj.source != "custom":
   328	        raise HTTPException(status_code=400, detail="외부 서빙은 커스텀 MCP만 켤 수 있습니다.")
   329	    if data.get("tools_meta") is None:
   330	        data.pop("tools_meta", None)  # None=미변경(스펙 151 — 편집 폼이 메타를 안 들고 있어도 보존)
   331	    # 참조 무결성(스펙 093, operation-symmetry): rename도 삭제와 똑같이 config의 name 링크를 끊는다.
   332	    new_name = data.get("name")
   333	    if new_name is not None and new_name != obj.name:
   334	        await _assert_renameable(session, obj, new_name)
   335	    auth_in = data.pop("auth", None)
   336	    for key, value in data.items():
   337	        setattr(obj, key, value)
   338	    _apply_auth_patch(obj, auth_in)
   339	    # auth(비밀)는 payload 제외라 auth-only 변경은 버전 무증가(스펙 369 §2 경계).
   340	    await record_block_version(session, "mcp-server", obj)

