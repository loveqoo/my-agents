    40	def _mask_dsn(dsn: str) -> str:
    41	    """로그용 DSN — 비밀번호만 ***로 가린다(비밀값 비노출)."""
    42	    # postgresql+asyncpg://user:PASSWORD@host:port/db → 가운데 :pw@ 구간만 마스킹.
    43	    if "://" not in dsn:
    44	        return dsn
    45	    scheme, rest = dsn.split("://", 1)
    46	    if "@" not in rest:
    47	        return dsn
    48	    creds, host = rest.split("@", 1)
    49	    if ":" in creds:
    50	        user = creds.split(":", 1)[0]
    51	        creds = f"{user}:***"
    52	    return f"{scheme}://{creds}@{host}"
