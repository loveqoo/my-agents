    50	
    51	    **재진입 안전(codex 354 P1)**: `sweep()`이 배치 프로세스에서 fallback으로 이 함수를 부르므로 동시
    52	    진입이 가능하다. lock으로 직렬화하고, 로컬 변수로 만든 뒤 **성공했을 때만** 전역에 publish해
    53	    풀 누수·전역 뒤집힘을 막는다.
    54	
    55	    DB가 없거나 setup이 실패하면 None을 남기고 경고만 — HIL 게이트는 그때 비활성(승인 게이팅 없이
    56	    기존 무상태 경로로 폴백, chat.py가 checkpointer None을 흡수). 메모리 부재가 채팅을 죽이지 않는
    57	    스펙 019 graceful 원칙과 동형.
    58	    """
    59	    global _saver, _pool
    60	    async with _init_lock:
    61	        if _saver is not None:
    62	            return _saver
    63	        url = os.environ.get(
    64	            "DATABASE_URL", "postgresql+asyncpg://agent:agent@localhost:5432/agents"
    65	        )
    66	        dsn = _sync_dsn(url)
    67	        pool: AsyncConnectionPool | None = None
    68	        try:
    69	            pool = AsyncConnectionPool(
    70	                conninfo=dsn,
    71	                min_size=_POOL_MIN,
    72	                max_size=_POOL_MAX,
    73	                open=False,
    74	                kwargs=_CONN_KWARGS,
    75	            )
    76	            await pool.open()
    77	            saver = AsyncPostgresSaver(pool)
    78	            await saver.setup()
    79	            _pool, _saver = pool, saver  # 성공 후에만 전역 publish
    80	            log.info("AsyncPostgresSaver 준비 완료(HIL 체크포인터 — 커넥션 풀 max=%d)", _POOL_MAX)
    81	        except Exception as exc:
    82	            log.warning("체크포인터 초기화 실패 — HIL 게이트 비활성: %s", exc)
    83	            if pool is not None:
    84	                with contextlib.suppress(Exception):  # 정리 실패는 삼킨다(초기화 실패 경로)
    85	                    await pool.close()
    86	        return _saver
    87	
    88	
    89	def get_checkpointer() -> AsyncPostgresSaver | None:
    90	    """현재 싱글턴(미초기화/실패 시 None). 그래프 재구축·재개가 같은 인스턴스를 받게 하는 단일 출처."""
    91	    return _saver
    92	
    93	
    94	async def close_checkpointer() -> None:
    95	    """앱 종료(lifespan)에 풀 정리."""
    96	    global _saver, _pool
    97	    if _pool is not None:
    98	        try:
    99	            await _pool.close()
   100	        except Exception as exc:
   101	            log.warning("체크포인터 종료 중 오류(무시): %s", exc)
   102	    _saver = None
   103	    _pool = None

