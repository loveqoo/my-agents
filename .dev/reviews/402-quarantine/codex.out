   252	            detail=f"도구를 가져오지 못했습니다 — 서버({obj.name}) 연결 실패 또는 원격에 {tool_name} 없음. '도구 정보 새로 탐색'으로 상태를 확인하세요.",
   253	        )
   254	    try:
   255	        await tools[0].ainvoke(body.args or {})
   256	    except Exception as exc:
   257	        # 래퍼 밖 실패 = 인자 스키마 검증(StructuredTool이 _run 이전에 검사) 등 — 500 대신
   258	        # 시험 결과로 표면화(인자 틀림도 정당한 시험 결과다). 마스킹+캡은 채팅 표면과 동일 규칙.
