    98	@router.post("/mcp-servers/discover", response_model=McpDiscoverResult)
    99	async def discover_mcp_tools(body: McpDiscoverIn) -> Any:
   100	    """저장 전 폼에서 MCP 서버에 **실제로 붙어** 도구목록을 읽는다(부작용 0 — list만). 등록 자동채움용(스펙 054 E).
   101	
   102	    stdio는 유예 — http만 라이브 탐색. 비밀은 결과에 미포함(latency·도구이름·메타만).
   103	    마스킹(•) auth는 헤더 생략(a2a_client 규칙).
   104	    """
