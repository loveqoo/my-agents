   171	def _assert_tool_enabled(obj: McpServer, tool_name: str) -> None:
   172	    """시험 대상은 활성 도구여야(스펙 326)."""
   173	    if tool_name not in (obj.enabled_tools or []):
   174	        raise HTTPException(status_code=400, detail=f"활성 도구가 아닙니다: {tool_name}")
   175	
   176	
   177	def _assert_tool_transport(obj: McpServer) -> None:
   178	    """http transport + URL 보유 서버만 시험 가능(스펙 326)."""
   179	    if obj.transport != "http" or not (obj.url or obj.endpoint):
   180	        raise HTTPException(
   181	            status_code=400, detail="http transport + URL이 있는 서버만 시험할 수 있습니다."
   182	        )
