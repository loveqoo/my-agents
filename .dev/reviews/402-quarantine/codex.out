   241	@router.post("/{agent_id}/chat")
   242	async def chat(
   243	    agent_id: uuid.UUID, body: ChatRequest, principal: User | str = Depends(current_principal)
   244	) -> StreamingResponse:
   245	    # 스펙 068: resume 바인딩에 067과 *동일한* 소유자 스코프를 주입(정본 authz.own_scope 재사용, 298).
   246	    # 비-admin이 타인/추측 session_id를 줘도 매칭 실패 → 새 세션(열거 오라클·소유권 탈취 봉인).
   247	    own = authz.own_scope(principal, "sessions", "read")
   248	    req_version = await _validate_entry(agent_id, body, principal)
   249	    ctx = await _load_context(
   250	        agent_id, body.sessionId, body.overrides, own=own, version=req_version
   251	    )
   252	    user_text = body.messages[-1].content if body.messages else ""
   253	
   254	    # mem0 user_id 축 = 인증 주체에서 도출(스펙 032). 쿠키 유저면 안정 UUID(str(user.id)),
   255	    # mem0 user 축 정체성(스펙 387) — 단일 관문: 머신 토큰만 body.userId 수용(위임 호출),
   256	    # 쿠키 유저가 보내면 422(032 보안 보존). 미지정 시 기존 동작(쿠키=자기 id, 머신=세션 축만).
   257	    user_id = resolve_memory_user_id(principal, body.userId)
   258	
   259	    # 코드(SDK)·외부(A2A) 에이전트 모두 비로컬 — 등록된 카드 url로 A2A 런타임 호출(스펙 057: A2A 단일화).
   260	    # code=우리가 SDK로 배포한 A2A(provenance 메타 보유), external=제3자 A2A. 전송은 _a2a_stream 하나.

