   126	def clean_model_params(mp: object) -> dict:
   127	    """modelParams 정리 — 화이트리스트 키의 **타입·범위 검증** 통과분만 보존(스펙 411). bool은 진짜
   128	    bool만, number는 진짜 수치(bool 배제)만·범위 클램프. 에이전트/노드/세션 저장 경계가 공유(하드코딩
   129	    없음 — 서술자 파생). 미지 키·타입 불일치는 드롭(문자열 "false"로 게이트 우회 차단)."""
   130	    if not isinstance(mp, dict):
   131	        return {}
   132	    out: dict = {}
   133	    for key, val in mp.items():
   134	        d = _BY_KEY.get(key)
   135	        if d is None:
   136	            continue
   137	        if d.kind == "bool" and isinstance(val, bool):
   138	            out[key] = val
   139	        elif d.kind == "number" and isinstance(val, (int, float)) and not isinstance(val, bool):
   140	            num = val
   141	            if d.minimum is not None:
   142	                num = max(d.minimum, num)
   143	            if d.maximum is not None:
   144	                num = min(d.maximum, num)
   145	            out[key] = int(num) if d.is_int else float(num)
   146	    return out
