   140	                placeholder={`모델 기본 ${inh}`}
   141	                onChange={(v) => {
   142	                  const mp = { ...value }
   143	                  if (v == null) delete mp[p.key]
   144	                  else mp[p.key] = v
   145	                  onChange(mp)
   146	                }}
   147	              />
   148	              {curNum !== undefined ? (
   149	                <Button
   150	                  size="small"
   151	                  type="text"
   152	                  onClick={() => {
   153	                    const mp = { ...value }
   154	                    delete mp[p.key]
   155	                    onChange(mp)
   156	                  }}
   157	                >
   158	                  상속
   159	                </Button>
   160	              ) : null}
   161	            </Flex>
   162	            <Text type="secondary" style={{ fontSize: 12 }}>
   163	              모델 기본값을 이 층에서 덮습니다(비우면 상속=모델 기본 {inh}).
   164	            </Text>
   165	          </Flex>
   166	        )

