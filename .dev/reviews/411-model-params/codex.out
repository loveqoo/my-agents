    71	def _as_bool(value: object, default: bool) -> bool:
    72	    """**진짜 bool만** 인정하고 그 외(문자열 "false"·정수·None)는 default로 폴백(스펙 409 codex P1②).
    73	    `bool("false")`가 True인 함정을 실행부에서 봉인 — 게이트가 문자열 주입으로 뚫리지 않는다."""
    74	    return value if isinstance(value, bool) else default
    75	
    76	
    77	def _cap_default(cap: str) -> bool:
    78	    return DEFAULT_CAPABILITIES.get(cap, True)
    79	
