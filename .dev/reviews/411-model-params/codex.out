    62	export function CapabilitySettings({
    63	  descriptors,
    64	  capabilities,
    65	  value,
    66	  onChange,
    67	  modelDefaults,
    68	  size = 'small',
    69	}: {
    70	  descriptors: ModelDescriptors
    71	  capabilities: Record<string, boolean> | undefined
    72	  value: ModelParams
    73	  onChange: (next: ModelParams) => void
    74	  modelDefaults?: Record<string, unknown> // 선택 모델의 params(상속 값 표시용)
    75	  size?: 'small' | 'middle'
    76	}) {
    77	  const { params } = descriptors
    78	  if (!params.length) return null
    79	  return (
    80	    <Flex vertical gap={12}>
    81	      {params.map((p) => {
    82	        // 능력 판정은 백엔드 resolve_effective와 **일치**(codex P2②): 키가 진짜 bool이면 그 값,
    83	        // 아니면(누락·비-bool) 서술자 capDefault(descriptors.capabilities에서 조회). cap=null이면
    84	        // 능력 게이트 없음(항상 가능) — capabilities=undefined(미조회)면 낙관적 허용.
    85	        const fact = p.cap ? descriptors.capabilities.find((c) => c.cap === p.cap) : undefined
    86	        const raw = p.cap ? capabilities?.[p.cap] : undefined
    87	        const capable = !p.cap
    88	          ? true
    89	          : capabilities
    90	            ? (typeof raw === 'boolean' ? raw : (fact?.capDefault ?? true))
    91	            : true
    92	
    93	        if (p.kind === 'bool') {
    94	          const cur = value[p.key] === undefined ? 'inherit' : value[p.key] ? 'on' : 'off'
    95	          const inh = inheritedOn(p, capable, modelDefaults)
    96	          return (
    97	            <Flex vertical gap={2} key={p.key}>
    98	              <Text style={{ fontSize: 13, fontWeight: 600 }}>{p.label}</Text>
    99	              <Select
   100	                size={size}
   101	                style={{ width: 220 }}
   102	                value={cur}
   103	                onChange={(v) => {
   104	                  const mp = { ...value }
   105	                  if (v === 'inherit') delete mp[p.key]
   106	                  else mp[p.key] = v === 'on'
   107	                  onChange(mp)
   108	                }}
   109	                options={[
   110	                  { value: 'inherit', label: `모델 기본(상속 — ${inh ? '켬' : '끔'})` },
   111	                  { value: 'on', label: '켬', disabled: !capable },
   112	                  { value: 'off', label: '끔' },
   113	                ]}
   114	              />
   115	              <Text type="secondary" style={{ fontSize: 12 }}>
   116	                {capable
   117	                  ? `모델 기본값을 이 층에서 덮습니다(상속=모델 설정 따름).`
   118	                  : `이 모델은 ${p.label}을(를) 지원하지 않아 켤 수 없습니다(능력 우선).`}
   119	              </Text>
   120	            </Flex>
   121	          )
   122	        }
   123	
   124	        // number: 상속(미설정)/값(min~max, step, isInt면 정수).
   125	        const cur = value[p.key]
   126	        const curNum = typeof cur === 'number' ? cur : undefined
   127	        const inh = inheritedNumber(p, modelDefaults)
   128	        return (
   129	          <Flex vertical gap={2} key={p.key}>
   130	            <Text style={{ fontSize: 13, fontWeight: 600 }}>{p.label}</Text>
   131	            <Flex align="center" gap={8}>
   132	              <InputNumber
   133	                size={size}
   134	                style={{ width: 160 }}
   135	                min={p.min ?? undefined}
   136	                max={p.max ?? undefined}
   137	                step={p.step ?? undefined}
   138	                precision={p.isInt ? 0 : undefined}
   139	                value={curNum}
   140	                placeholder={`모델 기본 ${inh}`}
   141	                onChange={(v) => {
   142	                  const mp = { ...value }
   143	                  if (v == null) delete mp[p.key]
   144	                  else mp[p.key] = v
   145	                  onChange(mp)
   146	                }}
   147	              />
   148	              {curNum !== undefined ? (
   149	                <Button
   150	                  size="small"
   151	                  type="text"
   152	                  onClick={() => {
   153	                    const mp = { ...value }
   154	                    delete mp[p.key]
   155	                    onChange(mp)
   156	                  }}
   157	                >
   158	                  상속
   159	                </Button>
   160	              ) : null}
   161	            </Flex>
   162	            <Text type="secondary" style={{ fontSize: 12 }}>
   163	              모델 기본값을 이 층에서 덮습니다(비우면 상속=모델 기본 {inh}).
   164	            </Text>
   165	          </Flex>
   166	        )
   167	      })}
   168	      {/* 안내(스펙 410) — 사고 과정은 모델 서버가 reasoning 파서를 지원할 때 스트리밍으로 표시된다
   169	          (예: rapid-mlx `--reasoning-parser qwen3`, vLLM `--reasoning-parser`). thinking 설정이 있을 때만 노출. */}
   170	      {params.some((p) => p.cap === 'thinking') ? (
   171	        <Text type="secondary" style={{ fontSize: 12 }}>
   172	          Thinking을 켜면 모델의 사고 과정이 대화에 접이식 패널로 표시됩니다(서버가 reasoning 파서를 지원할 때).
   173	        </Text>
   174	      ) : null}
   175	    </Flex>
   176	  )
   177	}
    30	  nodes?: PipelineNode[]
    31	}
    32	
    33	/* 에이전트 저장 설정에서 패널 기본값을 만든다. Agent엔 temperature 필드가 없어 자동(null).
    34	   tools 구저장 하이드레이션(스펙 276)은 컴포넌트가 blocks 카탈로그로 수행(여기선 저장값 그대로). */
    35	export function overrideDefaults(a: Agent): Overrides {
    36	  return {
    37	    model: a.model ?? '',
    38	    systemPrompt: a.systemPrompt ?? '',
    39	    mcps: [...(a.mcps ?? [])],
    40	    tools: [...(a.tools ?? [])],
    41	    memories: [...(a.memories ?? [])],
    42	    capabilities: [...(a.capabilities ?? [])],
    43	    historyDepth: a.historyDepth ?? 20,
    44	    modelParams: { ...(a.modelParams ?? {}) }, // 세션 베이스=에이전트 저장 설정(변경분만 전송)
    45	
    46	    // 노드형(스펙 287→316) — 베이스는 **해석된 유효 노드**(resolvedNodes: 참조를 등록 config로 치환한
    47	    // 파생, 서버도 해석→병합 순서라 인덱스 정렬 일치). resolvedNodes가 없으면(구 응답) 저장 nodes로
    48	    // 폴백하되, 참조 항목이 남아 있으면(미해결) 편집 불가 — undefined로 두고 패널이 Alert로 안내.
    49	    // 깊은 복사: 에디터가 필드를 편집해도 원본 불변.
    50	    nodes: (() => {
    51	      if (a.impl !== 'pipeline') return undefined
    52	      const base = a.resolvedNodes ?? a.nodes
    53	      if (!base || base.some(isNodeRef)) return undefined
    54	      return structuredClone(base as PipelineNode[])
    55	    })(),
    56	  }
    57	}
    58	
    59	const sameSet = (a: string[], b: string[]) =>
    60	  a.length === b.length && [...a].sort().join('\n') === [...b].sort().join('\n')
