+    FE/BE 드리프트 0(사본 금지). capabilities(사실 축)와 params(튜닝 축)를 함께 실어 FE가 모델 폼의
+    능력 토글과 파라미터 오버라이드를 각각 렌더한다."""
+    return {
+        "capabilities": [
+            {"cap": c, "label": _CAP_LABEL.get(c, c), "capDefault": DEFAULT_CAPABILITIES.get(c, False)}
+            for c in CAPABILITIES
