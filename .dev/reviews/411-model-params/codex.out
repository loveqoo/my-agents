   103	def resolve_number(key: str, *layers: dict) -> float | int | None:
   104	    """number 파라미터의 유효값 — 층을 뒤에서 앞으로 훑어 처음 명시된 수치를 취하고, 없으면 서술자
   105	    default. 범위 클램프. max_tokens처럼 default=0(미설정=서버 기본)이면 0 반환(호출부가 안 보냄)."""
   106	    d = _BY_KEY.get(key)
   107	    if d is None or d.kind != "number":
   108	        return None
   109	    val: float | int | None = d.default
   110	    for layer in layers:
   111	        if not layer:
   112	            continue
   113	        raw = layer.get(key)
   114	        if isinstance(raw, (int, float)) and not isinstance(raw, bool):
   115	            val = raw
   116	            break
   117	    if val is None:
   118	        return None
   119	    if d.minimum is not None:
   120	        val = max(d.minimum, val)
   121	    if d.maximum is not None:
   122	        val = min(d.maximum, val)
   123	    return int(val) if d.is_int else float(val)
