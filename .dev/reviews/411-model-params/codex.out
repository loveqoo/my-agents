    46	def build_chat_openai(
    47	    cfg: dict | None,
    48	    params: dict | None = None,
    49	    *,
    50	    default_temperature: float = 0.7,
    51	    on_missing: str = "raise",
    52	    error_label: str = _MISSING_MSG,
    53	) -> ChatOpenAI | None:
    54	    """model_cfg → ChatOpenAI. base_url/model_id 없으면 `on_missing`: "raise"(기본)면 명확히 실패,
    55	    "none"이면 None 반환(모델 없이도 도는 경로용 — artifact ask-only). temperature 우선순위:
    56	    호출자 params > 모델 등록 params > `default_temperature`."""
    57	    cfg = cfg or {}
    58	    base_url = cfg.get("base_url") or ""
    59	    model_id = cfg.get("model_id") or ""
    60	    if not base_url or not model_id:
    61	        if on_missing == "none":
    62	            return None
    63	        raise RuntimeError(error_label)
    64	    cfg_params = cfg.get("params") or {}
    65	    params = params or {}
    66	    caps = cfg.get("capabilities") or {}
    67	    # 파라미터 유효값을 서술자(capabilities.py PARAMS)로 해석·배선(스펙 411 — temperature·top_p·
    68	    # max_tokens·repetition_penalty·stream·enable_thinking 단일 메커니즘). 층 우선순위=호출자 params
    69	    # (세션) > cfg_params(모델·에이전트·노드 병합). bool은 능력 AND 설정(게이트), number는 범위 클램프.
    70	    # wire별 배선이 유일한 축별 코드: top=ChatOpenAI 직접 kwargs, extra_body=비표준, disable_streaming.
    71	    top_kwargs: dict = {}
    72	    chat_template_kwargs: dict = {}
    73	    extra_body: dict = {}
    74	    disable_streaming = False
    75	    for p in PARAMS:
    76	        if p.kind == "bool":
    77	            eff = resolve_effective(p.key, caps, params, cfg_params)
    78	            if p.wire == "disable_streaming":
    79	                disable_streaming = not eff
    80	            elif p.wire == "extra_body":
    81	                chat_template_kwargs[p.key] = eff
    82	        else:  # number
    83	            if p.key == "temperature":
    84	                # temperature는 미명시 시 caller default_temperature 존중(기존 계약 — 스펙 077 흡수).
    85	                num = resolve_number("temperature", params, cfg_params)
    86	                explicit = any(
    87	                    isinstance(lay.get("temperature"), (int, float)) and not isinstance(lay.get("temperature"), bool)
    88	                    for lay in (params, cfg_params)
    89	                )
    90	                num = num if explicit else default_temperature
    91	            else:
    92	                num = resolve_number(p.key, params, cfg_params)
    93	            if p.key == "max_tokens" and (num is None or num <= 0):
    94	                continue  # 0/미설정=서버 기본(안 보냄)
    95	            if num is None:
    96	                continue
    97	            if p.wire == "top":
    98	                top_kwargs[p.key] = num
    99	            elif p.wire == "extra_body":
   100	                extra_body[p.key] = num
   101	    if chat_template_kwargs:
   102	        extra_body["chat_template_kwargs"] = chat_template_kwargs
   103	    api_key = cfg.get("api_key") or "sk-noauth"
   104	    # 클라이언트 풀(스펙 371 D2) — 같은 연결·모델·파라미터면 인스턴스 재사용(ChatOpenAI는 호출간
   105	    # 무상태·async-safe). 목적은 생성 비용(~0.1ms)이 아니라 **커넥션 재사용**(실 프로바이더 TLS
   106	    # 핸드셰이크 — mock 루프백 사각지대). 키에 api_key 지문 포함 → 로테이션=새 인스턴스.
   107	    # 루프별 격리 — httpx async 클라이언트는 자기 이벤트 루프에 묶인다. 서버는 루프 하나라 늘
   108	    # 적중하고, 루프를 새로 여는 컨텍스트(in-process 테스트의 asyncio.run 반복)는 루프마다 새
   109	    # 인스턴스(죽은 루프의 엔트리는 LRU가 축출). 루프 밖(동기)이면 풀 미사용.
   110	    try:
   111	        loop_id = id(asyncio.get_running_loop())
   112	    except RuntimeError:
   113	        loop_id = None
   114	    # 풀 키에 해석된 모든 파라미터 반영(스펙 411) — 값이 다르면 다른 클라이언트(캐시 오염 방지).
   115	    key = (
   116	        loop_id,
   117	        base_url,
   118	        hashlib.sha256(api_key.encode()).hexdigest()[:8],
   119	        model_id,
   120	        json.dumps(top_kwargs, sort_keys=True),
   121	        json.dumps(extra_body, sort_keys=True),
   122	        disable_streaming,
   123	    )
   124	    pooled = _CLIENT_POOL.get(key) if loop_id is not None else None
   125	    if pooled is not None:
   126	        return pooled
   127	    # ReasoningChatOpenAI(스펙 410): base가 버리는 reasoning_content를 additional_kwargs로 되살린다
   128	    # (사고 없는 모델·응답엔 무영향 — 항상 써도 안전). 사고 과정 표시(410 P2/P3)가 이를 소비.
   129	    # top_kwargs=temperature/top_p/max_tokens(표준 인자), extra_body=enable_thinking/repetition_penalty(비표준).
   130	    client = ReasoningChatOpenAI(
   131	        base_url=base_url,
   132	        api_key=api_key,
   133	        model=model_id,
   134	        # 능력 없음/사용 끔 → astream이 ainvoke로 접혀 완성문 1회 yield(비스트리밍 안전 실행).
   135	        disable_streaming=disable_streaming,
   136	        extra_body=extra_body,
   137	        **top_kwargs,
   138	    )
   139	    if loop_id is not None:
   140	        if len(_CLIENT_POOL) >= _CLIENT_POOL_MAX:
   141	            _CLIENT_POOL.pop(next(iter(_CLIENT_POOL)))  # 최고령 축출(삽입순)
   142	        _CLIENT_POOL[key] = client
   143	    return client
     1	/* 능력→설정 오버라이드 단일 컴포넌트(스펙 409·411). 에이전트 폼·플레이그라운드 오버라이드·노드
     2	   편집기가 **공유**한다(사본 금지 — 회고 261 "사본이면 드리프트"의 설정 축 교정). 서술자 목록
     3	   (백엔드 정본)으로 렌더하므로 설정이 늘면 이 컴포넌트를 안 고쳐도 자동 반영된다.
     4	
     5	   스펙 411: params는 kind별로 다른 표현이다 — bool은 상속(키 없음)/켬/끔 3상, number는
     6	   상속(미설정)/값(min~max, step, isInt면 정수)이다. 능력이 아니라 **사용값**을 덮는다 — 모델이
     7	   못 하는 걸 켤 수는 없어(부분집합 불가침), 능력 false인 bool 축은 '켬'을 비활성하고 사유를 표시한다.
     8	   temperature도 이제 params 안 kind=number 항목이라(스펙 077 TemperatureField 은퇴) 이 컴포넌트가 담는다. */
     9	import { Button, Flex, InputNumber, Select, Typography } from 'antd'
    10	import { useEffect, useState } from 'react'
    11	import { getCapabilityDescriptors, type ModelDescriptors, type ParamDescriptor } from '../../../api'
    12	
    13	const { Text } = Typography
    14	
    15	const EMPTY_DESCRIPTORS: ModelDescriptors = { capabilities: [], params: [] }
    16	
    17	// 서술자는 사실상 정적(백엔드 상수) — 프로세스 1회 fetch 후 캐시(프롭 배관 없이 어느 소비처든 훅 호출).
    18	let _cache: ModelDescriptors | null = null
    19	let _inflight: Promise<ModelDescriptors> | null = null
    20	
    21	export function useCapabilityDescriptors(): ModelDescriptors {
    22	  const [d, setD] = useState<ModelDescriptors>(_cache ?? EMPTY_DESCRIPTORS)
    23	  const [attempt, setAttempt] = useState(0)
    24	  useEffect(() => {
    25	    if (_cache) return
    26	    let alive = true
    27	    let timer: ReturnType<typeof setTimeout> | undefined
    28	    if (!_inflight) _inflight = getCapabilityDescriptors().then((r) => (_cache = r))
    29	    _inflight
    30	      .then((r) => alive && setD(r))
    31	      .catch(() => {
    32	        // 실패 시 _inflight를 비우고 **현재 마운트에서도** 백오프 재시도(codex 재검 P2① — _inflight만
    33	        // 비우면 재마운트해야 재시도라 화면이 계속 떠 있으면 빈 UI 고착). 최대 5회, 성공 값만 캐시.
    34	        _inflight = null
    35	        if (alive && attempt < 5) timer = setTimeout(() => setAttempt((a) => a + 1), 1000 * (attempt + 1))
    36	      })
    37	    return () => {
    38	      alive = false
    39	      if (timer) clearTimeout(timer)
    40	    }
    41	  }, [attempt])
    42	  return d
    43	}
    44	
    45	type ModelParams = Record<string, boolean | number | undefined>
    46	
    47	/** 이 층에서 상속했을 때 실제로 켜질지(bool 전용, 모델 params → 서술자 default, 능력 false면 무조건 끔).
    48	 *  BE resolve_effective와 **일치**(codex 재검 P2②): 모델 params 값이 진짜 bool일 때만 그 값을
    49	 *  쓰고, 비-bool(문자열 "false" 등)은 서술자 default로 폴백(FE가 켬으로 오표시하던 것 봉인). */
    50	function inheritedOn(p: ParamDescriptor, capable: boolean, modelDefaults?: Record<string, unknown>): boolean {
    51	  if (!capable) return false
    52	  const v = modelDefaults?.[p.key]
    53	  return typeof v === 'boolean' ? v : Boolean(p.default)
    54	}
    55	
    56	/** 상속 시 표시할 모델 기본값(number 전용) — modelDefaults가 진짜 number면 그 값, 아니면 서술자 default. */
    57	function inheritedNumber(p: ParamDescriptor, modelDefaults?: Record<string, unknown>): number {
    58	  const v = modelDefaults?.[p.key]
    59	  return typeof v === 'number' ? v : Number(p.default)
    60	}
