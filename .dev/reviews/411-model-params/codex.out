    81	def resolve_effective(cap_or_key: str, capabilities: dict, *layers: dict) -> bool:
    82	    """bool 파라미터의 유효값 = **능력 AND 설정**(스펙 409 — 능력 false면 어느 층도 못 켬).
    83	
    84	    cap_or_key: 능력 키(streaming/thinking) 또는 파라미터 키(stream/enable_thinking) — 둘 다 허용.
    85	    설정값은 층을 뒤에서 앞으로 훑어 처음 명시된 진짜 bool을 취하고, 없으면 서술자 default.
    86	    """
    87	    # 능력 키로 왔으면 대응 파라미터 서술자를 찾는다(stream↔streaming, enable_thinking↔thinking).
    88	    d = _BY_KEY.get(cap_or_key)
    89	    if d is None:
    90	        d = next((p for p in PARAMS if p.cap == cap_or_key), None)
    91	    if d is None or d.kind != "bool":
    92	        return False
    93	    cap = d.cap
    94	    capable = _as_bool(capabilities.get(cap), _cap_default(cap)) if cap else True
    95	    want = bool(d.default)
    96	    for layer in layers:
    97	        if layer and isinstance(layer.get(d.key), bool):
    98	            want = layer[d.key]
    99	            break
   100	    return capable and want
